+void LibretroDroid::setRewindEnabled(bool enabled) { rewindWanted = enabled; }
+
+// Under the core lock, on each frame: the history is made once the game is running and freed when rewind is turned off.
+void LibretroDroid::syncRewind() {
+    if (rewindWanted && !rewind) {
+        size_t size = core->retro_serialize_size();
+        rewind = size ? smz_rewind_new(size, 48u << 20, 3600) : nullptr;
+        if (rewind) rewindBuffer.resize(size);
+        rewindIsOpen = rewind ? 0 : -1;
+    } else if (!rewindWanted && rewind) {
+        smz_rewind_free(rewind);
+        rewind = nullptr;
+        rewindBuffer = {};
+        rewindBuffer.shrink_to_fit();
+        rewinding = false;
+        rewindCursor = rewindCount = rewindIsOpen = -1;
+    }
+}
+
+// A save taken while rewinding gets the present, not the frame on screen.
+void LibretroDroid::leaveRewind() {
+    if (!rewind || !rewinding) return;
+    smz_rewind_step(rewind, smz_rewind_count(rewind));
+    core->retro_unserialize(smz_rewind_state(rewind), rewindBuffer.size());
+    rewinding = false;
+    rewindIsOpen = 0;
+}
+
+void LibretroDroid::rewindOpen() { rewindRequest = 1; }
+void LibretroDroid::rewindHold(int direction) { rewindDirection = direction; }
+void LibretroDroid::rewindClose(bool playFromCursor) { rewindRequest = playFromCursor ? 2 : 3; }
+
+std::vector<int> LibretroDroid::rewindPosition() { return {rewindCursor.load(), rewindCount.load(), rewindIsOpen.load()}; }
+
+// Called under the core lock on each frame: carries out the requests and, while open, shows the cursor's frame. True
+// while the game stands still.
+bool LibretroDroid::stepRewind() {
+    int request = rewindRequest.exchange(0);
+    if (request == 1 && !rewinding && smz_rewind_count(rewind) > 1) {
+        rewinding = true;
+        smz_rewind_open(rewind);
+        rewindShown = -1;
+        rewindDir = rewindHeld = 0;
+    } else if ((request == 2 || request == 3) && rewinding) {
+        if (request == 3) smz_rewind_step(rewind, smz_rewind_count(rewind));
+        core->retro_unserialize(smz_rewind_state(rewind), rewindBuffer.size());
+        if (request == 2) smz_rewind_cut(rewind);
+        rewinding = false;
+    }
+    rewindIsOpen = rewinding ? 1 : 0;
+    rewindCount = smz_rewind_count(rewind);
+    if (!rewinding) return false;
+
+    int dir = rewindDirection.load();
+    if (dir != rewindDir) { rewindDir = dir; rewindHeld = 0; }
+    if (dir) {   // real speed first, then twice and four times as fast
+        rewindHeld++;
+        smz_rewind_step(rewind, dir * (rewindHeld < 72 ? 1 : rewindHeld < 180 ? 2 : 4));
+    }
+    int cursor = smz_rewind_cursor(rewind);
+    if (cursor != rewindShown) {   // the picture of that moment: its state and one silent frame
+        rewindShown = cursor;
+        core->retro_unserialize(smz_rewind_state(rewind), rewindBuffer.size());
+        bool wasEnabled = audioEnabled;
+        audioEnabled = false;
+        core->retro_run();
+        audioEnabled = wasEnabled;
+    }
+    rewindCursor = cursor;
+    return true;
+}
