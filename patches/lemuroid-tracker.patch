+        val cancel = { boxKind = "" }
+        boxKind = "pick"
+        val b = Smz3Box(activity)
+        fun move(d: Int) { i = (i + d + PAUSE_HOURS.size) % PAUSE_HOURS.size; b.message = line() }
+        box = b.apply {
+            title = "Pause until"; message = line()
+            options = listOf(
+                Smz3Box.Option("Ask the others") { RaceClient.send("pause", JSONObject().put("resumeAt", serverNow() + PAUSE_HOURS[i] * 3_600_000L), true); Smz3Finish.cue(6); boxKind = "" },
+                Smz3Box.Option("Later", keep = true) { move(1) },
+                Smz3Box.Option("Cancel") { cancel() },
+            )
+            step = { move(it) }
+            back = cancel; backLabel = "Cancel"
+        }.show()
+    }
+
+    private fun showVote() {
+        box?.dismiss()
+        boxKind = "vote"
+        val who = (0 until players.length()).map { players.getJSONObject(it) }.firstOrNull { it.optString("pid") == voteBy }?.optString("name") ?: "A rival"
+        val at = voteAt
+        val yes = { voteDone = at; RaceClient.send("vote", JSONObject().put("yes", true), true); Smz3Finish.cue(6); boxKind = "" }
+        val no = { voteDone = at; RaceClient.send("vote", JSONObject().put("yes", false), true); Smz3Finish.cue(5); boxKind = "" }
+        box = Smz3Box(activity).apply {
+            title = "Pause the race?"; message = "$who asks to pause until ${whenAt(at)}"
+            options = listOf(Smz3Box.Option("Yes") { yes() }, Smz3Box.Option("No") { no() })
+            back = no; backLabel = "No"
+        }.show()
+    }
+
+    private fun waitKey() = "$voteAt ${voteBy == you} ${voted()} ${noSent == voteAt}"
+
+    /** The asker can take the request back and a yes can become a no, once each vote. */
+    private fun showWait() {
+        box?.dismiss()
+        boxKind = "wait"
+        waitShown = waitKey()
+        val at = voteAt
+        val asker = voteBy == you
+        val change = noSent != at && (asker || voted())
+        val no = { noSent = at; voteDone = at; RaceClient.send("vote", JSONObject().put("yes", false), true); Smz3Finish.cue(5); boxKind = "" }
+        box = Smz3Box(activity).apply {
+            title = "Pause the race?"
+            message = when {
+                noSent == at -> if (asker) "Taken back: waiting for the server" else "You said no: waiting for the server"
+                asker -> "You asked to pause until ${whenAt(at)}. Waiting for the others to answer"
+                voted() -> "You said yes. Waiting for the others to answer"
+                else -> "Waiting for the others to answer"
+            }
+            if (change) { val label = if (asker) "Take back" else "Change to No"; options = listOf(Smz3Box.Option(label) { no() }); back = no; backLabel = label }
+        }.show()
+    }
+
+    private fun showPausedCard() {
+        if (activity.isFinishing) return
+        pausedBox?.dismiss()
+        pausedBox = Smz3Box(activity).apply {
+            title = "RACE PAUSED"
+            message = "Goes on ${whenAt(resumeAt)}. Come back on this device, from Championship.\n\n" + table()
+            options = listOf(Smz3Box.Option("Back to menu") { onLeave() })
+            back = onLeave; backLabel = "Back to menu"
+        }.show()
+    }
+
+    private fun closeCard() { card?.dismiss(); card = null; Smz3Finish.clear() }
+
+    /**
+     * VICTORY, a place, DRAW, DEFEAT or RACE CANCELLED: the end card of a run (Smz3Finish) with the standings, and its
+     * fanfare when won. A keeps playing (or saves the time to the ladder), B goes to the menu. [again]: the same result
+     * shown once more (a multi race that ended after this player's finish), so it comes up without the show.
+     */
+    private fun showCard(again: Boolean = false) {
+        if (activity.isFinishing) return
+        val cancelled = state == "cancelled"
+        val running = state == "running"
+        val ladder = won() && !draft() && (state == "finished" || running)
+        val draw = endWhy == "draw"
+        val mine = me()
+        val title = if (cancelled) "RACE CANCELLED" else if (first()) "VICTORY" else if (draw) "DRAW" else mine?.optInt("place")?.takeIf { it > 0 }?.let { "${ordinal(it).uppercase()} PLACE" } ?: "DEFEAT"
+        val win = title == "VICTORY"
+        val head = if (cancelled && endWhy.isNotEmpty()) endWhy else when (format) { "sprint" -> "Sprint"; "half" -> "Half"; "draft" -> "Online draft"; else -> "Full game" } +
+            if (running) ": the race goes on" else if (pauses > 0) ", paused" else ""
+        val winner = sorted().firstOrNull { it.optInt("place") == 1 }
+        val big = when {
+            myTime() >= 0 -> null
+            cancelled -> "No result"
+            draw -> "Time is up"
+            win -> "The others left"
+            winner != null -> "${winner.optString("name")} won"
+            else -> "-"
+        }
+        val stay = if (myTime() >= 0) "Keep watching" else "Keep playing"
+        val c = Smz3Finish.Card(
+            title, head, "", true, maxOf(0L, myTime()),
+            standings = sorted().map { Smz3Finish.Standing(place(it), it.optString("name"), timeOf(it), it.optString("pid") == you) },
+            big = big, win = win,
+            accent = if (win) Smz3Box.GOLD else if (cancelled || draw) Smz3Box.DIM else Smz3Box.RED,
+            a = if (ladder) "Save to ladder" else stay, b = "Back to menu",
+        )
+        val same = again && card?.isShowing == true && Smz3Finish.card?.title == title
+        card?.dismiss()
+        Smz3Finish.start(c)
+        if (same) Smz3Finish.skip()
+        Smz3Finish.onA = { main.post { if (Smz3Finish.card === c && c.a == "Save to ladder") saveToLadder(c) else closeCard() } }
+        Smz3Finish.onB = { main.post { closeCard(); onLeave() } }
+        card = Smz3Finish.host(activity)
+    }
+
+    private fun saveToLadder(c: Smz3Finish.Card) {
+        RaceClient.send("ladder", null, true)
+        Smz3Finish.cue(6)
+        c.ladder = "Saved to the ladder"
+        c.a = "Keep watching"
+    }
+}
