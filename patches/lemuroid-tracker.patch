+
+/** The transition between screens: the wallpaper covers the screen, then a bright diagonal seam opens it, four bands
+ * locking in one after another. */
+private fun DrawScope.drawWipe(progress: Float, scale: Float, drift: Float) {
+    if (progress >= 1f) return
+    val w = size.width; val h = size.height; val band = h / 4f; val slope = 0.22f; val rows = 90
+    val p = progress
+    val cover = Path()
+    val edges = FloatArray(rows)
+    for (r in 0 until rows) {
+        val y = r * h / rows; val b = (y / band).toInt()
+        val edge = if (p <= 0f) -1f else p * (w + h * slope + 0.54f * w) - 0.18f * w * b - y * slope
+        edges[r] = edge
+        val left = if (edge < 0f) 0f else edge
+        if (left < w) cover.addRect(androidx.compose.ui.geometry.Rect(left, y, w, y + h / rows + 1f))
+    }
+    clipPath(cover) { drawBackdrop(scale, drift) }
+    if (p <= 0f) return
+    for (r in 0 until rows) {
+        val y = r * h / rows; val edge = edges[r]
+        if (edge > -8f && edge < w) {
+            drawRect(Color(0xFFF2A33A).copy(alpha = 0.22f * (1 - p)), Offset(edge - 5f, y), Size(14f, h / rows + 1f))
+            drawRect(Color(0xFFFFE7A8).copy(alpha = 1 - p * 0.6f), Offset(edge, y), Size(3f, h / rows + 1f))
+        }
+    }
+}
