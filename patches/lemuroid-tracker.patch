+                options = listOf(Smz3Box.Option("Leave") { onLeave() }, Smz3Box.Option("Keep waiting") { stay() })
+                backLabel = "Keep waiting"
+            } else {
+                title = "Leave the race?"
+                options = listOf(Smz3Box.Option("Leave the race") { onLeave() }, Smz3Box.Option("Stay") { stay() })
+                backLabel = "Stay"
+            }
+            back = stay
+        }.show()
+    }
