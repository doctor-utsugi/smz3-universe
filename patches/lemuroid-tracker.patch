+            }
+            if (info.diff.size > lines.size && room > 0) text(canvas, "+ ${info.diff.size - lines.size} more", x + 5f, y, 6f, DIM)
+            paint.color = BORDER
+            canvas.drawRect((l + 6f) * u, (t + h - 17f) * u, (l + w - 6f) * u, (t + h - 17f) * u + 1f, paint)
+            text(canvas, fit(info.logic, w / 2f - 12f, 6f), x, t + h - 7f, 6f, TEXT)
+            text(canvas, fit("♪ " + info.music, w / 2f - 6f, 6f), l + w - 9f, t + h - 7f, 6f, DIM, Paint.Align.RIGHT)
+        }
+
+        private fun clock(ms: Long): String {
+            val m = ms / 60000
+            return "%d:%02d:%02d".format(m / 60, m % 60, ms / 1000 % 60)
+        }
+
+        private fun bar(canvas: Canvas, label: String, v: Pair<Int, Int>, x: Float, y: Float, w: Float, color: Int) {
+            text(canvas, label, x, y, 5.5f, DIM)
