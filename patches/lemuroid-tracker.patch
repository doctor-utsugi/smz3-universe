+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/** A player-placed marker: an item icon at a half-size map position, with an optional note. */
+class UserMark(val id: Long, val x: Float, val y: Float, val game: Int, val name: String, val icon: String, val note: String)
+
+/** The markers of one run, kept in a JSON file next to the run. */
+object Smz3Marks {
+    fun load(file: File): List<UserMark> = runCatching {
+        val a = JSONArray(file.readText())
+        List(a.length()) { i ->
+            a.getJSONObject(i).let {
+                UserMark(it.getLong("id"), it.getDouble("x").toFloat(), it.getDouble("y").toFloat(), it.getInt("game"), it.getString("name"), it.getString("icon"), it.optString("note"))
+            }
+        }
+    }.getOrDefault(emptyList())
+
+    fun save(file: File, marks: List<UserMark>) {
+        val a = JSONArray()
+        for (m in marks) a.put(JSONObject().put("id", m.id).put("x", m.x.toDouble()).put("y", m.y.toDouble()).put("game", m.game).put("name", m.name).put("icon", m.icon).put("note", m.note))
+        file.writeText(a.toString())
+    }
+}
