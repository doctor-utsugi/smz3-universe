--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Shortcuts.kt
@@ -0,0 +1,148 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.view.InputDevice
+import android.view.KeyEvent
+import com.swordfish.lemuroid.app.shared.input.InputKey
+import com.swordfish.lemuroid.app.shared.input.RetroKey
+import com.swordfish.lemuroid.app.shared.settings.GameShortcut
+import java.util.concurrent.ConcurrentLinkedQueue
+
+/**
+ * Item shortcuts: five ALttP slots that equip an item on Y, the Super Metroid beams and its HUD weapons, from the tracker's RUN tab or from
+ * a pad button bound to one. The ids and the memory writes come from the core (smz3_shortcuts.c); the tracker loop makes
+ * the writes, only in normal play.
+ */
+object Smz3Shortcuts {
+    const val SLOTS = 5
+    private const val FILE = "smz3_shortcuts"
+
+    class Item(val id: Int, val name: String, val icon: String, val zelda: Boolean, val weapon: Boolean)
+
+    val items: List<Item> by lazy {
+        Smz3Native.shortcutList().mapIndexed { id, s ->
+            val (name, icon) = s.split("|", limit = 2)
+            Item(id, name, icon, name !in BEAMS && name !in WEAPONS, name in WEAPONS)
+        }
+    }
+    private val BEAMS = setOf("Wave", "Ice", "Spazer", "Plasma")
+    private val WEAPONS = setOf("Missiles", "Super Missiles", "Power Bombs")
+
+    /** The pad mapping and Lemuroid's own shortcuts, kept current by the game's input, to tell a free button. */
+    @Volatile var padBindings: ((InputDevice?) -> Map<InputKey, RetroKey>)? = null
+    @Volatile var padShortcuts: Map<InputDevice, List<GameShortcut>> = emptyMap()
+
+    /** Set while the bind panel waits for a button: the next press goes here instead of the game. */
+    @Volatile var capture: ((KeyEvent) -> Unit)? = null
+
+    /** From the last read of the game: in normal play, the ids owned and the ids on (one bit per id). */
+    @Volatile var ready = false
+    @Volatile var owned = 0L
+    @Volatile var active = 0L
+
+    private val queue = ConcurrentLinkedQueue<Int>()
+    private val consumed = HashSet<Int>()
+
+    private fun prefs(context: Context) = context.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+
+    fun slot(context: Context, i: Int): Int = prefs(context).getInt("slot$i", -1).takeIf { it in items.indices } ?: -1
+
+    fun setSlot(context: Context, i: Int, id: Int) = prefs(context).edit().putInt("slot$i", id).apply()
+
+    /** Puts [id] in slot [i] (-1 empties it). The button of the item it held moves to [id], or goes away when the slot is
+     * emptied or [id] has its own, unless another slot still holds that item. */
+    fun assignSlot(context: Context, i: Int, id: Int) {
+        val old = slot(context, i)
+        setSlot(context, i, id)
+        if (old == -1 || old == id || (0 until SLOTS).any { slot(context, it) == old }) return
+        val code = key(context, old) ?: return
+        val edit = prefs(context).edit().remove("key$code")
+        if (id != -1 && key(context, id) == null) edit.putInt("key$code", id)
+        edit.apply()
+    }
+
+    fun rowShown(context: Context): Boolean = prefs(context).getBoolean("row", true)
+
+    fun setRowShown(context: Context, on: Boolean) = prefs(context).edit().putBoolean("row", on).apply()
+
+    /** The second Super Metroid row, under the beams: missiles, super missiles and power bombs. */
+    fun weaponRowShown(context: Context): Boolean = prefs(context).getBoolean("weapons", true)
+
+    fun setWeaponRowShown(context: Context, on: Boolean) = prefs(context).edit().putBoolean("weapons", on).apply()
+
+    /** The button bound to [id], or null. */
+    fun key(context: Context, id: Int): Int? = prefs(context).all.entries
+        .firstOrNull { it.key.startsWith("key") && it.value == id }?.key?.removePrefix("key")?.toIntOrNull()
+
+    private fun boundTo(context: Context, keyCode: Int): Int? = prefs(context).getInt("key$keyCode", -1).takeIf { it in items.indices }
+
+    fun unbind(context: Context, id: Int) {
+        key(context, id)?.let { prefs(context).edit().remove("key$it").apply() }
+    }
+
+    fun keyName(keyCode: Int): String = InputKey(keyCode).displayName()
+
+    /** Binds [event]'s button to [id], or returns what already uses it. */
+    fun bind(context: Context, id: Int, event: KeyEvent): String? {
+        val code = event.keyCode
+        usedBy(context, id, event)?.let { return "${keyName(code)} is used by $it" }
+        unbind(context, id)
+        prefs(context).edit().putInt("key$code", id).apply()
+        return null
+    }
+
+    private val SNES_KEYS = mapOf(
+        KeyEvent.KEYCODE_BUTTON_A to "A", KeyEvent.KEYCODE_BUTTON_B to "B", KeyEvent.KEYCODE_BUTTON_X to "X",
+        KeyEvent.KEYCODE_BUTTON_Y to "Y", KeyEvent.KEYCODE_BUTTON_L1 to "L", KeyEvent.KEYCODE_BUTTON_R1 to "R",
+        KeyEvent.KEYCODE_BUTTON_START to "Start", KeyEvent.KEYCODE_BUTTON_SELECT to "Select",
+        KeyEvent.KEYCODE_DPAD_UP to "Up", KeyEvent.KEYCODE_DPAD_DOWN to "Down", KeyEvent.KEYCODE_DPAD_LEFT to "Left",
+        KeyEvent.KEYCODE_DPAD_RIGHT to "Right",
+    )
+
+    private fun usedBy(context: Context, id: Int, event: KeyEvent): String? {
+        val code = event.keyCode
+        when (code) {
+            KeyEvent.KEYCODE_BACK, KeyEvent.KEYCODE_HOME, KeyEvent.KEYCODE_VOLUME_UP, KeyEvent.KEYCODE_VOLUME_DOWN,
+            KeyEvent.KEYCODE_POWER, KeyEvent.KEYCODE_APP_SWITCH -> return "Android"
+            KeyEvent.KEYCODE_BUTTON_MODE -> return "the emulator's menu"
+            KeyEvent.KEYCODE_BUTTON_THUMBR -> if (Smz3ScreenMode.singleActive) return "the tracker"
+        }
+        val mapped = padBindings?.invoke(event.device)?.get(InputKey(code))?.keyCode ?: code
+        SNES_KEYS[mapped]?.let { return "the SNES $it button" }
+        Smz3HotkeyAction.entries.firstOrNull { it != Smz3HotkeyAction.FOCUS_GAME && code in Smz3Hotkeys.keys(context, it) }?.let { action ->
+            return "the ${action.title} hotkey (" + Smz3Hotkeys.keys(context, action).joinToString(" + ") { Smz3Hotkeys.name(it) } + ")"
+        }
+        padShortcuts.values.flatten().firstOrNull { code in it.keys }?.let { return "the emulator's ${it.type.displayName()} shortcut (${it.name})" }
+        boundTo(context, code)?.takeIf { it != id }?.let { return "the ${items[it].name} shortcut" }
+        return null
+    }
+
+    /** A tap on the row or a bound button: the tracker loop makes the writes at its next read. */
+    fun request(id: Int) {
+        if (id in items.indices) queue.add(id)
+    }
+
+    fun poll(): Int? = queue.poll()
+
+    fun pending(): Boolean = queue.isNotEmpty()
+
+    fun isOwned(id: Int) = owned and (1L shl id) != 0L
+
+    fun isActive(id: Int) = active and (1L shl id) != 0L
+
+    /** Returns true when the key was taken by the bind panel or a bound shortcut and must not reach the game. */
+    fun onKey(context: Context, event: KeyEvent): Boolean {
+        val code = event.keyCode
+        if (event.action == KeyEvent.ACTION_UP) return consumed.remove(code)
+        if (event.action != KeyEvent.ACTION_DOWN) return code in consumed
+        capture?.let { take ->
+            consumed.add(code)
+            if (event.repeatCount == 0) { capture = null; take(event) }
+            return true
+        }
+        val id = boundTo(context, code) ?: return false
+        consumed.add(code)
+        if (event.repeatCount == 0) request(id)
+        return true
+    }
+}
