@@ -0,0 +1,72 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.animation.ValueAnimator
+import android.content.Context
+import android.graphics.BlurMaskFilter
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.view.View
+import android.view.animation.AccelerateInterpolator
+import kotlin.math.hypot
+
+/**
+ * A portal between the games: the old game's colour covers the tracker, a violet ring opens in the middle and spins as it
+ * grows, and the new game's tracker shows through the hole while it fades in.
+ */
+internal class Smz3PortalView(context: Context) : View(context) {
+    private val density = context.resources.displayMetrics.density
+    private val cover = Paint()
+    private val ring = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.parseColor("#B48CF0") }
+    private val glow = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.parseColor("#B48CF0") }
+    private val hole = Path()
+    private var t = 1f
+    private var anim: ValueAnimator? = null
+
+    init { visibility = GONE; setLayerType(LAYER_TYPE_SOFTWARE, null) }   // the glow's blur needs software drawing
+
+    /** Plays the portal over [under], which is faded in as the hole opens; [from] is the colour of the game being left. */
+    fun play(from: Int, under: View) {
+        anim?.cancel()
+        cover.color = from
+        visibility = VISIBLE
+        under.alpha = 0f
+        anim = ValueAnimator.ofFloat(0f, 1f).apply {
+            duration = 1000
+            interpolator = AccelerateInterpolator(1.4f)
+            addUpdateListener { t = it.animatedValue as Float; under.alpha = t; invalidate() }
+            addListener(object : android.animation.AnimatorListenerAdapter() {
+                override fun onAnimationEnd(a: android.animation.Animator) { visibility = GONE; under.alpha = 1f }
+                override fun onAnimationCancel(a: android.animation.Animator) { visibility = GONE; under.alpha = 1f }
+            })
+            start()
+        }
+    }
+
+    override fun onDraw(c: Canvas) {
+        val cx = width / 2f
+        val cy = height / 2f
+        val r = hypot(cx, cy) * 1.05f * t
+        hole.reset()
+        hole.fillType = Path.FillType.INVERSE_WINDING
+        hole.addCircle(cx, cy, r, Path.Direction.CW)
+        cover.alpha = (255 * (1f - t * 0.35f)).toInt()
+        c.drawPath(hole, cover)
+        // the ring: a thick spinning arc set on a soft glow, thinning and fading as it reaches the edges
+        val fade = (255 * (1f - t)).toInt().coerceIn(0, 255)
+        val w = density * (5f - 3f * t)
+        glow.strokeWidth = w * 3f
+        glow.alpha = fade / 3
+        glow.maskFilter = BlurMaskFilter(density * 8f, BlurMaskFilter.Blur.NORMAL)
+        c.drawCircle(cx, cy, r, glow)
+        ring.strokeWidth = w
+        ring.alpha = fade
+        c.save()
+        c.rotate(360f * t, cx, cy)
+        c.drawArc(cx - r, cy - r, cx + r, cy + r, 0f, 250f, false, ring)
+        ring.alpha = fade / 2
+        c.drawArc(cx - r, cy - r, cx + r, cy + r, 270f, 60f, false, ring)
+        c.restore()
+    }
+}
