+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.animation.ValueAnimator
+import android.media.MediaPlayer
+
+/** The launcher's music (assets/smz3/smz3_intro.mp3): loops at half volume while the menu is up and the option is on. */
+object Smz3MenuMusic {
+    private const val FILE = "smz3_menu_music"
+    private const val VOLUME = 0.5f
+    private var player: MediaPlayer? = null
+    private var fade: ValueAnimator? = null
+
+    private fun prefs(context: Context) = context.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+
+    fun enabled(context: Context): Boolean = prefs(context).getBoolean("on", true)
+
+    fun setEnabled(context: Context, on: Boolean) {
+        prefs(context).edit().putBoolean("on", on).apply()
+        if (on) play(context) else pause()
+    }
+
+    /** Plays from the start, when the option is on. */
+    fun play(context: Context) {
+        if (!enabled(context)) return
+        val p = player ?: runCatching {
+            context.applicationContext.assets.openFd("smz3/smz3_intro.mp3").use { fd ->
+                MediaPlayer().apply {
+                    setDataSource(fd.fileDescriptor, fd.startOffset, fd.length)
+                    isLooping = true
+                    setVolume(VOLUME, VOLUME)
+                    prepare()
+                }
+            }
+        }.getOrNull()?.also { player = it } ?: return
+        fade?.cancel()
+        fade = null
+        if (p.isPlaying) return
+        p.setVolume(VOLUME, VOLUME)
+        p.seekTo(0)
+        p.start()
+    }
+
+    /** Fades out over half a second, then pauses; a pause while fading lets the fade finish. Main thread. */
+    fun pause() {
+        val p = player?.takeIf { it.isPlaying } ?: return
+        if (fade != null) return
+        fade = ValueAnimator.ofFloat(VOLUME, 0f).setDuration(500).apply {
+            addUpdateListener { (it.animatedValue as Float).let { v -> runCatching { p.setVolume(v, v) } } }
+            addListener(object : android.animation.AnimatorListenerAdapter() {
+                override fun onAnimationEnd(a: android.animation.Animator) {
+                    if (fade === a) { fade = null; runCatching { if (p.isPlaying) p.pause() } }
+                }
+            })
+            start()
+        }
+    }
+
+    fun release() { fade?.cancel(); fade = null; player?.release(); player = null }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/CloudSync.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/CloudSync.kt
