+        RaceClient.resume(activity)
+        if (!RaceClient.joined()) return
+        on = true
+        Smz3RaceState.on = true
+        Smz3RaceState.daily = false
+        Smz3RaceState.lines.clear()
+        RaceClient.slow = true
+        val paused = RaceClient.paused(activity)
+        kept = keptHere && paused != null
+        back = paused != null && !kept
+        if (kept) { resumeAt = paused!!.resumeAt; main.post { showPausedCard() } }
+        RunStore.load(activity, RaceClient.SLOT)?.settings?.let { s ->
+            val j = runCatching { JSONObject(s) }.getOrDefault(JSONObject())
+            val z3 = j.optJSONObject("z3")
+            need = when {   // what the progress counts: crystals and Metroid bosses, a single game's own
+                z3 != null -> maxOf(z3.optString("ganon_open").toIntOrNull() ?: 7, z3.optString("tower_open").toIntOrNull() ?: 7) + 3
+                j.optString("game") == "sm" -> j.optInt("tourianBosses", 4)
+                else -> maxOf(j.optInt("ganonCrystals", 7), j.optInt("ganonsTowerCrystals", 7)) + j.optInt("tourianBosses", 4)
+            }
+            goal = Smz3Native.raceGoalText(s)
+        }
+        val pad = (8 * activity.resources.displayMetrics.density).toInt()
+        val face = Smz3Box.face(activity)
+        fun label(gravity: Int, color: Int, bottom: Int) = TextView(activity).apply {
+            setTextColor(color); textSize = 14f; typeface = face; setPadding(pad * 2, pad, pad * 2, pad); visibility = View.GONE
+            setBackgroundColor(Color.argb(215, 8, 11, 17))
