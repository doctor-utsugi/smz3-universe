+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3DailyBlock.kt
@@ -0,0 +1,135 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.view.View
+
+/**
+ * The daily challenge on the RUN tab: the goal in its box (a boss's with its icon, and where it waits under it) with a thin
+ * bar of who is on it (green playing now, gold finished, out of everyone who started), the three counts with their pixel
+ * icons and the next hint, then the window left.
+ */
+internal class Smz3DailyBlock(context: Context) : View(context) {
+    private val density = context.resources.displayMetrics.density
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val text = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val r = RectF()
+    private var goal = ""
+    private var bossIcon: android.graphics.Bitmap? = null
+    private var place = ""
+    private var done = false
+    private var playing = -1
+    private var started = 0
+    private var finished = 0
+    private var hint = ""
+    private var window = ""
+    private var windowWarn = false
+    private var face: Typeface? = null
+    private var textColor = Color.WHITE
+    private var dimColor = Color.GRAY
+    private var accentColor = Color.YELLOW
+    private val green = Color.parseColor("#4CC38A")
+    private val gold = Color.parseColor("#E9A23B")
+    private val track = Color.parseColor("#25324A")
+    private val box = Color.parseColor("#141B27")
+
+    fun setTheme(theme: Smz3Theme) {
+        textColor = theme.text; dimColor = theme.dim; accentColor = theme.accent; face = theme.typeface
+        invalidate()
+    }
+
+    /** [players]: now, started, finished; null while the server has not said. */
+    fun set(goal: String, done: Boolean, players: IntArray?, hint: String, window: String, windowWarn: Boolean) {
+        if (goal != this.goal) {
+            val b = Smz3GoalIcon.boss(goal)
+            bossIcon = b?.let { Smz3GoalIcon.icon(context, it.sprite) }
+            val was = place
+            place = b?.let { "in ${it.place}" } ?: ""
+            if (place.isEmpty() != was.isEmpty()) requestLayout()
+        }
+        this.goal = goal; this.done = done; this.hint = hint; this.window = window; this.windowWarn = windowWarn
+        playing = players?.getOrNull(0) ?: -1; started = players?.getOrNull(1) ?: 0; finished = players?.getOrNull(2) ?: 0
+        invalidate()
+    }
+
+    private fun dp(v: Float) = v * density
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        setMeasuredDimension(MeasureSpec.getSize(widthMeasureSpec), dp(if (place.isEmpty()) 76f else 92f).toInt())
+    }
+
+    private fun write(c: Canvas, s: String, x: Float, y: Float, size: Float, color: Int, align: Paint.Align = Paint.Align.LEFT): Float {
+        text.typeface = face; text.textSize = dp(size); text.color = color; text.textAlign = align
+        c.drawText(s, x, y, text)
+        return text.measureText(s)
+    }
+
+    // pixel icons on a grid of u px: a dot (playing), a chequered flag (finished), a plain flag (started)
+    private fun dot(c: Canvas, x: Float, y: Float, u: Float) {
+        paint.color = green; c.drawRect(x + u, y + u, x + 7 * u, y + 7 * u, paint)
+        paint.color = Color.parseColor("#BFF0D6"); c.drawRect(x + 2 * u, y + 2 * u, x + 4 * u, y + 3 * u, paint)
+    }
+
+    private fun flag(c: Canvas, x: Float, y: Float, u: Float, chequered: Boolean) {
+        paint.color = dimColor; c.drawRect(x + u, y, x + 2 * u, y + 10 * u, paint)
+        if (!chequered) { c.drawRect(x + 2 * u, y, x + 8 * u, y + 4 * u, paint); return }
+        paint.color = box; c.drawRect(x + 2 * u, y, x + 8 * u, y + 4 * u, paint)
+        paint.color = gold
+        c.drawRect(x + 2 * u, y, x + 4 * u, y + 2 * u, paint)
+        c.drawRect(x + 6 * u, y, x + 8 * u, y + 2 * u, paint)
+        c.drawRect(x + 4 * u, y + 2 * u, x + 6 * u, y + 4 * u, paint)
+    }
+
+    override fun onDraw(c: Canvas) {
+        val w = width.toFloat()
+        paint.style = Paint.Style.FILL
+
+        // the goal's box: accent edge, checkbox, text, and the players bar along its bottom
+        r.set(0f, 0f, w, dp(34f))
+        paint.color = box; c.drawRect(r, paint)
+        paint.color = accentColor; c.drawRect(0f, 0f, dp(3f), dp(34f), paint)
+        val s = dp(10f)
+        r.set(dp(10f), dp(9f), dp(10f) + s, dp(9f) + s)
+        if (done) { paint.color = green; c.drawRect(r, paint) }
+        else { paint.style = Paint.Style.STROKE; paint.strokeWidth = dp(1.2f); paint.color = dimColor; c.drawRect(r, paint); paint.style = Paint.Style.FILL }
+        val gw = write(c, goal, dp(26f), dp(18f), 13f, textColor)
+        bossIcon?.let { b ->   // the boss itself after its name, pixel sharp, as tall as the box allows
+            val ih = dp(16f); val iw = ih * b.width / b.height; val ix = dp(26f) + gw + dp(6f)
+            r.set(ix, dp(18f) - dp(13f), ix + iw, dp(18f) - dp(13f) + ih)
+            paint.isFilterBitmap = false; c.drawBitmap(b, null, r, paint)
+        }
+        val bx = dp(10f); val bw = w - dp(20f); val by = dp(27f)
+        paint.color = track; c.drawRect(bx, by, bx + bw, by + dp(3f), paint)
+        if (started > 0 && playing >= 0) {
+            val gw = bw * minOf(playing, started) / started
+            val fw = bw * minOf(finished, started - minOf(playing, started)) / started
+            paint.color = green; c.drawRect(bx, by, bx + gw, by + dp(3f), paint)
+            paint.color = gold; c.drawRect(bx + gw, by, bx + gw + fw, by + dp(3f), paint)
+        }
+
+        // where the boss waits, under its box
+        val dy = if (place.isEmpty()) 0f else dp(16f)
+        if (place.isNotEmpty()) write(c, place, dp(10f), dp(48f), 11f, dimColor)
+
+        // counts with their icons, the next hint on the right
+        val u = dp(1.4f)
+        val base = dp(54f) + dy
+        var x = 0f
+        if (playing >= 0) {
+            dot(c, x, base - 9 * u, u); x += 10 * u
+            x += write(c, "$playing now", x, base, 12f, green) + dp(12f)
+            flag(c, x, base - 10 * u, u, true); x += 11 * u
+            x += write(c, "$finished", x, base, 12f, gold) + dp(12f)
+            flag(c, x, base - 10 * u, u, false); x += 11 * u
+            write(c, "$started", x, base, 12f, dimColor)
+        }
+        if (hint.isNotEmpty()) write(c, hint, w, base, 12f, dimColor, Paint.Align.RIGHT)
+
+        write(c, "Window", 0f, dp(72f) + dy, 12f, dimColor)
+        write(c, window, w, dp(72f) + dy, 12f, if (windowWarn) Color.parseColor("#E05A4F") else textColor, Paint.Align.RIGHT)
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3DailyOverlay.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3DailyOverlay.kt
new file mode 100644
index 0000000..fa5752f
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3DailyOverlay.kt
@@ -0,0 +1,235 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.app.Activity
+import android.graphics.Color
+import android.os.Handler
+import android.os.Looper
+import android.view.Gravity
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.TextView
+import com.swordfish.lemuroid.app.mobile.feature.runs.DailyAttempt
+import com.swordfish.lemuroid.app.mobile.feature.runs.DailyChallenge
+import com.swordfish.lemuroid.app.mobile.feature.runs.OnlineLadder
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunStore
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * The daily challenge while playing: the window clock (red in its last 15 minutes), the own time from Start, the goal and
+ * the time to the next hint, each one hideable in the tracker's CONFIG tab, and a new hint for 15 seconds. With a second
+ * screen they go to its strip ([latestNote]); only a phone without one gets the box in the game's top-right corner. The
+ * TIME IS UP card comes once when the window closes before the goal. While the window is open its chat is read every 5
+ * seconds into the tracker's CHAT tab ([Smz3RaceState], as a race's): the others' lines show bottom right for two seconds
+ * (a phone without a second screen), and someone's finish top left for four, with the rival's chime.
+ */
+class Smz3DailyOverlay(private val activity: Activity, private val onLeave: () -> Unit) {
+    companion object {
+        /** The newest hint and until when it stays highlighted, for the second screen's strip. */
+        @Volatile var latestNote: Pair<String, Long>? = null
+        /** "N players on this daily right now", shown for a few seconds every 10 minutes, and until when. */
+        @Volatile var playersNote: Pair<String, Long>? = null
+        private const val BEAT_MS = 60_000L
+        private const val PLAYERS_EVERY_MS = 10 * 60_000L
+        private const val PLAYERS_FOR_MS = 8_000L
+        private const val CHAT_EVERY_MS = 5_000L
+        /** The chat read so far, kept while the activity is made again (a turn of the screen): its window and newest line. */
+        private var chatWindow = ""
+        private var chatSince = 0L
+        private var chatPrimed = false   // the first answer only sets where the chat stands: older lines are not news
+    }
+    private var news: TextView? = null
+    private var say: TextView? = null
+    private var newsUntil = 0L
+    private var nextChat = 0L
+    private var polling = false
+    private var myName = ""
+    private val sent = ArrayList<String>()   // own lines on their way: the first one back tells this player's pid
+    private var nextBeat = 0L
+    private var nextPlayers = 0L
+    private val main = Handler(Looper.getMainLooper())
+    private var box: TextView? = null
+    private var note: TextView? = null
+    private var attempt: DailyAttempt? = null
+    private var asking = false
+    private var nextAsk = 0L
+    private var timeUpShown = false
+    private var noteUntil = 0L
+    private val tick = object : Runnable {
+        override fun run() { update(); main.postDelayed(this, 1000) }
+    }
+
+    fun start() {
+        if (RunStore.activeSlot(activity) != DailyChallenge.SLOT) return
+        attempt = DailyChallenge.attempt(activity) ?: return
+        timeUpShown = RunStore.load(activity, DailyChallenge.SLOT)?.completedAt?.let { it != 0L } ?: false
+        val pad = (8 * activity.resources.displayMetrics.density).toInt()
+        box = TextView(activity).apply {
+            typeface = Smz3Box.face(activity); setTextColor(Color.WHITE); textSize = 13f; setPadding(pad, pad / 2, pad, pad / 2)
+            setBackgroundColor(Color.argb(190, 8, 11, 17))
+            activity.addContentView(this, FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP or Gravity.END).apply { setMargins(pad, pad, pad, pad) })
+        }
+        note = TextView(activity).apply {
+            typeface = Smz3Box.face(activity); setTextColor(Color.rgb(0xF2, 0xA3, 0x3A)); textSize = 15f; setPadding(pad * 2, pad, pad * 2, pad); visibility = android.view.View.GONE
+            setBackgroundColor(Color.argb(215, 8, 11, 17))
+            activity.addContentView(this, FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL).apply { setMargins(pad, pad, pad, pad * 3) })
+        }
+        fun label(gravity: Int, bottom: Int) = TextView(activity).apply {
+            typeface = Smz3Box.face(activity); setTextColor(Color.rgb(0xE8, 0xEC, 0xF2)); textSize = 14f; setPadding(pad * 2, pad, pad * 2, pad); visibility = android.view.View.GONE
+            setBackgroundColor(Color.argb(215, 8, 11, 17))
+            activity.addContentView(this, FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, gravity).apply { setMargins(pad, pad, pad, bottom) })
+        }
+        news = label(Gravity.TOP or Gravity.START, pad)
+        say = label(Gravity.BOTTOM or Gravity.END, pad * 12)
+        myName = OnlineLadder.profileFor(activity).first
+        val race = Smz3RaceState
+        if (chatWindow != attempt!!.window || !race.daily) { chatWindow = attempt!!.window; chatSince = 0; chatPrimed = false; race.lines.clear(); race.you = "" }
+        race.on = true; race.daily = true; race.players = JSONArray(); race.version++
+        race.dailySay = ::sendChat
+        main.post(tick)
+    }
+
+    fun stop() {
+        main.removeCallbacks(tick)
+        if (attempt == null) return
+        Smz3RaceState.on = false; Smz3RaceState.dailySay = null; Smz3RaceState.version++
+    }
+
+    private fun showNews(text: String, chime: Boolean = true) {
+        news?.text = text; news?.visibility = android.view.View.VISIBLE
+        newsUntil = System.currentTimeMillis() + 4000
+        if (chime) Smz3Finish.cue(4)
+    }
+
+    /** Someone's chat line over the game: two seconds, then it fades. */
+    private fun showSay(text: String) {
+        val v = say ?: return
+        v.animate().cancel()
+        v.text = text; v.alpha = 1f; v.visibility = android.view.View.VISIBLE
+        v.animate().alpha(0f).setStartDelay(2000).setDuration(500).withEndAction { v.visibility = android.view.View.GONE }.start()
+    }
+
+    /** Sends a line of the CHAT tab; the next poll comes at once, so it shows there. */
+    private fun sendChat(text: String) {
+        val a = attempt ?: return
+        sent += text
+        if (sent.size > 8) sent.removeAt(0)
+        Thread {
+            val code = DailyChallenge.say(activity, a, text)
+            main.post {
+                nextChat = 0L
+                when (code) {
+                    200 -> {}
+                    409 -> showNews("The window has closed: the chat is over", false)
+                    429 -> showNews("Too fast: wait a moment", false)
+                    -1 -> showNews("No connection: not sent", false)
+                    else -> showNews("Not sent", false)
+                }
+            }
+        }.start()
+    }
+
+    private fun readChat(j: JSONObject) {
+        val race = Smz3RaceState
+        val log = j.optJSONArray("log") ?: return
+        for (i in 0 until log.length()) {
+            val l = log.getJSONObject(i)
+            val seq = l.optLong("seq")
+            if (seq <= chatSince) continue
+            chatSince = seq
+            val line = Smz3RaceState.Line(seq, l.optString("kind"), l.optString("pid"), l.optString("name"), l.optString("text"))
+            if (line.kind == "chat" && race.you.isEmpty() && line.name == myName && sent.remove(line.text)) race.you = line.pid
+            race.lines += line
+            if (race.lines.size > 40) race.lines.removeAt(0)
+            if (!chatPrimed) continue
+            val mine = race.you.isNotEmpty() && line.pid == race.you
+            when (line.kind) {
+                "chat" -> if (!mine && race.shown(line) && !Smz3Tracker.onSecondScreen) showSay("${line.name}: ${line.text}")   // two screens: the CHAT tab has it
+                "finish" -> if (!mine && !(line.name == myName && Smz3Tracker.currentGame == 3)) showNews("${line.name} ${line.text}")
+            }
+        }
+        chatPrimed = true
+        race.version++
+    }
+
+    private fun update() {
+        val a = DailyChallenge.attempt(activity)?.also { attempt = it } ?: attempt ?: return   // the tracker sets the game's start in the file
+        val now = System.currentTimeMillis()
+        val finished = Smz3Tracker.currentGame == 3
+        val left = a.closesAt - now
+        val lines = ArrayList<Pair<CharSequence, Int>>()
+        if (DailyChallenge.shown(activity, 0)) lines += (if (left > 0) "Window  ${DailyChallenge.span(left)}" else "Window closed") to (if (left < 15 * 60_000) Color.rgb(0xE0, 0x5A, 0x4F) else Color.WHITE)
+        if (DailyChallenge.shown(activity, 1) && !finished) lines += "Time  ${DailyChallenge.clock(now - a.clockFrom)}" to Color.WHITE
+        if (DailyChallenge.shown(activity, 2)) lines += Smz3GoalIcon.withIcon(activity, a.goal, ((box?.textSize ?: 30f) * 1.2f).toInt()) to Color.rgb(0xF2, 0xA3, 0x3A)
+        if (DailyChallenge.shown(activity, 3) && a.nextHintAt > 0 && !finished) lines += "Next hint in ${DailyChallenge.span(a.nextHintAt - now)}" to Color.rgb(0x87, 0x93, 0xA6)
+        val below = Smz3Tracker.onSecondScreen
+        box?.let { b ->
+            b.visibility = if (lines.isEmpty() || below || Smz3RaceState.dailyInPanel) android.view.View.GONE else android.view.View.VISIBLE
+            val text = android.text.SpannableStringBuilder()
+            lines.forEachIndexed { i, (t, c) ->
+                if (i > 0) text.append('\n')
+                val from = text.length
+                text.append(t)
+                text.setSpan(android.text.style.ForegroundColorSpan(c), from, text.length, 0)
+            }
+            b.text = text
+            Smz3RaceState.dailyText = text
+        }
+        if (now >= noteUntil || below) note?.visibility = android.view.View.GONE
+        if (now >= newsUntil) news?.visibility = android.view.View.GONE
+        // the window's chat, which also counts this device as playing and keeps the RUN tab's player counts fresh
+        if (!polling && left > 0 && now >= nextChat) {
+            polling = true
+            nextChat = now + CHAT_EVERY_MS
+            val since = chatSince
+            Thread {
+                val j = DailyChallenge.chat(a, since)
+                main.post { polling = false; if (j != null) readChat(j) }
+            }.start()
+        }
+        // every 10 minutes, for a few seconds: how many are on this window now (only when there is someone else)
+        val p = DailyChallenge.players
+        if (p != null && p[0] >= 2 && left > 0 && !finished && now >= nextPlayers) {
+            nextPlayers = now + PLAYERS_EVERY_MS
+            val t = "${p[0]} players on this daily right now"
+            playersNote = t to now + PLAYERS_FOR_MS
+            if (!below && now >= noteUntil) {
+                note?.setTextColor(Color.rgb(0x4C, 0xC3, 0x8A)); note?.text = t; noteUntil = now + PLAYERS_FOR_MS
+                note?.visibility = android.view.View.VISIBLE
+            }
+        }
+        // a hint is due: ask for it (again every 15 seconds while the server has not released it); once a minute anyway,
+        // which is how the server knows this device is playing
+        val due = a.nextHintAt > 0 && now >= a.nextHintAt && now >= nextAsk
+        if (!asking && (due || (now >= nextBeat && left > 0)) && !finished) {
+            asking = true
+            nextAsk = now + 15_000
+            nextBeat = now + BEAT_MS
+            Thread {
+                val fresh = DailyChallenge.hints(activity, a)
+                main.post {
+                    asking = false
+                    if (fresh != null) {
+                        if (fresh.hints.size > a.hints.size && DailyChallenge.shown(activity, 2)) {
+                            note?.setTextColor(Color.rgb(0xF2, 0xA3, 0x3A))
+                            note?.text = "Hint: " + fresh.hints.last().second
+                            noteUntil = System.currentTimeMillis() + 15_000
+                            latestNote = fresh.hints.last().second to noteUntil
+                            if (!Smz3Tracker.onSecondScreen) note?.visibility = android.view.View.VISIBLE
+                        }
+                        attempt = fresh
+                    }
+                }
+            }.start()
+        }
+        if (!timeUpShown && left <= 0 && !finished) {
+            timeUpShown = true
+            Smz3Box(activity).apply {
+                title = "TIME IS UP"; accent = Smz3Box.RED
+                message = "The window closed before the goal: this attempt is marked failed.\n\nYou can keep playing it. A finish now goes on the late list, without prize."
+                options = listOf(Smz3Box.Option("Keep playing") { }, Smz3Box.Option("Leave the run") { onLeave() })
+                back = { }; backLabel = "Keep playing"
+            }.show()
+        }
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Discovery.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Discovery.kt
