+/** One box per crystal or boss, four to a row, lit when its bit is set. */
+@Composable
+private fun Marks(labels: List<String>, mask: Int) {
+    BoxWithConstraints(Modifier.fillMaxWidth().padding(top = 3.dp)) {
+        val gap = 3.dp
+        val perRow = 4
+        val side = minOf(18.dp, (maxWidth - gap * (perRow - 1)) / perRow)
+        Column(verticalArrangement = Arrangement.spacedBy(gap)) {
+            labels.withIndex().chunked(perRow).forEach { row ->
+                Row(horizontalArrangement = Arrangement.spacedBy(gap)) {
+                    for ((i, label) in row) {
+                        val on = mask and (1 shl i) != 0
+                        Box(Modifier.size(side).background(if (on) GOLD else Color(0xFF1D2430), RoundedCornerShape(2.dp)), contentAlignment = Alignment.Center) {
+                            Text(label, color = if (on) PANEL else DIM, fontSize = 10.sp)
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
