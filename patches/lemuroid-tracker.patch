+    /** RomM's newer files come down before a run opens, then [then]; when both sides changed the conflict screen asks instead. */
+    fun synced(slot: Int, forcePull: Boolean = false, forcePush: Boolean = false, then: () -> Unit) {
+        if (!CloudSync.signedIn() || slot >= RunStore.SLOTS) { then(); return }
+        val game = RunStore.mode
+        scope.launch {
+            var busy = false
+            val shown = launch { kotlinx.coroutines.delay(400); busy = true; Smz3Native.uiBusy("Syncing with RomM..."); version++ }
+            val r = withContext(Dispatchers.IO) { CloudSync.open(context, game, slot, forcePull, forcePush) }
+            shown.cancel()
+            if (busy) Smz3Native.uiIdle()
+            refreshSlots()
+            val result = r?.get(0)?.toIntOrNull() ?: CloudSync.OK
+            if (result == CloudSync.CONFLICT) {
+                Smz3Native.uiCloudConflict(slot, r!![3], CloudSync.whenText(r[4].toLongOrNull() ?: 0L))
+                version++
+                return@launch
+            }
+            val note = if (result == CloudSync.FAILED) "Sync: ${r!![5]}" else if (result == CloudSync.OK && r?.get(2) == "1") "Synced from outside SMZ3: unranked" else null
+            if (note != null) {
+                Smz3Native.uiBusy(note.take(43))
+                version++
+                kotlinx.coroutines.delay(2500)
+                Smz3Native.uiIdle()
+                version++
+            }
+            if (game == RunStore.mode) then()
+        }
+    }
