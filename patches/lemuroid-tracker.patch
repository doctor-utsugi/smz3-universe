+    /** The message for a single game whose ROM is missing (SMZ3 asks for its two instead). */
+    fun singleRomMissing(): String? = when (RunStore.mode) {
+        "sm" -> RunGenerator.wrongBaseRom ?: "Add the Super Metroid ROM first"
+        "z3" -> RunGenerator.wrongBaseRom ?: "Add the ALttP JP ROM first"
+        else -> null
+    }
