+            return@runCatching context.assets.open("smz3/flags/${key.substringAfter('/')}.png").use { android.graphics.BitmapFactory.decodeStream(it) }.asImageBitmap()
+        }
+        val goal = if (key.startsWith("goal/")) key.substringAfter('/').replace('/', '_') else null
