+        val timeIn = myTime() >= 0   // only watching now: nothing is abandoned
+        val stay = if (timeIn) "Keep watching" else "Keep racing"
+        askBox = Smz3Box(activity).apply {
+            title = if (timeIn) "Leave the race?" else "Abandon the race?"
+            options = listOfNotNull(
+                Smz3Box.Option(if (timeIn) "Back to menu" else "Leave the race") { onLeave() },
