+    private fun me(): JSONObject? = (0 until players.length()).map { players.getJSONObject(it) }.firstOrNull { it.optString("pid") == you }
+    private fun myTime(): Long = me()?.let { if (it.isNull("timeMs")) -1L else it.optLong("timeMs", -1L) } ?: -1L
+    private fun first(): Boolean = me()?.optInt("place") == 1
+    private fun won(): Boolean = first() && myTime() >= 0
+    private fun serverNow() = System.currentTimeMillis() + offset
+    private fun draft() = format == "draft"
+
+    /** The count (or GO) with a Draft's goal under it, the same for everyone. */
+    private fun withGoal(big: String): CharSequence {
+        if (!draft() || goal.isEmpty()) return big
+        return SpannableString("$big\n$goal").apply {
+            setSpan(RelativeSizeSpan(0.25f), big.length, length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            setSpan(ForegroundColorSpan(Color.rgb(0xE8, 0xEC, 0xF2)), big.length, length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        }
+    }
+
+    private fun canPause(): Boolean {
+        if (state != "running" || format != "full" || serverNow() < goAt || voteBy.isNotEmpty()) return false
+        return (0 until players.length()).none { val p = players.getJSONObject(it); p.has("timeMs") && !p.isNull("timeMs") }
+    }
+
+    private fun voted() = (0 until voteYes.length()).any { voteYes.optString(it) == you }
+    private fun voteOpen() = state == "running" && voteBy.isNotEmpty() && voteBy != you && !voted() && voteAt != voteDone
+
+    private fun setHeld(value: Boolean) {
+        if (value == held) return
+        val view = Smz3Rewind.view ?: return
+        held = value
+        view.setHeld(value)
+    }
+
+    private fun showNews(text: String) {
+        news?.text = text; news?.visibility = View.VISIBLE
+        newsUntil = System.currentTimeMillis() + 4000
+        Smz3Finish.cue(4)
+    }
+
+    private fun read(text: String) {
+        val o = runCatching { JSONObject(text) }.getOrNull() ?: return
+        val room = o.optJSONObject("room") ?: return
+        state = room.optString("state"); format = room.optString("format"); Smz3RaceState.draft = format == "draft"; endWhy = room.optString("endWhy"); code = room.optString("code", code)
+        startAt = room.optLong("startAt", 0L)
+        goAt = room.optLong("goAt", startAt); endAt = room.optLong("endAt", 0L)
+        resumeAt = room.optLong("resumeAt", 0L); pauses = room.optInt("pauses")
+        val vote = room.optJSONObject("vote")
+        voteBy = vote?.optString("by") ?: ""; voteAt = vote?.optLong("resumeAt") ?: 0L; voteYes = vote?.optJSONArray("yes") ?: JSONArray()
+        players = room.optJSONArray("players") ?: players
+        // stamped answers: the server read its clock about halfway through the trip, and the quickest trip is the surest,
+        // unless the clock itself jumped
+        if (o.has("now") && o.has("sent") && o.has("got")) {
+            val sent = o.optLong("sent"); val rtt = o.optLong("got") - sent
+            val est = o.optLong("now") - (sent + rtt / 2)
+            if (!synced || rtt <= bestRtt || est > offset + 2000 || est < offset - 2000) { offset = est; bestRtt = rtt }
+            synced = true
+        } else if (o.has("now")) {   // unstamped: each answer comes late by its trip, so the largest estimate is the closest
+            val est = o.optLong("now") - System.currentTimeMillis()
+            if (!synced || est > offset || est < offset - 2000) offset = est
+            synced = true
+        }
+        if (o.has("you")) you = o.optString("you")
+        Smz3RaceState.you = you
+        Smz3RaceState.players = players
+        Smz3RaceState.version++
+        val log = o.optJSONArray("log") ?: return
+        for (i in 0 until log.length()) {
+            val l = log.getJSONObject(i)
+            val seq = l.optLong("seq")
+            if (seq <= since) continue
+            since = seq
+            val line = Smz3RaceState.Line(seq, l.optString("kind"), l.optString("pid"), l.optString("name"), l.optString("text"))
+            Smz3RaceState.lines += line
+            if (Smz3RaceState.lines.size > 40) Smz3RaceState.lines.removeAt(0)
+            if (!primed) continue
+            val mine = you.isNotEmpty() && line.pid == you
+            when (line.kind) {
+                "chat" -> if (!mine && Smz3RaceState.shown(line) && !Smz3Tracker.onSecondScreen) {   // two screens: it goes to the CHAT tab
+                    say?.text = "${line.name}: ${line.text}"; say?.alpha = 1f; say?.visibility = View.VISIBLE; sayAt = System.currentTimeMillis()
+                }
+                "event" -> if (!mine) showNews("${line.name} ${line.text}")
+                else -> if (!mine) showNews(line.text)
+            }
+        }
+    }
