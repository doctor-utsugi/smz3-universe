+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.animation.ValueAnimator
+import android.app.Presentation
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.graphics.Shader
+import android.hardware.display.DisplayManager
+import android.os.Bundle
+import android.view.Display
+import android.view.View
+import android.view.ViewGroup
+import android.view.animation.LinearInterpolator
+import com.swordfish.lemuroid.app.mobile.feature.runs.Leaderboard
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunStore
+import com.swordfish.lemuroid.app.mobile.feature.runs.LeaderboardEntry
+import com.swordfish.lemuroid.app.mobile.feature.runs.OnlineLadder
+import kotlin.math.PI
+import kotlin.math.sin
+import kotlin.random.Random
+
+/** The secondary display while the run menu is in front: the logo, the selected run and the ladders. */
+internal class Smz3IdlePresentation(context: Context, display: Display) : Presentation(context, display) {
+    private var animator: ValueAnimator? = null
+    private var view: IdleView? = null
+
+    fun clearFade() { view?.let { it.dark = 0f; it.invalidate() } }
+
+    /** A game is starting: the screen goes to black, which the game's black stand-in then takes over. */
+    fun fadeOut() {
+        val v = view ?: return
+        ValueAnimator.ofFloat(v.dark, 1f).apply {
+            duration = 350
+            addUpdateListener { v.dark = it.animatedValue as Float; v.invalidate() }
+            start()
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setCancelable(false)   // the second screen's own Back button would close it and leave the system's app drawer
+        window?.setBackgroundDrawable(android.graphics.drawable.ColorDrawable(Color.BLACK))
+        window?.clearFlags(android.view.WindowManager.LayoutParams.FLAG_DIM_BEHIND)
+        val view = IdleView(context).also { this.view = it }
+        setContentView(view, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        animator = ValueAnimator.ofFloat(0f, 1f).apply {
+            duration = 40000
+            repeatCount = ValueAnimator.INFINITE
+            interpolator = LinearInterpolator()
+            addUpdateListener { view.phase = it.animatedValue as Float; view.invalidate() }
+            start()
+        }
+    }
+
+    override fun onStop() {
+        animator?.cancel()
+        super.onStop()
+    }
+
+    /** Drawn on the run menu's 320-wide grid and in its colours, so both screens read as one device. */
+    private class IdleView(context: Context) : View(context) {
+        var phase = 0f
+        var dark = 0f
+        private val rnd = Random(7)
+        private val stars = List(70) { floatArrayOf(rnd.nextFloat(), rnd.nextFloat(), 0.3f + rnd.nextFloat() * 0.7f) }
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val face = runCatching { Typeface.createFromAsset(context.assets, "smz3/menu_font.ttf") }.getOrDefault(Typeface.MONOSPACE)
+        private val logo: Bitmap? = runCatching { context.assets.open("smz3/logo.png").use { BitmapFactory.decodeStream(it) } }.getOrNull()
+        private var online = OnlineLadder.cached(context).isNotEmpty()
+        private var ladders = loadLadders(context)
+        private var ladderGame = RunStore.mode   // the game the tables are of: a game entered from the carousel loads its own
+        private var tab = 0
+        private val tabRects = List(TABS.size) { RectF() }
+        private var u = 1f
+
+        init {
+            Smz3MenuSelection.onChange = { postInvalidate() }
+            fetch(context, true)
+        }
+
+        /** Fetches the shown game's tables; a reply that comes after another game was entered is dropped. */
+        private fun fetch(context: Context, flush: Boolean) {
+            val game = RunStore.mode
+            Thread {
+                if (flush) OnlineLadder.flush(context)
+                if (OnlineLadder.refresh(context) && game == RunStore.mode) {
+                    ladders = loadLadders(context)
+                    online = true
+                    postInvalidate()
+                }
+            }.start()
+        }
+
+        private fun loadLadders(context: Context): List<List<LeaderboardEntry>> = listOf(
+            OnlineLadder.cached(context).ifEmpty { Leaderboard.top(context, true, ROWS) },
+            OnlineLadder.cached(context, 1),
+            OnlineLadder.cached(context, 2),
+            Leaderboard.top(context, false, ROWS),
+        )
+
+        override fun onDetachedFromWindow() {
+            if (Smz3MenuSelection.onChange != null) Smz3MenuSelection.onChange = null
+            super.onDetachedFromWindow()
+        }
+
+        override fun onTouchEvent(event: android.view.MotionEvent): Boolean {
+            if (event.action == android.view.MotionEvent.ACTION_UP) {
+                tabRects.indexOfFirst { it.contains(event.x, event.y) }.takeIf { it >= 0 }?.let { tab = it; invalidate() }
+            }
+            return true
+        }
+
+        private fun text(canvas: Canvas, s: String, x: Float, y: Float, size: Float, color: Int, align: Paint.Align = Paint.Align.LEFT) {
+            paint.style = Paint.Style.FILL
+            paint.typeface = face
+            paint.textSize = size * u
+            paint.textAlign = align
+            paint.color = color
+            canvas.drawText(s, x * u, y * u, paint)
+        }
+
+        /** [s] cut with an ellipsis to fit [width] grid units at [size]. */
+        private fun fit(s: String, width: Float, size: Float): String {
+            paint.typeface = face
+            paint.textSize = size * u
+            if (paint.measureText(s) <= width * u) return s
+            var n = s.length
+            while (n > 1 && paint.measureText(s.take(n) + "…") > width * u) n--
+            return s.take(n) + "…"
+        }
+
+        private fun panel(canvas: Canvas, l: Float, t: Float, w: Float, h: Float) {
+            fun chamfer(l: Float, t: Float, w: Float, h: Float, c: Float) = Path().apply {
+                moveTo((l + c) * u, t * u); lineTo((l + w) * u, t * u); lineTo((l + w) * u, (t + h - c) * u)
+                lineTo((l + w - c) * u, (t + h) * u); lineTo(l * u, (t + h) * u); lineTo(l * u, (t + c) * u); close()
+            }
+            paint.style = Paint.Style.FILL
+            paint.color = BORDER
+            canvas.drawPath(chamfer(l, t, w, h, 6f), paint)
+            paint.color = PANEL
+            canvas.drawPath(chamfer(l + 0.7f, t + 0.7f, w - 1.4f, h - 1.4f, 5.3f), paint)
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            if (ladderGame != RunStore.mode) {
+                ladderGame = RunStore.mode
+                online = OnlineLadder.cached(context).isNotEmpty()
+                ladders = loadLadders(context)
+                fetch(context, false)
+            }
+            val w = width.toFloat()
+            val h = height.toFloat()
+            u = w / 320f
+            val gh = h / u
