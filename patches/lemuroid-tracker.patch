+    /** The CHAT tab and the RUN standings, while an online race (or the daily challenge, chat only) is on; redrawn only when
+     * it changed. */
+    private fun renderRace() {
+        val race = Smz3RaceState
+        if (tabs[CHAT_TAB].visibility != (if (race.on) View.VISIBLE else View.GONE)) {
+            tabs[CHAT_TAB].visibility = if (race.on) View.VISIBLE else View.GONE
+            if (!race.on && selectedTab == CHAT_TAB) select(0)
+        }
+        standings.visibility = if (race.on && !race.daily && Smz3Tracker.onSecondScreen) View.VISIBLE else View.GONE
+        if (Smz3Tracker.onSecondScreen) raceTrack.update() else raceTrack.visibility = View.GONE
+        if (!race.on || race.version == raceVersion) return
+        raceVersion = race.version
+        if (race.phrases != phrasesShown) {
+            phrasesShown = race.phrases
+            phraseBox.removeAllViews()
+            for (row in race.phrases.chunked(4)) {
+                val line = LinearLayout(context).apply { orientation = LinearLayout.HORIZONTAL }
+                for (p in row) line.addView(overlayButton(p) { said(Smz3RaceState.say(p)) }.apply { isAllCaps = false; textSize = 12f }, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+                phraseBox.addView(line)
+            }
+        }
+        if (!race.daily) standings.text = "RACE"
+        val shown = race.lines.filter { race.shown(it) }.takeLast(30)
+        chatLines.text = if (race.chatOff) "Chat is off" else if (shown.isEmpty() && race.daily) "No one has said anything in this window yet" else shown.joinToString("\n") { race.text(it) }
+        chatScroll.post { chatScroll.fullScroll(View.FOCUS_DOWN) }
+        chatToggle.text = if (race.chatOff) "CHAT ON" else "CHAT OFF"
+        val others = race.others()
+        val key = others.joinToString { it.first + it.second } + race.muted.joinToString()
+        if (key == mutePlayers) return
+        mutePlayers = key
+        muteRow.removeAllViews()
+        for ((pid, name) in others) {
+            muteRow.addView(overlayButton((if (pid in race.muted) "UNMUTE " else "MUTE ") + name) { race.toggleMute(pid) }.apply { isAllCaps = false; textSize = 12f })
+        }
+    }
