index 0000000..1a5680e
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Bosses.kt
@@ -0,0 +1,62 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+/** A boss or dungeon reward shown on the map; [icon] is a file in assets/smz3/rewards. */
+class BossMark(val x: Float, val y: Float, val icon: String, val done: Boolean)
+
+/** Which bosses are beaten, read from the game RAM, and where to draw them on the half-size map. */
+object Smz3Bosses {
+    private class Dungeon(val region: String, val room: Int)
+
+    // Boss room of each dungeon; the room's "boss defeated" flag is bit 0x0800 of its word at $7EF000 + 2 * room.
+    private val dungeons = listOf(
+        Dungeon("Eastern Palace", 200), Dungeon("Desert Palace", 51), Dungeon("Tower of Hera", 7),
+        Dungeon("Palace of Darkness", 90), Dungeon("Swamp Palace", 6), Dungeon("Skull Woods", 41),
+        Dungeon("Thieves' Town", 172), Dungeon("Ice Palace", 222), Dungeon("Misery Mire", 144),
+        Dungeon("Turtle Rock", 164), Dungeon("Castle Tower", 32),
+    )
+
+    // Super Metroid's four bosses: room pointer, the area byte at $7ED828 + area and its flag (Brinstar 1, Norfair 2,
+    // Wrecked Ship 3, Maridia 4; the other flags of those bytes belong to mini bosses such as Spore Spawn), icon.
+    private class Boss(val room: Int, val area: Int, val flag: Int, val icon: String)
+    private val bosses = listOf(
+        Boss(0xA59F, 1, 0x01, "kraid_boss_token.png"), Boss(0xCD13, 3, 0x01, "phantoon_boss_token.png"),
+        Boss(0xDA60, 4, 0x01, "draygon_boss_token.png"), Boss(0xB32E, 2, 0x01, "ridley_boss_token.png"),
+    )
+
+    private fun u16(w: ByteArray, a: Int) = (w[a].toInt() and 0xFF) or ((w[a + 1].toInt() and 0xFF) shl 8)
+
+    fun marks(wram: ByteArray, discovery: Smz3Discovery): List<BossMark> {
+        if (wram.size < 0x10000) return emptyList()
+        val out = mutableListOf<BossMark>()
+        for (d in dungeons) {
+            val box = discovery.zeldaBox(d.region) ?: continue
+            out += BossMark(box[0] - 12f, box[1] - 12f, "unknown.png", (u16(wram, 0xF000 + 2 * d.room) and 0x0800) != 0)
+        }
+        for (b in bosses) {
+            val c = discovery.metroidRoomCentre(b.room) ?: continue
+            out += BossMark(c.x, c.y, b.icon, (wram[0xD828 + b.area].toInt() and b.flag) != 0)
+        }
+        return out
+    }
+
+    /** Bit 0 Kraid, 1 Phantoon, 2 Draygon, 3 Ridley: the Super Metroid bosses beaten (area bytes from $7ED828). */
+    fun metroidMask(wram: ByteArray, sram: ByteArray, game: Int): Int {
+        // while Zelda is running the Super Metroid memory is parked in the save RAM ($A16000 block, event word at +$78)
+        val flags = if (game == 2) { if (wram.size < 0xD830) return 0; wram.copyOfRange(0xD828, 0xD830) } else { if (sram.size < 0x2080) return 0; sram.copyOfRange(0x2078, 0x2080) }
+        var mask = 0
+        for ((i, b) in bosses.withIndex()) if (flags[b.area].toInt() and b.flag != 0) mask = mask or (1 shl i)
+        return mask
+    }
+
+    // The crystal byte at $7EF37A has one bit per crystal number: bit 0 is crystal 6, then 1, 5, 7, 2, 4, 3.
+    private val crystalOfBit = intArrayOf(6, 1, 5, 7, 2, 4, 3)
+
+    /** Bit n-1 set when crystal n is collected. */
+    fun crystalMask(wram: ByteArray, sram: ByteArray, game: Int): Int {
+        // Zelda's memory lives in the work RAM while it runs and in the save RAM ($A06000) while Super Metroid (or the credits) does
+        val bits = if (game == 2 || game == 3) { if (sram.size < 0x37B) return 0; sram[0x37A].toInt() and 0xFF } else { if (wram.size < 0xF37B) return 0; wram[0xF37A].toInt() and 0xFF }
+        var mask = 0
+        for (b in 0 until 7) if (bits and (1 shl b) != 0) mask = mask or (1 shl (crystalOfBit[b] - 1))
+        return mask
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3DailyBlock.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3DailyBlock.kt
