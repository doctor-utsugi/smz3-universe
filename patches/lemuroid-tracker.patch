+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/CloudSync.kt
@@ -0,0 +1,442 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Native
+import com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3SyncHost
+import com.swordfish.lemuroid.lib.storage.DirectoriesManager
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.util.concurrent.ConcurrentLinkedQueue
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.zip.GZIPInputStream
+import java.util.zip.GZIPOutputStream
+
+/**
+ * One run's files as the shared sync code sees them (SMZ_SYNC_* kinds): Lemuroid's .srm and gzipped states, and the run
+ * itself as the SMZRUN1 text without the ROM path, with the small files beside it as "x.<name>=" lines, as the PC does.
+ */
+class RunFiles(private val context: Context, private val game: String, private val slot: Int, private val romName: String) : Smz3SyncHost() {
+    private val dir = RunStore.runsDir(context, game)
+    private val dirs by lazy { DirectoriesManager(context.applicationContext) }
+
+    private fun side(ext: String) = File(dir, "slot$slot.$ext")
+
+    private fun romFile(): File {
+        val path = RunStore.load(context, slot, game)?.romPath.orEmpty()
+        return when {
+            path.isNotEmpty() -> File(path)
+            romName.isNotEmpty() -> File(dir, romName)
+            else -> File(dir, "smz3_run_$slot.sfc")
+        }
+    }
+
+    /** Lemuroid names saves and states after the ROM file (Game.fileName). */
+    private fun srmFile() = File(dirs.getSavesDirectory(), romFile().name.substringBeforeLast('.') + ".srm")
+
+    private fun stateFile(kind: Int): File {
+        val name = romFile().name + if (kind == RESUME) ".state" else ".slot${kind - Q1 + 1}"
+        return File(File(dirs.getStatesDirectory(), "snes9x").apply { mkdirs() }, name)
+    }
+
+    override fun read(kind: Int): ByteArray? = runCatching {
+        when (kind) {
+            SRM -> srmFile().takeIf { it.length() > 0 }?.readBytes()
+            in RESUME until RACE -> stateFile(kind).takeIf { it.length() > 0 }?.let { gunzip(it.readBytes()) }
+            RUN -> runText()?.toByteArray()
+            HELP -> helpText()?.toByteArray()
+            ROM -> romFile().takeIf { it.isFile }?.readBytes()
+            RECORD -> RunStore.syncFile(context, slot, game).takeIf { it.isFile }?.readBytes()
+            else -> null
+        }
+    }.getOrNull()
+
+    override fun write(kind: Int, data: ByteArray?): Boolean = runCatching {
+        when (kind) {
+            SRM -> put(srmFile(), data)
+            in RESUME until RACE -> {
+                val f = stateFile(kind)
+                put(f, data?.let { gzip(it) })
+                put(File(f.path + ".metadata"), data?.let { "{\"diskIndex\":0,\"version\":0}".toByteArray() })
+            }
+            RUN -> applyRunText(String(data ?: return@runCatching false, Charsets.UTF_8))
+            HELP -> applyHelp(data?.let { String(it, Charsets.UTF_8) })
+            ROM -> put(romFile(), data)
+            RECORD -> put(RunStore.syncFile(context, slot, game), data)
+            RACE -> {}
+            else -> return@runCatching false
+        }
+        true
+    }.getOrDefault(false)
+
+    private fun put(f: File, data: ByteArray?) {
+        if (data == null) { f.delete(); return }
+        f.parentFile?.mkdirs()
+        val tmp = File(f.path + ".part")
+        tmp.writeBytes(data)
+        if (!tmp.renameTo(f)) { f.writeBytes(data); tmp.delete() }
+    }
+
+    private fun gunzip(b: ByteArray): ByteArray = runCatching { GZIPInputStream(b.inputStream()).use { it.readBytes() } }.getOrDefault(b)
+
+    private fun gzip(b: ByteArray): ByteArray = ByteArrayOutputStream().also { o -> GZIPOutputStream(o).use { it.write(b) } }.toByteArray()
+
+    private fun text(f: File) = f.takeIf { it.isFile }?.readText()
+
+    /** The side files the PC keeps too, by their name there; each is replaced (or removed) on every pull. */
+    private fun commonSides(): List<Pair<String, File>> = listOf("online", "token", "proof", "preset").map { it to side(it) } +
+        (0 until 4).map { "q${it + 1}.goals" to RunStore.goalsStateFile(context, slot, it, game) }
+
+    private fun runText(): String? {
+        val r = RunStore.load(context, slot, game) ?: return null
+        val goals = text(RunStore.goalsFile(context, slot, game))?.trim().orEmpty()
+        val sb = StringBuilder("SMZRUN1\n")
+        sb.append("id=${r.id}\nmode=$game\nname=${r.name}\nseed=${r.seed}\ncreated=${r.createdAt}\nplayed=${r.lastPlayedAt}\nplay_ms=${r.playTimeMs}\n")
+        sb.append("game=${r.game}\nzc=${r.zeldaCleared}\nzt=${r.zeldaTotal}\nmc=${r.metroidCleared}\nmt=${r.metroidTotal}\nbm=${r.bossMask}\ncm=${r.crystalMask}\n")
+        sb.append("sms=${r.saveMs}\nsz=${r.saveZelda}\nsm=${r.saveMetroid}\ngoals=$goals\nsettings=${r.settings}\n")
+        for ((name, f) in commonSides()) text(f)?.let { sb.append("x.$name=").append(esc(it)).append('\n') }
+        text(RunStore.discoveryFile(context, slot, game))?.let { sb.append("x.discovery=").append(esc(discoveryToText(it))).append('\n') }
+        // Android's own: the PC drops them, and a pull without them keeps what is here
+        text(RunStore.marksFile(context, slot, game))?.let { sb.append("x.marks=").append(esc(it)).append('\n') }
+        text(side("mode"))?.let { sb.append("x.mode=").append(esc(it)).append('\n') }
+        if (r.completedAt != 0L) sb.append("x.completed=${r.completedAt}\n")
+        return sb.toString()
+    }
+
+    private fun applyRunText(t: String) {
+        val fields = HashMap<String, String>()
+        val sides = HashMap<String, String>()
+        for (line in t.lineSequence()) {
+            val i = line.indexOf('=')
+            if (i <= 0) continue
+            val k = line.substring(0, i); val v = line.substring(i + 1)
+            if (k.startsWith("x.")) sides[k.substring(2)] = unesc(v) else fields[k] = v
+        }
+        val old = RunStore.load(context, slot, game)
+        val settings = fields["settings"]?.ifEmpty { null } ?: "{}"
+        val json = runCatching { JSONObject(settings) }.getOrDefault(JSONObject())
+        val seed = fields["seed"].orEmpty()
+        fun l(k: String) = fields[k]?.toLongOrNull() ?: 0L
+        fun i(k: String) = fields[k]?.toIntOrNull() ?: 0
+        val rom = old?.romPath?.takeIf { it.isNotEmpty() } ?: File(dir, romName.ifEmpty { RunStore.romName(seed, settings) }).path
+        RunStore.save(
+            context,
+            Run(
+                slot = slot, name = fields["name"].orEmpty().ifEmpty { "Run ${slot + 1}" }, gameId = old?.gameId ?: 0, createdAt = l("created"),
+                lastPlayedAt = l("played"), playTimeMs = l("play_ms"), game = i("game"),
+                zeldaCleared = i("zc"), zeldaTotal = i("zt"), metroidCleared = i("mc"), metroidTotal = i("mt"), bossMask = i("bm"), crystalMask = i("cm"),
+                logic = old?.logic ?: "Vanilla", keysanity = json.optString("keysanity", "None") != "None", romPath = rom, seed = seed, settings = settings,
+                mapMode = json.optString("mapMode", old?.mapMode ?: "all"), completedAt = sides["completed"]?.toLongOrNull() ?: old?.completedAt ?: 0L,
+                saveMs = l("sms"), saveZelda = i("sz"), saveMetroid = i("sm"), id = fields["id"].orEmpty().ifEmpty { old?.id.orEmpty() },
+            ),
+            game,
+        )
+        val goals = fields["goals"].orEmpty()
+        if (goals.isNotEmpty()) RunStore.goalsFile(context, slot, game).writeText(goals) else RunStore.goalsFile(context, slot, game).delete()
+        for ((name, f) in commonSides()) sides[name]?.let { f.writeText(it) } ?: f.delete()
+        sides["discovery"]?.let { RunStore.discoveryFile(context, slot, game).writeText(discoveryFromText(it)) } ?: RunStore.discoveryFile(context, slot, game).delete()
+        sides["marks"]?.let { RunStore.marksFile(context, slot, game).writeText(it) }
+        sides["mode"]?.let { side("mode").writeText(it) }
+    }
+
+    /** Smz3Help's JSON as the PC's help file: seed, used, fixed, revealed and the hints given. */
+    private fun helpText(): String? {
+        val r = RunStore.load(context, slot, game) ?: return null
+        val j = JSONObject(text(side("help.json")) ?: return null)
+        val s = runCatching { JSONObject(r.settings) }.getOrDefault(JSONObject())
+        val fixed = if (s.has("showFixedKeys")) s.optBoolean("showFixedKeys") else r.name == "Cozy run"
+        val sb = StringBuilder("seed=${r.seed}\nused=${j.optInt("used")}\nfixed=${if (fixed) 1 else 0}\nrevealed=")
+        j.optJSONArray("revealed")?.let { a -> for (k in 0 until a.length()) sb.append(a.getInt(k)).append(',') }
+        sb.append('\n')
+        j.optJSONArray("hints")?.let { a -> for (k in 0 until a.length()) sb.append("hint=").append(a.getString(k)).append('\n') }
+        return sb.toString()
+    }
+
+    private fun applyHelp(t: String?) {
+        val f = side("help.json")
+        if (t == null) { f.delete(); return }
+        val seed = RunStore.load(context, slot, game)?.seed
+        var used = 0
+        val hints = JSONArray()
+        val revealed = JSONArray()
+        for (line in t.lineSequence()) when {
+            line.startsWith("seed=") -> if (line.substring(5) != seed) { f.delete(); return }   // another run's
+            line.startsWith("used=") -> used = line.substring(5).toIntOrNull() ?: 0
+            line.startsWith("hint=") -> hints.put(line.substring(5))
+            line.startsWith("revealed=") -> line.substring(9).split(',').mapNotNull { it.toIntOrNull() }.forEach { revealed.put(it) }
+        }
+        f.writeText(JSONObject().put("used", used).put("hints", hints).put("revealed", revealed).toString())
+    }
+
+    companion object {
+        fun esc(t: String) = t.replace("\\", "\\\\").replace("\r", "").replace("\n", "\\n")
+
+        fun unesc(t: String): String {
+            val sb = StringBuilder()
+            var i = 0
+            while (i < t.length) {
+                val c = t[i]
+                if (c == '\\' && i + 1 < t.length) { i++; sb.append(if (t[i] == 'n') '\n' else t[i]) } else sb.append(c)
+                i++
+            }
+            return sb.toString()
+        }
+
+        /** Smz3Discovery's JSON as smz_disc_save's text ("rooms 1 2" / "screens 0 1" / "dungeons A;B;"), and back. */
+        fun discoveryToText(json: String): String {
+            val o = runCatching { JSONObject(json) }.getOrDefault(JSONObject())
+            fun list(k: String) = o.optJSONArray(k)?.let { a -> (0 until a.length()).map { a.get(it).toString() } }.orEmpty()
+            return "rooms" + list("rooms").joinToString("") { " $it" } + "\nscreens" + list("screens").joinToString("") { " $it" } +
+                "\ndungeons " + list("dungeons").joinToString("") { "$it;" } + "\n"
+        }
+
+        fun discoveryFromText(t: String): String {
+            val o = JSONObject()
+            for (line in t.lineSequence()) when {
+                line.startsWith("rooms") -> o.put("rooms", JSONArray(line.substring(5).trim().split(' ').mapNotNull { it.toIntOrNull() }))
+                line.startsWith("screens") -> o.put("screens", JSONArray(line.substring(7).trim().split(' ').mapNotNull { it.toIntOrNull() }))
+                line.startsWith("dungeons") -> o.put("dungeons", JSONArray(line.substring(8).split(';').map { it.trim() }.filter { it.isNotEmpty() }))
+            }
+            return o.toString()
+        }
+    }
+}
+
+/**
+ * Cloud sync with RomM (docs/PLAN_ROMM_SYNC.md), the PC's pc_sync.c for Android: the sign-in kept in sync.txt, runs pulled
+ * before they open and pushed after they close, account runs brought into free slots. The logic is the shared C code.
+ */
+object CloudSync {
+    const val OK = 0
+    const val CONFLICT = 1
+    const val HELD = 3
+    const val FAILED = 4
+    // UI_CLOUD_* and CLOUD_* in core/ui/smz3_ui.h
+    private const val STATE_OUT = 0
+    private const val STATE_WAITING = 1
+    private const val STATE_IN = 2
+    const val SIGN_IN = 1
+    const val CANCEL = 2
+    const val SYNC = 3
+    const val CODE = 4
+    const val LINK = 5
+    const val SIGN_OUT = 6
+    const val KEEP_HERE = 7
+    const val KEEP_CLOUD = 8
+    const val ADDRESS = 9
+
+    /** One sync call at a time, in the order asked (an open waits for the push before it). */
+    private val worker = Executors.newSingleThreadExecutor()
+    @Volatile private var base = ""   // each player's own RomM, typed on the Cloud sync screen
+    @Volatile private var token = ""
+    @Volatile private var device = ""
+    @Volatile private var user = ""
+    @Volatile private var loaded = false
+    @Volatile private var listedOnce = false
+    @Volatile private var loginState = 0   // 0 idle, 1 waiting for approval, 2 signed in, 3 failed
+    @Volatile private var loginCancel = false
+    @Volatile private var code = ""
+    @Volatile private var url = ""
+    private var shownWaiting = false
+    private val messages = ConcurrentLinkedQueue<String>()
+    private val listDone = AtomicBoolean(false)
+    private val net = Smz3SyncHost()
+
+    private fun configFile(context: Context) = File(context.filesDir, "sync.txt")
+
+    private fun load(context: Context) {
+        if (loaded) return
+        loaded = true
+        runCatching {
+            for (line in configFile(context).readLines()) {
+                val k = line.substringBefore('=', ""); val v = line.substringAfter('=', "")
+                when (k) { "romm" -> if (v.isNotEmpty()) base = v; "token" -> token = v; "device" -> device = v; "user" -> user = v }
+            }
+        }
+    }
+
+    private fun save(context: Context) {
+        runCatching { configFile(context).writeText("romm=$base\ntoken=$token\ndevice=$device\nuser=$user\n") }
+    }
+
+    fun signedIn() = token.isNotEmpty()
+
+    private fun host() = base.substringAfter("://")
+
+    private fun cfg(context: Context) = arrayOf(base, token, device, OnlineLadder.server(), OnlineLadder.installIdFor(context), "Android " + android.os.Build.MODEL)
+
+    private fun say(m: String) { messages.add(m) }
+
+    /** After Smz3Native.uiInit: turns the Options row on; the first time, signed in, brings the account's runs here. */
+    fun attach(context: Context) {
+        load(context)
+        Smz3Native.uiCloudEnable(true)
+        showState()
+        if (signedIn() && !listedOnce) { listedOnce = true; list(context) }
+    }
+
+    private fun showState() {
+        if (signedIn()) Smz3Native.uiCloudState(STATE_IN, user, host(), "", "") else Smz3Native.uiCloudState(STATE_OUT, "", host(), "", "")
+    }
+
+    /** On the main thread: shows what the background calls finished. 0 nothing, 1 redraw, 2 the run list changed. */
+    fun poll(context: Context): Int {
+        var r = 0
+        if (loginState == 1 && !shownWaiting) { shownWaiting = true; Smz3Native.uiCloudState(STATE_WAITING, "", host(), code, url); r = 1 }
+        if (loginState == 2) { loginState = 0; shownWaiting = false; showState(); Smz3Native.uiCloudMsg("Signed in"); list(context); r = 1 }
+        if (loginState == 3) { loginState = 0; shownWaiting = false; showState(); r = 1 }
+        while (true) { Smz3Native.uiCloudMsg(messages.poll() ?: break); r = 1 }
+        if (listDone.getAndSet(false)) r = 2
+        return r
+    }
+
+    private fun login(context: Context) {
+        val c = cfg(context).also { it[1] = "" }
+        val start = Smz3Native.syncLoginStart(net, c, "Android")
+        if (start[0].isEmpty()) { say(start[1].take(47)); loginState = 3; return }
+        code = start[1]
+        url = start[2].substringAfter("://")
+        loginState = 1
+        val interval = (start[3].toIntOrNull() ?: 5).coerceAtLeast(1) * 1000L
+        val end = System.currentTimeMillis() + (start[4].toLongOrNull() ?: 600) * 1000
+        var p = "1"
+        while (p == "1" && !loginCancel && System.currentTimeMillis() < end) {
+            Thread.sleep(interval)
+            if (loginCancel) break
+            val q = Smz3Native.syncLoginPoll(net, c, start[0])
+            p = q[0]
+            if (p == "0") { token = q[1]; device = q[2]; user = q[3]; save(context) }
+            else if (p == "-1") say(q[1].take(47))
+        }
+        if (p == "0" && !loginCancel) loginState = 2
+        else { if (!loginCancel && p == "1") say("The code expired: sign in again"); loginState = 3 }
+    }
+
+    private fun game(runId: String) = when (runId.firstOrNull()) { 'z' -> "z3"; 'm' -> "sm"; else -> "smz3" }
+
+    /** Brings the account's runs that are on no slot here into free slots, every game. */
+    private fun listRuns(context: Context) {
+        val notes = Smz3Native.syncNotes(net, cfg(context)) ?: return
+        for (n in 0 until notes.size / 5) {
+            val f = notes.copyOfRange(n * 5, n * 5 + 5).map { String(it, Charsets.UTF_8) }
+            val (runId, romId, noteId, rom, text) = f
+            if (text.isEmpty()) continue
+            val game = game(runId)
+            val runs = (0 until RunStore.SLOTS).map { RunStore.load(context, it, game) }
+            val here = runs.indexOfFirst { it?.id == runId }
+            if (here >= 0) { Smz3Native.syncKeepIds(RunFiles(context, game, here, rom), romId.toIntOrNull() ?: 0, noteId.toIntOrNull() ?: 0); continue }
+            val slot = runs.indexOfFirst { it == null }.takeIf { it >= 0 } ?: continue
+            RunStore.clearExtras(context, slot, game)
+            File(RunStore.runsDir(context, game), "slot$slot.help.json").delete()
+            val files = RunFiles(context, game, slot, rom)
+            if (files.write(Smz3SyncHost.RUN, text.toByteArray())) Smz3Native.syncNewRecord(files, romId.toIntOrNull() ?: 0, noteId.toIntOrNull() ?: 0)
+        }
+    }
+
+    private fun list(context: Context) {
+        val app = context.applicationContext
+        worker.execute {
+            runCatching {
+                if (signedIn()) {
+                    val who = Smz3Native.syncWhoami(net, cfg(app))
+                    if (who[0] == "1") { token = ""; save(app); say("RomM signed this device out"); loginState = 3 }
+                    else if (who[0] == "0") listRuns(app)
+                }
+            }.onFailure { android.util.Log.e("CloudSync", "list failed", it) }
+            listDone.set(true)
+        }
+    }
+
+    /** The Cloud sync screen's rows (ACT_CLOUD); the conflict choice is the menu's, see [open]. */
+    fun action(context: Context, what: Int, link: String, address: String = "") {
+        val app = context.applicationContext
+        when (what) {
+            ADDRESS -> {
+                base = address; token = ""; device = ""; user = ""
+                worker.execute { save(app) }
+                Smz3Native.uiCloudState(STATE_OUT, "", host(), "", "")
+                Smz3Native.uiCloudMsg("RomM address saved")
+            }
+            SIGN_IN -> if (loginState != 1 && base.isNotEmpty()) {
+                loginCancel = false
+                Smz3Native.uiCloudMsg("Asking RomM for a code...")
+                Thread { runCatching { login(app) }.onFailure { say("Sign-in failed"); loginState = 3 } }.start()
+            }
+            CANCEL -> { loginCancel = true; Smz3Native.uiCloudState(STATE_OUT, "", host(), "", "") }
+            SIGN_OUT -> {
+                worker.execute { token = ""; device = ""; user = ""; save(app) }
+                Smz3Native.uiCloudState(STATE_OUT, "", host(), "", "")
+                Smz3Native.uiCloudMsg("Signed out: the runs here stay")
+            }
+            SYNC -> { Smz3Native.uiCloudMsg("Syncing..."); list(app) }
+            CODE -> {
+                Smz3Native.uiCloudMsg("Asking the server for a code...")
+                Thread { val r = Smz3Native.syncPlayer(net, cfg(app), 0, ""); say(if (r[0] == "0") "On the other device enter ${r[1]}" else r[1].take(47)) }.start()
+            }
+            LINK -> Thread { val r = Smz3Native.syncPlayer(net, cfg(app), 1, link); say(if (r[0] == "0") "Linked: one player on both devices" else r[1].take(47)) }.start()
+        }
+    }
+
+    private fun online(context: Context, game: String, slot: Int) =
+        runCatching { File(RunStore.runsDir(context, game), "slot$slot.online").readText().trim() }.getOrNull() in setOf("original", "monthly", "weekly")
+
+    private fun job(context: Context, game: String, slot: Int, push: Boolean, force: Boolean): Array<String>? {
+        val run = RunStore.load(context, slot, game) ?: return null
+        val files = RunFiles(context, game, slot, "")
+        val online = online(context, game, slot)
+        val proof = if (online) runCatching { File(RunStore.runsDir(context, game), "slot$slot.proof").readText() }.getOrDefault("") else ""
+        if (online && !push) Smz3Native.syncHold(net, cfg(context), run.id, true)   // playing it here takes it over
+        val rom = RunStore.romName(run.seed, run.settings)
+        val r = Smz3Native.syncRun(files, cfg(context), push, force, arrayOf(run.id, rom, run.name, proof), online, run.playTimeMs, 0, System.currentTimeMillis())
+        if (!push && online && r[0] == "0" && r[2] == "1" && game == RunStore.mode) OnlineLadder.markRun(context, slot, false, "")   // files made outside SMZ3
+        return r
+    }
+
+    /** Before a run starts: RomM's newer files come down (forcePull keeps RomM's, forcePush this device's). Blocks: call off the
+     *  main thread. {result, changed, unranked, cloud device, cloud ms, why}; null when there was nothing to do. */
+    fun open(context: Context, game: String, slot: Int, forcePull: Boolean, forcePush: Boolean): Array<String>? {
+        if (!signedIn() || slot >= RunStore.SLOTS) return null
+        val app = context.applicationContext
+        return worker.submit<Array<String>?> {
+            runCatching { job(app, game, slot, forcePush, forcePull || forcePush) }.onFailure { android.util.Log.e("CloudSync", "open failed", it) }.getOrNull()
+        }.get()
+    }
+
+    /** After a run: what changed goes up, in the background. */
+    fun left(context: Context, game: String, slot: Int) {
+        if (!signedIn() || slot >= RunStore.SLOTS) return
+        val app = context.applicationContext
+        worker.execute {
+            val r = runCatching { job(app, game, slot, true, false) }.onFailure { android.util.Log.e("CloudSync", "push failed", it) }.getOrNull() ?: return@execute
+            when (r[0].toIntOrNull()) {
+                CONFLICT -> say("A run changed elsewhere too: open it to choose")
+                HELD -> say("Another device took this run over")
+                FAILED -> say(r[5].take(47))
+            }
+        }
+    }
+
+    /** SMZ3's emulator wrote a file of the run being played (in the game's process): its hash goes into the sync record. */
+    fun own(context: Context, kind: Int, data: ByteArray) {
+        runCatching {
+            val slot = RunStore.activeSlot(context) ?: return
+            if (slot < RunStore.SLOTS) Smz3Native.syncOwn(RunFiles(context, RunStore.mode, slot, ""), kind, data)
+        }
+    }
+
+    /** A run is being deleted here: it goes from RomM too. Call before its files go. */
+    fun deleted(context: Context, slot: Int) {
+        if (!signedIn() || slot >= RunStore.SLOTS) return
+        val record = runCatching { RunStore.syncFile(context, slot).readBytes() }.getOrNull() ?: return
+        val app = context.applicationContext
+        worker.execute {
+            val host = object : Smz3SyncHost() { override fun read(kind: Int) = if (kind == RECORD) record else null }
+            runCatching { Smz3Native.syncDelete(host, cfg(app)) }
+        }
+    }
+
+    /** "there on 26 Nov, 14:05", for the conflict screen. */
+    fun whenText(ms: Long): String = java.text.SimpleDateFormat("'there on' d MMM, HH:mm", java.util.Locale.ENGLISH).format(java.util.Date(ms))
+}
