+private val PANEL = Color(0xFF10141B)
+private val DIM = Color(0xFF8793A6)
+private val TEXT = Color(0xFFE6E9EF)
+private val GOLD = Color(0xFFE9A23B)
+private val TAB = Color(0xFF2E4A6B)
