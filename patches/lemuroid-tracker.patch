+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/AppBackup.kt
@@ -0,0 +1,63 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.Build
+import java.io.File
+
+/**
+ * An update signed with another key can't install over this app, and uninstalling it to get past that wipes the app's
+ * files: the runs, the sign-ins, the install id. Before that, they are copied to /sdcard/SMZ3/backup/<package>, which an
+ * uninstall leaves alone, and the next install takes them back on its first start.
+ */
+object AppBackup {
+    private val KEEP = listOf("runs", "sync.txt", "saved_customs.txt")
+
+    private fun dir(context: Context) = File("/sdcard/SMZ3/backup/" + context.packageName)
+
+    /** False when the downloaded APK is signed with another key than this app (it could not install over it). */
+    fun sameSigner(context: Context, apk: File): Boolean = runCatching {
+        val pm = context.packageManager
+        if (Build.VERSION.SDK_INT >= 28) {
+            val flag = PackageManager.GET_SIGNING_CERTIFICATES
+            val theirs = pm.getPackageArchiveInfo(apk.path, flag)?.signingInfo?.apkContentsSigners ?: return@runCatching true
+            val mine = pm.getPackageInfo(context.packageName, flag).signingInfo?.apkContentsSigners ?: return@runCatching true
+            theirs.map { it.toByteArray().contentHashCode() }.toSet() == mine.map { it.toByteArray().contentHashCode() }.toSet()
+        } else {
+            @Suppress("DEPRECATION")
+            val theirs = pm.getPackageArchiveInfo(apk.path, PackageManager.GET_SIGNATURES)?.signatures ?: return@runCatching true
+            @Suppress("DEPRECATION")
+            val mine = pm.getPackageInfo(context.packageName, PackageManager.GET_SIGNATURES).signatures ?: return@runCatching true
+            theirs.map { it.toByteArray().contentHashCode() }.toSet() == mine.map { it.toByteArray().contentHashCode() }.toSet()
+        }
+    }.getOrDefault(true)
+
+    /** Copies the app's own files that an uninstall would lose; false when the shared folder can't be written. */
+    fun save(context: Context): Boolean = runCatching {
+        val to = dir(context)
+        to.mkdirs()
+        if (!to.canWrite()) return@runCatching false
+        for (name in KEEP) {
+            val f = File(context.filesDir, name)
+            if (f.exists()) f.copyRecursively(File(to, name), overwrite = true)
+        }
+        File(to, "saved.txt").writeText(System.currentTimeMillis().toString())
+        true
+    }.getOrDefault(false)
+
+    /** On the first start of an install that has no runs, takes back a backup made by [save]. */
+    fun restoreIfEmpty(context: Context) {
+        runCatching {
+            val checked = File(context.filesDir, "backup_checked")
+            if (checked.exists()) return
+            checked.writeText("")
+            val from = dir(context)
+            val runs = File(context.filesDir, "runs")
+            if (!File(from, "saved.txt").exists() || runs.walkTopDown().any { it.isFile && it.name.startsWith("slot") && it.name.endsWith(".json") }) return
+            for (name in KEEP) {
+                val f = File(from, name)
+                if (f.exists()) f.copyRecursively(File(context.filesDir, name), overwrite = true)
+            }
+        }
+    }
+}
