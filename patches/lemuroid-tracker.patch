+            drawPath(chamfer(l, t, w, h, cut), Color(0xFF25324A))
+            drawPath(chamfer(l + 0.7f * scale, t + 0.7f * scale, w - 1.4f * scale, h - 1.4f * scale, cut - 0.7f * scale), Color(0xFF141B27))
