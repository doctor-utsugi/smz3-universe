+    }.getOrNull()
+
+    /** Sends a run's world goal counters (key=n,key=n text); the run is told apart by its slot and when it was made. Call off the main thread. */
+    fun reportGoals(context: Context, runId: String, online: Boolean, counters: String) {
+        val counts = JSONObject()
+        for (part in counters.split(',')) {
+            val k = part.substringBefore('=', ""); val v = part.substringAfter('=', "").toLongOrNull()
+            if (k.isNotEmpty() && !k.startsWith("_") && v != null) counts.put(k, v)
+        }
+        if (counts.length() == 0) return
+        val (name, country) = profile(context)   // the name and flag last month's top 10 shows
+        val body = JSONObject().put("install", installId(context)).put("run", runId).put("online", online).put("counts", counts).put("player", name)
+        if (country.length == 2) body.put("country", country)
+        post("/api/goals/report", body)
+    }
+
+    /** Downloads the three ladders of the game shown into the cache; true when the original one worked. Call off the main thread. */
+    fun refresh(context: Context): Boolean {
+        val game = RunStore.mode
+        var original = false
+        for (tab in 0..2) {
+            val ok = runCatching {
+                val text = ladderJson(tab, game) ?: error("offline")
+                JSONObject(text).getJSONArray("runs")
+                cacheFile(context, tab, game).writeText(text)
+            }.isSuccess
+            if (tab == 0) original = ok
+        }
+        return original
+    }
+}
