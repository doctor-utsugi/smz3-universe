+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.annotation.SuppressLint
+import android.app.Activity
+import android.app.Dialog
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import android.os.SystemClock
+import android.view.KeyEvent
+import android.view.MotionEvent
+import android.view.View
+import kotlin.math.min
+import kotlin.math.sin
+
+/**
+ * A prompt over the game drawn like the shared menus (cut corners, the chosen row glowing amber, the menu font, the
+ * button bar), in place of the system dialogs. Up and down choose a row, A takes it, B does [back]; Left and Right go to
+ * [step] when it is set (a value that the message shows). Rows take touches too.
+ */
+class Smz3Box(private val activity: Activity) {
+    /** A row; a [keep] row does its action and leaves the box up (a value to change by touch). */
+    class Option(val label: String, val detail: String = "", val keep: Boolean = false, val action: () -> Unit)
+
+    var title = ""
+    var message = ""
+        set(value) { field = value; view?.invalidate() }
+    var options: List<Option> = emptyList()
+    var back: (() -> Unit)? = null
+    var backLabel = "Back"
+    var step: ((Int) -> Unit)? = null
+    /** The title's colour: gold by default. */
+    var accent = GOLD
+    var chosen = 0
+
+    private var dialog: Dialog? = null
+    private var view: BoxView? = null
+    val isShowing get() = dialog?.isShowing == true
+
+    fun show(): Smz3Box {
+        if (activity.isFinishing) return this
+        dismiss()
+        chosen = chosen.coerceIn(0, maxOf(0, options.size - 1))
+        val v = BoxView(activity, this)
+        view = v
+        dialog = Dialog(activity, android.R.style.Theme_Translucent_NoTitleBar_Fullscreen).apply {
+            setContentView(v)
+            setCancelable(false)
+            setOnKeyListener { _, k, e -> key(k, e) }
+            show()
+        }
+        Smz3Finish.cue(4)
+        return this
+    }
+
+    fun dismiss() { dialog?.dismiss(); dialog = null; view = null }
+
+    private fun key(k: Int, e: KeyEvent): Boolean {
+        if (e.action != KeyEvent.ACTION_DOWN) return true
+        when (k) {
+            KeyEvent.KEYCODE_DPAD_UP -> move(-1)
+            KeyEvent.KEYCODE_DPAD_DOWN -> move(1)
+            KeyEvent.KEYCODE_DPAD_LEFT, KeyEvent.KEYCODE_DPAD_RIGHT -> step?.let { it(if (k == KeyEvent.KEYCODE_DPAD_LEFT) -1 else 1); Smz3Finish.cue(1) }
+            KeyEvent.KEYCODE_BUTTON_A, KeyEvent.KEYCODE_ENTER, KeyEvent.KEYCODE_DPAD_CENTER -> choose(chosen)
+            KeyEvent.KEYCODE_BUTTON_B, KeyEvent.KEYCODE_BACK, KeyEvent.KEYCODE_ESCAPE -> back?.let { dismiss(); Smz3Finish.cue(5); it() }
+        }
+        return true
+    }
+
+    private fun move(d: Int) {
+        if (options.size < 2) return
+        chosen = (chosen + d + options.size) % options.size
+        Smz3Finish.cue(1)
+        view?.invalidate()
+    }
+
+    internal fun choose(i: Int) {
+        val o = options.getOrNull(i) ?: return
+        if (!o.keep) dismiss()
+        Smz3Finish.cue(3)
+        o.action()
+    }
+
+    companion object {
+        val GOLD = Color.rgb(0xF2, 0xA3, 0x3A)
+        val TEXT = Color.rgb(0xE8, 0xEC, 0xF2)
+        val DIM = Color.rgb(0x87, 0x93, 0xA6)
+        val RED = Color.rgb(0xE0, 0x5A, 0x4F)
+        private val EDGE = Color.rgb(0x25, 0x32, 0x4A)
+        private val INNER = Color.rgb(0x14, 0x1B, 0x27)
+        private var face: Typeface? = null
+        fun face(c: Context): Typeface = face ?: runCatching { Typeface.createFromAsset(c.assets, "smz3/menu_font.ttf") }
+            .getOrDefault(Typeface.DEFAULT_BOLD).also { face = it }
+
+        fun chamfer(p: Path, l: Float, t: Float, w: Float, h: Float, cut: Float) = p.apply {
+            reset(); moveTo(l + cut, t); lineTo(l + w - cut, t); lineTo(l + w, t + cut); lineTo(l + w, t + h - cut)
+            lineTo(l + w - cut, t + h); lineTo(l + cut, t + h); lineTo(l, t + h - cut); lineTo(l, t + cut); close()
+        }
+
+        /** A row of the shared menus: [lit] is the chosen one, which glows and breathes. */
+        fun row(c: Canvas, fill: Paint, path: Path, l: Float, t: Float, w: Float, h: Float, u: Float, lit: Boolean, pulse: Float) {
+            val cut = 10 * u
+            if (lit) {
+                for (g in 3 downTo 1) { fill.color = Smz3Finish.alpha(GOLD, (0.10f + 0.10f * pulse) / g); c.drawPath(chamfer(path, l - g * 2 * u, t - g * 2 * u, w + g * 4 * u, h + g * 4 * u, cut + g * 2 * u), fill) }
+                fill.color = Smz3Finish.alpha(GOLD, 0.55f + 0.45f * pulse); c.drawPath(chamfer(path, l, t, w, h, cut), fill)
+                fill.color = Color.rgb(0x24, 0x22, 0x1C); c.drawPath(chamfer(path, l + 2 * u, t + 2 * u, w - 4 * u, h - 4 * u, cut - 2 * u), fill)
+                fill.color = Smz3Finish.alpha(GOLD, 0.10f); c.drawRect(l + 2 * u, t + 2 * u, l + w / 2, t + h - 2 * u, fill)
+            } else {
+                fill.color = EDGE; c.drawPath(chamfer(path, l, t, w, h, cut), fill)
+                fill.color = INNER; c.drawPath(chamfer(path, l + 1.5f * u, t + 1.5f * u, w - 3 * u, h - 3 * u, cut - 1.5f * u), fill)
+            }
+        }
+
+        /** The button bar of the shared menus, right-aligned at [right]: a light circle with the letter, then its label. */
+        fun hint(c: Canvas, text: Paint, fill: Paint, right: Float, cy: Float, ih: Float, items: List<Pair<String, String>>) {
+            text.textSize = ih * 0.92f; text.textAlign = Paint.Align.LEFT
+            val gap = ih * 1.1f
+            var total = 0f
+            for ((k, it) in items.withIndex()) total += ih + ih * 0.3f + text.measureText(it.second) + if (k > 0) gap else 0f
+            var x = right - total
+            for ((b, label) in items) {
+                fill.color = Color.rgb(0xC7, 0xD0, 0xDE); c.drawCircle(x + ih / 2, cy, ih / 2, fill)
+                text.color = Color.rgb(0x0C, 0x11, 0x19); text.textAlign = Paint.Align.CENTER; text.textSize = ih * 0.72f
+                c.drawText(b, x + ih / 2, cy + ih * 0.26f, text)
+                text.color = Color.rgb(0xB8, 0xC2, 0xD4); text.textAlign = Paint.Align.LEFT; text.textSize = ih * 0.92f
+                c.drawText(label, x + ih * 1.3f, cy + ih * 0.32f, text)
+                x += ih * 1.3f + text.measureText(label) + gap
+            }
+        }
+
+        /** [s] broken into lines that fit [w], keeping the line breaks it has. */
+        fun wrap(p: Paint, s: String, w: Float): List<String> {
+            val out = ArrayList<String>()
+            for (para in s.split('\n')) {
+                var line = ""
+                for (word in para.split(' ')) {
+                    val next = if (line.isEmpty()) word else "$line $word"
+                    if (p.measureText(next) > w && line.isNotEmpty()) { out += line; line = word } else line = next
+                }
+                out += line
+            }
+            return out
+        }
+    }
+
+    @SuppressLint("ViewConstructor")
+    private class BoxView(context: Context, private val box: Smz3Box) : View(context) {
+        private val text = Paint(Paint.ANTI_ALIAS_FLAG).apply { typeface = face(context) }
+        private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val path = Path()
+        private val rows = ArrayList<RectF>()
+        private val born = SystemClock.uptimeMillis()
+
+        override fun onDraw(c: Canvas) {
+            val t = (SystemClock.uptimeMillis() - born) / 1000f
+            val w = width.toFloat(); val h = height.toFloat(); val u = min(w / 900f, h / 560f)
+            val inA = Smz3Finish.easeOut(t / 0.18f)
+            c.drawColor(Color.argb((170 * inA).toInt(), 0, 0, 0))
+            val pw = min(w - 32 * u, 640 * u); val px = (w - pw) / 2
+            text.textSize = 21 * u
+            val lines = if (box.message.isEmpty()) emptyList() else wrap(text, box.message, pw - 56 * u)
+            val rowH = 54 * u; val rowGap = 12 * u
+            val ph = 64 * u + (if (lines.isEmpty()) 0f else lines.size * 29 * u + 14 * u) + box.options.size * (rowH + rowGap) + 52 * u
+            val py = (h - ph) / 2 + (1 - inA) * 18 * u
+
+            // the panel and its title strip
+            fill.color = Color.rgb(0x25, 0x32, 0x4A); c.drawPath(chamfer(path, px - 2 * u, py - 2 * u, pw + 4 * u, ph + 4 * u, 14 * u), fill)
+            fill.color = Color.rgb(0x0A, 0x0E, 0x15); c.drawPath(chamfer(path, px, py, pw, ph, 13 * u), fill)
+            fill.shader = LinearGradient(0f, py, 0f, py + 56 * u, Color.rgb(0x2A, 0x21, 0x12), Color.rgb(0x10, 0x16, 0x1F), Shader.TileMode.CLAMP)
+            c.drawRect(px + 6 * u, py + 2 * u, px + pw - 6 * u, py + 56 * u, fill); fill.shader = null
+            fill.color = Color.rgb(0x25, 0x32, 0x4A); c.drawRect(px, py + 56 * u, px + pw, py + 57 * u, fill)
+            text.color = box.accent; text.textSize = 30 * u; text.textAlign = Paint.Align.LEFT
+            c.drawText(box.title, px + 28 * u, py + 40 * u, text)
+
+            var y = py + 64 * u
+            text.textSize = 21 * u; text.color = Smz3Box.TEXT
+            if (lines.isNotEmpty()) { y += 6 * u; for (l in lines) { c.drawText(l, px + 28 * u, y + 21 * u, text); y += 29 * u }; y += 8 * u }
+
+            val pulse = 0.5f + 0.5f * sin(t * 4f)
+            while (rows.size < box.options.size) rows += RectF()
+            box.options.forEachIndexed { i, o ->
+                val lit = i == box.chosen
+                row(c, fill, path, px + 20 * u, y, pw - 40 * u, rowH, u, lit, pulse)
+                rows[i].set(px + 20 * u, y, px + pw - 20 * u, y + rowH)
+                text.textSize = 24 * u; text.color = if (lit) Color.WHITE else Smz3Box.TEXT; text.textAlign = Paint.Align.LEFT
+                c.drawText(o.label, px + 42 * u, y + rowH / 2 + 8 * u, text)
+                if (o.detail.isNotEmpty()) { text.color = Smz3Box.DIM; text.textSize = 19 * u; text.textAlign = Paint.Align.RIGHT; c.drawText(o.detail, px + pw - 42 * u, y + rowH / 2 + 7 * u, text) }
+                y += rowH + rowGap
+            }
+
+            // the buttons this box takes
+            val items = ArrayList<Pair<String, String>>()
+            if (box.options.isNotEmpty()) items += "A" to "Choose"
+            if (box.back != null) items += "B" to box.backLabel
+            if (box.step != null) items.add(0, "<>" to "Change")
+            fill.color = Color.rgb(0x0C, 0x11, 0x19); c.drawRect(px + 4 * u, py + ph - 40 * u, px + pw - 4 * u, py + ph - 4 * u, fill)
+            hint(c, Paint(text), fill, px + pw - 24 * u, py + ph - 22 * u, 22 * u, items)
+            postInvalidateOnAnimation()
+        }
+
+        @SuppressLint("ClickableViewAccessibility")
+        override fun onTouchEvent(e: MotionEvent): Boolean {
+            if (e.action != MotionEvent.ACTION_UP) return true
+            val i = rows.indexOfFirst { it.contains(e.x, e.y) }
+            if (i in box.options.indices) { box.chosen = i; box.choose(i) }
+            return true
+        }
+    }
+}
