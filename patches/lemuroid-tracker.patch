+    private fun setPadFocus(v: View?) {
+        padFocus?.foreground = null
+        padFocus = v
+        v?.foreground = android.graphics.drawable.GradientDrawable().apply { setStroke(dp(2), theme.accent); cornerRadius = dp(4).toFloat() }
+        v?.requestRectangleOnScreen(android.graphics.Rect(0, 0, v.width, v.height), false)   // the page's scroll follows
+    }
+
+    /** Single screen: dy goes to the nearest button on the row above or below, dx to the one before or after; past the
+     * last one (or on a page with none, like HELP) the page scrolls. False below the end of the page. */
+    fun move(dx: Int, dy: Int): Boolean {
+        val page = pages.getOrNull(selectedTab) ?: return false
+        val all = mutableListOf<View>().also { clickables(page, it) }
+        val at = IntArray(2)
+        val pos = all.associateWith { v -> v.getLocationOnScreen(at); at[0] + v.width / 2 to at[1] + v.height / 2 }
+        val order = all.sortedWith(compareBy({ pos.getValue(it).second }, { pos.getValue(it).first }))
+        val cur = padFocus?.takeIf { it in pos }
+        val next = when {
+            order.isEmpty() -> null
+            cur == null -> if (dy < 0 || dx < 0) null else order.first()
+            dx != 0 -> order.getOrNull(order.indexOf(cur) + dx)
+            else -> {
+                val (cx, cy) = pos.getValue(cur)
+                val row = order.filter { val y = pos.getValue(it).second; if (dy > 0) y > cy + dp(4) else y < cy - dp(4) }
+                val rowY = if (dy > 0) row.minOfOrNull { pos.getValue(it).second } else row.maxOfOrNull { pos.getValue(it).second }
+                row.filter { kotlin.math.abs(pos.getValue(it).second - (rowY ?: 0)) <= dp(12) }.minByOrNull { kotlin.math.abs(pos.getValue(it).first - cx) }
+            }
+        }
+        if (next != null) { setPadFocus(next); return true }
+        if (dy == 0) return true
+        if (dy < 0 && cur != null && cur === order.firstOrNull()) setPadFocus(null)
+        val scroll = firstScroll(page)
+        if (dy > 0 && scroll?.canScrollVertically(1) != true) return false   // the end of the page: the caller goes on below it
+        scroll?.smoothScrollBy(0, dy * scroll.height / 3)
+        return true
+    }
