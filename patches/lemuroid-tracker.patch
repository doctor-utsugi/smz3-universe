+    /** Asks the server for the run's token the first time it is played; no network means no token and the run stays off the online ladder. */
+    fun ensureToken(context: Context, slot: Int): Boolean {
+        if (!onlineFile(context, slot).exists() || tokenFile(context, slot).exists()) return true
+        val kind = runCatching { onlineFile(context, slot).readText().trim() }.getOrNull() ?: return false
+        val body = JSONObject().put("install", installId(context)).put("kind", kind)
+        if (RunStore.mode != "smz3") body.put("game", RunStore.mode)   // SMZ3 sends none
+        runCatching { presetFile(context, slot).readText().trim() }.getOrNull()?.takeIf { it.isNotEmpty() }?.let { body.put("preset", it) }
+        val r = call("/api/start", body) ?: return false
+        val token = r.optString("token").takeIf { it.isNotEmpty() } ?: return false
+        tokenFile(context, slot).writeText(token)
