+    /** I'm ready in the race's ready room: the game is made with the skins picked (they go into the ROM), then the server hears both. */
+    fun buildRace() {
+        scope.launch {
+            val outcome = runCatching {
+                val (sm, z3) = onlineBases()
+                    ?: run {   // the ready room stays while the picker is open: the game is built again once both ROMs are in
+                        singleRomMissing()?.let { error(it) }
+                        val wrong = RunGenerator.wrongBaseRom
+                        askRoms { uris ->
+                            val message = if (uris.isEmpty()) null else RunGenerator.importRoms(context, uris)
+                            if (message?.startsWith("Both") == true) buildRace()
+                            else { Smz3Native.uiRaceFail((message ?: wrong ?: "Pick the base ROMs to race").take(31)); version++ }
+                        }
+                        return@launch
+                    }
+                val made = Smz3Native.raceSettingsJson().ifEmpty { error("The race's settings do not fit") }
+                Smz3Native.uiSetPlando(null)
+                val (rom, usedSeed, raw) = onlineGame(sm, z3, made)
+                val settings = JSONObject(raw)
+                if (RunStore.mode == "smz3" && !Smz3Native.raceApplyStart(rom, raw)) error("The Draft's start does not fit")   // Drafts are SMZ3's
+                RunStore.delete(context, RaceClient.SLOT)
+                RunStore.goalsFile(context, RaceClient.SLOT).delete()   // a Draft's kills and rupees count from zero
+                val romFile = RunStore.newRomFile(context, usedSeed, raw)
+                romFile.writeBytes(rom)
+                val totals = Smz3Native.summarize(ByteArray(0), ByteArray(0))
+                RunStore.save(
+                    context,
+                    Run(
+                        slot = RaceClient.SLOT, name = "Race ${Smz3Native.uiRaceInfo()[4]}", gameId = 0, createdAt = System.currentTimeMillis(),
+                        zeldaTotal = totals[3], metroidTotal = totals[5], keysanity = settings.optString("keysanity") != "None",
+                        logic = "Vanilla", romPath = romFile.path, seed = usedSeed, settings = raw, mapMode = settings.optString("mapMode", "all"),
+                    ),
+                )
+                OnlineLadder.markRun(context, RaceClient.SLOT, false, "")
+            }.onFailure { android.util.Log.e("NativeMenu", "race build failed", it) }
+            val failed = outcome.exceptionOrNull()
+            if (failed != null) Smz3Native.uiRaceFail((failed.message ?: "Cannot make the race's game").take(31))
+            else {
+                val info = Smz3Native.uiRaceInfo()
+                RaceClient.send("pick", JSONObject().put("link", info[6]).put("samus", info[7]), true)
+                RaceClient.send("ready", null, true)
+            }
+            version++
+        }
+    }
