--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/RaceClient.kt
@@ -0,0 +1,207 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import android.os.SystemClock
+import com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Native
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * The online race's requests (server/ladder/race.js), as the PC's pc_race.c: one thread sends them in order and polls the
+ * room, every second in the rooms and every two in the race; the menu and the game take the answers with [take]. The game
+ * runs in a process of its own, so the room's token waits in a file for it ([resume]).
+ */
+object RaceClient {
+    const val ROOM = 0
+    const val ROOMS = 1
+    const val ERROR = 2
+    /** The race game's slot, after the daily challenge's; never listed with the runs. */
+    const val SLOT = RunStore.SLOTS + 1
+
+    private class Req(val what: String, val fields: JSONObject?, val withToken: Boolean)
+
+    private val lock = Object()
+    private val queue = ArrayDeque<Req>()
+    private val answers = ArrayDeque<Pair<Int, String>>()
+    private val events = ArrayList<String>()
+    private val chats = ArrayList<String>()
+    private var token = ""
+    private var since = 0L
+    private var progress = 0
+    @Volatile var slow = false
+    private var tokenFile: File? = null
+    private var offlineSince = 0L   // elapsedRealtime of the first failed poll in a row; 0 while the server answers
+    private var worker: Thread? = null
+    @Volatile private var busy = false
+
+    private fun base(): String = OnlineLadder.server()
+
+    fun proofFile(context: Context) = File(RunStore.runsDir(context), "slot$SLOT.proof")   // where OnlineLadder.noteChecks writes it
+
+    fun init(context: Context) {
+        synchronized(lock) {
+            if (tokenFile == null) tokenFile = File(File(context.filesDir, "runs").apply { mkdirs() }, "race.token")
+            if (worker == null) worker = Thread(::loop, "race").apply { isDaemon = true; start() }
+        }
+    }
+
+    /** In the game's process: the room the menu joined. */
+    fun resume(context: Context) {
+        init(context)
+        synchronized(lock) { token = runCatching { tokenFile!!.readText().trim() }.getOrDefault("") }
+    }
+
+    /** A paused race kept on this device: its token, code and resume time (server ms), and the game's state beside it. */
+    class Paused(val token: String, val code: String, val resumeAt: Long)
+
+    fun stateFile(context: Context) = File(File(context.filesDir, "runs"), "slot$SLOT.racestate")
+
+    fun paused(context: Context): Paused? = runCatching {
+        val l = File(File(context.filesDir, "runs"), "race.paused").readLines()
+        Paused(l[0], l[1], l[2].toLong())
+    }.getOrNull()
+
+    fun keepPaused(context: Context, code: String, resumeAt: Long, state: ByteArray?) {
+        if (state != null) stateFile(context).writeBytes(state)
+        File(File(context.filesDir, "runs").apply { mkdirs() }, "race.paused").writeText("${synchronized(lock) { token }}\n$code\n$resumeAt\n")
+    }
+
+    fun forgetPaused(context: Context) { File(File(context.filesDir, "runs"), "race.paused").delete(); stateFile(context).delete() }
+
+    /** The menu picks the paused race again: its token goes to the game's process like a joined room's. */
+    fun resumePaused(context: Context, p: Paused) {
+        init(context)
+        synchronized(lock) { queue.removeAll { it.what == "forget" }; token = p.token; since = 0; progress = 0; events.clear(); chats.clear(); offlineSince = 0; saveToken() }
+    }
+
+    /** How long the polls have failed in a row, in ms (0 while the server answers). */
+    fun offlineMs(): Long = synchronized(lock) { if (offlineSince == 0L) 0L else SystemClock.elapsedRealtime() - offlineSince }
+
+    /** The player as the requests carry it. */
+    fun who(context: Context): JSONObject {
+        val (name, country) = OnlineLadder.profileFor(context)
+        val j = JSONObject().put("install", OnlineLadder.installIdFor(context)).put("player", name).put("country", country).put("version", Smz3Native.version())
+        if (RunStore.mode != "smz3") j.put("game", RunStore.mode)   // SMZ3 sends none
+        return j
+    }
+
+    /** Queues a POST to /api/race/<what>; with [withToken] the room's token goes along. */
+    fun send(what: String, fields: JSONObject?, withToken: Boolean) = synchronized(lock) { queue.addLast(Req(what, fields, withToken)) }
+
+    /** Queues the request for the open public rooms of the game shown. */
+    fun find() = send("open", JSONObject().put("game", RunStore.mode), false)
+
+    /** Stops polling and forgets the room, once the requests queued before it are sent. */
+    fun forget() = send("forget", null, false)
+
+    /** The game takes the room over: this process stops polling, the token stays in its file. */
+    fun handOver() = send("handover", null, false)
+
+    /** Waits up to [ms] for the queued requests to go out (off the main thread). */
+    fun drain(ms: Long) {
+        val until = SystemClock.elapsedRealtime() + ms
+        while (synchronized(lock) { queue.isNotEmpty() || busy } && SystemClock.elapsedRealtime() < until) Thread.sleep(20)
+    }
+
+    /** Sends [what] with the token on this thread (not the main one), past the queue. */
+    fun now(what: String) = request(Req(what, null, true))
+
+    /** The next answer: its kind with the JSON (or the error text); null when none is waiting. */
+    fun take(): Pair<Int, String>? = synchronized(lock) { answers.removeFirstOrNull() }
+
+    fun joined(): Boolean = synchronized(lock) { token.isNotEmpty() }
+    fun setSince(s: Long) = synchronized(lock) { since = s }
+    fun setProgress(p: Int) = synchronized(lock) { progress = p.coerceIn(0, 100) }
+    fun event(text: String) = synchronized(lock) { if (events.size < 8) events += text }
+    /** False when three lines already wait for the next poll. */
+    fun chat(text: String): Boolean = synchronized(lock) { (chats.size < 3).also { if (it) chats += text } }
+
+    private fun saveToken() { runCatching { if (token.isEmpty()) tokenFile?.delete() else tokenFile?.writeText(token) } }
+
+    private fun answer(kind: Int, text: String) = synchronized(lock) {
+        if (answers.size >= 16) answers.removeFirst()
+        answers.addLast(kind to text)
+    }
+
+    private fun http(method: String, path: String, body: String?): Pair<Int, String> = runCatching {
+        val c = URL(base() + path).openConnection() as HttpURLConnection
+        c.requestMethod = method
+        c.connectTimeout = 8000
+        c.readTimeout = 8000
+        if (body != null) {
+            c.doOutput = true
+            c.setRequestProperty("Content-Type", "application/json")
+            c.outputStream.use { it.write(body.toByteArray()) }
+        }
+        val text = runCatching { (if (c.responseCode < 400) c.inputStream else c.errorStream).bufferedReader().use { it.readText() } }.getOrDefault("")
+        Pair(c.responseCode, text).also { c.disconnect() }
+    }.getOrDefault(Pair(-1, ""))
+
+    /** What can't be lost in a race: sent again until the server answers. */
+    private fun keeps(what: String) = what == "finish" || what == "ladder" || what == "back" || what == "vote" || what == "pause"
+
+    /** Sends one request and files its answer; a create or join answer brings the room's token. False when the server
+     * could not be reached. */
+    private fun request(r: Req): Boolean {
+        when (r.what) {
+            "forget" -> { synchronized(lock) { token = ""; since = 0; progress = 0; events.clear(); chats.clear(); slow = false; offlineSince = 0; saveToken() }; return true }
+            "handover" -> { synchronized(lock) { token = ""; since = 0; progress = 0; events.clear(); chats.clear() }; return true }
+        }
+        val sent = System.currentTimeMillis()
+        val (code0, text) = if (r.what == "open") http("GET", "/api/race/open" + RunStore.gameQuery(r.fields?.optString("game") ?: "smz3", true), null) else {
+            val body = JSONObject(r.fields?.toString() ?: "{}")
+            if (r.withToken) body.put("token", synchronized(lock) { token })
+            http("POST", "/api/race/${r.what}", body.toString())
+        }
+        if (r.what == "leave") { synchronized(lock) { token = ""; since = 0; saveToken() }; return true }   // gone either way
+        // The proxy's own page while the server restarts: a short outage, not a no.
+        val code = if (code0 >= 500 && !text.contains("\"error\"")) -1 else code0
+        synchronized(lock) { if (code < 0) { if (offlineSince == 0L) offlineSince = SystemClock.elapsedRealtime() } else offlineSince = 0 }
+        if (code < 0) { if (!keeps(r.what) && r.what != "poll") answer(ERROR, "No connection"); return false }
+        if (code != 200) {
+            val err = runCatching { JSONObject(text).optString("error") }.getOrDefault("")
+            answer(ERROR, if (err == "version") "Update the app to join this room" else err.ifEmpty { "The server said no" })
+            return true
+        }
+        if (r.what == "open") { answer(ROOMS, text); return true }
+        if (r.what == "create" || r.what == "join") {
+            val t = runCatching { JSONObject(text).optString("token") }.getOrDefault("")
+            if (t.isNotEmpty()) { synchronized(lock) { token = t; saveToken() }; return true }   // the room itself comes with the next poll, at once
+        }
+        // stamped with this device's clock around the trip, for the server's "now"
+        val stamped = if (text.startsWith("{") && !text.startsWith("{}")) "{\"sent\":$sent,\"got\":${System.currentTimeMillis()}," + text.substring(1) else text
+        answer(ROOM, stamped)
+        return true
+    }
+
+    private fun loop() {
+        var last = 0L
+        while (true) {
+            val r = synchronized(lock) { queue.removeFirstOrNull().also { busy = it != null } }
+            if (r != null) {
+                if (!request(r) && keeps(r.what)) { synchronized(lock) { queue.addFirst(r) }; busy = false; Thread.sleep(2000); continue }   // first in the queue again, a little later
+                busy = false; last = 0L; continue   // a poll right after, so the room shows the change
+            }
+            val now = SystemClock.elapsedRealtime()
+            var sentEvents = 0
+            var sentChats = 0
+            val body = synchronized(lock) {
+                if (token.isEmpty() || now - last < if (slow) 2000 else 1000) null
+                else {
+                    sentEvents = events.size; sentChats = chats.size
+                    JSONObject().put("token", token).put("since", since).put("progress", progress)
+                        .put("events", JSONArray(events.toList())).put("chat", JSONArray(chats.toList()))
+                }
+            }
+            if (body == null) { Thread.sleep(50); continue }
+            last = now
+            if (request(Req("poll", body, false))) synchronized(lock) {   // sent: off the lists, keeping what came in meanwhile
+                repeat(minOf(sentEvents, events.size)) { events.removeAt(0) }
+                repeat(minOf(sentChats, chats.size)) { chats.removeAt(0) }
+            }
+        }
+    }
+}
