+            modifier
+                .background(TAB, RoundedCornerShape(6.dp))
+                .border(1.dp, GOLD, RoundedCornerShape(6.dp))
+                .clickable(onClick = onClick)
+                .padding(horizontal = 12.dp, vertical = 6.dp),
+    )
+}
