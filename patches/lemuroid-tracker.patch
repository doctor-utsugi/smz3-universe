+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.view.View
+import org.json.JSONObject
+
+/**
+ * The race as a horse race: one lane per player, a runner at their progress (the Draft goal's %, or bosses and crystals in
+ * a Championship), the finish line at the right, the time once they are in, and the player's own lane in gold.
+ */
+class Smz3RaceTrack(context: Context) : View(context) {
+    private class Lane(val name: String, val mine: Boolean, val progress: Int, val place: Int, val time: String?, val left: Boolean)
+
+    private var lanes = emptyList<Lane>()
+    private var shown = -1
+    private val density = resources.displayMetrics.density
+    private val text = Paint(Paint.ANTI_ALIAS_FLAG).apply { textSize = 11f * density }
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val rect = RectF()
+
+    /** Reads [Smz3RaceState] again when it changed; true when there is a race to show. */
+    fun update(): Boolean {
+        val race = Smz3RaceState
+        val on = race.on && !race.daily && race.players.length() > 0
+        visibility = if (on) VISIBLE else GONE
+        if (!on || race.version == shown) return on
+        shown = race.version
+        lanes = (0 until race.players.length()).map { race.players.getJSONObject(it) }
+            .sortedWith(compareBy<JSONObject>({ if (it.optInt("place") > 0) it.optInt("place") else 99 }, { -it.optInt("progress") }))
+            .map {
+                val done = it.has("timeMs") && !it.isNull("timeMs")
+                Lane(it.optString("name"), it.optString("pid") == race.you, if (done) 100 else it.optInt("progress").coerceIn(0, 100),
+                    it.optInt("place"), if (done) Smz3RaceOverlay.clock(it.optLong("timeMs")).removePrefix("0:") else null, it.optBoolean("left"))
+            }
+        requestLayout()
+        invalidate()
+        return true
+    }
+
+    private fun laneHeight() = 20f * density
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val w = MeasureSpec.getSize(widthMeasureSpec)
+        setMeasuredDimension(w, (laneHeight() * maxOf(1, lanes.size) + 4 * density).toInt())
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val h = laneHeight()
+        val pad = 2 * density
+        val nameW = width * 0.34f
+        val track0 = nameW + 4 * density
+        val track1 = width - pad - 10 * density
+        lanes.forEachIndexed { i, l ->
+            val y = pad + i * h
+            val mid = y + h / 2
+            text.color = if (l.mine) GOLD else if (l.left) DIM else TEXT
+            text.textAlign = Paint.Align.LEFT
+            val label = (if (l.place > 0) "${l.place} " else "") + l.name
+            canvas.drawText(ellipsize(label, nameW - 2 * density), pad, mid + text.textSize / 3, text)
+            fill.color = LANE
+            rect.set(track0, mid - 3 * density, track1, mid + 3 * density)
+            canvas.drawRoundRect(rect, 3 * density, 3 * density, fill)
+            fill.color = FLAG
+            canvas.drawRect(track1, y + 2 * density, track1 + 2 * density, y + h - 2 * density, fill)
+            val x = track0 + (track1 - track0) * l.progress / 100f
+            fill.color = if (l.left) DIM else if (l.mine) GOLD else RIVAL
+            rect.set(track0, mid - 3 * density, x, mid + 3 * density)
+            canvas.drawRoundRect(rect, 3 * density, 3 * density, fill)
+            canvas.drawCircle(x, mid, 6 * density, fill)
+            val tag = l.time ?: if (l.left) "left" else "${l.progress}%"
+            text.color = if (l.time != null) GOLD else TEXT
+            text.textAlign = Paint.Align.RIGHT
+            val tw = text.measureText(tag)
+            val tx = if (x + 10 * density + tw < track1) x + 10 * density + tw else x - 10 * density
+            canvas.drawText(tag, tx, mid + text.textSize / 3, text)
+        }
+    }
+
+    private fun ellipsize(s: String, w: Float): String {
+        if (text.measureText(s) <= w) return s
+        var n = s.length
+        while (n > 1 && text.measureText(s.take(n) + "…") > w) n--
+        return s.take(n) + "…"
+    }
+
+    private companion object {
+        val GOLD = Color.rgb(0xF2, 0xA3, 0x3A)
+        val TEXT = Color.rgb(0xE8, 0xEC, 0xF2)
+        val DIM = Color.rgb(0x87, 0x93, 0xA6)
+        val RIVAL = Color.rgb(0x4F, 0x9D, 0xE0)
+        val LANE = Color.rgb(0x1D, 0x24, 0x30)
+        val FLAG = Color.WHITE
+    }
+}
