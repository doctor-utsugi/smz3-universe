+                val time = Leaderboard.format(e.timeMs)
+                paint.typeface = face
+                paint.textSize = 6.5f * u
+                val timeW = paint.measureText(time) / u
+                text(canvas, fit(e.name, w - 34f - timeW, 6.5f), l + 24f, y + 9.5f, 6.5f, if (i == 0) TEXT_HI else TEXT)
+                text(canvas, time, l + w - 8f, y + 9.5f, 6.5f, if (i == 0) ACCENT else TEXT, Paint.Align.RIGHT)
+            }
+        }
+
+        companion object {
+            const val ROWS = 12
+            val VERSION: String by lazy { runCatching { Smz3Native.version() }.getOrDefault("") }
+            val TABS = listOf("ORIGINAL", "MONTHLY", "WEEKLY", "CUSTOM")
+            val BG = Color.parseColor("#0A0E15")
+            val PANEL = Color.parseColor("#E6141B27")
+            val BORDER = Color.parseColor("#25324A")
+            val TEXT = Color.parseColor("#E8ECF2")
+            val TEXT_HI = Color.parseColor("#FFF4DC")
+            val DIM = Color.parseColor("#8793A6")
+            val ACCENT = Color.parseColor("#F2A33A")
+            val GREEN = Color.parseColor("#4CC38A")
+            val BLUE = Color.parseColor("#4FC3F7")
+            val MEDALS = listOf(Color.parseColor("#F2C14E"), Color.parseColor("#C7D0DE"), Color.parseColor("#C98A55"))
+        }
+    }
+}
+
+/** Keeps at most one idle presentation, shown while the run menu is in front. */
+internal object Smz3Idle {
+    private var presentation: Smz3IdlePresentation? = null
+
+    fun show(context: Context) {
+        val target = Smz3ScreenMode.secondDisplay(context)
+        if (target == null) { hide(); return }   // the screen mode was set to single in the game
+        presentation?.let { it.clearFade(); return }   // back from a game that never started
+        runCatching {
+            presentation = Smz3IdlePresentation(context, target).also { p -> p.setOnDismissListener { if (presentation === p) presentation = null }; p.show() }
+        }
+    }
+
+    fun hide() {
+        runCatching { presentation?.dismiss() }
+        presentation = null
+    }
+
+    fun fadeOut() = presentation?.fadeOut()
+
+    private var black: Presentation? = null
+
+    /** Keeps the display black from the game's start until its tracker shows, instead of a gap with no picture. */
+    fun showBlack(context: Context) {
+        if (black != null) return
+        val target = Smz3ScreenMode.secondDisplay(context) ?: return
+        runCatching {
+            black = Presentation(context, target).apply {
+                setCancelable(false)
+                val cover = View(context).apply { setBackgroundColor(Color.BLACK); alpha = 0f }
+                setContentView(cover)
+                window?.setBackgroundDrawable(android.graphics.drawable.ColorDrawable(Color.TRANSPARENT))   // fades in over the menu's screen
+                cover.animate().alpha(1f).setDuration(300).start()
+                window?.clearFlags(android.view.WindowManager.LayoutParams.FLAG_DIM_BEHIND)
+                show()
+            }
+        }
+    }
+
+    fun hideBlack() {
+        runCatching { black?.dismiss() }
+        black = null
+    }
+}
