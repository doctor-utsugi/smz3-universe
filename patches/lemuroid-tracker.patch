@@ -0,0 +1,22 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+/**
+ * Decides which Super Metroid room samples can be trusted. After the Zelda to Super Metroid portal the room pointer
+ * ($79B) keeps a stale value (the Kraid room) for a sample or two while the game is not in normal gameplay, so a
+ * sample counts only when the game state ($0998) is 8 and the same room was read in two consecutive samples.
+ */
+class Smz3RoomFilter {
+    private var candidate = -1
+    private var count = 0
+
+    /** True when [room], read while the game was in [gameState], can be accepted. */
+    fun accept(gameState: Int, room: Int): Boolean {
+        if (gameState != NORMAL_GAMEPLAY) { candidate = -1; count = 0; return false }
+        if (room == candidate) count++ else { candidate = room; count = 1 }
+        return count >= 2
+    }
+
+    companion object {
+        const val NORMAL_GAMEPLAY = 8
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3ScreenMode.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3ScreenMode.kt
new file mode 100644
index 0000000..9821178
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3ScreenMode.kt
@@ -0,0 +1,187 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.hardware.display.DisplayManager
+import android.os.Build
+import android.view.Display
+import kotlinx.coroutines.flow.MutableStateFlow
+
+/**
+ * Whether the tracker gets its own screen (dual, the AYN Thor) or shares the game's (single, any phone). Auto picks dual
+ * only for a second screen built into the device: an HDMI cable or a cast screen does not count.
+ */
+object Smz3ScreenMode {
+    enum class Mode(val title: String) { AUTO("Auto"), SINGLE("Single"), DUAL("Dual") }
+
+    private const val FILE = "smz3_screen"
+    private const val TYPE_INTERNAL = 1   // Display.TYPE_INTERNAL, hidden API
+
+    /** Single screen: the tracker is open over the game (landscape) or over the touch pad (portrait). */
+    val trackerOpen = MutableStateFlow(false)
+
+    /** Set by the game screen: this game shares one screen, and in which orientation. */
+    @Volatile var singleActive = false
+    @Volatile var landscape = false
+
+    fun toggleTracker() {
+        closeFocused.value = false
+        trackerOpen.value = !trackerOpen.value
+    }
+
+    /** The d-pad went past the end of the tracker's page onto its Close button: A closes it, up goes back. */
+    val closeFocused = MutableStateFlow(false)
+
+    private val held = HashSet<Int>()
+    private var r3Alone = false
+
+    /** The game lost focus (its menu opened): the releases of the keys held now go elsewhere. */
+    fun releaseKeys() {
+        held.clear()
+        r3Alone = false
+    }
+
+    /**
+     * Pad keys in single-screen mode: R3 pressed and released on its own opens and closes the tracker, and goes on to
+     * the rest so combos with it (L3 + R3 opens the menu) still work; while the tracker covers the game (landscape),
+     * L1 and R1 change tab, the d-pad moves through the page, A presses and B closes it. True when the key was used here.
+     */
+    fun onKey(event: android.view.KeyEvent): Boolean {
+        if (!singleActive) return false
+        val code = event.keyCode
+        val down = event.action == android.view.KeyEvent.ACTION_DOWN && event.repeatCount == 0
+        if (down) {
+            held.add(code)
+            r3Alone = if (code == android.view.KeyEvent.KEYCODE_BUTTON_THUMBR) held.size == 1 else false
+        } else if (event.action == android.view.KeyEvent.ACTION_UP) {
+            held.remove(code)
+        }
+        val overlay = trackerOpen.value && landscape
+        when (code) {
+            android.view.KeyEvent.KEYCODE_BUTTON_THUMBR -> {
+                if (event.action == android.view.KeyEvent.ACTION_UP && r3Alone) { r3Alone = false; toggleTracker() }
+                return false
+            }
+            android.view.KeyEvent.KEYCODE_BUTTON_L1 -> if (overlay) { if (down) Smz3Tracker.embedded?.step(-1) } else return false
+            android.view.KeyEvent.KEYCODE_BUTTON_R1 -> if (overlay) { if (down) Smz3Tracker.embedded?.step(1) } else return false
+            android.view.KeyEvent.KEYCODE_BUTTON_B -> if (overlay) { if (down) close() } else return false
+            android.view.KeyEvent.KEYCODE_DPAD_UP -> if (overlay && event.action == android.view.KeyEvent.ACTION_DOWN) padMove(0, -1) else return false
+            android.view.KeyEvent.KEYCODE_DPAD_DOWN -> if (overlay && event.action == android.view.KeyEvent.ACTION_DOWN) padMove(0, 1) else return false
+            android.view.KeyEvent.KEYCODE_DPAD_LEFT -> if (overlay && event.action == android.view.KeyEvent.ACTION_DOWN) padMove(-1, 0) else return false
+            android.view.KeyEvent.KEYCODE_DPAD_RIGHT -> if (overlay && event.action == android.view.KeyEvent.ACTION_DOWN) padMove(1, 0) else return false
+            android.view.KeyEvent.KEYCODE_BUTTON_A -> if (overlay && event.action == android.view.KeyEvent.ACTION_DOWN) { if (down) { if (closeFocused.value) close() else Smz3Tracker.embedded?.press() } } else return false   // releases reach the game
+            else -> return overlay && swallowed(event)
+        }
+        return true
+    }
+
+    private fun close() { closeFocused.value = false; trackerOpen.value = false }
+
+    private fun padMove(dx: Int, dy: Int) {
+        if (closeFocused.value) { if (dy < 0) closeFocused.value = false; return }
+        if (Smz3Tracker.embedded?.move(dx, dy) == false && dy > 0) closeFocused.value = true
+    }
+
+    private var hatX = 0
+    private var hatY = 0
+
+    /** A pad whose d-pad is a hat axis: over the open tracker its presses move through the page as the d-pad keys do. */
+    fun onMotion(event: android.view.MotionEvent): Boolean {
+        val x = Math.round(event.getAxisValue(android.view.MotionEvent.AXIS_HAT_X))
+        val y = Math.round(event.getAxisValue(android.view.MotionEvent.AXIS_HAT_Y))
+        val moved = x != hatX || y != hatY
+        if (moved && singleActive && trackerOpen.value && landscape) {
+            if (x != 0 && x != hatX) padMove(x, 0)
+            if (y != 0 && y != hatY) padMove(0, y)
+            hatX = x; hatY = y
+            return x != 0 || y != 0   // a hat back in the middle still reaches the game, so nothing stays held
+        }
+        hatX = x; hatY = y
+        return false
+    }
+
+    /** Under the open tracker the game gets no pad presses, but releases go through (none stays held) and so do the
+     * menu combo's buttons. */
+    private fun swallowed(event: android.view.KeyEvent): Boolean {
+        val code = event.keyCode
+        if (event.action == android.view.KeyEvent.ACTION_UP) return false
+        val pad = android.view.KeyEvent.isGamepadButton(code) || code == android.view.KeyEvent.KEYCODE_DPAD_UP ||
+            code == android.view.KeyEvent.KEYCODE_DPAD_DOWN || code == android.view.KeyEvent.KEYCODE_DPAD_LEFT ||
+            code == android.view.KeyEvent.KEYCODE_DPAD_RIGHT || code == android.view.KeyEvent.KEYCODE_DPAD_CENTER
+        if (!pad || code == android.view.KeyEvent.KEYCODE_BUTTON_THUMBL) return false
+        val menu = Smz3Shortcuts.padShortcuts.values.flatten().filter { it.type == com.swordfish.lemuroid.app.shared.settings.GameShortcutType.MENU }
+        return menu.none { code in it.keys }
+    }
+
+    private var heldView: com.swordfish.libretrodroid.GLRetroView? = null
+
+    /** Single screen, landscape: the game stands still under the open tracker, unless a race or the daily challenge is on
+     * (their clock runs for everyone, and the race keeps its own hold). */
+    fun syncHold() {
+        val want = singleActive && landscape && trackerOpen.value && !Smz3RaceState.on
+        if (!want) { heldView?.setHeld(false); heldView = null; return }
+        val view = Smz3Rewind.view
+        if (view == null || view === heldView) return
+        heldView?.setHeld(false)
+        heldView = view
+        view.setHeld(true)
+    }
+
+    /** Read from disk each time: the game's process changes it, the menu's reads it. */
+    @Suppress("DEPRECATION")
+    fun mode(context: Context): Mode =
+        runCatching { Mode.valueOf(context.getSharedPreferences(FILE, Context.MODE_MULTI_PROCESS).getString("mode", null) ?: "AUTO") }.getOrDefault(Mode.AUTO)
+
+    /** Written at once: the game's process may close right after. */
+    fun setMode(context: Context, mode: Mode) { prefs(context).edit().putString("mode", mode.name).commit() }
+
+    /** The display the tracker goes to, or null when it shares the game's screen. */
+    fun secondDisplay(context: Context): Display? {
+        val displays = (context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager)
+            .getDisplays(DisplayManager.DISPLAY_CATEGORY_PRESENTATION)
+        return when (mode(context)) {
+            Mode.SINGLE -> null
+            Mode.DUAL -> displays.firstOrNull()
+            Mode.AUTO -> displays.firstOrNull { builtIn(it) }
+        }
+    }
+
+    fun isSingle(context: Context) = secondDisplay(context) == null
+
+    /** The touch pad even with a controller connected (CONFIG tab, off by default); with no controller it shows anyway. */
+    val touchOn = kotlinx.coroutines.flow.MutableStateFlow<Boolean?>(null)
+
+    /** Single screen, landscape: the tracker panels beside the game, hidden by the SIDE_PANELS hotkey. */
+    val panelsOff = kotlinx.coroutines.flow.MutableStateFlow<Boolean?>(null)
+
+    fun panelsHidden(context: Context): Boolean =
+        panelsOff.value ?: prefs(context).getBoolean("panels_hidden", false).also { panelsOff.value = it }
+
+    fun setPanelsHidden(context: Context, hidden: Boolean) {
+        prefs(context).edit().putBoolean("panels_hidden", hidden).apply()
+        panelsOff.value = hidden
+    }
+
+    fun forceTouch(context: Context): Boolean =
+        touchOn.value ?: prefs(context).getBoolean("force_touch", false).also { touchOn.value = it }
+
+    fun setForceTouch(context: Context, on: Boolean) {
+        prefs(context).edit().putBoolean("force_touch", on).apply()
+        touchOn.value = on
+    }
+
+    /** What Auto resolves to on this device, for the config tab. */
+    fun autoTitle(context: Context): String {
+        val displays = (context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager)
+            .getDisplays(DisplayManager.DISPLAY_CATEGORY_PRESENTATION)
+        return if (displays.any { builtIn(it) }) "Auto (dual)" else "Auto (single)"
+    }
+
+    /** The Thor counts whatever type its bottom panel reports; elsewhere the hidden display type, when readable, decides. */
+    private fun builtIn(display: Display): Boolean {
+        if (Build.MANUFACTURER.contains("AYN", ignoreCase = true) || Build.MODEL.contains("Thor", ignoreCase = true)) return true
+        val type = runCatching { Display::class.java.getMethod("getType").invoke(display) as Int }.getOrNull()
+        return type == TYPE_INTERNAL
+    }
+
+    private fun prefs(context: Context) = context.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Shortcuts.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Shortcuts.kt
new file mode 100644
