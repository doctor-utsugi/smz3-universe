+    private fun buildItemsPage(): View {
+        // one grid for both games (A Link to the Past first); the square cell size comes from the space the page really gets
+        val columns = 9
+        val grid = object : ViewGroup(context) {
+            override fun onMeasure(widthSpec: Int, heightSpec: Int) {
+                val w = MeasureSpec.getSize(widthSpec)
+                val h = MeasureSpec.getSize(heightSpec)
+                val rows = (childCount + columns - 1) / columns
+                val iw = w - paddingLeft - paddingRight
+                val ih = h - paddingTop - paddingBottom
+                val cell = minOf(iw / columns, if (rows > 0) ih / rows else iw)
+                val spec = MeasureSpec.makeMeasureSpec(cell, MeasureSpec.EXACTLY)
+                for (i in 0 until childCount) getChildAt(i).measure(spec, spec)
+                setMeasuredDimension(w, h)
+            }
+            override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+                val rows = (childCount + columns - 1) / columns
+                val iw = r - l - paddingLeft - paddingRight
+                val ih = b - t - paddingTop - paddingBottom
+                val cell = minOf(iw / columns, if (rows > 0) ih / rows else iw)
+                val left = paddingLeft + (iw - cell * columns) / 2
+                for (i in 0 until childCount) {
+                    val x = left + (i % columns) * cell
+                    val y = paddingTop + (i / columns) * cell
+                    getChildAt(i).layout(x, y, x + cell, y + cell)
+                }
+            }
+        }
+        for (gameId in listOf(1, 2)) {
+            for (i in 0 until Smz3Native.inventoryCount()) {
+                val info = Smz3Native.inventoryInfo(i).split("|")
+                if (info[0].toInt() != gameId || !Smz3Tracker.gameShown(gameId)) continue
+                val cell = FrameLayout(context).apply { setPadding(dp(3), dp(3), dp(3), dp(3)) }
+                val icon = ImageView(context).apply {
+                    scaleType = ImageView.ScaleType.FIT_CENTER
+                    runCatching {
+                        context.assets.open("smz3/items/" + info[2].replace(" ", "_")).use { stream ->
+                            val bitmap = BitmapFactory.decodeStream(stream)
+                            setImageDrawable(BitmapDrawable(context.resources, bitmap).apply { isFilterBitmap = false })
+                        }
+                    }
+                    alpha = 0.2f
+                }
+                val count = label(13f, Role.TEXT).apply {
+                    setShadowLayer(3f, 0f, 0f, Color.BLACK)
+                    gravity = Gravity.END or Gravity.BOTTOM
+                    setPadding(0, 0, dp(3), 0)
+                }
+                cell.addView(icon, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+                cell.addView(count, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+                grid.addView(cell)
+                cells += ItemCell(i, icon, count)
+            }
+        }
+        grid.setPadding(dp(12), dp(4), dp(12), dp(4))
+        return grid
+    }
