+    /** Options > Update: the new release's APK is downloaded, then handed to the system installer. */
+    fun update() {
+        val tag = AppUpdate.tag()
+        Smz3Native.uiBusy("Downloading $tag ...")
+        version++
+        scope.launch {
+            val percent = java.util.concurrent.atomic.AtomicInteger(0)
+            val job = async(Dispatchers.IO) { runCatching { AppUpdate.download(context) { percent.set(it) } } }
+            while (!job.isCompleted) {
+                kotlinx.coroutines.delay(250)
+                Smz3Native.uiBusy("Downloading $tag ${percent.get()}%")
+                version++
+            }
