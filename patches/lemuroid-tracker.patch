+    /** Moves [delta] tabs to the right (left when negative), wrapping around. */
+    fun step(delta: Int) {
+        if (pages.isEmpty()) return
+        var next = selectedTab
+        do next = (next + delta + pages.size) % pages.size while (tabs[next].visibility != View.VISIBLE && next != selectedTab)   // hidden tabs are skipped
