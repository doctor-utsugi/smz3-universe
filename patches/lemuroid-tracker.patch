@@ -0,0 +1,49 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.drawable.BitmapDrawable
+import android.text.SpannableString
+import android.text.Spanned
+import android.text.style.ImageSpan
+import java.io.File
+
+/**
+ * A boss goal ("Defeat Arrghus") as the game shows it: the boss's name, its goal icon and where it waits. The icon is the
+ * app's own (assets smz3/goals/<sprite>.png) or else the one cut from the player's ROM (goals/<sprite>.pv: u8 width, u8
+ * height, RGBA), as the menu loads its "goal/" previews; decoded once and kept.
+ */
+internal object Smz3GoalIcon {
+    class Boss(val name: String, val sprite: String, val place: String)
+
+    private val bosses = HashMap<String, Boss?>()
+    private val icons = HashMap<String, Bitmap?>()
+
+    /** The boss [goal] defeats, null for the other goals. */
+    fun boss(goal: String): Boss? = synchronized(bosses) {
+        bosses.getOrPut(goal) { runCatching { Smz3Native.goalBoss(goal) }.getOrNull()?.let { Boss(it[0], it[1], it[2]) } }
+    }
+
+    fun icon(context: Context, sprite: String): Bitmap? = if (sprite.isEmpty()) null else synchronized(icons) { icons.getOrPut(sprite) { load(context, sprite) } }
+
+    private fun load(context: Context, sprite: String): Bitmap? {
+        runCatching { context.assets.open("smz3/goals/$sprite.png").use { BitmapFactory.decodeStream(it) } }.getOrNull()?.let { return cropToArt(it) }
+        return runCatching {
+            val b = File(File(context.filesDir, "goals"), "$sprite.pv").readBytes()
+            val w = b[0].toInt() and 255; val h = b[1].toInt() and 255
+            val px = IntArray(w * h) { i ->
+                val o = 2 + i * 4
+                ((b[o + 3].toInt() and 255) shl 24) or ((b[o].toInt() and 255) shl 16) or ((b[o + 1].toInt() and 255) shl 8) or (b[o + 2].toInt() and 255)
+            }
+            cropToArt(Bitmap.createBitmap(px, w, h, Bitmap.Config.ARGB_8888))
+        }.getOrNull()
+    }
+
+    /** [goal] with its boss's icon after it, [height] px tall, for a TextView; the plain text for other goals. */
+    fun withIcon(context: Context, goal: String, height: Int): CharSequence {
+        val bmp = boss(goal)?.let { icon(context, it.sprite) } ?: return goal
+        val d = BitmapDrawable(context.resources, bmp).apply { setBounds(0, 0, maxOf(1, bmp.width * height / bmp.height), height); paint.isFilterBitmap = false }
+        return SpannableString("$goal  ").apply { setSpan(ImageSpan(d, ImageSpan.ALIGN_BOTTOM), length - 1, length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE) }
+    }
+}
