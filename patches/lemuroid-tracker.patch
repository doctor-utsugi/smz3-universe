+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import org.json.JSONObject
+import java.io.File
+import java.util.Random
+
+/**
+ * Custom music through MSU-1. A music package is a folder of PCM tracks under [ROOT]: files named `<anything>-N.pcm` replace
+ * track N of the game, any other `.pcm` files form a pool whose tracks are dealt out at random (the bank that
+ * `tools/music-bank.py` renders is such a pool). The run's ROM gets a `.msu` marker and `-N.pcm` links to the chosen files;
+ * a slot without a link keeps the game's own music.
+ */
+object Smz3Music {
+    const val ROOT = "/sdcard/SMZ3/music"
+
+    /** MSU-1 track numbers of the looping tracks SMZ3 uses: A Link to the Past 1-32 and Super Metroid 100+. */
+    private val SLOTS = intArrayOf(
+        2, 4, 5, 7, 9, 11, 12, 13, 14, 15, 16, 17, 18, 20, 21, 22, 23, 24, 26, 27, 28, 30, 31, 32,
+        103, 104, 105, 106, 108, 109, 110, 111, 112, 113, 114, 115, 116, 117, 118, 119, 120, 121, 122, 123, 124, 126, 127,
+    )
+    private val numbered = Regex(""".*-(\d+)\.pcm""", RegexOption.IGNORE_CASE)
+
+    private fun pcms(dir: File) = dir.listFiles { f -> f.isFile && f.name.endsWith(".pcm", true) }?.sortedBy { it.name }.orEmpty()
+
+    /** Names of the folders under [ROOT] that hold tracks, for the "Music package" picker. */
+    fun packages(): Array<String> =
+        File(ROOT).listFiles { f -> f.isDirectory && f.name.length <= 31 && '"' !in f.name && '\\' !in f.name && pcms(f).isNotEmpty() }
+            ?.map { it.name }?.sorted()?.toTypedArray() ?: emptyArray()
+
+    /** The package named by a run's settings: "" (the game's music), "*" (every package) or a folder name. */
+    fun packageOf(settings: String): String = runCatching { JSONObject(settings).optString("musicPackage") }.getOrDefault("")
+
+    /** Links the tracks for a run (or removes the links when the run keeps the original music); returns how many tracks were linked. */
+    fun prepare(rom: File, settings: String, seed: String): Int {
+        val base = rom.path.removeSuffix(".sfc")
+        clear(base)
+        val pkg = packageOf(settings)
+        if (pkg.isEmpty()) return 0
+        val files = if (pkg == "*") File(ROOT).listFiles { f -> f.isDirectory }.orEmpty().flatMap { pcms(it) } + pcms(File(ROOT)) else pcms(File(ROOT, pkg))
+        if (files.isEmpty()) return 0
+        File("$base.msu").writeBytes(ByteArray(0))
+        val fixed = files.mapNotNull { f -> numbered.matchEntire(f.name)?.let { it.groupValues[1].toInt() to f } }.toMap()
+        if (pkg != "*" && fixed.isNotEmpty()) {
+            fixed.forEach { (n, f) -> link(base, n, f) }
+            return fixed.size
+        }
+        val order = files.toMutableList().also { it.shuffle(Random(seed.hashCode().toLong() * 31 + 7)) }
+        SLOTS.forEachIndexed { i, slot -> link(base, slot, order[i % order.size]) }
+        return SLOTS.size
+    }
+
+    private fun link(base: String, track: Int, file: File) {
+        runCatching { android.system.Os.symlink(file.path, "$base-$track.pcm") }
+    }
+
+    private fun clear(base: String) {
+        val dir = File(base).parentFile ?: return
+        val name = File(base).name
+        dir.listFiles { f -> f.name == "$name.msu" || (f.name.startsWith("$name-") && f.name.endsWith(".pcm")) }?.forEach { it.delete() }
+    }
+}
