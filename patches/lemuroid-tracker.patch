+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+
+/** One attempt at a daily challenge, its times in the device clock (ms since 1970). */
+data class DailyAttempt(
+    val window: String,
+    val token: String,
+    val goal: String,
+    val check: String,
+    val startedAt: Long,
+    val closesAt: Long,
+    val nextHintAt: Long,
+    val hints: List<Pair<Long, String>>,
+    /** When the game itself started (the file loaded), as the ladder times its runs; 0 until then. */
+    val beganAt: Long = 0,
+) {
+    /** Where the own clock counts from: the game's start, or Start on the menu while the game has not begun. */
+    val clockFrom: Long get() = maxOf(beganAt, startedAt)
+}
+
+/**
+ * The daily timed challenge (docs/DAILY.md): three windows a day, one attempt each, the real clock from the game's start, hints
+ * released by the server. The attempt's run lives in its own slot ([SLOT], never listed with the others); the attempt
+ * itself in runs/daily.json. Server times are moved to the device clock with the answers' "now". Each online game has its own
+ * challenge: a game other than SMZ3 keeps it in its runs folder (runs/<game>/) and its requests carry the game's id.
+ */
+object DailyChallenge {
+    const val SLOT = RunStore.SLOTS
+
+    private fun dir(context: Context, game: String = RunStore.mode) = RunStore.runsDir(context, game)
+    private fun attemptFile(context: Context, game: String = RunStore.mode) = File(dir(context, game), "daily.json")
+    private fun finishFile(context: Context, game: String = RunStore.mode) = File(dir(context, game), "daily.finish")
+    private fun resultFile(context: Context) = File(dir(context), "daily.result")
+    fun proofFile(context: Context, game: String = RunStore.mode) = File(dir(context, game), "slot$SLOT.proof")
+
+    private fun base(): String = OnlineLadder.server()
+
+    private fun installId(context: Context): String = OnlineLadder.installIdFor(context)
+
+    private fun request(method: String, path: String, body: JSONObject? = null): Pair<Int, String> = runCatching {
+        val c = URL(base() + path).openConnection() as HttpURLConnection
+        c.requestMethod = method
+        c.connectTimeout = 8000
+        c.readTimeout = 8000
+        if (body != null) {
+            c.doOutput = true
+            c.setRequestProperty("Content-Type", "application/json")
+            c.outputStream.use { it.write(body.toString().toByteArray()) }
+        }
+        val text = runCatching { (if (c.responseCode < 400) c.inputStream else c.errorStream).bufferedReader().use { it.readText() } }.getOrDefault("")
+        Pair(c.responseCode, text).also { c.disconnect() }
+    }.getOrDefault(Pair(-1, ""))
+
+    /** The /api/daily answer for this install and the game shown, null offline. Call off the main thread. */
+    fun info(context: Context): String? = request("GET", "/api/daily?install=" + installId(context) + RunStore.gameQuery()).let { (code, text) -> if (code == 200) text else null }
+
+    fun attempt(context: Context, game: String = RunStore.mode): DailyAttempt? = runCatching {
+        val j = JSONObject(attemptFile(context, game).readText())
+        val h = j.getJSONArray("hints")
+        DailyAttempt(j.getString("window"), j.getString("token"), j.getString("goal"), j.getString("check"), j.getLong("startedAt"), j.getLong("closesAt"),
+            j.optLong("nextHintAt"), List(h.length()) { h.getJSONArray(it).let { p -> p.getLong(0) to p.getString(1) } }, j.optLong("beganAt"))
+    }.getOrNull()
+
+    private fun save(context: Context, a: DailyAttempt) {
+        val h = JSONArray(a.hints.map { JSONArray().put(it.first).put(it.second) })
+        runCatching {
+            attemptFile(context).writeText(JSONObject().put("window", a.window).put("token", a.token).put("goal", a.goal).put("check", a.check)
+                .put("startedAt", a.startedAt).put("closesAt", a.closesAt).put("nextHintAt", a.nextHintAt).put("hints", h).put("beganAt", a.beganAt).toString())
+        }
+    }
+
+    /** True when the daily slot holds the run of [window]. */
+    fun kept(context: Context, window: String): Boolean = window.isNotEmpty() && attempt(context)?.window == window && RunStore.load(context, SLOT) != null
+
+    private fun hintsOf(j: JSONObject, shift: Long): Pair<List<Pair<Long, String>>, Long> {
+        val a = j.optJSONArray("hints") ?: JSONArray()
+        val next = if (j.isNull("nextHintAt")) 0L else j.optLong("nextHintAt").let { if (it > 0) it + shift else 0L }
+        return List(a.length()) { a.getJSONObject(it).let { h -> h.getLong("at") + shift to h.getString("text") } } to next
+    }
+
+    /** Starts (or resumes on the server) the attempt of [window]: the server's run settings, or the reason it failed. Call off the main thread. */
+    fun start(context: Context, window: String): Result<Pair<DailyAttempt, String>> {
+        val body = JSONObject().put("install", installId(context)).put("window", window)
+        if (RunStore.mode != "smz3") body.put("game", RunStore.mode)   // SMZ3 sends none
+        val (code, text) = request("POST", "/api/daily/start", body)
+        if (code < 0) return Result.failure(Exception("No connection to the challenge server"))
+        val j = runCatching { JSONObject(text) }.getOrNull() ?: return Result.failure(Exception("Cannot start the challenge ($code)"))
+        if (code != 200) return Result.failure(Exception("Cannot start: " + j.optString("error", code.toString())))
+        val shift = System.currentTimeMillis() - j.optLong("now", System.currentTimeMillis())
+        val settings = j.optString("settings")
+        val check = Regex("\"goal\":\"([^\"]+)\"").find(settings)?.groupValues?.get(1) ?: return Result.failure(Exception("The challenge has no goal"))
+        val (hints, next) = hintsOf(j, shift)
+        playersOf(j)
+        val a = DailyAttempt(j.getString("window"), j.getString("token"), j.optJSONObject("goal")?.optString("text").orEmpty(), check,
+            j.getLong("startedAt") + shift, j.getLong("closesAt") + shift, next, hints)
+        return Result.success(a to settings)
+    }
+
+    /** Keeps the attempt beside the new run and forgets what the slot had before. */
+    fun begin(context: Context, a: DailyAttempt) {
+        finishFile(context).delete(); resultFile(context).delete(); proofFile(context).delete()
+        save(context, a)
+    }
+
+    /** Who is on the current attempt's window (now, started, finished) as the server last said; null until it has. */
+    @Volatile var players: IntArray? = null
+
+    private fun playersOf(j: JSONObject) {
+        j.optJSONObject("players")?.let { p -> players = intArrayOf(p.optInt("now"), p.optInt("started"), p.optInt("done")) }
+    }
+
+    /** Asks for the hints released by now (and so says this device is playing); the updated attempt, or null offline. Call off the main thread. */
+    fun hints(context: Context, a: DailyAttempt): DailyAttempt? {
+        val (code, text) = request("GET", "/api/daily/hints?token=" + a.token)
+        if (code != 200) return null
+        val j = runCatching { JSONObject(text) }.getOrNull() ?: return null
+        val (hints, next) = hintsOf(j, System.currentTimeMillis() - j.optLong("now", System.currentTimeMillis()))
+        playersOf(j)
+        val began = maxOf(a.beganAt, attempt(context)?.beganAt ?: 0L)   // the game may have started while the hints were on their way
+        return a.copy(hints = hints, nextHintAt = next, beganAt = began).also { save(context, it) }
+    }
+
+    /** The window's chat lines newer than [since] (GET /api/daily/chat, which also counts this device as playing now), its
+     * player counts kept in [players]; null offline. Call off the main thread. */
+    fun chat(a: DailyAttempt, since: Long): JSONObject? {
+        val (code, text) = request("GET", "/api/daily/chat?token=" + a.token + "&since=" + since)
+        if (code != 200) return null
+        return runCatching { JSONObject(text) }.getOrNull()?.also { playersOf(it) }
+    }
+
+    /** Says [text] in the window's chat, with the name and country the finish sends: the HTTP code (409 once the window has
+     * closed, 429 when too fast, -1 offline). Call off the main thread. */
+    fun say(context: Context, a: DailyAttempt, text: String): Int {
+        val (name, country) = OnlineLadder.profileFor(context)
+        val body = JSONObject().put("token", a.token).put("player", name).put("text", text)
+        if (country.length == 2) body.put("country", country)
+        return request("POST", "/api/daily/chat", body).first
+    }
+
+    /**
+     * The game has started (the tracker sees a file in play): the own clock starts here, once. A start more than 10 minutes
+     * after Start (an attempt resumed on a new install) keeps Start, so losing the files never resets the clock.
+     */
+    @Synchronized
+    fun noteBegan(context: Context) {
+        val a = attempt(context)?.takeIf { it.beganAt == 0L } ?: return
+        val now = System.currentTimeMillis()
+        save(context, a.copy(beganAt = if (now > a.startedAt && now - a.startedAt <= 10 * 60_000) now else a.startedAt))
+    }
+
+    /** Remembers the attempt's real time at the goal; [flush] sends it with the slot's proof. */
+    @Synchronized
+    fun queueFinish(context: Context, timeMs: Long) {
+        resultFile(context).delete()
+        runCatching { finishFile(context).writeText(timeMs.toString()) }
+    }
+
+    /** What the server answered to the finish, a line for the player; null while nothing came back. */
+    fun result(context: Context): String? = runCatching { resultFile(context).readText() }.getOrNull()
+
+    /** Sends the finishes waiting, of every online game. Call off the main thread. */
+    @Synchronized
+    fun flush(context: Context) {
+        for (game in RunStore.ONLINE_GAMES) flush(context, game)
+    }
+
+    private fun flush(context: Context, game: String) {
+        val time = runCatching { finishFile(context, game).readText().trim().toLong() }.getOrNull() ?: return
+        val a = attempt(context, game) ?: return
+        val (name, country) = OnlineLadder.profileFor(context)
+        val body = JSONObject().put("token", a.token).put("timeMs", time).put("player", name)
+        if (country.length == 2) body.put("country", country)
+        body.put("proof", runCatching { proofFile(context, game).readText() }.getOrDefault(""))
+        val (code, text) = request("POST", "/api/daily/finish", body)
+        if (code != 200 && code != 400) return   // no answer: sent again later
+        val j = runCatching { JSONObject(text) }.getOrDefault(JSONObject())
+        val line = when {
+            code == 400 -> "Not counted: " + j.optString("error", "refused")
+            j.optBoolean("held") -> "Held for a check before it counts"
+            j.optBoolean("late") -> "After the window closed: on the late list, no prize"
+            else -> "Rank ${j.optInt("rank").takeIf { it > 0 } ?: "?"} for now  -  +${j.optInt("tokens")} rupeergies (${j.optInt("balance")})"
+        }
+        runCatching { File(dir(context, game), "daily.result").writeText(line) }
+        finishFile(context, game).delete()
+    }
+
+    /** What the challenge shows over the game, each one can be hidden: 0 window clock, 1 own time, 2 goal and new hints, 3 next hint in. */
+    val SHOW_TITLES = listOf("Window clock", "Own time", "Goal and hints", "Next hint in")
+    private fun prefs(context: Context) = context.getSharedPreferences("smz3_daily", Context.MODE_PRIVATE)
+    fun shown(context: Context, what: Int) = (prefs(context).getInt("hide", 0) shr what and 1) == 0
+    fun toggle(context: Context, what: Int) = prefs(context).edit().putInt("hide", prefs(context).getInt("hide", 0) xor (1 shl what)).apply()
+
+    /** "2h 05m", "12m 30s", "45s". */
+    fun span(ms: Long): String {
+        val s = if (ms > 0) (ms + 999) / 1000 else 0
+        return if (s >= 3600) "%dh %02dm".format(s / 3600, s / 60 % 60) else if (s >= 60) "%dm %02ds".format(s / 60, s % 60) else "${s}s"
+    }
+
+    fun clock(ms: Long): String { val s = ms.coerceAtLeast(0) / 1000; return "%d:%02d:%02d".format(s / 3600, s / 60 % 60, s % 60) }
+}
