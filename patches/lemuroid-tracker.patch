+    /** The game closes: out before the finish, the rivals hear it; otherwise the room is just forgotten. Not [closing]: the
+     * activity is only being made again (a turn of the screen), the race goes on. */
+    fun stop(closing: Boolean) {
+        main.removeCallbacks(tick)
+        hold?.dismiss(); card?.dismiss(); box?.dismiss(); leaveBox?.dismiss(); askBox?.dismiss(); pausedBox?.dismiss()
+        if (!on || !closing) return
+        on = false
+        Smz3RaceState.on = false
+        setHeld(false)
+        // back from a pause and gone again counts as abandoning; a game paused here only closes
+        val leaving = (state == "running" && myTime() < 0 && !kept) || (state == "paused" && back)
+        if (leaving) RaceClient.forgetPaused(activity)
+        // the game's process closes right after: what is queued (a finish, the ladder) and the leave go out before
+        Thread { RaceClient.drain(1500); RaceClient.now(if (leaving) "leave" else "forget") }.apply { start(); join(3000) }
+    }
