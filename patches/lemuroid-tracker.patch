+    fun pollActions() {
+        for (m in pendingWeekly.indices) {
+            val game = when (m) { SMZ_MODE_SM -> "sm"; SMZ_MODE_Z3 -> "z3"; else -> "smz3" }
+            pendingWeekly[m].getAndSet(null)?.let { (label, seed) -> Smz3Native.uiSetWeekly(m, label, seed, daysLeftInWeek()); Smz3Native.uiSetPlaying(m, 1, OnlineLadder.playing(game, true)); version++ }
+            pendingMonthly[m].getAndSet(null)?.let { (label, seed) -> Smz3Native.uiSetMonthly(m, label, seed, daysLeftInMonth()); Smz3Native.uiSetPlaying(m, 0, OnlineLadder.playing(game, false)); version++ }
+        }
+        Smz3Native.uiSavedChanged()?.let { runCatching { savedCustoms.writeText(it) } }
+        Smz3Native.uiMemoryText().let { m ->   // the game and slots picked last, for the next start
+            val prefs = context.getSharedPreferences("smz3_menu", Context.MODE_PRIVATE)
+            if (prefs.getString("memory", null) != m) prefs.edit().putString("memory", m).apply()
+        }
+        Smz3Native.uiPlayerChanged()?.let { OnlineLadder.saveProfile(context, it) }
+        val (act, slot) = Smz3Native.uiAction().let { Act.values()[it[0]] to it[1] }
+        when (act) {
+            Act.CONTINUE -> synced(slot) { continueRun(slot) }
+            Act.CLOUD -> when (slot) {
+                CloudSync.KEEP_HERE, CloudSync.KEEP_CLOUD -> Smz3Native.uiCloudInfo()[0].toIntOrNull()?.let { s ->
+                    synced(s, forcePull = slot == CloudSync.KEEP_CLOUD, forcePush = slot == CloudSync.KEEP_HERE) { continueRun(s) }
+                }
+                else -> Smz3Native.uiCloudInfo().let { CloudSync.action(context, slot, it[1], it[2]) }
+            }
+            Act.LOAD_SAVE -> RunStore.load(context, slot)?.let { play(it, false) }
+            Act.LOAD_STATE -> RunStore.load(context, slot)?.let { play(it, true) }
+            Act.DELETE -> { CloudSync.deleted(context, slot); RunStore.delete(context, slot); refreshSlots() }
+            Act.GENERATE -> generate(slot)
+            Act.ROMS -> askRoms { uris ->   // the ROMs screen: its cards follow checkSmRom
+                if (uris.isEmpty()) return@askRoms
+                val message = RunGenerator.importRoms(context, uris)
+                checkSmRom()
+                cutRomArt()
+                Smz3Native.uiRomsNote(
+                    when {
+                        message.startsWith("Both") || message.startsWith("Only") -> ""
+                        message.startsWith("Those") -> "Not Super Metroid or ALttP files"
+                        else -> message.take(39)
+                    },
+                )
+                version++
+            }
+            Act.LADDER -> {
+                Thread {
+                    val game = RunStore.mode
+                    val preset = Smz3Native.uiLadderPreset()
+                    val tables = Array(3) { OnlineLadder.ladderJson(it, game, preset) }
+                    if (game == RunStore.mode) pendingLadder.set(tables)   // another game's tables are dropped
+                }.start()
+                askGoals()
+            }
+            Act.DAILY -> startDaily()
+            Act.OPTIONS -> when (slot) {
+                UI_OPT_QUIT -> (context as? android.app.Activity)?.finish()
+                UI_OPT_SOUND -> Smz3MenuMusic.setEnabled(context, !Smz3MenuMusic.enabled(context))
+                UI_OPT_SEED -> com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3SeedCode.let { it.set(context, !it.shown(context)) }
+                UI_OPT_BUTTONS -> context.startActivity(android.content.Intent(context, com.swordfish.lemuroid.app.mobile.feature.input.Smz3ControlsActivity::class.java))
+            }
+            Act.RACE_CREATE, Act.RACE_JOIN -> {
+                val info = Smz3Native.uiRaceInfo()
+                val f = RaceClient.who(context)
+                if (act == Act.RACE_CREATE) f.put("format", info[0]).put("size", info[1].toInt()).put("public", info[2] == "1") else f.put("code", info[3])
+                RaceClient.forget()
+                RaceClient.send(if (act == Act.RACE_CREATE) "create" else "join", f, false)
+            }
+            Act.RACE_FIND -> RaceClient.find()
+            Act.RACE_CLOSE -> RaceClient.send("close", null, true)
+            Act.RACE_KICK -> Smz3Native.uiRacePid(slot).takeIf { it.isNotEmpty() }?.let { RaceClient.send("kick", JSONObject().put("pid", it), true) }
+            Act.RACE_LEAVE -> RaceClient.send("leave", null, true)
+            Act.RACE_READY -> buildRace()
+            Act.UPDATE -> update()
+            Act.RACE_START -> if (lifecycle.currentState.isAtLeast(androidx.lifecycle.Lifecycle.State.RESUMED)) startRace() else raceStartLater.set(true)
+            Act.RACE_RESUME -> {   // the paused race: its game loads the state kept and tells the server
+                val p = RaceClient.paused(context)
+                val run = RunStore.load(context, RaceClient.SLOT)
+                if (p == null || run == null) Smz3Native.uiRaceSetPaused("", 0L)
+                else {
+                    RaceClient.resumePaused(context, p)
+                    RaceClient.handOver()
+                    play(run, false)
+                    Smz3Native.uiRaceEnd()
+                }
+            }
+            Act.NONE -> {}
+        }
+    }
