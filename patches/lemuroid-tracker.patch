+    /** The shortcuts asked for since the last read; one that cannot act now (not owned, not in normal play) is dropped. */
+    private fun applyShortcuts(view: GLRetroView) {
+        while (true) {
+            val id = Smz3Shortcuts.poll() ?: return
+            val wram = view.readMemory(GLRetroView.MEMORY_SYSTEM_RAM, 0, WRAM_SIZE)
+            val sram = view.readMemory(GLRetroView.MEMORY_SAVE_RAM, 0, SRAM_SIZE)
+            val pokes = Smz3Native.shortcutPokes(id, wram, sram)
+            for (i in pokes.indices step 2) view.writeMemory(GLRetroView.MEMORY_SYSTEM_RAM, pokes[i], byteArrayOf(pokes[i + 1].toByte()))
