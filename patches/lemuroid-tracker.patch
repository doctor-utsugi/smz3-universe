+    /** Like [slotKind] but online or not: 2 for a monthly seed run, 3 for a weekly run, 0 otherwise. Runs made before the mode was kept fall back to their ladder kind. */
+    fun runMode(context: Context, slot: Int): Int = when (runCatching { modeFile(context, slot).readText().trim() }.getOrNull()) {
