+            if (nb != 0 || nc != 0) {
+                val names = if (Smz3Tracker.z3Alone) arrayOf("got the Green Pendant", "got the Blue Pendant", "got the Red Pendant", "")   // its boss mask holds the pendants
+                    else arrayOf("beat Kraid", "beat Phantoon", "beat Draygon", "beat Ridley")
