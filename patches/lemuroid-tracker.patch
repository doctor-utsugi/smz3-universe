+    fun press(button: Int) { Smz3Finish.cue(Smz3Native.uiInput(button)); pollActions(); version++; publishSelection() }
+    // the race server's answers, for the race screens (the start comes back as an action)
+    LaunchedEffect(Unit) {
+        while (true) {
+            kotlinx.coroutines.delay(100)
+            var any = false
+            while (true) {
+                val (kind, text) = RaceClient.take() ?: break
+                any = true
+                when (kind) {
+                    RaceClient.ROOMS -> Smz3Native.uiRaceRooms(text)
+                    RaceClient.ERROR -> Smz3Native.uiRaceFail(text)
+                    else -> Smz3Native.uiRaceUpdate(text, System.currentTimeMillis())
+                }
+            }
+            if (any) { RaceClient.setSince(Smz3Native.uiRaceInfo()[5].toLongOrNull() ?: 0L); pollActions(); version++ }
+        }
+    }
