+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunStore
+import org.json.JSONObject
+
+/** What the secondary screen says about the run highlighted in the menu: its rules and the options that differ from the defaults. */
+class RunInfo(
+    val slot: Int, val name: String, val isDefault: Boolean, val diff: List<String>, val music: String,
+    val playTimeMs: Long = 0, val zelda: Pair<Int, Int> = 0 to 0, val metroid: Pair<Int, Int> = 0 to 0, val logic: String = "", val finished: Boolean = false,
+)
+
+object Smz3MenuSelection {
+    var info: RunInfo? = null
+        private set
+    var onChange: (() -> Unit)? = null
+
+    fun select(context: Context, slot: Int?) {
+        val next = slot?.let { load(context, it) }
+        if (next?.slot == info?.slot && next?.name == info?.name && next?.diff == info?.diff && next?.playTimeMs == info?.playTimeMs) return
+        info = next
+        onChange?.invoke()
+    }
+
+    private fun load(context: Context, slot: Int): RunInfo? {
+        val run = RunStore.load(context, slot) ?: return null
+        val s = runCatching { JSONObject(run.settings) }.getOrNull() ?: JSONObject()
+        val diff = s.optJSONArray("diff")?.let { a -> List(a.length()) { a.getString(it) } } ?: emptyList()
+        val music = s.optString("musicPackage").let { if (it.isEmpty()) "Original" else if (it == "*") "Random" else it }
+        return RunInfo(slot, run.name, s.optBoolean("defaultRules", true), diff, music, run.playTimeMs, run.zeldaCleared to run.zeldaTotal,
+            run.metroidCleared to run.metroidTotal, run.logic + if (run.keysanity) " · Keysanity" else "", run.completedAt > 0)
+    }
+}
