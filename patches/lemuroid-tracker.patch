+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Native
+import java.io.File
+import java.util.zip.ZipInputStream
+
+/** Map Rando (core/maprando): its packed data ships as assets/maprando/data.zip and is unpacked once into the app's storage. */
+object MapRando {
+    private const val ASSET = "maprando"
+
+    private fun dataDir(context: Context) = File(context.filesDir, "maprando-data")
+
+    private fun stamp(context: Context) = runCatching { context.assets.open("$ASSET/stamp.txt").use { String(it.readBytes()).trim() } }.getOrNull()
+
+    /** Offers Map Rando in the menu when the APK carries its data; nothing is unpacked yet. */
+    fun setup(context: Context) {
+        if (stamp(context) != null) Smz3Native.mapRandoSetup(dataDir(context).path)
+    }
+
+    fun isMapRando(settings: String?) = settings?.contains("\"generator\":\"maprando\"") == true
+
+    /** Unpacks the data when this APK's differs from what is there (blocking: call it off the main thread). */
+    fun ensure(context: Context) {
+        val want = stamp(context) ?: return
+        val dir = dataDir(context)
+        val mark = File(dir, ".stamp")
+        if (mark.isFile && mark.readText() == want) return
+        dir.deleteRecursively()
+        val root = dir.canonicalPath + File.separator
+        ZipInputStream(context.assets.open("$ASSET/data.zip").buffered()).use { zip ->
+            while (true) {
+                val e = zip.nextEntry ?: break
+                val out = File(dir, e.name)
+                require(out.canonicalPath.startsWith(root)) { "bad entry ${e.name}" }
+                if (e.isDirectory) { out.mkdirs(); continue }
+                out.parentFile?.mkdirs()
+                out.outputStream().use { zip.copyTo(it) }
+            }
+        }
+        mark.writeText(want)
+    }
+
+    /** The busy line while a seed is built, from the native progress and the seconds since [since]. */
+    fun progressText(since: Long): String {
+        val s = (System.currentTimeMillis() - since) / 1000
+        return when (val p = Smz3Native.mapRandoProgress()) {
+            -1 -> "Unpacking Map Rando ... ${s}s"
+            0 -> "Loading Map Rando ... ${s}s"
+            else -> "Map Rando seed, try ${p - 1} ... ${s}s"
+        }
+    }
+}
