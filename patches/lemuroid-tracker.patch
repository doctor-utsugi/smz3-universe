+    private fun place(p: JSONObject) = p.optInt("place").takeIf { it > 0 }?.toString() ?: ""
+
+    private fun timeOf(p: JSONObject): String {
+        if (p.isNull("timeMs") || !p.has("timeMs")) return if (p.optBoolean("left")) "Left" else if (p.optInt("place") == 1) "Won" else if (state == "running") "racing" else "-"
