+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+/** JNI bridge to the shared C core (core/smz3_state.c). */
+object Smz3Native {
+    init {
+        System.loadLibrary("smz3core")
+    }
+
+    /** {game, started, zeldaCleared, zeldaTotal, metroidCleared, metroidTotal}; game is 0 none, 1 zelda, 2 metroid, 3 credits. */
+    @JvmStatic external fun summarize(wram: ByteArray, sram: ByteArray): IntArray
+    /** The daily challenge goal of the run being played, from its settings JSON (none clears it). */
+    @JvmStatic external fun setGoal(settings: String?)
+    @JvmStatic external fun preparedPokes(wram: ByteArray, sram: ByteArray): IntArray
+    @JvmStatic external fun addShortcutHooks(rom: ByteArray): ByteArray?
+
+    @JvmStatic external fun shortcutList(): Array<String>
+    @JvmStatic external fun shortcutState(wram: ByteArray, sram: ByteArray): LongArray
+    /** The fixed keys not taken yet, {room, x, y, big} each. */
+    @JvmStatic external fun fixedKeysLeft(wram: ByteArray, sram: ByteArray, zelda: Boolean): IntArray
