+                onDispose { com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3RaceState.dailyInPanel = false }
+            }
+            androidx.compose.ui.viewinterop.AndroidView(   // the overlay's own lines, its goal icon included; s changes every read
+                factory = { android.widget.TextView(it).apply { setTextColor(android.graphics.Color.WHITE); textSize = 12f; typeface = com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Box.face(it) } },
+                update = { it.tag = s; it.text = com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3RaceState.dailyText },
+                modifier = Modifier.fillMaxWidth().padding(vertical = 2.dp),
+            )
+        }
+        if (com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3RaceState.on && !com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3RaceState.daily) {
+            Spacer(Modifier.height(8.dp))
+            Text("Race", color = DIM, fontSize = 12.sp)
+            androidx.compose.runtime.DisposableEffect(Unit) {
