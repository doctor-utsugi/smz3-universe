+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Tracker.kt
@@ -0,0 +1,499 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.app.Presentation
+import android.content.Context
+import android.graphics.Color
+import android.hardware.display.DisplayManager
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.view.KeyEvent
+import android.view.Display
+import android.view.Gravity
+import android.view.ViewGroup
+import android.widget.LinearLayout
+import android.widget.ProgressBar
+import android.widget.TextView
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunGenerator
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunKeys
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunLogic
+import com.swordfish.lemuroid.app.mobile.feature.runs.Leaderboard
+import com.swordfish.lemuroid.app.mobile.feature.runs.OnlineLadder
+import com.swordfish.lemuroid.app.mobile.feature.runs.LeaderboardEntry
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunStore
+import com.swordfish.libretrodroid.GLRetroView
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+data class Smz3Snapshot(
+    val game: Int,
+    val started: Boolean,
+    val zeldaCleared: Int,
+    val zeldaTotal: Int,
+    val metroidCleared: Int,
+    val metroidTotal: Int,
+    val recent: List<String>,
+    val recentItems: List<Int> = emptyList(),
+    val bossMask: Int = 0,
+    val crystalMask: Int = 0,
+    val elapsedMs: Long,
+    val cleared: Set<Int>,
+    val inventory: IntArray,
+    val inLogic: Set<Int>?,
+    val position: MapPosition? = null,
+    val dungeonLive: DungeonLive? = null,
+    val dungeonData: DungeonData? = null,
+    val seen: List<android.graphics.RectF> = emptyList(),
+    val discoveredOnly: Boolean = false,
+    val bosses: List<BossMark> = emptyList(),
+    val help: HelpInfo = HelpInfo(),
+    val areaBox: android.graphics.RectF? = null,
+)
+
+/** Reads SMZ3 memory from the running core and shows the run on the secondary display (the AYN Thor's bottom screen). */
+object Smz3Tracker {
+    private const val WRAM_SIZE = 0x20000
+    private const val SRAM_SIZE = 0x100000
+    private const val MAX_RECENT = 8
+    private const val MAX_RECENT_ITEMS = 8
+
+    private val main = Handler(Looper.getMainLooper())
+    private var presentation: Smz3Presentation? = null
+    /** The tracker is on a second screen (the Thor's bottom one): the daily challenge shows there instead of over the game. */
+    val onSecondScreen: Boolean get() = presentation != null
+
+    /** Single screen: the tracker inside the game screen, and the last read for its side panels and status line. */
+    internal var embedded: Smz3TrackerPanel? = null
+    val latest = kotlinx.coroutines.flow.MutableStateFlow<Smz3Snapshot?>(null)
+    private var pendingPlayTime = 0L
+
+    /** 1 for 1x speed, otherwise the fast-forward speed being held; play time and the clock advance by it. */
+    @Volatile var speed = 1
+
+    /** 0 until the game is known, then 1 for A Link to the Past, 2 for Super Metroid and 3 for the credits. */
+    @Volatile var currentGame = 0
+
+    /** The run is Super Metroid alone: the map shows its half only and the Zelda counters are hidden. */
+    @Volatile var smAlone = false
+    @Volatile var mapRando = false   // a Map Rando seed: its map is rebuilt, so the tracker shows no map
+
+    /** The run is A Link to the Past alone: the map shows its half only and the Metroid counters are hidden. */
+    @Volatile var z3Alone = false
+
+    /** A single game's seed hash, the words or icons of its file select screen ("" for SMZ3 runs). */
+    @Volatile var smHash = ""
+
+    /** Whether the run has the game (1 Zelda, 2 Metroid). */
+    fun gameShown(game: Int) = if (game == 1) !smAlone else !z3Alone
+
+    /** Set after a save state is loaded: the next reads drop the recent checks and items the state undid. */
+    @Volatile var stateLoaded = 0
+    private var baseMs = 0L
+    private var baseSlot: Int? = null
+    private var finishedSaved = false
+
+    /** Called (from the tracker thread) when a run ends in this session: name, final time in ms, checks per game, ladder line. */
+    @Volatile var onRunComplete: ((name: String, ms: Long, zelda: String, metroid: String, ladder: String) -> Unit)? = null
+
+    /** Called (from a thread) with the server's answer to a daily challenge's finish, to replace the card's last line. */
+    @Volatile var onDailyResult: ((String) -> Unit)? = null
+    private var nextTokenTry = 0L
+    private var lastSramHash: Int? = null
+    private var pendingSave: LongArray? = null
+    private var lastPad = 0
+    private var lastSmState = -1
+
+    /** Keeps the world goal counters beside a save state, and puts them back when that state is loaded (repeating a stretch adds nothing). */
+    fun saveGoalsAt(context: Context, index: Int) {
+        RunStore.activeSlot(context)?.let { RunStore.goalsStateFile(context, it, index).writeText(Smz3Native.countersText()) }
+    }
+
+    fun loadGoalsAt(context: Context, index: Int) {
+        RunStore.activeSlot(context)?.let { slot -> runCatching { RunStore.goalsStateFile(context, slot, index).readText() }.getOrNull()?.let { Smz3Native.countersLoad(it) } }
+    }
+
+    /** Sends the run's world goal counters in the background (every few minutes, at the end and when the game closes). */
+    fun reportGoals(context: Context, slot: Int, runId: String) {
+        val text = Smz3Native.countersText()
+        val online = OnlineLadder.slotKind(context, slot) != 0
+        Thread { OnlineLadder.reportGoals(context, runId, online, text) }.start()
+    }
+
+    /** A Map Rando run's ROM goes to the game map (core/ui/smz3_smmap.c); any other run clears it. */
+    private fun loadGameMap(context: Context, slot: Int?) {
+        val rom = if (mapRando && slot != null) runCatching { RunStore.romFile(context, slot).readBytes() }.getOrNull() else null
+        Smz3Native.gameMapRom(rom)
+    }
+
+    fun start(scope: CoroutineScope, view: GLRetroView) {
+        val context = view.context
+        // which randomizer's ROM runs: the memory reads (in this process) and the tracker follow it
+        val activeRun = RunStore.activeSlot(context)?.let { RunStore.load(context, it) }
+        smAlone = RunStore.mode == "sm"
+        z3Alone = RunStore.mode == "z3"
+        smHash = if (smAlone || z3Alone) activeRun?.let { runCatching { org.json.JSONObject(it.settings).optString("hash") }.getOrNull() }.orEmpty() else ""
+        mapRando = smAlone && com.swordfish.lemuroid.app.mobile.feature.runs.MapRando.isMapRando(activeRun?.settings)
+        Smz3Native.setMode(RunStore.stateMode(activeRun?.settings))
+        loadGameMap(context, RunStore.activeSlot(context))
+        val displays = context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager
+        displays.registerDisplayListener(
+            object : DisplayManager.DisplayListener {
+                override fun onDisplayAdded(displayId: Int) = main.post { showOnSecondary(context) }.let { }
+
+                override fun onDisplayRemoved(displayId: Int) = main.post { dismiss() }.let { }
+
+                override fun onDisplayChanged(displayId: Int) = Unit
+            },
+            main,
+        )
+        main.post { showOnSecondary(context) }
+        // Screen shape: the config tab's choice wins over the one the run was created with.
+        val runShape = activeRun
+            ?.let { runCatching { org.json.JSONObject(it.settings).optString("screenShape", "original") }.getOrNull() }
+        view.aspectRatioOverride = Smz3Hotkeys.aspect(Smz3Hotkeys.shape(context) ?: runShape ?: "original")
+
+        scope.launch(Dispatchers.Default) {
+            var seen = emptySet<Int>()
+            val recent = ArrayDeque<String>()
+            val recentItems = ArrayDeque<Int>()
+            var inventoryBaseline = false
+            var recentSaved = ""
+            var recentRun = 0L
+            var startedAt = 0L
+            var dailyBegan = false
+            var liveSummary: IntArray? = null
+            var liveCleared: Set<Int> = emptySet()
+            var liveAt = 0L
+            var lastTick = SystemClock.elapsedRealtime()
+            var saveCountdown = 0
+            var lastFrame = -1
+            val itemNames = List(Smz3Native.inventoryCount()) { Smz3Native.inventoryInfo(it).split("|")[1] }
+            var logicKey = ""
+            var inLogic: Set<Int>? = null
+            var logicCountdown = 0
+            val inventoryCache = IntArray(Smz3Native.inventoryCount())
+            val discovery = Smz3Discovery(context)
+            var discoverySlot: Int? = null
+            var seenRects = emptyList<android.graphics.RectF>()
+            var seenCount = -1
+            var discoveredOnly = false
+            var lastGame = 0
+            var countersSlot: Int? = null
+            var nextGoalsReport = SystemClock.elapsedRealtime() + 300_000
+            var nextPlaying = SystemClock.elapsedRealtime() + 15_000   // a ranked monthly or weekly run counts as played: soon, then every 4 minutes
+            while (isActive) {
+                // a full read every 500 ms; in between, while a run is being played, a light check every 100 ms so the
+                // end of the run is taken close to the real moment (the final time is what the ladder keeps)
+                var waited = 0
+                while (waited < 500) {
+                    delay(100)
+                    waited += 100
+                    if (Smz3Shortcuts.pending()) { applyShortcuts(view); break }   // a full read right after, to show it
+                    if (lastGame == 0 || lastGame == 3 || Smz3Rewind.isOpen) continue
+                    val w = view.readMemory(GLRetroView.MEMORY_SYSTEM_RAM, 0, WRAM_SIZE)
+                    val sr = view.readMemory(GLRetroView.MEMORY_SAVE_RAM, 0, SRAM_SIZE)
+                    Smz3Native.countersTick(w, sr, lastGame, -1)   // an enemy's death lasts less than the full read's 500 ms
+                    if (Smz3Native.summarize(w, sr)[0] == 3) break
+                }
+                // rewinding: the picture is a past frame, so nothing is read; the clock's time is counted on the read after
+                if (Smz3Rewind.isOpen) continue
+                val wram = view.readMemory(GLRetroView.MEMORY_SYSTEM_RAM, 0, WRAM_SIZE)
+                if (wram.size > 0x8D) {
+                    val pad = (wram[0x8B].toInt() and 0xFF) or ((wram[0x8C].toInt() and 0xFF) shl 8)
+                    val sm = (wram[0x998].toInt() and 0xFF) or ((wram[0x999].toInt() and 0xFF) shl 8)
+                    if (sm != lastSmState) { lastSmState = sm; Timber.i("SMZ3 SM game state \$0998 = %04x frame \$05B6 = %02x".format(sm, wram[0x5B6])) }
+                    if (pad != lastPad) { lastPad = pad; Timber.i("SMZ3 SM pad word \$8B = %04x".format(pad)) }
+                }
+                val sram = view.readMemory(GLRetroView.MEMORY_SAVE_RAM, 0, SRAM_SIZE)
+                if (wram.isEmpty() || sram.isEmpty()) continue   // no game in the core yet (a race's countdown)
+                Smz3Native.shortcutState(wram, sram).let { st ->
+                    Smz3Shortcuts.ready = st[0] != 0L
+                    Smz3Shortcuts.owned = st[1]
+                    Smz3Shortcuts.active = st[2]
+                }
+                // a mid-game daily start keeps its dead bosses dead (nothing to write for any other run)
+                val pokes = Smz3Native.preparedPokes(wram, sram)
+                for (i in pokes.indices step 3) {
+                    val region = if (pokes[i] == 0) GLRetroView.MEMORY_SYSTEM_RAM else GLRetroView.MEMORY_SAVE_RAM
+                    view.writeMemory(region, pokes[i + 1], byteArrayOf(pokes[i + 2].toByte()))
+                }
+                // Both games bump a frame counter every frame (ALttP 0x7E001A, Super Metroid 0x7E05B6): when it does
+                // not move between two reads the emulator is paused or in the background, so no play time is counted.
+                val frame = if (wram.size > 0x05B6) (wram[0x1A].toInt() and 0xFF) or ((wram[0x05B6].toInt() and 0xFF) shl 8) else -1
+                val running = frame != lastFrame
+                lastFrame = frame
+                var s = Smz3Native.summarize(wram, sram)
+                var cleared = Smz3Native.clearedLocations(wram, sram).toSet()
+                // A transition frame (room load, screen fade) can briefly read as not started: hold the last live state.
+                val nowMs = SystemClock.elapsedRealtime()
+                if (s[1] != 0) { liveSummary = s; liveCleared = cleared; liveAt = nowMs }
+                else if (liveSummary != null && nowMs - liveAt < 2000) { s = liveSummary!!; cleared = liveCleared }
+
+                val started = s[1] != 0
+                // the game's own save: when the save RAM changes during play, remember the play time and the checks it holds
+                val sramHash = java.util.Arrays.hashCode(sram)
+                if (lastSramHash != null && sramHash != lastSramHash && started) {
+                    val saved = Smz3Native.summarize(ByteArray(0), sram)
+                    pendingSave = longArrayOf(baseMs + pendingPlayTime, saved[2].toLong(), saved[4].toLong())
