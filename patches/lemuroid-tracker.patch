+/** Options > Seed code: the RUN tab shows the seed's code (ALttP's five icons) only when asked for; it reads like items otherwise. */
+object Smz3SeedCode {
+    private var on: Boolean? = null
+    private fun prefs(context: android.content.Context) = context.getSharedPreferences("smz3_seed_code", android.content.Context.MODE_PRIVATE)
+    fun shown(context: android.content.Context): Boolean = on ?: prefs(context).getBoolean("on", false).also { on = it }
+    fun set(context: android.content.Context, value: Boolean) { on = value; prefs(context).edit().putBoolean("on", value).apply() }
+}
