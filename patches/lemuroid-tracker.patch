@@ -0,0 +1,180 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import org.json.JSONObject
+import java.io.File
+
+/** One saved SMZ3 run. [gameId] points at the ROM in the Lemuroid library; the summary is refreshed while the run is played. */
+data class Run(
+    val slot: Int,
+    val name: String,
+    val gameId: Int,
+    val createdAt: Long,
+    val lastPlayedAt: Long = 0,
+    val playTimeMs: Long = 0,
+    val game: Int = 0,
+    val zeldaCleared: Int = 0,
+    val zeldaTotal: Int = 0,
+    val metroidCleared: Int = 0,
+    val metroidTotal: Int = 0,
+    /** Bosses beaten (bit 0 Kraid, 1 Phantoon, 2 Draygon, 3 Ridley) and crystals collected (bit n-1 is crystal n). */
+    val bossMask: Int = 0,
+    val crystalMask: Int = 0,
+    val logic: String = "Normal",
+    val keysanity: Boolean = false,
+    val romPath: String = "",
+    val seed: String = "",
+    val settings: String = "{}",
+    /** "all": the whole map is shown with the missing items; "discovered": only the parts and items found so far. */
+    val mapMode: String = "all",
+    /** When the credits were reached (0 while the run is unfinished); the play time is then final and on the leaderboard. */
+    val completedAt: Long = 0,
+    /** Play time and checks done when the game's own save RAM last changed: what "Game save" means in the load choice (0 = never seen). */
+    val saveMs: Long = 0,
+    val saveZelda: Int = 0,
+    val saveMetroid: Int = 0,
+    /** The run's id on every device (its game letter and a UUID); "" until [RunStore.save] gives a new run one. */
+    val id: String = "",
+)
+
+/** 32 run slots, each a small JSON file in the app's private storage. */
+object RunStore {
+    const val SLOTS = 32
+
+    /** The game entered from the carousel ("smz3", "z3", "sm"): SMZ3 keeps runs/, the others runs/<id>/. */
+    @Volatile var mode = "smz3"
+
+    /** [mode] as the core's SMZ_MODE_* (0 SMZ3, 1 ALttP, 2 Super Metroid). */
+    fun modeIndex() = when (mode) { "z3" -> 1; "sm" -> 2; else -> 0 }
+
+    /** What the memory reads follow for a run of the game shown: its mode, with SMZ3_MAPRANDO (0x10) for a Map Rando seed and
+     *  SMZ3_Z3_INVERTED (0x20) for an Inverted ALttP run. */
+    fun stateMode(settings: String?) = modeIndex() or (if (mode == "sm" && MapRando.isMapRando(settings)) 0x10 else 0) or
+        (if (mode == "z3" && settings?.contains("\"world_state\":\"inverted\"") == true) 0x20 else 0)
+
+    fun runsDir(context: Context) = runsDir(context, mode)
+
+    /** The folder of [game]'s runs, whichever game the menu shows now (sending what another game left waiting). */
+    fun runsDir(context: Context, game: String) = File(context.filesDir, if (game == "smz3") "runs" else "runs/$game").apply { mkdirs() }
+
+    /** The games with an online ladder, daily challenge and races. */
+    val ONLINE_GAMES = listOf("smz3", "sm", "z3")
+
+    /** "&game=<id>" (or "?game=" with [first]) for a game other than SMZ3; SMZ3's requests stay as they were. */
+    fun gameQuery(game: String = mode, first: Boolean = false) = if (game == "smz3") "" else (if (first) "?" else "&") + "game=" + game
+
+    /** Slot of the run being played; the tracker (which runs in the game process) writes its progress into it. */
+    fun setActiveSlot(context: Context, slot: Int?) {
+        val f = File(File(context.filesDir, "runs").apply { mkdirs() }, "active")
+        if (slot == null) f.delete() else f.writeText("$slot $mode")
+    }
+
+    /** Also takes the run's game, so the game process reaches the same folder as the menu. */
+    fun activeSlot(context: Context): Int? {
+        val t = File(File(context.filesDir, "runs"), "active").takeIf { it.exists() }?.readText()?.trim()?.split(' ') ?: return null
+        t.getOrNull(1)?.let { mode = it }
+        return t[0].toIntOrNull()
+    }
+
+    private fun file(context: Context, slot: Int, game: String) = File(runsDir(context, game), "slot$slot.json")
+
+    /** The game letter that starts a run id. */
+    fun letter(game: String) = when (game) { "sm" -> 'm'; "z3" -> 'z'; else -> 's' }
+
+    fun load(context: Context, slot: Int, game: String = mode): Run? {
+        val f = file(context, slot, game)
+        if (!f.exists()) return null
+        return runCatching {
+            JSONObject(f.readText()).let {
+                Run(
+                    slot = slot,
+                    name = it.getString("name"),
+                    gameId = it.getInt("gameId"),
+                    createdAt = it.getLong("createdAt"),
+                    lastPlayedAt = it.optLong("lastPlayedAt"),
+                    playTimeMs = it.optLong("playTimeMs"),
+                    game = it.optInt("game"),
+                    zeldaCleared = it.optInt("zeldaCleared"),
+                    zeldaTotal = it.optInt("zeldaTotal"),
+                    metroidCleared = it.optInt("metroidCleared"),
+                    metroidTotal = it.optInt("metroidTotal"),
+                    bossMask = it.optInt("bossMask"),
+                    crystalMask = it.optInt("crystalMask"),
+                    logic = it.optString("logic", "Normal"),
+                    keysanity = it.optBoolean("keysanity"),
+                    romPath = it.optString("romPath"),
+                    seed = it.optString("seed"),
+                    settings = it.optString("settings", "{}"),
+                    mapMode = it.optString("mapMode", "all"),
+                    completedAt = it.optLong("completedAt"),
+                    saveMs = it.optLong("saveMs"),
+                    saveZelda = it.optInt("saveZelda"),
+                    saveMetroid = it.optInt("saveMetroid"),
+                    // a run made before the sync keeps the id its world goal reports already used
+                    id = it.optString("id").ifEmpty { "${letter(game)}$slot-${it.getLong("createdAt")}" },
+                )
+            }
+        }.getOrNull()
+    }
+
+    fun loadAll(context: Context): List<Run?> = (0 until SLOTS).map { load(context, it) }
+
+    @Synchronized
+    fun save(context: Context, run: Run, game: String = mode) {
+        val id = run.id.ifEmpty {
+            com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Native.syncNewId(letter(game), java.security.SecureRandom().nextLong())
+        }
+        val json = JSONObject()
+            .put("name", run.name).put("gameId", run.gameId).put("createdAt", run.createdAt)
+            .put("lastPlayedAt", run.lastPlayedAt).put("playTimeMs", run.playTimeMs).put("game", run.game)
+            .put("zeldaCleared", run.zeldaCleared).put("zeldaTotal", run.zeldaTotal)
+            .put("metroidCleared", run.metroidCleared).put("metroidTotal", run.metroidTotal).put("bossMask", run.bossMask).put("crystalMask", run.crystalMask)
+            .put("logic", run.logic).put("keysanity", run.keysanity)
+            .put("romPath", run.romPath).put("seed", run.seed).put("settings", run.settings).put("mapMode", run.mapMode).put("completedAt", run.completedAt)
+            .put("saveMs", run.saveMs).put("saveZelda", run.saveZelda).put("saveMetroid", run.saveMetroid).put("id", id)
+        file(context, run.slot, game).writeText(json.toString())
+    }
+
+    fun discoveryFile(context: Context, slot: Int, game: String = mode) = File(runsDir(context, game), "slot$slot.disc.json")
+
+    fun recentFile(context: Context, slot: Int) = File(runsDir(context), "slot$slot.recent.json")
+
+    /** The run's world goal counters (key=n,key=n text, see smz3_counters.h). */
+    fun goalsFile(context: Context, slot: Int, game: String = mode) = File(runsDir(context, game), "slot$slot.goals")
+
+    /** The counters at a save state (index -1: the quick save): loading the state puts them back. */
+    fun goalsStateFile(context: Context, slot: Int, index: Int, game: String = mode) = File(runsDir(context, game), "slot$slot.goals.state$index")
+
+    fun marksFile(context: Context, slot: Int, game: String = mode) = File(runsDir(context, game), "slot$slot.marks.json")
+
+    /** This device's sync record of the run (SMZ_SYNC_RECORD, core/ui/smz3_sync.h). */
+    fun syncFile(context: Context, slot: Int, game: String = mode) = File(runsDir(context, game), "slot$slot.sync")
+
+    private fun romDir(context: Context) = runsDir(context)
+
+    /** The slot's ROM: the file named in its run (see [romName]) or, for runs made before stable names, the slot file. */
+    fun romFile(context: Context, slot: Int, game: String = mode): File {
+        val path = load(context, slot, game)?.romPath.orEmpty()
+        return if (path.isNotEmpty()) File(path) else File(runsDir(context, game), "smz3_run_$slot.sfc")
+    }
+
+    /** The stable ROM name is computed by the shared C code (core/ui) so every device agrees on it. */
+    fun romName(seed: String, settingsJson: String) = com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Native.romName(settingsJson, seed)
+
+    fun newRomFile(context: Context, seed: String, settingsJson: String) = File(romDir(context), romName(seed, settingsJson))
+
+    fun delete(context: Context, slot: Int) {
+        val rom = romFile(context, slot)
+        file(context, slot, mode).delete()
+        rom.delete()
+        clearExtras(context, slot)
+    }
+
+    /** The map, marks and recent lists of whatever run used the slot before: a new run starts without them. */
+    fun clearExtras(context: Context, slot: Int, game: String = mode) {
+        discoveryFile(context, slot, game).delete()
+        marksFile(context, slot, game).delete()
+        File(runsDir(context, game), "slot$slot.recent.json").delete()
+        syncFile(context, slot, game).delete()
+    }
+}
