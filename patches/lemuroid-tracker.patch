+    } else if ((idx == 1 || idx == 2) && lw >= 24f && lh >= 10f) {
+        val cut = (if (lh >= 28f) 4f else 2f) * scale
+        if (idx == 2) {
+            for (g in 3 downTo 1) drawPath(chamfer(l - g * scale, t - g * scale, w + 2 * g * scale, h + 2 * g * scale, cut + g * scale), Color(0xFFF2A33A).copy(alpha = (0.10f + 0.10f * pulse) / g))
+            drawPath(chamfer(l, t, w, h, cut), Color(0xFFF2A33A).copy(alpha = 0.55f + 0.45f * pulse))
+            drawPath(chamfer(l + scale, t + scale, w - 2 * scale, h - 2 * scale, cut - scale), Color(0xFF24221C))
+            drawRect(Color(0xFFF2A33A).copy(alpha = 0.10f), Offset(l + scale, t + scale), Size(w / 2, h - 2 * scale))
