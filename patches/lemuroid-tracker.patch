@@ -0,0 +1,171 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Rect
+import org.json.JSONObject
+
+/** Where Link is inside a dungeon: the dungeon, the floor index, the room cell on the 5 x 5 grid and the spot inside the room (0..15). */
+class DungeonLive(val d: Int, val idx: Int, val cell: Int, val lx: Int, val ly: Int)
+
+/** What the game remembers about the dungeons: the visited quadrants of every room (`$7EF000`) and the owned dungeon maps. */
+/** keys: the fixed keys still to take, {room, x, y, big} each, when the run marks them; else empty. */
+class DungeonData(val roomFlags: ByteArray, val mapMask: Int, val compassMask: Int, val keys: IntArray = IntArray(0))
+
+/**
+ * The game's own dungeon maps (the screen the pause menu shows), rendered from the ROM by tools/zelda-dungeon-maps.py into two
+ * atlases: every room fully drawn, and the dimmed outline the map item reveals. Without the atlas files nothing is available.
+ */
+class Smz3DungeonMaps private constructor(context: Context) {
+    private class Dungeon(val below: Int, val floors: List<IntArray>, val bounds: IntArray)
+
+    private val cell: Int
+    private val dungeons: List<Dungeon>
+    private val chests: Map<Int, List<IntArray>>
+    private val full: Bitmap?
+    private val hint: Bitmap?
+    val available: Boolean
+
+    init {
+        var c = 80
+        var list = emptyList<Dungeon>()
+        var f: Bitmap? = null
+        var h: Bitmap? = null
+        var ch = emptyMap<Int, List<IntArray>>()
+        runCatching {
+            val o = JSONObject(context.assets.open("smz3/dungeon_maps.json").use { String(it.readBytes()) })
+            c = o.getInt("cell")
+            val a = o.getJSONArray("dungeons")
+            list = (0 until a.length()).map { i ->
+                val d = a.getJSONObject(i)
+                val fl = d.getJSONArray("floors")
+                val floors = (0 until fl.length()).map { j -> fl.getJSONArray(j).let { g -> IntArray(g.length()) { k -> g.getInt(k) } } }
+                // the part of the 5 x 5 grid any floor uses: columns and rows, so every floor of a dungeon is cropped the same way
+                var x0 = 5; var y0 = 5; var x1 = -1; var y1 = -1
+                for (g in floors) for (k in g.indices) if (g[k] != 0xF) {
+                    x0 = minOf(x0, k % 5); x1 = maxOf(x1, k % 5); y0 = minOf(y0, k / 5); y1 = maxOf(y1, k / 5)
+                }
+                if (x1 < 0) { x0 = 0; y0 = 0; x1 = 4; y1 = 4 }
+                Dungeon(d.getInt("below"), floors, intArrayOf(x0, y0, x1, y1))
+            }
+            o.optJSONObject("chests")?.let { co ->
+                ch = co.keys().asSequence().associate { k -> k.toInt() to co.getJSONArray(k).let { a -> List(a.length()) { i -> intArrayOf(a.getJSONArray(i).getInt(0), a.getJSONArray(i).getInt(1)) } } }
+            }
+            f = context.assets.open("smz3/dungeon_maps.png").use { BitmapFactory.decodeStream(it) }
+            h = context.assets.open("smz3/dungeon_maps_hint.png").use { BitmapFactory.decodeStream(it) }
+        }
+        cell = c; dungeons = list; full = f; hint = h; chests = ch
+        available = f != null && h != null && list.size == 14
+    }
+
+    /** Where the [k]th chest of a room stands, in 0..63 tiles of the room, or null when it is not known. */
+    fun chestPos(room: Int, k: Int): IntArray? = chests[room]?.getOrNull(k)
+
+    fun name(d: Int) = NAMES.getOrElse(d) { "Dungeon" }
+    fun floorCount(d: Int) = dungeons.getOrNull(d)?.floors?.size ?: 0
+    fun below(d: Int) = dungeons.getOrNull(d)?.below ?: 0
+    fun grid(d: Int, idx: Int): IntArray? = dungeons.getOrNull(d)?.floors?.getOrNull(idx)
+
+    /** First and last used column and row of the dungeon's grid: [x0, y0, x1, y1]. */
+    fun bounds(d: Int): IntArray = dungeons.getOrNull(d)?.bounds ?: intArrayOf(0, 0, 4, 4)
+
+    /** "1F" for the ground floor, "2F" above it, "B1" below. */
+    fun floorLabel(d: Int, idx: Int): String {
+        val floor = idx - below(d)
+        return if (floor >= 0) "${floor + 1}F" else "B${-floor}"
+    }
+
+    private fun u16(w: ByteArray, a: Int) = (w[a].toInt() and 0xFF) or ((w[a + 1].toInt() and 0xFF) shl 8)
+
+    private var stable: DungeonLive? = null
+
+    /**
+     * Link's place when the Zelda work RAM says he is inside a dungeon, else null. While the game is in the middle of a room change
+     * (underworld module 7 with a submodule running) the room number and Link's coordinates do not belong to the same room yet,
+     * so the last settled place is kept instead of a position on the wrong side of the room.
+     */
+    fun live(w: ByteArray): DungeonLive? {
+        val now = place(w)
+        val moving = w[0x10].toInt() == 0x07 && w[0x11].toInt() != 0
+        if (moving && now != null) stable?.let { if (it.d == now.d) return it }
+        stable = now
+        return now
+    }
+
+    private fun place(w: ByteArray): DungeonLive? {
+        if (!available) return null
+        val d = (w[0x040C].toInt() and 0xFF) / 2
+        val dungeon = dungeons.getOrNull(d) ?: return null
+        val idx = (w[0xA4].toInt() + dungeon.below).coerceIn(0, dungeon.floors.size - 1)
+        var room = u16(w, 0xA0)
+        for ((from, to) in ROOM_ALIASES) if (room == from) room = to
+        val here = dungeon.floors[idx].indexOf(room)
+        if (here < 0) return DungeonLive(d, idx, -1, 0, 0)
+        return DungeonLive(d, idx, here, (u16(w, 0x22) and 0x1E0) shr 5, (u16(w, 0x20) and 0x1E0) shr 5)
+    }
+
+    /** The remembered dungeon state from the Zelda work RAM (Zelda running) or from the parked save RAM (Super Metroid running). */
+    fun data(wram: ByteArray, sram: ByteArray, zeldaRunning: Boolean, fixedKeys: Boolean = false): DungeonData? {
+        val src = if (zeldaRunning) wram else sram
+        val base = if (zeldaRunning) 0xF000 else 0
+        if (src.size < base + 0x370) return null
+        return DungeonData(src.copyOfRange(base, base + 0x200), u16(src, base + 0x368), u16(src, base + 0x364),
+            if (fixedKeys) Smz3Native.fixedKeysLeft(wram, sram, zeldaRunning) else IntArray(0))
+    }
+
+    private val cache = HashMap<String, Bitmap>()
+
+    /** Rooms not visited yet on a run that shows the whole map: the same picture, much fainter. */
+    private val faint = android.graphics.Paint().apply { alpha = 100 }
+
+    /**
+     * The 80 x 80 picture of one floor. A room quadrant shows the full drawing once Link has been there. The rest is faint when
+     * the run shows the whole map ([showAll]); otherwise it is the outline the dungeon's map item reveals, or nothing.
+     */
+    fun render(d: Int, idx: Int, data: DungeonData?, showAll: Boolean): Bitmap? {
+        val fullBmp = full ?: return null
+        val hintBmp = hint ?: return null
+        val grid = grid(d, idx) ?: return null
+        val haveMap = data != null && (data.mapMask and (0x8000 shr d)) != 0
+        val seen = IntArray(25) { c -> if (grid[c] == 0xF || data == null) 0 else data.roomFlags[grid[c] * 2].toInt() and 0xF }
+        val key = "$d/$idx/${seen.joinToString(",")}/$haveMap/$showAll"
+        cache[key]?.let { return it }
+        val bmp = Bitmap.createBitmap(FLOOR, FLOOR, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bmp)
+        val src = Rect(); val dst = Rect()
+        for (c in 0 until 25) for (q in 0 until 4) {
+            val visited = seen[c] and (8 shr q) != 0
+            val atlas = if (visited || showAll) fullBmp else if (haveMap) hintBmp else continue
+            val paint = if (visited || !showAll) null else faint
+            val ox = (c % 5) * ROOM + (q and 1) * 8
+            val oy = (c / 5) * ROOM + (q shr 1) * 8
+            src.set(idx * cell + ox, d * cell + oy, idx * cell + ox + 8, d * cell + oy + 8)
+            dst.set(ox, oy, ox + 8, oy + 8)
+            canvas.drawBitmap(atlas, src, dst, paint)
+        }
+        if (cache.size > 64) cache.clear()
+        cache[key] = bmp
+        return bmp
+    }
+
+    companion object {
+        const val ROOM = 16
+        const val FLOOR = 80
+        /** The boss room of each dungeon, the floor it is on (relative to the ground floor), and where the icon sits (x << 8 | y, -1 for none). */
+        val BOSS_ROOM = intArrayOf(15, 15, 200, 51, 32, 6, 90, 144, 41, 222, 7, 172, 164, 13)
+        val BOSS_FLOOR = intArrayOf(-1, -1, 1, 1, 6, -1, -1, -1, -2, -7, 5, -1, -3, 6)
+        val BOSS_SPOT = intArrayOf(-1, -1, 0x808, 8, 0, 8, 0x808, 8, 0x808, 0x800, 0x404, 0x808, 8, 8)
+        private val ROOM_ALIASES = listOf(137 to 169, 167 to 119, 79 to 190)
+        private val NAMES = listOf(
+            "Sewers", "Hyrule Castle", "Eastern Palace", "Desert Palace", "Castle Tower", "Swamp Palace", "Palace of Darkness",
+            "Misery Mire", "Skull Woods", "Ice Palace", "Tower of Hera", "Thieves' Town", "Turtle Rock", "Ganon's Tower",
+        )
+
+        @Volatile private var shared: Smz3DungeonMaps? = null
+
+        fun get(context: Context): Smz3DungeonMaps =
+            shared ?: synchronized(this) { shared ?: Smz3DungeonMaps(context.applicationContext).also { shared = it } }
+    }
+}
