+                        waitingApk[0] = apk
+                        Smz3Native.uiBusy("Allow SMZ3 to install the update")
+                        version++
+                        runCatching { AppUpdate.askInstallPermission(context) }.onFailure { waitingApk[0] = null; Smz3Native.uiUpdateEnd("Installs not allowed"); version++ }
+                    }
+                }
+        }
+    }
