+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.view.View
+
+/**
+ * The dungeon half of a map view: the floor picture with Link and the unopened checks, the floor list, the dungeon switcher and
+ * the chips that swap with the world map. Inside a dungeon it shows the floor Link is on until the player picks another one.
+ */
+internal class Smz3DungeonPanel(private val view: View, private val maps: Smz3DungeonMaps) {
+    var live: DungeonLive? = null
+        set(value) {
+            if (value == null && field != null && mode == MODE_WORLD) mode = MODE_AUTO
+            if (!interactive && mode == MODE_PICKED && (value == null || value.d != field?.d)) mode = MODE_AUTO   // a floor picked on the mini map belongs to one dungeon visit
+            field = value
+        }
+    var data: DungeonData? = null
+    var showAll = false
+    /** The big map has the buttons; the mini map only follows Link, at the zoom the player picked. */
+    var interactive = true
+    var zoom = 1f
+    /** Per room, its checks still to do: the room flag bit shifted left twice, plus 1 when in logic or 2 when out of logic. */
+    var pendingRooms: Map<Int, List<Int>> = emptyMap()
+
+    private var mode = MODE_AUTO
+    private var pickedD = 2
+    private var pickedIdx = 0
+
+    private val density get() = view.resources.displayMetrics.density
+    private val hits = ArrayList<Pair<RectF, () -> Unit>>()
+    private val src = Rect()
+    private val dst = RectF()
+    private val bitmapPaint = Paint().apply { isFilterBitmap = false }
+    private val chipFill = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.argb(225, 12, 16, 22) }
+    private val chipOn = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#3A4A66") }
+    private val chipRim = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; strokeWidth = 3f; color = Color.parseColor("#FFD54A") }
+    private val text = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE; typeface = Typeface.DEFAULT_BOLD; textAlign = Paint.Align.CENTER }
+    private val title = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE; typeface = Typeface.DEFAULT_BOLD; setShadowLayer(4f, 0f, 0f, Color.BLACK) }
+    private val me = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE }
+    private val meRing = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.BLACK; strokeWidth = 3f }
+    private val pendingFill = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#FFB300") }
+    private val pendingRim = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.WHITE; strokeWidth = 3f }
+    private val dimFill = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#E6243038") }
+    private val dimRim = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.parseColor("#F0F4F8"); strokeWidth = 2.5f }
+    private val bossFill = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#D32F2F") }
+    private val keyGold = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#F2C14E") }
+    private val keyBig = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#FFE08A") }
+    private val keyInk = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#1A1408") }
+    private val blackRim = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.BLACK; strokeWidth = 3f }
+
+    /** True when the view should draw the dungeon picture rather than the world map. */
+    fun showsDungeon(): Boolean = maps.available && !Smz3Tracker.smAlone && if (!interactive) live != null else when (mode) {
+        MODE_WORLD -> false
+        MODE_PICKED -> true
+        else -> live != null
+    }
+
+    /** True when there is something to offer on the world map (the maps are installed). */
+    fun available() = maps.available
+
+    private fun shownD() = if (interactive && mode == MODE_PICKED) pickedD else live?.d ?: pickedD
+    private fun shownIdx() = if (mode == MODE_PICKED && (interactive || live != null)) pickedIdx else live?.idx ?: pickedIdx
+
+    private fun pick(d: Int, idx: Int) {
+        pickedD = d.coerceIn(0, 13)
+        pickedIdx = idx.coerceIn(0, maxOf(0, maps.floorCount(pickedD) - 1))
+        mode = MODE_PICKED
+        view.invalidate()
+    }
+
+    fun hitTest(x: Float, y: Float): Boolean = hits.any { it.first.contains(x, y) }
+
+    /** Handles a tap; true when it landed on one of the panel's buttons. */
+    fun tap(x: Float, y: Float): Boolean {
+        for ((r, action) in hits.asReversed()) if (r.contains(x, y)) { action(); return true }
+        return false
+    }
+
+    private fun chip(canvas: Canvas, r: RectF, label: String, on: Boolean = false, action: () -> Unit) {
+        canvas.drawRoundRect(r, 8f, 8f, if (on) chipOn else chipFill)
+        canvas.drawRoundRect(r, 8f, 8f, chipRim)
+        text.textSize = minOf(r.height() * 0.45f, r.width() * 0.4f)
+        canvas.drawText(label, r.centerX(), r.centerY() + text.textSize * 0.35f, text)
+        hits += r to action
+    }
+
+    /** The chip that leads from the world map into the dungeon pictures. */
+    fun drawWorldChip(canvas: Canvas, h: Int) {
+        hits.clear()
+        if (!maps.available || !interactive || Smz3Tracker.smAlone) return
+        val d = density
+        chip(canvas, RectF(6f * d, h - 38f * d, 98f * d, h - 6f * d), "DUNGEONS") {
+            if (live == null) pick(pickedD, pickedIdx) else mode = MODE_AUTO
+            view.invalidate()
+        }
+    }
+
+    fun drawDungeon(canvas: Canvas, w: Int, h: Int) {
+        hits.clear()
+        val d = density
+        val dn = shownD()
+        val idx = shownIdx()
+        val count = maps.floorCount(dn)
+        val lv = live
+
+        val colW = if (interactive) 50f * d else if (count > 1) 38f * d else 0f
+        val barH = if (interactive) 40f * d else 0f
+        if (interactive) {
+        // floor list, top floor first
+        for (i in count - 1 downTo 0) {
+            val row = count - 1 - i
+            val r = RectF(6f * d, 44f * d + row * 38f * d, 6f * d + 44f * d, 44f * d + row * 38f * d + 32f * d)
+            chip(canvas, r, maps.floorLabel(dn, i), on = i == idx) { pick(dn, i) }
+        }
+
+        // dungeon switcher along the bottom
+        val prev = RectF(colW + 6f * d, h - barH - 4f * d, colW + 6f * d + 44f * d, h - 4f * d)
+        val next = RectF(w - 6f * d - 44f * d, h - barH - 4f * d, w - 6f * d, h - 4f * d)
+        chip(canvas, prev, "<") { pick((dn + 13) % 14, maps.below((dn + 13) % 14)) }
+        chip(canvas, next, ">") { pick((dn + 1) % 14, maps.below((dn + 1) % 14)) }
+        title.textSize = 15f * d
+        title.textAlign = Paint.Align.CENTER
+        canvas.drawText(maps.name(dn), (prev.right + next.left) / 2f, prev.centerY() + 5f * d, title)
+        title.textAlign = Paint.Align.LEFT
+
+        // top right: back to the world map, or back to where Link is
+        val worldChip = RectF(w - 98f * d, 6f * d, w - 6f * d, 38f * d)
+        chip(canvas, worldChip, "FULL MAP") { mode = MODE_WORLD; view.invalidate() }
+        if (lv != null && (dn != lv.d || idx != lv.idx || mode == MODE_PICKED)) {
+            chip(canvas, RectF(6f * d, 44f * d + count * 38f * d, 6f * d + 44f * d, 44f * d + count * 38f * d + 32f * d), "HERE") { mode = MODE_AUTO; view.invalidate() }
+        }
+
+        } else if (count > 1) {
+            // the mini map: the floors of the dungeon Link is in, top floor first, to look at the other levels
+            for (i in count - 1 downTo 0) {
+                val row = count - 1 - i
+                val r = RectF(4f * d, 30f * d + row * 34f * d, 4f * d + 32f * d, 30f * d + row * 34f * d + 28f * d)
+                chip(canvas, r, maps.floorLabel(dn, i), on = i == idx) { pick(dn, i) }
+            }
+            if (lv != null && idx != lv.idx) {
+                chip(canvas, RectF(4f * d, 30f * d + count * 34f * d, 4f * d + 32f * d, 30f * d + count * 34f * d + 28f * d), "HERE") { mode = MODE_AUTO; view.invalidate() }
+            }
+        }
+
+        // the floor, cropped to the part of the grid this dungeon uses
+        val bmp = maps.render(dn, idx, data, showAll) ?: return
+        val b = maps.bounds(dn)
+        val cols = b[2] - b[0] + 1
+        val rows = b[3] - b[1] + 1
+        val areaL = colW + 6f * d
+        val areaT = if (interactive) 44f * d else 30f * d
+        val areaR = w - 6f * d
+        val areaB = if (interactive) h - barH - 12f * d else h - 6f * d
+        var scale = minOf((areaR - areaL) / (cols * Smz3DungeonMaps.ROOM), (areaB - areaT) / (rows * Smz3DungeonMaps.ROOM))
+        if (!interactive) scale *= zoom
+        val picW = cols * Smz3DungeonMaps.ROOM * scale
+        val picH = rows * Smz3DungeonMaps.ROOM * scale
+        var left = areaL + ((areaR - areaL) - picW) / 2f
+        var top = areaT + ((areaB - areaT) - picH) / 2f
+        if (!interactive && zoom > 1f && lv != null && lv.cell >= 0 && lv.d == dn && lv.idx == idx) {
+            // zoomed in, the picture follows Link
+            left = (areaL + areaR) / 2f - ((lv.cell % 5 - b[0]) * Smz3DungeonMaps.ROOM + lv.lx + 0.5f) * scale
+            top = (areaT + areaB) / 2f - ((lv.cell / 5 - b[1]) * Smz3DungeonMaps.ROOM + lv.ly + 0.5f) * scale
+        }
+        src.set(b[0] * Smz3DungeonMaps.ROOM, b[1] * Smz3DungeonMaps.ROOM, (b[2] + 1) * Smz3DungeonMaps.ROOM, (b[3] + 1) * Smz3DungeonMaps.ROOM)
+        dst.set(left, top, left + picW, top + picH)
+        canvas.drawBitmap(bmp, src, dst, bitmapPaint)
+
+        title.textSize = 16f * d
+        if (interactive) canvas.drawText(maps.floorLabel(dn, idx) + "  (" + (idx + 1) + "/" + count + ")", left, areaT - 6f * d, title)
+        else canvas.drawText(maps.name(dn) + "  " + maps.floorLabel(dn, idx), 8f * d, 22f * d, title)
+
+        // unopened checks: at their chest when the game's room data places it, else together at the room's centre
+        val grid = maps.grid(dn, idx)
+        if (grid != null) for (c in 0 until 25) {
+            val room = grid[c]
+            if (room == 0xF) continue
+            val list = pendingRooms[room] ?: continue
+            val originX = left + (c % 5 - b[0]) * Smz3DungeonMaps.ROOM * scale
+            val originY = top + (c / 5 - b[1]) * Smz3DungeonMaps.ROOM * scale
+            var loose = 0
+            for (e in list) {
+                val pos = maps.chestPos(room, (e shr 2) - 4)
+                if (pos == null || (e shr 2) - 4 !in 0..5) { loose = loose or (e and 3); continue }
+                dot(canvas, originX + (pos[0] + 0.5f) / 4f * scale, originY + (pos[1] + 0.5f) / 4f * scale, scale * 2f, e and 3)
+            }
+            if (loose != 0) {
+                val r = scale * 2.6f
+                val off = if (loose == 3) r * 0.9f else 0f
+                if (loose and 2 != 0) dot(canvas, originX + 8f * scale + off, originY + 8f * scale, r, 2)
+                if (loose and 1 != 0) dot(canvas, originX + 8f * scale - off, originY + 8f * scale, r, 1)
+            }
+        }
+
+        // keys under pots and on enemies, until taken, on runs that ask for them
+        val keys = data?.keys
+        if (grid != null && keys != null) for (k in keys.indices step 4) {
+            val c = grid.indexOf(keys[k])
+            if (c < 0) continue
+            val x = left + ((c % 5 - b[0]) * Smz3DungeonMaps.ROOM + (keys[k + 1] + 0.5f) / 4f) * scale
+            val y = top + ((c / 5 - b[1]) * Smz3DungeonMaps.ROOM + (keys[k + 2] + 0.5f) / 4f) * scale
+            keyMark(canvas, x, y, scale * 1.6f, keys[k + 3] != 0)
+        }
+
+        // the boss, once the compass says where (or on all-map runs), until it is beaten
+        val spot = Smz3DungeonMaps.BOSS_SPOT[dn]
+        val bossIdx = Smz3DungeonMaps.BOSS_FLOOR[dn] + maps.below(dn)
+        val room = Smz3DungeonMaps.BOSS_ROOM[dn]
+        val dd = data
+        if (spot >= 0 && idx == bossIdx && grid != null && dd != null) {
+            val known = showAll || (dd.compassMask and (0x8000 shr dn)) != 0
+            val beaten = (dd.roomFlags[room * 2 + 1].toInt() and 0x08) != 0
+            val c = grid.indexOf(room)
+            if (known && !beaten && c >= 0) {
+                val x = left + ((c % 5 - b[0]) * Smz3DungeonMaps.ROOM + (spot shr 8) + 4f) * scale
+                val y = top + ((c / 5 - b[1]) * Smz3DungeonMaps.ROOM + (spot and 0xFF) + 4f) * scale
+                val r = scale * 2.8f
+                canvas.drawCircle(x, y, r + 2f, pendingRim)
+                canvas.drawCircle(x, y, r, bossFill)
+                canvas.drawCircle(x, y, r, blackRim)
+                text.textSize = r * 1.5f
+                canvas.drawText("B", x, y + text.textSize * 0.35f, text)
+            }
+        }
+
+        // Link, blinking, only on the floor he is on
+        if (lv != null && lv.d == dn && lv.idx == idx && lv.cell >= 0 && (android.os.SystemClock.uptimeMillis() / 350) % 2 == 0L) {
+            val x = left + ((lv.cell % 5 - b[0]) * Smz3DungeonMaps.ROOM + lv.lx + 0.5f) * scale
+            val y = top + ((lv.cell / 5 - b[1]) * Smz3DungeonMaps.ROOM + lv.ly + 0.5f) * scale
+            canvas.drawCircle(x, y, scale * 1.9f, meRing)
+            canvas.drawCircle(x, y, scale * 1.3f, me)
+        }
+    }
+
+    /** A key standing up, its bow at the top: gold, a big key larger and paler. */
+    private fun keyMark(canvas: Canvas, x: Float, y: Float, size: Float, big: Boolean) {
+        val s = if (big) size * 1.25f else size
+        val gold = if (big) keyBig else keyGold
+        canvas.drawCircle(x, y - s * 0.55f, s * 0.62f, keyInk)
+        canvas.drawRect(x - s * 0.3f, y - s * 0.3f, x + s * 0.3f, y + s * 1.2f, keyInk)
+        canvas.drawCircle(x, y - s * 0.55f, s * 0.45f, gold)
+        canvas.drawCircle(x, y - s * 0.55f, s * 0.18f, keyInk)
+        canvas.drawRect(x - s * 0.13f, y - s * 0.15f, x + s * 0.13f, y + s * 1.05f, gold)
+        canvas.drawRect(x + s * 0.13f, y + s * 0.6f, x + s * 0.45f, y + s * 0.8f, gold)
+        canvas.drawRect(x + s * 0.13f, y + s * 0.85f, x + s * 0.37f, y + s * 1.03f, gold)
+    }
+
+    private fun dot(canvas: Canvas, x: Float, y: Float, r: Float, state: Int) {
+        if (state == 2) {
+            canvas.drawCircle(x, y, r * 0.8f, dimFill)
+            canvas.drawCircle(x, y, r * 0.8f, dimRim)
+        } else {
+            canvas.drawCircle(x, y, r + 2f, pendingRim)
+            canvas.drawCircle(x, y, r, pendingFill)
+            canvas.drawCircle(x, y, r, blackRim)
+        }
+    }
+
+    private companion object {
+        const val MODE_AUTO = 0
+        const val MODE_WORLD = 1
+        const val MODE_PICKED = 2
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Finish.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Finish.kt
