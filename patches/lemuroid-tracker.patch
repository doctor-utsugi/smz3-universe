+    fun continueRun(slot: Int) {
+        val run = RunStore.load(context, slot) ?: return
+        // a save state ahead of the game save asks which of the two to load (a finished run's clock is frozen, so
+        // it always asks); ladder runs have none
+        if (OnlineLadder.slotKind(context, slot) >= 1) play(run, false)
+        else if (run.saveMs > 0 && (run.completedAt != 0L || run.game == 3 || run.playTimeMs - run.saveMs > 10_000)) {
+            Smz3Native.uiLoadChoice(slot, run.saveMs, run.saveZelda, run.saveMetroid, run.playTimeMs, run.zeldaCleared, run.metroidCleared, run.zeldaTotal, run.metroidTotal)
+            version++
+        } else play(run, true)
+    }
