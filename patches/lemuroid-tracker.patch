+                        drawStyledRect(f[5].toInt(), f[1].toFloat(), f[2].toFloat(), f[3].toFloat(), f[4].toFloat(), l, t, r - l, b - t, scale, pulse, color)
+                    } else if (kind == 4) {   // progress ring: a dark track, then the share in the align field (percent) from the top
+                        val d = f[3].toFloat() * scale; val th = 4.2f * scale
+                        val tl = Offset(x + th / 2, y + th / 2); val sz = Size(d - th, d - th)
+                        val stroke = androidx.compose.ui.graphics.drawscope.Stroke(width = th)
