+private fun percent(s: Smz3Snapshot): String {
+    val total = s.zeldaTotal + s.metroidTotal
+    return if (total == 0) "0%" else "${(s.zeldaCleared + s.metroidCleared) * 100 / total}%"
+}
+
+private fun clock(ms: Long): String {
+    val sec = ms / 1000
+    return "%d:%02d:%02d".format(sec / 3600, sec / 60 % 60, sec % 60)
+}
+
+/** Percent, time and checks under the game; [toggle] is the label of the button that swaps the touch pad and the tracker. */
+@Composable
+private fun StatusLine(s: Smz3Snapshot?, toggle: String?) {
+    Row(
+        Modifier.fillMaxWidth().background(PANEL).padding(horizontal = 12.dp, vertical = 4.dp),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        if (s != null) {
+            Text(percent(s), color = GOLD, fontSize = 14.sp, fontWeight = FontWeight.Bold)
+            Text(clock(s.elapsedMs), color = TEXT, fontSize = 14.sp)
+            Text("${s.zeldaCleared + s.metroidCleared}/${s.zeldaTotal + s.metroidTotal}", color = DIM, fontSize = 14.sp)
+        } else {
+            Spacer(Modifier.weight(1f))
+        }
+        if (toggle != null) SmallButton(toggle, Modifier) { Smz3ScreenMode.toggleTracker() }
+    }
+}
