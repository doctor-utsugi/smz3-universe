+            val time = fields[0].toLongOrNull() ?: continue
+            val token = runCatching { tokenFile(context, slot, game).readText().trim() }.getOrNull() ?: continue
+            val (name, country) = profile(context)
+            val body = JSONObject().put("token", token).put("timeMs", time).put("player", name)
+            if (country.length == 2) body.put("country", country)
+            fields.getOrNull(1)?.takeIf { it.length in 1..9 && it.all { c -> c.isDigit() } }?.let { body.put("seed", it) }
+            body.put("proof", runCatching { proofFile(context, slot, game).readText() }.getOrDefault(""))
