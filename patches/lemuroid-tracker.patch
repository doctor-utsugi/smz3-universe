+        }
+        val out = HashMap<Int, IntArray>()
+        for (list in groups.values) if (list.size >= 2) { val all = list.toIntArray(); for (i in all) out[i] = all }
+        out
+    }
+
+    private val zeldaRoom: IntArray by lazy { IntArray(Smz3Native.locationCount()) { Smz3Native.zeldaLocationRoom(it) } }
+
+    /** Link's place in a dungeon (null outside) and what the game remembers about the dungeons. */
+    fun setDungeon(live: DungeonLive?, data: DungeonData?, showAll: Boolean) {
+        panel.live = live
+        panel.data = data
+        panel.showAll = showAll
+        invalidate()
+    }
+
+    /** The checks still to do in each dungeon room, for the dungeon pictures: per room the flag bit and logic state of each one. */
+    private fun refreshPendingRooms() {
+        if (!panel.available()) return
+        val rooms = HashMap<Int, MutableList<Int>>()
+        for (i in zeldaRoom.indices) {
+            val code = zeldaRoom[i]
+            if (code < 0 || i in cleared) continue
+            if (visibleChecks != null && i !in visibleChecks!!) continue
+            val state = if (inLogic == null || i in inLogic!!) 1 else 2
+            rooms.getOrPut(code and 0xFFFF) { ArrayList() } += ((code shr 16) shl 2) or state
+        }
+        panel.pendingRooms = rooms
+    }
+
+    fun setDiscovery(pos: MapPosition?, rects: List<RectF>, onlyDiscovered: Boolean) {
+        position = pos
+        seen = rects
+        discoveredOnly = onlyDiscovered
+        invalidate()
+    }
+
+    private var bosses: List<BossMark> = emptyList()
+    private val icons = HashMap<String, Bitmap?>()
+
+    fun setBosses(list: List<BossMark>) {
+        bosses = list
+        invalidate()
+    }
+
+    private fun icon(name: String): Bitmap? = icons.getOrPut(name) {
+        runCatching { context.assets.open("smz3/rewards/$name").use { BitmapFactory.decodeStream(it) } }.getOrNull()
+    }
+
+    private val iconPaint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val markBack = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.argb(215, 12, 16, 22) }
+    private val noteRim = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.parseColor("#FF4FB8"); strokeWidth = 5f }
+    private val markRim = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.parseColor("#FFD54A"); strokeWidth = 2.5f }
+    private val dst = RectF()
+
+    private fun isSeen(x: Float, y: Float) = seen.any { it.contains(x, y) }
+
+    /** The [FOLLOW] button: while on, the map keeps the player in the middle (any zoom) and cannot be dragged. */
+    var following = false
+        set(on) {
+            field = on
+            if (on) keepCentered()
+            invalidate()
+        }
+
+    private fun keepCentered() {
+        val pos = position ?: return
+        val pts = floatArrayOf(pos.x, pos.y)
+        matrix.mapPoints(pts)
+        matrix.postTranslate(width / 2f - pts[0], height / 2f - pts[1])
+    }
+
+    private fun centerOnPlayer() {
+        val pos = position ?: return fit()
+        val s = width / 240f * miniZoom
+        matrix.reset()
+        matrix.postScale(s, s)
+        matrix.postTranslate(width / 2f - pos.x * s, height / 2f - pos.y * s)
+    }
+
+    /** The [CENTER] button: puts the player in the middle of the view at a readable zoom (the whole map when unknown). */
+    fun centerOnPlayerNow() {
+        if (gameShown()) { Smz3Native.gameMapStep(0); gameFitted = false; invalidate(); return }
+        centerOnPlayer()
+        invalidate()
+    }
+
+    /** Fits a part of the map (half-size map pixels) in the view, e.g. the Super Metroid area Samus is in. */
+    fun fitRect(r: RectF) {
+        if (width == 0 || height == 0) { pendingFit = r; return }
+        val sc = minOf(width / r.width(), height / r.height())
+        matrix.reset()
+        matrix.postScale(sc, sc)
+        matrix.postTranslate((width - r.width() * sc) / 2f - r.left * sc, (height - r.height() * sc) / 2f - r.top * sc)
+        fitted = true
+        invalidate()
+    }
+
+    private var pendingFit: RectF? = null
+
+    private fun fit() {
+        val bmp = bitmap ?: return
+        if (width == 0 || height == 0) return
+        if (Smz3Tracker.smAlone) { fitRect(RectF(SM_LEFT, 0f, MAP_W, MAP_H)); return }   // Super Metroid alone: its half of the map
+        if (Smz3Tracker.z3Alone) { fitRect(RectF(0f, 0f, SM_LEFT, MAP_H)); return }   // A Link to the Past alone: the other half
+        val s = minOf(width.toFloat() / MAP_W, height.toFloat() / MAP_H)
+        matrix.reset()
+        matrix.postScale(s, s)
+        matrix.postTranslate((width - MAP_W * s) / 2, (height - MAP_H * s) / 2)
+        fitted = true
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+        val p = pendingFit
+        if (p != null) { pendingFit = null; fitRect(p) } else if (!fitted) fit()
+        if (follow) centerOnPlayer()
+    }
+
+    private var panelDown = false
+    private var zoomDown = 0
+
+    /** Whether a touch lands on one of the dungeon panel's buttons (they exist after the first draw). */
+    private fun panelHit(x: Float, y: Float) = panel.hitTest(x, y)
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (follow) {
+            placeZoom()
+            if (event.action == MotionEvent.ACTION_DOWN) zoomDown = if (zoomIn.contains(event.x, event.y)) 1 else if (zoomOut.contains(event.x, event.y)) -1 else 0
+            if (zoomDown != 0) {
+                if (event.action == MotionEvent.ACTION_UP) setMiniZoom(miniZoom * if (zoomDown > 0) 1.4f else 1f / 1.4f)
+                if (event.action == MotionEvent.ACTION_UP || event.action == MotionEvent.ACTION_CANCEL) zoomDown = 0
+                return true
+            }
+        }
+        if (event.action == MotionEvent.ACTION_DOWN) panelDown = panel.available() && panelHit(event.x, event.y)
+        if (panelDown) {
+            if (event.action == MotionEvent.ACTION_UP) panel.tap(event.x, event.y)
+            if (event.action == MotionEvent.ACTION_UP || event.action == MotionEvent.ACTION_CANCEL) panelDown = false
+            return true
+        }
+        if (follow) {
+            if (event.action == MotionEvent.ACTION_UP) performClick()
+            return true
+        }
+        parent?.requestDisallowInterceptTouchEvent(true)
+        scaleDetector.onTouchEvent(event)
+        if (!scaleDetector.isInProgress) panDetector.onTouchEvent(event)
+        return true
+    }
+
+    // Map Rando: the game's own pause map (core/ui/smz3_smmap.c), the area's 512 x 256 picture drawn in whole pixels.
+    private val gameMatrix = Matrix()
+    private var gameBmp: Bitmap? = null
+    private var gamePx: IntArray? = null
+    private var gameStamp = -2
+    private var gameInfo = IntArray(8) { -1 }
+    private var gameFitted = false
+    private val gamePaint = Paint()
+    private val gameLabel = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#E8ECF2"); typeface = Typeface.DEFAULT_BOLD }
+    private val gameLabelBack = Paint().apply { color = Color.argb(170, 0, 0, 0) }
+
+    private fun gameShown() = Smz3Tracker.mapRando && gameStamp >= 0
+
+    /** The next area the player has been in, as Select does on the pause screen. */
+    fun nextGameArea() {
+        Smz3Native.gameMapStep(1)
+        invalidate()
+    }
+
+    private fun drawGameMap(canvas: Canvas): Boolean {
+        val stamp = Smz3Native.gameMapStamp()
+        if (stamp < 0 || width == 0 || height == 0) { gameStamp = -2; return false }
+        val bmp = gameBmp ?: Bitmap.createBitmap(512, 256, Bitmap.Config.ARGB_8888).also { gameBmp = it }
+        if (stamp != gameStamp) {
+            val px = gamePx ?: IntArray(512 * 256).also { gamePx = it }
+            val info = Smz3Native.gameMapPicture(px)
+            if (info[0] != gameInfo[0]) gameFitted = false   // another area starts from its own view
+            gameInfo = info
+            bmp.setPixels(px, 0, 512, 0, 0, 512, 256)
+            gameStamp = stamp
+        }
+        val home = Smz3Native.gameMapHome(width, height)
+        val here = gameInfo[1] == gameInfo[0] && gameInfo[2] >= 0
+        val sx = gameInfo[2] * 8 + 4f
+        val sy = gameInfo[3] * 8 + 4f
+        if (follow || !gameFitted) {
+            val z = if (follow) maxOf(1f, Math.round(home[2] * miniZoom).toFloat()) else home[2]
+            val cx = if (follow && here) sx else home[0]
+            val cy = if (follow && here) sy else home[1]
+            gameMatrix.reset()
+            gameMatrix.postScale(z, z)
+            gameMatrix.postTranslate(Math.round(width / 2f - cx * z).toFloat(), Math.round(height / 2f - cy * z).toFloat())
+            gameFitted = true
+        } else if (following && here) {
+            val pts = floatArrayOf(sx, sy)
+            gameMatrix.mapPoints(pts)
+            gameMatrix.postTranslate(Math.round(width / 2f - pts[0]).toFloat(), Math.round(height / 2f - pts[1]).toFloat())
+        }
+        canvas.drawColor(Color.BLACK)
+        canvas.save()
+        canvas.concat(gameMatrix)
+        canvas.drawBitmap(bmp, 0f, 0f, gamePaint)
+        canvas.restore()
+        val name = Smz3Native.gameMapArea()
+        if (name.isNotEmpty()) {
+            val d = resources.displayMetrics.density
+            gameLabel.textSize = 14f * d
+            canvas.drawRect(0f, 0f, gameLabel.measureText(name) + 12f * d, 22f * d, gameLabelBack)
+            canvas.drawText(name, 6f * d, 16f * d, gameLabel)
+        }
+        if (follow) drawZoom(canvas)
+        return true
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        canvas.drawColor(Color.parseColor("#0B0E12"))
+        if (Smz3Tracker.mapRando && drawGameMap(canvas)) return
+        if (Smz3Tracker.mapRando) {   // its rooms are moved: the vanilla map would point the wrong way
+            val note = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#8793A6"); textAlign = Paint.Align.CENTER; textSize = minOf(width / 22f, 15f * resources.displayMetrics.density) }
+            canvas.drawText("Map Rando rebuilds the map:", width / 2f, height / 2f - note.textSize * 0.2f, note)
+            canvas.drawText("see the game's own map", width / 2f, height / 2f + note.textSize * 1.1f, note)
+            return
+        }
+        if (panel.showsDungeon()) { panel.drawDungeon(canvas, width, height); if (follow) drawZoom(canvas); postInvalidateDelayed(175); return }
+        val bmp = bitmap ?: return
+        if (follow) centerOnPlayer() else if (following) keepCentered()
+        canvas.save()
+        canvas.concat(matrix)
+        if (Smz3Tracker.smAlone) canvas.clipRect(SM_LEFT, 0f, MAP_W, MAP_H)
+        if (Smz3Tracker.z3Alone) canvas.clipRect(0f, 0f, SM_LEFT, MAP_H)
+        canvas.drawBitmap(bmp, null, mapRect, bitmapPaint)
+        val strip = patchStrip
+        if (strip != null && (Smz3Tracker.smAlone || Smz3Tracker.z3Alone)) for (p in patches) {
+            patchSrc.set(p[4], 0, p[4] + p[2], p[3])
+            patchDst.set(p[0] / 2f, p[1] / 2f, (p[0] + p[2]) / 2f, (p[1] + p[3]) / 2f)
+            canvas.drawBitmap(strip, patchSrc, patchDst, bitmapPaint)
+        }
+        canvas.restore()
+        // Parts of the map not seen yet are covered by a veil: light when everything is shown, dark when only discovered parts are.
+        val layer = canvas.saveLayer(0f, 0f, width.toFloat(), height.toFloat(), null)
+        fog.alpha = if (discoveredOnly) 235 else 110
+        canvas.drawRect(0f, 0f, width.toFloat(), height.toFloat(), fog)
+        for (r in seen) {
+            mapped.set(r)
+            matrix.mapRect(mapped)
+            canvas.drawRect(mapped, clear)
+        }
+        canvas.restoreToCount(layer)
+        matrix.getValues(values)
+        val zoom = values[Matrix.MSCALE_X]
+        val pts = FloatArray(2)
+        val radius = (5f + 2f * zoom).coerceIn(5f, 16f)
+        for (m in markers) {
+            if ((Smz3Tracker.smAlone && m[1] < SM_LEFT) || (Smz3Tracker.z3Alone && m[1] >= SM_LEFT)) continue
+            val my = (m[2] + Smz3Native.markerDy(m[0])).toFloat()
+            pts[0] = m[1].toFloat(); pts[1] = my
+            matrix.mapPoints(pts)
+            if (pts[0] < -20 || pts[1] < -20 || pts[0] > width + 20 || pts[1] > height + 20) continue
+            if (discoveredOnly && !isSeen(m[1].toFloat(), my)) continue
+            val stack = stacks[m[0]]
+            if (stack != null) {
+                // a dungeon is one dot: finished only when every check inside is, as pending as its remaining checks
+                if (stack[0] != m[0]) continue
+                val shown = stack.filter { visibleChecks == null || it in visibleChecks!! || it in cleared }
+                if (shown.isEmpty()) continue
+                val left = shown.filter { it !in cleared }
+                if (left.isEmpty()) {
+                    canvas.drawCircle(pts[0], pts[1], radius * 0.65f, done)
+                    canvas.drawCircle(pts[0], pts[1], radius * 0.65f, doneRim)
+                    continue
+                }
+                if (inLogic != null && left.none { it in inLogic!! }) {
+                    canvas.drawCircle(pts[0], pts[1], radius * 0.7f, dim)
+                    canvas.drawCircle(pts[0], pts[1], radius * 0.7f, dimRim)
+                    continue
+                }
+                val r = radius * (1f + 0.22f * pulse)
+                pending.alpha = (255 * (0.75f + 0.25f * (1f - pulse))).toInt()
+                canvas.drawCircle(pts[0], pts[1], r + 2f, pendingOuter)
+                canvas.drawCircle(pts[0], pts[1], r, pending)
+                canvas.drawCircle(pts[0], pts[1], r, ring)
+                continue
+            }
+            if (m[0] in cleared) {
+                canvas.drawCircle(pts[0], pts[1], radius * 0.65f, done)
+                canvas.drawCircle(pts[0], pts[1], radius * 0.65f, doneRim)
+            } else if (visibleChecks != null && m[0] !in visibleChecks!!) {
+                continue
+            } else if (inLogic != null && m[0] !in inLogic!!) {
+                canvas.drawCircle(pts[0], pts[1], radius * 0.7f, dim)
+                canvas.drawCircle(pts[0], pts[1], radius * 0.7f, dimRim)
+            } else {
+                // gentle breathing: size and brightness move a little, never blink
+                val r = radius * (1f + 0.22f * pulse)
+                pending.alpha = (255 * (0.75f + 0.25f * (1f - pulse))).toInt()
+                canvas.drawCircle(pts[0], pts[1], r + 2f, pendingOuter)
+                canvas.drawCircle(pts[0], pts[1], r, pending)
+                canvas.drawCircle(pts[0], pts[1], r, ring)
+            }
+        }
+        for (b in bosses) {
+            if ((Smz3Tracker.smAlone && b.x < SM_LEFT) || (Smz3Tracker.z3Alone && b.x >= SM_LEFT)) continue
+            if (discoveredOnly && !isSeen(b.x, b.y)) continue
+            pts[0] = b.x; pts[1] = b.y
+            matrix.mapPoints(pts)
+            val bmp2 = icon(b.icon) ?: continue
+            val half = (7f + 3f * zoom).coerceIn(8f, 20f)
+            dst.set(pts[0] - half, pts[1] - half, pts[0] + half, pts[1] + half)
+            iconPaint.alpha = if (b.done) 90 else 255
+            canvas.drawBitmap(bmp2, null, dst, iconPaint)
+            if (b.done) canvas.drawCircle(pts[0] + half * 0.6f, pts[1] + half * 0.6f, half * 0.35f, done)
+        }
+        for (m in marks) {
+            pts[0] = m.x; pts[1] = m.y
+            matrix.mapPoints(pts)
+            val bmp2 = itemIcon(m.icon) ?: continue
+            val half = markHalf(zoom)
+            canvas.drawCircle(pts[0], pts[1], half + 2f, markBack)
+            if (m.note.isNotBlank()) canvas.drawCircle(pts[0], pts[1], half + 2f, noteRim)
+            else canvas.drawCircle(pts[0], pts[1], half + 2f, markRim)
+            dst.set(pts[0] - half, pts[1] - half, pts[0] + half, pts[1] + half)
+            iconPaint.alpha = 255
+            canvas.drawBitmap(bmp2, null, dst, iconPaint)
+        }
+        rippleAt?.let { r ->
+            val d = resources.displayMetrics.density
+            rippleRing.color = Color.argb((255 * (1f - ripple)).toInt(), 255, 213, 74)
+            canvas.drawCircle(r[0], r[1], (6f + 34f * ripple) * d, rippleRing)
+            canvas.drawCircle(r[0], r[1], 5f * d, rippleDot)
+        }
+        position?.let {
+            pts[0] = it.x; pts[1] = it.y
+            matrix.mapPoints(pts)
+            val pr = (6f + 2f * zoom).coerceIn(7f, 14f)
+            // the player's dot blinks so it stands out among the check dots
+            if ((android.os.SystemClock.uptimeMillis() / 350) % 2 == 0L) {
+                canvas.drawCircle(pts[0], pts[1], pr * 1.5f, ring)
+                canvas.drawCircle(pts[0], pts[1], pr, me)
+                canvas.drawCircle(pts[0], pts[1], pr, ring)
+            } else {
+                canvas.drawCircle(pts[0], pts[1], pr * 0.45f, me)
+            }
+        }
+        panel.drawWorldChip(canvas, height)
+        if (follow) drawZoom(canvas)
+    }
+
+    private companion object {
+        /** The mini map zoom the player picked, kept while the app runs. */
+        var miniZoom = 1f
+
+        /** Size of the half-size combined map: the coordinate space of the tracker data. */
+        const val MAP_W = 1623f
+        const val MAP_H = 958f
+
+        /** Where the Super Metroid half starts (the Zelda half is x 0..480, as smz_disc_area_box has it). */
+        const val SM_LEFT = 480f
+    }
+}
