+/** What the shared sync code calls back: one HTTP request, and a run's files by SMZ_SYNC_* kind (core/ui/smz3_sync.h). */
+open class Smz3SyncHost {
+    /** The last request's HTTP status. */
+    @JvmField var status = 0
+
+    /** headers holds "Name: value" lines. Null when the server was not reached. */
+    open fun http(method: String, url: ByteArray, headers: ByteArray?, body: ByteArray?): ByteArray? = runCatching {
+        val c = java.net.URL(String(url, Charsets.UTF_8)).openConnection() as java.net.HttpURLConnection
+        c.requestMethod = method
+        c.connectTimeout = 15_000
+        c.readTimeout = 120_000
+        headers?.let { String(it, Charsets.UTF_8) }?.lineSequence()?.forEach { line ->
+            val i = line.indexOf(':')
+            if (i > 0) c.setRequestProperty(line.substring(0, i).trim(), line.substring(i + 1).trim())
+        }
+        if (body != null || method == "POST" || method == "PUT") {
+            val b = body ?: ByteArray(0)
+            c.doOutput = true
+            c.setFixedLengthStreamingMode(b.size)
+            c.outputStream.use { it.write(b) }
+        }
+        val code = c.responseCode
+        val bytes = (if (code >= 400) c.errorStream else c.inputStream)?.use { it.readBytes() } ?: ByteArray(0)
+        c.disconnect()
+        status = code
+        bytes
+    }.onFailure { status = -1 }.getOrNull()
+
+    open fun read(kind: Int): ByteArray? = null
+
+    /** data null removes the file. */
+    open fun write(kind: Int, data: ByteArray?): Boolean = false
+
+    companion object {
+        const val SRM = 0
+        const val RESUME = 1
+        const val Q1 = 2
+        const val RACE = 6
+        const val RUN = 7
+        const val HELP = 8
+        const val ROM = 9
+        const val RECORD = 10
+    }
+}
