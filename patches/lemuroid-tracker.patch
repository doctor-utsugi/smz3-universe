+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3VisorView.kt
@@ -0,0 +1,67 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.animation.ValueAnimator
+import android.content.Context
+import android.graphics.BlurMaskFilter
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.view.View
+import android.view.animation.LinearInterpolator
+
+/**
+ * The tracker coming up when a game opens, like Samus's visor booting: a faint grid lights up, a scan line sweeps down
+ * over it and the tracker fades in behind the line.
+ */
+internal class Smz3VisorView(context: Context) : View(context) {
+    private val density = context.resources.displayMetrics.density
+    private val cyan = Color.parseColor("#4FC3F7")
+    private val grid = Paint().apply { color = cyan; strokeWidth = 1f }
+    private val line = Paint().apply { color = cyan }
+    private val glow = Paint().apply { color = cyan; maskFilter = BlurMaskFilter(10f, BlurMaskFilter.Blur.NORMAL) }
+    private val shade = Paint().apply { color = Color.BLACK }
+    private var t = 1f
+    private var anim: ValueAnimator? = null
+
+    init { visibility = GONE; setLayerType(LAYER_TYPE_SOFTWARE, null) }   // the glow's blur needs software drawing
+
+    /** Plays the boot over [under], which fades in behind the scan line. */
+    fun play(under: View) {
+        anim?.cancel()
+        visibility = VISIBLE
+        under.alpha = 0f
+        anim = ValueAnimator.ofFloat(0f, 1f).apply {
+            duration = 1000
+            interpolator = LinearInterpolator()
+            addUpdateListener { t = it.animatedValue as Float; under.alpha = ((t - 0.15f) / 0.6f).coerceIn(0f, 1f); invalidate() }
+            addListener(object : android.animation.AnimatorListenerAdapter() {
+                override fun onAnimationEnd(a: android.animation.Animator) { visibility = GONE; under.alpha = 1f }
+                override fun onAnimationCancel(a: android.animation.Animator) { visibility = GONE; under.alpha = 1f }
+            })
+            start()
+        }
+    }
+
+    override fun onDraw(c: Canvas) {
+        val w = width.toFloat()
+        val h = height.toFloat()
+        // below the scan line the screen is still dark; above it the tracker shows
+        val y = h * (t / 0.7f).coerceAtMost(1.04f)
+        shade.alpha = (230 * (1f - t)).toInt().coerceIn(0, 230)
+        c.drawRect(0f, y, w, h, shade)
+        // the grid: up quickly, then fading out as the tracker takes over
+        val g = when { t < 0.15f -> t / 0.15f; t < 0.4f -> 1f; else -> (1f - (t - 0.4f) / 0.4f).coerceAtLeast(0f) }
+        grid.alpha = (110 * g).toInt()
+        val step = 40 * density
+        var x = 0f
+        while (x <= w) { c.drawLine(x, 0f, x, h, grid); x += step }
+        var gy = 0f
+        while (gy <= h) { c.drawLine(0f, gy, w, gy, grid); gy += step }
+        if (t < 0.72f) {
+            glow.alpha = 160
+            c.drawRect(0f, y - 6 * density, w, y + 6 * density, glow)
+            line.alpha = 255
+            c.drawRect(0f, y - 1.5f * density, w, y + 1.5f * density, line)
+        }
+    }
+}
