--- a/lemuroid-app/build.gradle.kts
+++ b/lemuroid-app/build.gradle.kts
@@ -9,10 +9,26 @@ plugins {
 }
 
 android {
+    externalNativeBuild {
+        cmake {
+            path = file("../../../frontends/android/CMakeLists.txt")
+            version = "3.22.1"
+        }
+    }
+    // Map Rando's packed data, zipped there by build-android.sh and unpacked once into the app's storage (MapRando.kt)
+    sourceSets["main"].assets.srcDir("../../../build/android-assets")
     defaultConfig {
         versionCode = 252
-        versionName = "1.17.0" // Always remember to update Cores Tag!
-        applicationId = "com.swordfish.lemuroid"
+        // the SMZ3 release tag, the same one the second screen shows (frontends/android/CMakeLists.txt)
+        versionName = (System.getenv("GITHUB_REF_NAME")?.takeIf { it.startsWith("v") }
+            ?: providers.exec {
+                commandLine("git", "describe", "--tags", "--abbrev=0")
+                workingDir = file("../../..")
+                isIgnoreExitValue = true
+            }.standardOutput.asText.get().trim()).removePrefix("v").ifEmpty { "dev" }
+        applicationId = "com.utsugi.smz3"
+        // SMZ3 only runs on the AYN Thor (arm64).
+        ndk { abiFilters += "arm64-v8a" }
     }
     flavorDimensions += listOf("opensource", "cores")
 
@@ -72,6 +88,8 @@ android {
             // Stripping created some issues with some libretro cores such as ppsspp
             keepDebugSymbols += setOf("*/*/*_libretro_android.so")
