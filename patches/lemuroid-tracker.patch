+            }
+            }
+            drawCommands(commands)
+            // on the frame the screen changes the wipe has not started yet: cover the new screen instead of flashing it
+            if (launching) {
+                drawRect(Color.Black.copy(alpha = closing.value), Offset.Zero, size)
+            } else {
+                drawWipe(if (changed) 0f else wipe.value, scale, drift)
+                val fade = if (changed) 1f else leave.value   // the screen that left fades out over the wallpaper
+                val gone = leaving[0]
+                if (fade > 0f && gone != null) {
+                    drawContext.canvas.saveLayer(androidx.compose.ui.geometry.Rect(Offset.Zero, size), androidx.compose.ui.graphics.Paint().apply { alpha = fade })
