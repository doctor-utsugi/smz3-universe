+private typealias PadComposable = @Composable PadKitScope.(Modifier, TouchControllerSettingsManager.Settings) -> Unit
+
+/** Where each touch pad group sits and how big it is, per orientation: dragged and pinched in the edit mode. */
+object Smz3PadLayout {
+    data class Placement(val scale: Float, val dx: Float, val dy: Float)
+
+    const val MIN_SCALE = -0.5f   // Lemuroid's scale runs 0..1 (dial 0.75x..1.5x); this widens it to 0.375x..1.875x
+    const val MAX_SCALE = 1.5f
+
+    private fun prefs(context: Context) = context.getSharedPreferences("smz3_pad", Context.MODE_PRIVATE)
+
+    private fun key(landscape: Boolean, left: Boolean) = (if (landscape) "land_" else "port_") + (if (left) "left" else "right")
+
+    fun load(context: Context, landscape: Boolean, left: Boolean, defaultScale: Float): Placement {
+        val parts = prefs(context).getString(key(landscape, left), null)?.split(",")?.mapNotNull { it.toFloatOrNull() }
+        return if (parts == null || parts.size != 3) Placement(defaultScale, 0f, 0f) else Placement(parts[0], parts[1], parts[2])
+    }
+
+    fun save(context: Context, landscape: Boolean, left: Boolean, p: Placement) {
+        prefs(context).edit().putString(key(landscape, left), "${p.scale},${p.dx},${p.dy}").apply()
+    }
+
+    fun reset(context: Context, landscape: Boolean) {
+        prefs(context).edit().remove(key(landscape, true)).remove(key(landscape, false)).apply()
+    }
+}
