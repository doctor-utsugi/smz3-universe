@@ -0,0 +1,611 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.app.Activity
+import android.app.Dialog
+import android.graphics.Color
+import android.os.Handler
+import android.os.Looper
+import android.text.SpannableString
+import android.text.Spanned
+import android.text.style.ForegroundColorSpan
+import android.text.style.RelativeSizeSpan
+import android.view.Gravity
+import android.view.KeyEvent
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.TextView
+import com.swordfish.lemuroid.app.mobile.feature.runs.RaceClient
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunStore
+import org.json.JSONArray
+import org.json.JSONObject
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/** What the tracker's CHAT tab and RUN standings show of the race being played, or the CHAT tab of the daily challenge's
+ * window ([daily]: no standings, its own quick lines, sent by [dailySay]) (main thread only). */
+object Smz3RaceState {
+    class Line(val seq: Long, val kind: String, val pid: String, val name: String, val text: String)
+
+    var on = false
+    /** The race's countdown ended in this game process: a remade activity (a turn of the screen) need not hold the core
+     * until its first poll. */
+    var started = false
+    var daily = false
+    /** The race being played is a Draft. */
+    var draft = false
+    /** A Draft's goal line while it shows; the single-screen side panel draws it when it is up, instead of the overlay. */
+    @Volatile var goalLine = ""
+    @Volatile var goalInPanel = false
+    /** The daily's box (window, time, goal, next hint); the single-screen side panel draws it when it is up, instead of the overlay. */
+    @Volatile var dailyText: CharSequence = ""
+    @Volatile var dailyInPanel = false
+    /** Sends a daily chat line (set by the daily overlay); a race's lines go out with its polls. */
+    var dailySay: ((String) -> Unit)? = null
+    var you = ""
+    var players = JSONArray()
+    val lines = ArrayList<Line>()
+    val muted = HashSet<String>()
+    var chatOff = false
+    /** Bumped on every change, so the views redraw only then. */
+    var version = 0
+
+    private val racePhrases = listOf("Good luck!", "GG", "Nice!", "Close one!", "brb", "Back", "Ready?", "Wow")
+    private val dailyPhrases by lazy { runCatching { Smz3Native.dailyPhrases().toList() }.getOrDefault(listOf("GL HF!", "GG", ":)", ":D", ":(", "<3", "o7", "!!")) }
+    val phrases get() = if (daily) dailyPhrases else racePhrases
+
+    fun shown(l: Line) = l.kind != "chat" || (!chatOff && l.pid !in muted)
+
+    /** Sends a line: null once it is on its way, otherwise why it was not sent. */
+    fun say(text: String): String? {
+        if (chatOff) return "Chat is off: turn it on to send"
+        val t = text.trim().filter { it.code in 0x20..0x7E }.take(80)
+        if (t.isEmpty()) return if (text.isBlank()) "Type something first" else "Only plain letters, numbers and signs can be sent"
+        if (daily) dailySay?.invoke(t) ?: return "Not sent"
+        else if (!RaceClient.chat(t)) return "Too fast: wait a moment"
+        Smz3Finish.cue(6)
+        return null
+    }
+
+    /** Who can be muted (pid to name): the race's rivals, or whoever has spoken in the daily's chat. */
+    fun others(): List<Pair<String, String>> =
+        if (daily) lines.filter { it.kind == "chat" && it.pid != you }.map { it.pid to it.name }.distinctBy { it.first }
+        else (0 until players.length()).map { players.getJSONObject(it) }.filter { it.optString("pid") != you }.map { it.optString("pid") to it.optString("name") }
+
+    /** A line as the CHAT tab writes it. */
+    fun text(l: Line) = when {
+        l.kind == "chat" -> "${l.name}: ${l.text}"
+        l.kind == "event" || (daily && l.kind == "finish") -> "\u2022 ${l.name} ${l.text}"
+        else -> "\u2022 ${l.text}"
+    }
+
+    fun toggleMute(pid: String) { if (!muted.remove(pid)) muted += pid; version++ }
+
+    fun toggleChat() { chatOff = !chatOff; version++ }
+}
+
+/**
+ * An online race while playing, as on PC: the game takes no input until the server's start (a countdown over it), bosses
+ * and crystals go out as news and progress, the end sends the proof, the rivals' news shows top right for four seconds and
+ * their chat bottom right for two, "Race ends in" counts down a multi race after the first finish, and the result card
+ * comes once the room is over (or with the places so far when this player finishes a multi race). The Full game can be
+ * paused by a vote: the game stands still while it is open, keeps a state when it passes, and comes back from the menu,
