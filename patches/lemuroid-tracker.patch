+                else showNews(text)
+            } else { read(text); primed = true }
+        }
+        RaceClient.setSince(since)
+        val now = System.currentTimeMillis()
+        val server = now + offset
+        val goIn = if (goAt > 0) goAt - server else Long.MAX_VALUE
+        // no connection: the race goes on, and after five minutes it counts as cancelled
+        val off = RaceClient.offlineMs()
+        if (off == 0L) offlineNoted = false
+        else if (off > 10_000 && !offlineNoted) { offlineNoted = true; showNews("No connection: the race goes on") }
+        if (off > 5 * 60_000 && state == "running") { state = "cancelled"; endWhy = "No connection" }
+        // back after a pause: the state kept loads once (the core running), then the server hears this player is back
+        if (back && !stateLoaded && Smz3Rewind.view != null && Smz3Tracker.latest.value != null) {
+            stateLoaded = true
+            val view = Smz3Rewind.view!!
+            setHeld(true)
