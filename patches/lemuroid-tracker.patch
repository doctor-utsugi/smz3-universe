+            }
+        }
+
+        private fun drawLadder(canvas: Canvas, l: Float, t: Float, w: Float, h: Float) {
+            panel(canvas, l, t, w, h)
+            val tw = (w - 12f) / TABS.size
+            for ((i, name) in TABS.withIndex()) {
+                val tx = l + 6f + i * tw
+                tabRects[i].set(tx * u, t * u, (tx + tw) * u, (t + 18f) * u)
+                text(canvas, fit(name, tw - 2f, 5.5f), tx + tw / 2f, t + 12f, 5.5f, if (i == tab) ACCENT else DIM, Paint.Align.CENTER)
+                if (i == tab) {
+                    paint.color = ACCENT
+                    canvas.drawRect((tx + 4f) * u, (t + 15.5f) * u, (tx + tw - 4f) * u, (t + 17f) * u, paint)
+                }
+            }
+            paint.color = BORDER
+            canvas.drawRect((l + 6f) * u, (t + 17f) * u, (l + w - 6f) * u, (t + 17f) * u + 1f, paint)
+            val entries = ladders[tab]
+            if (entries.isEmpty()) {
+                text(canvas, if (tab == 3) "No finished custom runs" else "No times yet", l + w / 2f, t + h / 2f + 6f, 6.5f, DIM, Paint.Align.CENTER)
+                return
+            }
+            val rowH = 14f
+            val rows = minOf(entries.size, ((h - 24f) / rowH).toInt())
+            for ((i, e) in entries.take(rows).withIndex()) {
+                val y = t + 22f + i * rowH
