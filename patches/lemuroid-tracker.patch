+/** The tracker on the secondary display (the Thor's bottom screen). */
+internal class Smz3Presentation(context: Context, display: Display) : Presentation(context, display) {
+    private var panel: Smz3TrackerPanel? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setCancelable(false)   // the second screen's own Back button would close it and leave the system's app drawer
+        window?.setSoftInputMode(android.view.WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE)
+        val built = Smz3TrackerPanel(context).also { it.build() }
+        panel = built
+        setContentView(built)
+        window?.setBackgroundDrawable(android.graphics.drawable.ColorDrawable(Color.BLACK))
+    }
+
+    fun render(snapshot: Smz3Snapshot) {
+        panel?.render(snapshot)
+    }
+
+    private val held = HashSet<Int>()
+
+    override fun dispatchKeyEvent(event: android.view.KeyEvent): Boolean {
+        if (Smz3Hotkeys.focusGameKey(context, event, held)) {
+            focusGame()
+            return true
+        }
+        return super.dispatchKeyEvent(event)
+    }
+
+    override fun dispatchTouchEvent(event: android.view.MotionEvent): Boolean {
+        val w = window
+        if (event.actionMasked == android.view.MotionEvent.ACTION_DOWN && w != null && (w.attributes.flags and NOT_FOCUSABLE) != 0) w.clearFlags(NOT_FOCUSABLE)
+        return super.dispatchTouchEvent(event)
+    }
+
+    /** A screen with no focusable window passes the input focus to the game's, until the next touch here takes it back. */
+    private fun focusGame() {
+        held.clear()
+        window?.addFlags(NOT_FOCUSABLE)
+    }
+
+    private companion object {
+        const val NOT_FOCUSABLE = android.view.WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+    }
+}
