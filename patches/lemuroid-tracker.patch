+// The hint line of the shared menus ("A Open  Select Ladder") drawn as a bar with the Thor's buttons, like the PC build
+private val HINT_WORDS = setOf("A", "B", "X", "Y", "L", "R", "L/R", "Select", "Start", "Up", "Down", "Left", "Right")
+
+private fun isHint(text: String): Boolean = text.substringBefore(' ').trimEnd(':') in HINT_WORDS
+
+private fun drawHintBar(c: android.graphics.Canvas, paint: Paint, scale: Float, hint: String) {
+    val words = hint.split(' ', ',').filter { it.isNotEmpty() }.map { it.trimEnd(':') }
+    val items = ArrayList<Pair<String, String>>()   // button, label
+    var i = 0
+    while (i < words.size) {
+        if (words[i] !in HINT_WORDS) { i++; continue }
+        var button = words[i]; var j = i + 1
+        if (j < words.size && ((button == "Left" && words[j] == "Right") || (button == "Up" && words[j] == "Down") || (button == "L" && words[j] == "R"))) { button += "+" + words[j]; j++ }
+        val label = StringBuilder()
+        while (j < words.size && words[j] !in HINT_WORDS) { if (label.isNotEmpty()) label.append(' '); label.append(words[j]); j++ }
+        items.add(button to label.toString().replaceFirstChar { it.uppercase() })
+        i = j
+    }
+    val top = (H - 16f) * scale; val h = 16f * scale; val w = W * scale
+    val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+    fill.color = 0xFF0C1119.toInt(); c.drawRect(0f, top, w, top + h, fill)
+    fill.color = 0xFF25324A.toInt(); c.drawRect(0f, top, w, top + maxOf(1f, h * 0.03f), fill)
+    val ih = h * 0.62f; val cy = top + h / 2; val gap = ih * 1.1f
+    val text = Paint(paint).apply { textAlign = Paint.Align.LEFT }
+    val glyphText = Paint(paint).apply { textAlign = Paint.Align.CENTER; color = 0xFF0C1119.toInt() }
+    fun pillLabel(b: String) = when (b) { "Select" -> "SELECT"; "Start" -> "START"; "L" -> "L1"; "R" -> "R1"; else -> b }
+    fun glyphW(b: String): Float = when (b) {
+        "A", "B", "X", "Y", "Up", "Down", "Left", "Right", "Left+Right", "Up+Down" -> ih
+        "L+R" -> 2 * ih * 1.4f + ih * 0.2f
+        else -> { glyphText.textSize = ih * 0.52f; maxOf(ih, glyphText.measureText(pillLabel(b)) + ih * 0.7f) }
+    }
+    text.textSize = ih * 0.92f
+    var total = 0f
+    for ((k, it) in items.withIndex()) total += glyphW(it.first) + ih * 0.3f + text.measureText(it.second) + if (k > 0) gap else 0f
+    var x = maxOf(4f * scale, w - total - h * 0.8f)
+    for ((b, label) in items) {
+        val gw = glyphW(b)
+        fill.color = 0xFFC7D0DE.toInt()
+        when (b) {
+            "A", "B", "X", "Y" -> {
+                c.drawCircle(x + ih / 2, cy, ih / 2, fill)
+                glyphText.textSize = ih * 0.72f
+                c.drawText(b, x + ih / 2, cy + ih * 0.26f, glyphText)
+            }
+            "Up", "Down", "Left", "Right", "Left+Right", "Up+Down" -> {   // a D-pad cross, the arms in use lit
+                val t = ih / 3
+                fill.color = 0xFF4A5670.toInt()
+                c.drawRect(x, cy - t / 2, x + ih, cy + t / 2, fill); c.drawRect(x + t, cy - ih / 2, x + 2 * t, cy + ih / 2, fill)
+                fill.color = 0xFFC7D0DE.toInt()
+                if ("Left" in b) c.drawRect(x, cy - t / 2, x + t, cy + t / 2, fill)
+                if ("Right" in b) c.drawRect(x + 2 * t, cy - t / 2, x + ih, cy + t / 2, fill)
+                if ("Up" in b) c.drawRect(x + t, cy - ih / 2, x + 2 * t, cy - t / 2, fill)
+                if ("Down" in b) c.drawRect(x + t, cy + t / 2, x + 2 * t, cy + ih / 2, fill)
+            }
+            else -> {
+                val parts = if (b == "L+R") listOf("L1", "R1") else listOf(pillLabel(b))
+                var px = x
+                glyphText.textSize = ih * 0.52f
+                for (p in parts) {
+                    val pw = if (b == "L+R") ih * 1.4f else gw
+                    c.drawRoundRect(px, cy - ih / 2, px + pw, cy + ih / 2, ih / 2, ih / 2, fill)
+                    c.drawText(p, px + pw / 2, cy + ih * 0.19f, glyphText)
+                    px += pw + ih * 0.2f
+                }
+            }
+        }
+        text.color = 0xFFB8C2D4.toInt()
+        c.drawText(label, x + gw + ih * 0.3f, cy + ih * 0.32f, text)
+        x += gw + ih * 0.3f + text.measureText(label) + gap
+    }
+}
