+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Rewind.kt
@@ -0,0 +1,140 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.os.SystemClock
+import android.view.KeyEvent
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunStore
+import com.swordfish.libretrodroid.GLRetroView
+
+/**
+ * Rewind: an option of the run, never on a run that sends a time online. While it is on, LibretroDroid keeps a state of
+ * every frame for up to a minute; opening stops the game on the newest one, the held direction moves through them, and
+ * closing plays on from the frame shown or goes back to the present. The game clock keeps running meanwhile.
+ */
+object Smz3Rewind {
+    const val SFX_OPEN = 0
+    const val SFX_TICK_BACK = 1
+    const val SFX_TICK_FWD = 2
+    const val SFX_PLAY = 3
+    const val SFX_CANCEL = 4
+    private const val RATE = 44100
+
+    @Volatile var view: GLRetroView? = null
+    /** True from the open request until the game plays again; the tracker reads nothing meanwhile. */
+    @Volatile var isOpen = false
+        private set
+    @Volatile var direction = 0
+        private set
+    private val held = HashMap<Int, Int>()
+    private var nextTick = 0L
+    private val tracks = arrayOfNulls<AudioTrack>(5)
+
+    fun allowed(context: Context): Boolean {
+        if (Smz3Hotkeys.noAutosave(context)) return false
+        val run = RunStore.activeSlot(context)?.let { RunStore.load(context, it) } ?: return false
+        return runCatching { org.json.JSONObject(run.settings).optBoolean("rewind", false) }.getOrDefault(false)
+    }
+
+    /** Called once the game view exists: rewind keeps its history only when the run allows it. */
+    fun attach(context: Context, retroView: GLRetroView) {
+        view = retroView
+        isOpen = false
+        // a race's game waits on its first frame for the countdown; the daily, which also sets on (for its chat), has none
+        if (Smz3RaceState.on && !Smz3RaceState.daily && !Smz3RaceState.started) retroView.setHeld(true)
+        retroView.rewindEnabled = allowed(context)
+    }
+
+    private var openWait = 0
+
+    /** Cursor, states kept, open (1) or not; -1 each while rewind is off. Polled once a frame: an open the core never
+     * carried out (or one a save ended) gives the keys back after half a second. */
+    fun position(): IntArray {
+        val p = view?.rewindPosition() ?: intArrayOf(-1, -1, -1)
+        if (isOpen && p[2] != 1) {
+            if (++openWait > 30) { isOpen = false; direction = 0; held.clear(); openWait = 0 }
+        } else openWait = 0
+        return p
+    }
+
+    fun open(): Boolean {
+        val v = view ?: return false
+        val p = v.rewindPosition()
+        if (isOpen || p[1] < 2) return false
+        v.rewindOpen()
+        isOpen = true
+        direction = 0
+        held.clear()
+        sound(SFX_OPEN)
+        return true
+    }
+
+    fun hold(dir: Int) {
+        if (!isOpen || dir == direction) return
+        direction = dir
+        view?.rewindHold(dir)
+    }
+
+    fun close(playFromCursor: Boolean) {
+        if (!isOpen) return
+        view?.rewindHold(0)
+        view?.rewindClose(playFromCursor)
+        isOpen = false
+        direction = 0
+        held.clear()
+        if (playFromCursor) Smz3Tracker.stateLoaded = 3
+        sound(if (playFromCursor) SFX_PLAY else SFX_CANCEL)
+    }
+
+    /** A tick when the cursor moved, spaced by the speed it is going at. */
+    fun cursorMoved(heldMs: Long) {
+        val now = SystemClock.elapsedRealtime()
+        if (direction == 0 || now < nextTick) return
+        nextTick = now + if (heldMs < 1200) 160 else if (heldMs < 3000) 110 else 75
+        sound(if (direction < 0) SFX_TICK_BACK else SFX_TICK_FWD)
+    }
+
+    /** While open, every key is the rewind screen's: back / forward while held, A plays on, B goes back to now. */
+    fun onKey(context: Context, event: KeyEvent): Boolean {
+        if (!isOpen) return false
+        val code = event.keyCode
+        val back = code == KeyEvent.KEYCODE_DPAD_LEFT || code == KeyEvent.KEYCODE_BUTTON_L1 || code == KeyEvent.KEYCODE_BUTTON_L2 ||
+            code in Smz3Hotkeys.keys(context, Smz3HotkeyAction.REWIND)
+        val fwd = code == KeyEvent.KEYCODE_DPAD_RIGHT || code == KeyEvent.KEYCODE_BUTTON_R1 || code == KeyEvent.KEYCODE_BUTTON_R2
+        when (event.action) {
+            KeyEvent.ACTION_DOWN -> if (event.repeatCount == 0) {
+                when {
+                    back || fwd -> held[code] = if (back) -1 else 1
+                    code == KeyEvent.KEYCODE_BUTTON_A || code == KeyEvent.KEYCODE_ENTER -> close(true)
+                    code == KeyEvent.KEYCODE_BUTTON_B || code == KeyEvent.KEYCODE_BACK || code == KeyEvent.KEYCODE_ESCAPE -> close(false)
+                }
+            }
+            KeyEvent.ACTION_UP -> held.remove(code)
+        }
+        if (isOpen) hold(held.values.lastOrNull() ?: 0)
+        return true
+    }
+
+    /** Opening from a hotkey still held rewinds at once, until those keys are let go. */
+    fun heldOnOpen(keys: List<Int>) {
+        for (k in keys) held[k] = -1
+        hold(-1)
+    }
+
+    fun sound(kind: Int) {
+        runCatching {
+            val track = tracks[kind] ?: Smz3Native.rewindSound(kind, RATE).let { pcm ->
+                AudioTrack.Builder()
+                    .setAudioAttributes(AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_GAME).setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION).build())
+                    .setAudioFormat(AudioFormat.Builder().setEncoding(AudioFormat.ENCODING_PCM_16BIT).setSampleRate(RATE).setChannelMask(AudioFormat.CHANNEL_OUT_MONO).build())
+                    .setTransferMode(AudioTrack.MODE_STATIC).setBufferSizeInBytes(maxOf(2, pcm.size * 2)).build()
+                    .also { it.write(pcm, 0, pcm.size); tracks[kind] = it }
+            }
+            if (track.playState == AudioTrack.PLAYSTATE_PLAYING) track.stop()
+            track.reloadStaticData()
+            track.play()
+        }
+    }
+}
