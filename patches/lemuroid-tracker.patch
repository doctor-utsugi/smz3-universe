+    }
+
+    private fun ordinal(n: Int) = n.toString() + if (n % 100 / 10 == 1) "th" else when (n % 10) { 1 -> "st"; 2 -> "nd"; 3 -> "rd"; else -> "th" }
+
+    private fun sorted() = (0 until players.length()).map { players.getJSONObject(it) }.sortedBy { if (it.optInt("place") > 0) it.optInt("place") else 99 }
+
+    private fun table(): String = sorted().joinToString("\n") { p -> listOf(place(p), p.optString("name"), timeOf(p)).filter { it.isNotEmpty() }.joinToString("   ") }
