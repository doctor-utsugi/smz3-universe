+    private fun clickables(v: View, out: MutableList<View>) {
+        if (!v.isShown) return
+        if (v.isClickable && v.isEnabled) { out += v; return }
+        if (v is ViewGroup) for (i in 0 until v.childCount) clickables(v.getChildAt(i), out)
+    }
