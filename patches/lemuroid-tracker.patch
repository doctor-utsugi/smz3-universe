+                    goalsRun = true
+                } else if (set != null) {
+                    goals.setRules(set.optInt("ganonCrystals", 7), set.optInt("ganonsTowerCrystals", 7), set.optInt("tourianBosses", 4))
+                    goalsRun = true
+                }
+            }
+        }
