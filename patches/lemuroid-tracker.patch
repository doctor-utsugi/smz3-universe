+    private var format = ""
+    private var endWhy = ""
+    private var code = ""
+    private var you = ""
+    private var goAt = 0L
+    private var startAt = 0L
+    private var endAt = 0L
+    private var resumeAt = 0L
+    private var pauses = 0
+    private var voteBy = ""
+    private var voteAt = 0L
+    private var voteYes = JSONArray()
+    private var voteDone = 0L
+    private var offset = 0L
+    private var synced = false
