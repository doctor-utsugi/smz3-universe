+private val itemIcons = mutableMapOf<String, ImageBitmap?>()
+
+@Composable
+private fun RecentItem(index: Int) {
+    val context = LocalContext.current
+    val info = remember(index) { Smz3Native.inventoryInfo(index).split("|") }
+    val file = info.getOrNull(2)?.replace(" ", "_")
+    val icon = remember(file) {
+        file?.let { name ->
+            itemIcons.getOrPut(name) {
+                runCatching { context.assets.open("smz3/items/$name").use { BitmapFactory.decodeStream(it)?.asImageBitmap() } }.getOrNull()
+            }
+        }
+    }
+    Row(Modifier.padding(top = 3.dp), verticalAlignment = Alignment.CenterVertically) {
+        if (icon != null) Image(icon, null, Modifier.size(16.dp)) else Spacer(Modifier.size(16.dp))
+        Text(info.getOrElse(1) { "" }, color = TEXT, fontSize = 12.sp, modifier = Modifier.padding(start = 5.dp), maxLines = 1)
+    }
+}
