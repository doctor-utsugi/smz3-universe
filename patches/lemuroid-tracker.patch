diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/AppUpdate.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/AppUpdate.kt
new file mode 100644
index 0000000..fa51cc8
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/AppUpdate.kt
@@ -0,0 +1,91 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.provider.Settings
+import androidx.core.content.FileProvider
+import org.json.JSONObject
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * The self-update: /api/version names the newest release, whose APK is downloaded to the cache and handed to the system
+ * installer. Release APKs share the signing key, so it installs over this one and keeps its data.
+ */
+object AppUpdate {
+    private const val APK = "SMZ3-android-arm64.apk"
+
+    private fun base(): String = OnlineLadder.server()
+
+    /** The last /api/version answer, kept for the menu's next opening. */
+    @Volatile var latest: String? = null
+        private set
+    private var checkedAt = 0L
+
+    /** Asks the server at most every 30 minutes; the answer, or null when it was not asked or failed. Call off the main thread. */
+    fun check(): String? {
+        if (System.currentTimeMillis() - checkedAt < 30 * 60_000L) return null
+        checkedAt = System.currentTimeMillis()
+        return runCatching {
+            val c = URL(base() + "/api/version").openConnection() as HttpURLConnection
+            c.connectTimeout = 8000
+            c.readTimeout = 8000
+            try { if (c.responseCode == 200) c.inputStream.bufferedReader().use { it.readText() } else null } finally { c.disconnect() }
+        }.getOrNull()?.also { latest = it }
+    }
+
+    fun tag(): String = runCatching { JSONObject(latest!!).getString("tag") }.getOrDefault("")
+
+    private fun apkFile(context: Context) = File(File(context.cacheDir, "update").apply { mkdirs() }, "smz3.apk")
+
+    /** Downloads the newest release's APK (redirects followed), reporting 0-100 to [progress]. Call off the main thread. */
+    fun download(context: Context, progress: (Int) -> Unit): File {
+        val url = JSONObject(latest ?: error("No update")).getString("base") + APK
+        val out = apkFile(context)
+        val c = URL(url).openConnection() as HttpURLConnection
+        c.connectTimeout = 15000
+        c.readTimeout = 30000
+        try {
+            if (c.responseCode != 200) error("HTTP ${c.responseCode}")
+            val total = c.contentLengthLong
+            var done = 0L
+            c.inputStream.use { input ->
+                out.outputStream().use { output ->
+                    val buf = ByteArray(64 * 1024)
+                    while (true) {
+                        val n = input.read(buf)
+                        if (n < 0) break
+                        output.write(buf, 0, n)
+                        done += n
+                        if (total > 0) progress((done * 100 / total).toInt())
+                    }
+                }
+            }
+            if (total > 0 && done != total) error("Download cut short")
+        } catch (e: Exception) {
+            out.delete()
+            throw e
+        } finally {
+            c.disconnect()
+        }
+        return out
+    }
+
+    /** False when Android needs the user to allow this app to install others first. */
+    fun canInstall(context: Context): Boolean = Build.VERSION.SDK_INT < 26 || context.packageManager.canRequestPackageInstalls()
+
+    fun askInstallPermission(context: Context) {
+        context.startActivity(Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, Uri.parse("package:" + context.packageName)))
+    }
+
+    fun install(context: Context, apk: File) {
+        val uri = FileProvider.getUriForFile(context, context.packageName + ".update", apk)
+        context.startActivity(
+            Intent(Intent.ACTION_VIEW).setDataAndType(uri, "application/vnd.android.package-archive")
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_ACTIVITY_NEW_TASK),
+        )
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/AppBackup.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/AppBackup.kt
new file mode 100644
index 0000000..2d69b72
