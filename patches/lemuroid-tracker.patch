+        if (a == null) { dailyStrip.visibility = View.GONE; dailyBlock.visibility = View.GONE; return false }
+        val now = System.currentTimeMillis()
+        val left = a.closesAt - now
+        // the strip over the tabs, on every tab: what used to sit over the game
+        val strip = android.text.SpannableStringBuilder()
+        fun part(t: CharSequence, c: Int) {
+            if (strip.isNotEmpty() && strip.last() != '\n') strip.append("    ")
+            val from = strip.length
+            strip.append(t)
+            strip.setSpan(android.text.style.ForegroundColorSpan(c), from, strip.length, 0)
+        }
+        if (daily.shown(context, 0)) part(if (left > 0) "Closes in ${daily.span(left)}" else "Window closed", if (left < 15 * 60_000) Color.rgb(0xE0, 0x5A, 0x4F) else Color.WHITE)
+        if (daily.shown(context, 1) && !finishedRun) part(daily.clock(now - a.clockFrom), Color.WHITE)
+        if (daily.shown(context, 2)) part(Smz3GoalIcon.withIcon(context, a.goal, (dailyStrip.textSize * 1.2f).toInt()), Color.rgb(0xF2, 0xA3, 0x3A))
+        if (daily.shown(context, 3) && a.nextHintAt > 0 && !finishedRun) part("Next hint in ${daily.span(a.nextHintAt - now)}", Color.rgb(0x87, 0x93, 0xA6))
+        Smz3DailyOverlay.latestNote?.takeIf { it.second > now && daily.shown(context, 2) }?.let { (t, _) -> strip.append("\n"); part("Hint: $t", Color.rgb(0xF2, 0xA3, 0x3A)) }
+        Smz3DailyOverlay.playersNote?.takeIf { it.second > now && !finishedRun }?.let { (t, _) -> strip.append("\n"); part("\u25CF $t", Color.rgb(0x4C, 0xC3, 0x8A)) }
+        dailyStrip.text = strip
+        dailyStrip.visibility = if (strip.isEmpty()) View.GONE else View.VISIBLE
+        if (!finishedRun) time.text = daily.clock(now - a.clockFrom)   // the challenge runs on the real clock
+        // on the run tab the challenge's goal takes the place of the completion bars
+        dailyBlock.set(a.goal, finishedRun, daily.players,
+            if (a.nextHintAt > 0 && !finishedRun) "hint in ${daily.span(a.nextHintAt - now)}" else if (a.hints.isNotEmpty()) "every hint out" else "",
+            if (left > 0) "${daily.span(left)} left" else "closed", left in 1 until 15 * 60_000)
+        dailyBlock.visibility = View.VISIBLE
+        // its hints, in order, on the HELP tab (the helps themselves are off in a challenge)
+        tabs.getOrNull(HELP_TAB)?.visibility = View.VISIBLE
+        helpStatus.text = if (a.nextHintAt > 0) "Hints come on a timer. Next one in ${daily.span(a.nextHintAt - now)}." else "Every hint is out."
+        hintButton.visibility = View.GONE
+        revealButton.visibility = View.GONE
+        regionPicker.visibility = View.GONE
+        helpHistory.text = if (a.hints.isEmpty()) "" else "Hints so far\n\n" + a.hints.joinToString("\n\n") { (at, t) -> "${(at - a.startedAt) / 60_000} min   $t" }
+        return true
+    }
