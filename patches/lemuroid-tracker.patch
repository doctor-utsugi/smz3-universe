+{"choices":{"keysanity":[{"value":"None","label":"None"},{"value":"Both","label":"Both Games"},{"value":"Zelda","label":"Zelda Only"},{"value":"SuperMetroid","label":"Metroid Only"},{"value":"Random","label":"Random"}],"itemPlacement":[{"value":"Anywhere","label":"Anywhere"},{"value":"DungeonsAndMetroid","label":"Dungeons and anywhere in Metroid"},{"value":"CrystalDungeonsAndMetroid","label":"Crystal dungeons and anywhere in Metroid"},{"value":"SameGame","label":"Vanilla game, but randomized location"},{"value":"OppositeGame","label":"Opposite game"}],"gameMode":[{"value":"Vanilla","label":"Collect crystals and defeat Metroid bosses"},{"value":"AllDungeons","label":"All dungeons and defeat Metroid bosses"},{"value":"SpazerHunt","label":"Spazer Hunt (auto tracking required)"}],"tourianBossDoor":[{"value":"Closed","label":"Require Crateria boss keycard"},{"value":"Open","label":"Open by default"},{"value":"Random","label":"Random"}],"pyramidHole":[{"value":"Closed","label":"Opens after Ganon\u0027s Tower is completed"},{"value":"Open","label":"Open by default"},{"value":"Random","label":"Random"}]},"logic":[{"name":"PreventScrewAttackSoftLock","label":"Prevent Screw Attack Soft Locks","tip":"You\u0027re not expected to use Screw Attack without the morph ball.","group":"CasMiddle","value":false},{"name":"PreventFivePowerBombSeed","label":"Prevent Five Power Bomb Seeds","tip":"You\u0027re expected to have at least two power bomb upgrades for navigation in Super Metroid. Will require tracking multiple power bombs.","group":"CasMiddle","value":false},{"name":"LeftSandPitRequiresSpringBall","label":"Left Sand Pit Needs Spring Ball","tip":"You\u0027re expected to have the spring ball to navigate the left sand pit in Maridia.","group":"CasMiddle","value":false},{"name":"LaunchPadRequiresIceBeam","label":"Launchpad Needs Ice Beam","tip":"You\u0027re expected to have the ice beam to freeze the boyons to run over to get speed for a shine spark in the old Tourian launchpad in central Crateria.","group":"CasMiddle","value":false},{"name":"WaterwayNeedsGravitySuit","label":"Waterway Needs Gravity Suit","tip":"You\u0027re expected to have the gravity suit to be able to access the Waterway in Pink Brinstar.","group":"CasMiddle","value":false},{"name":"EasyEastCrateriaSkyItem","label":"Easy East Crateria Sky Item","tip":"You\u0027re expected to have the space jump or speed booster to get the item in the sky in East Crateria after Wrecked Ship.","group":"CasMiddle","value":false},{"name":"EasyBlueBrinstarTop","label":"Easy Blue Brinstar Top Access","tip":"You\u0027re expected to have the space jump or gravity suit to get to the room up at the top of blue brinstar with the two items.","group":"CasMiddle","value":false},{"name":"KholdstareNeedsCaneOfSomaria","label":"Kholdstare Needs Somaria","tip":"You\u0027re expected to have the Cane of Somaria to get to Kholdstare to prevent from having to clear Ice Palace the vanilla way.","group":"CasMiddle","value":false},{"name":"ZoraNeedsRupeeItems","label":"Zora Needs Rupee Items","tip":"You\u0027re expected to find enough rupee items at locations in order to purchase the item from Zora so that you don\u0027t have to farm rupees from enemies, the Houlihan room, etc.","group":"CasMiddle","value":false},{"name":"QuarterMagic","label":"Include Quarter Magic","tip":"Adds an additional progressive half magic to the item pool.","group":"CasMiddle","value":false},{"name":"PreventLowResourceDarkWorld","label":"Prevent Low Resource Dark World","tip":"You\u0027re expected to at least 6 hearts total and some weapon that can deal damage before going to the Dark World.","group":"CasMiddle","value":false},{"name":"FireRodDarkRooms","label":"Fire Rod for Dark Rooms","tip":"You\u0027re expected to be able to use the fire rod to light torches for navigating Hyrule Castle escape, Eastern Palace Armos Knights, and select rooms in Palace of Darkness.","group":"TricksMiddle","value":false},{"name":"InfiniteBombJump","label":"Infinite Bomb Jump","tip":"You\u0027re expected to be able to use specially timed morph bombs to access high locations.","group":"TricksMiddle","value":false},{"name":"ParlorSpeedBooster","label":"Parlor Speed Booster Break In","tip":"You\u0027re expected to be able to use the speed booster to burst through to the Terminator Room/Brinstar without morph/power bombs or screw attack.","group":"TricksMiddle","value":false},{"name":"MoatSpeedBooster","label":"Moat Speed Booster Fly By","tip":"You\u0027re expected to be able to use the speed booster to shine spark over the moat in order to get to the Wrecked Ship.","group":"TricksMiddle","value":false},{"name":"MockBall","label":"Mockball","tip":"You\u0027re expected to be able to use to mockball to avoid having the speed booster at the entrance to Green Brinstar and Upper Norfair West.","group":"TricksMiddle","value":false},{"name":"SwordOnlyDarkRooms","label":"Sword Only Dark Rooms","tip":"Excluding Hyrule Castle Tower, you\u0027re expected to be able to pass through dark rooms without any light and using only your sword to navigate.","group":"TricksMiddle","value":false},{"name":"LightWorldSouthFakeFlippers","label":"Light World South Fake Flippers","tip":"You\u0027re expected to be able to use fake flippers in the Light World South near Lake Hylia to access under the bridge and, if you have the moon pearl, the waterfall fairy chests.","group":"TricksMiddle","value":false}]}
