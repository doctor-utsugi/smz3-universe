@@ -0,0 +1,471 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.os.SystemClock
+import android.view.MotionEvent
+import android.view.View
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.exp
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.pow
+import kotlin.math.roundToInt
+import kotlin.math.sin
+import kotlin.random.Random
+
+/**
+ * The end of a run or a race, on both screens: the top one gets the celebration (flash, rays, confetti, the title letter
+ * by letter and the final time counting up to a fanfare), the bottom one the details one per second and the buttons.
+ * After "Watch the credits" the bottom screen keeps a Back to menu button while the credits roll. A race's card has its
+ * standings as the details, and the rays, confetti and fanfare only when it is won.
+ */
+object Smz3Finish {
+    /** One line of a race's standings: the place, the name, the time or what became of the player. */
+    class Standing(val place: String, val name: String, val value: String, val mine: Boolean)
+
+    class Card(
+        val title: String, val name: String, @Volatile var ladder: String, val ladderBlue: Boolean, val ms: Long,
+        val zelda: Int = 0, val zeldaTotal: Int = 0, val metroid: Int = 0, val metroidTotal: Int = 0,
+        val standings: List<Standing>? = null,
+        /** Shown instead of the time when there is none (a win by the others leaving, a draw). */
+        val big: String? = null,
+        val win: Boolean = true,
+        val accent: Int = Color.rgb(0xF2, 0xA3, 0x3A),
+        @Volatile var a: String = "Main menu",
+        @Volatile var b: String = "Watch the credits",
+    )
+
+    const val T_CARD = 0.10f
+    const val T_TITLE = 0.35f
+    const val T_COUNT = 0.70f
+    const val T_LAND = 2.10f
+    const val T_ROWS = 1.0f   // the bottom screen's first row; one more each second
+    const val ROWS = 4
+    const val T_BUTTONS = T_ROWS + ROWS
+
+    /** The details shown one per second: a race's standings (at most four), or the run's four rows. */
+    fun rows(c: Card) = c.standings?.size?.coerceIn(1, ROWS) ?: ROWS
+    fun tButtons(): Float = card?.let { T_ROWS + rows(it) } ?: T_BUTTONS
+
+    @Volatile var card: Card? = null
+    @Volatile private var startedAt = 0L
+    /** While the card is up; false once it is closed for the credits. */
+    @Volatile var open = false
+    /** The card's A button (Main menu for a run): set by whoever shows the card. */
+    @Volatile var onA: (() -> Unit)? = null
+    /** Its B button (closes the top card for the credits, for a run). */
+    @Volatile var onB: (() -> Unit)? = null
+
+    fun start(c: Card) { card = c; startedAt = SystemClock.uptimeMillis(); open = true; skipped = false }
+
+    /** The game reached its end without a card (a finished run played again): the bottom screen shows the run's details. */
+    fun ended(c: Card) {
+        if (card != null) return
+        card = c; startedAt = SystemClock.uptimeMillis(); open = false; skipped = false
+    }
+
+    fun clear() { card = null; open = false }
+
+    fun time(): Float = (SystemClock.uptimeMillis() - startedAt) / 1000f
+
+    /** A press before the buttons are out only ends the animation: returns true then. */
+    fun skip(): Boolean {
+        val tb = tButtons()
+        if (time() >= tb) return false
+        startedAt = SystemClock.uptimeMillis() - (tb * 1000).toLong()
+        skipped = true
+        return true
+    }
+    @Volatile var skipped = false
+
+    fun pressA() { onA?.invoke() }
+
+    /** A run's B rolls the credits, so the card stays on the second screen without its buttons; a race's only closes. */
+    fun pressB() { if (card?.standings == null) open = false; onB?.invoke() }
+
+    /** The top screen's card in its own window over the game: A and B (and Enter, Back) go to [pressA] and [pressB], the
+     * first press only ends the animation. */
+    fun host(activity: android.app.Activity): android.app.Dialog = android.app.Dialog(activity, android.R.style.Theme_Translucent_NoTitleBar_Fullscreen).apply {
+        setContentView(Smz3FinishTopView(activity, Smz3Box.face(activity)))
+        setCancelable(false)
+        setOnKeyListener { _, code, e ->
+            if (e.action != android.view.KeyEvent.ACTION_UP) return@setOnKeyListener true
+            val yes = code == android.view.KeyEvent.KEYCODE_BUTTON_A || code == android.view.KeyEvent.KEYCODE_ENTER || code == android.view.KeyEvent.KEYCODE_DPAD_CENTER
+            val no = code == android.view.KeyEvent.KEYCODE_BUTTON_B || code == android.view.KeyEvent.KEYCODE_BACK || code == android.view.KeyEvent.KEYCODE_ESCAPE
+            if ((yes || no) && !skip()) { if (yes) pressA() else pressB() }
+            true
+        }
+        show()
+    }
+
+    // ---- sounds, made on the fly like the PC build's
+
+    private const val RATE = 44100
+    private fun note(out: FloatArray, start: Int, hz: Float, ms: Float, vol: Float) {
+        val n = (RATE * ms / 1000).toInt()
+        for (i in 0 until n) {
+            if (start + i >= out.size) break
+            val t = i.toFloat() / RATE
+            val env = min(1f, i / (RATE * 0.004f)) * exp(-t * 5000 / ms)
+            out[start + i] += vol * env * (sin(2 * PI * hz * t).toFloat() + 0.18f * sin(4 * PI * hz * t).toFloat())
+        }
+    }
+
+    private fun play(mix: FloatArray) {
+        Thread {
+            runCatching {
+                val pcm = ShortArray(mix.size) { (max(-1f, min(1f, mix[it])) * 32767).toInt().toShort() }
+                val track = AudioTrack.Builder()
+                    .setAudioAttributes(AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_GAME).setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION).build())
+                    .setAudioFormat(AudioFormat.Builder().setEncoding(AudioFormat.ENCODING_PCM_16BIT).setSampleRate(RATE).setChannelMask(AudioFormat.CHANNEL_OUT_MONO).build())
+                    .setTransferMode(AudioTrack.MODE_STATIC).setBufferSizeInBytes(pcm.size * 2).build()
+                track.write(pcm, 0, pcm.size)
+                track.play()
+                Thread.sleep(pcm.size * 1000L / RATE + 100)
+                track.release()
+            }
+        }.start()
+    }
+
+    private val CUES = arrayOf(
+        floatArrayOf(1318f, 0f, 0f, 45f, 0f, 0.10f), floatArrayOf(880f, 1175f, 0f, 70f, 40f, 0.11f), floatArrayOf(659f, 988f, 0f, 90f, 45f, 0.12f),
+        floatArrayOf(523f, 659f, 784f, 140f, 38f, 0.10f), floatArrayOf(988f, 659f, 0f, 90f, 45f, 0.11f), floatArrayOf(523f, 784f, 1047f, 220f, 55f, 0.12f),
+    )
+    private val cueMix = arrayOfNulls<FloatArray>(CUES.size)
+
+    /** The menu's sounds, the same as the PC's: the UiCue a menu input returned (move, tab, select, open, back, confirm). */
+    fun cue(c: Int) {
+        if (c < 1 || c > CUES.size) return
+        val mix = cueMix[c - 1] ?: CUES[c - 1].let { s ->
+            FloatArray(RATE / 2).also { m -> for (i in 0 until 3) if (s[i] > 0) note(m, (RATE * s[4] * i / 1000).toInt(), s[i], s[3], s[5]) }
+        }.also { cueMix[c - 1] = it }
+        play(mix)
+    }
+
+    fun tick() = play(FloatArray(RATE / 10).also { note(it, 0, 1568f, 60f, 0.08f); note(it, RATE * 30 / 1000, 2093f, 60f, 0.08f) })
+
+    fun row() = play(FloatArray(RATE / 6).also { note(it, 0, 659f, 90f, 0.12f); note(it, RATE * 45 / 1000, 988f, 90f, 0.12f) })
+
+    /** A rising arpeggio that lands on a held major chord. */
+    fun fanfare() = play(FloatArray(RATE * 13 / 10).also { m ->
+        floatArrayOf(523f, 659f, 784f, 1047f).forEachIndexed { i, hz -> note(m, RATE * 70 * i / 1000, hz, 160f, 0.10f) }
+        floatArrayOf(523f, 659f, 784f, 1047f, 1319f).forEach { note(m, RATE * 300 / 1000, it, 900f, 0.055f) }
+    })
+
+    // ---- shared drawing
+
+    val GOLD = Color.rgb(0xF2, 0xA3, 0x3A)
+    val PALE_GOLD = Color.rgb(0xFF, 0xE0, 0x7A)
+    val CARD = Color.rgb(0x10, 0x16, 0x1F)
+    val TEXT = Color.rgb(0xE8, 0xEC, 0xF2)
+    val DIM = Color.rgb(0x87, 0x93, 0xA6)
+    val BLUE = Color.rgb(0x4F, 0xC3, 0xF7)
+    val GREEN = Color.rgb(0x5B, 0xD4, 0x6A)
+    val ORANGE = Color.rgb(0xFF, 0x8A, 0x3D)
+    val TRACK = Color.rgb(0x1D, 0x24, 0x30)
+    private val CONFETTI = intArrayOf(GOLD, PALE_GOLD, GREEN, ORANGE, BLUE, Color.rgb(0xFF, 0x6A, 0xD5))
+
+    fun clamp01(v: Float) = if (v < 0f) 0f else if (v > 1f) 1f else v
+    fun easeOut(p: Float) = clamp01(p).let { 1 - (1 - it).pow(3) }
+    fun backOut(p: Float) = clamp01(p).let { val c = 1.9f; 1 + (c + 1) * (it - 1).pow(3) + c * (it - 1).pow(2) }
+    fun alpha(c: Int, a: Float) = Color.argb((255 * clamp01(a)).toInt(), Color.red(c), Color.green(c), Color.blue(c))
+
+    fun clock(ms: Long): String {
+        val s = ms / 1000
+        return String.format(java.util.Locale.US, "%d:%02d:%02d.%02d", s / 3600, s / 60 % 60, s % 60, ms % 1000 / 10)
+    }
+
+    fun pct(a: Int, b: Int) = if (b > 0) (100.0 * a / b).roundToInt() else 0
+
+    class Confetti {
+        private class P(var x: Float, var y: Float, var vx: Float, var vy: Float, var rot: Float, val vrot: Float, val size: Float, val flutter: Float, val color: Int)
+        private val parts = ArrayList<P>()
+        private val path = Path()
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+        fun burst(x: Float, y: Float, n: Int, speed: Float) = repeat(n) {
+            val a = -PI.toFloat() / 2 + (Random.nextFloat() - 0.5f) * 2.6f
+            val v = speed * (0.45f + 0.55f * Random.nextFloat())
+            parts += P(x, y, cos(a) * v, sin(a) * v, Random.nextFloat() * 6.3f, (Random.nextFloat() - 0.5f) * 14, 0.6f + 0.6f * Random.nextFloat(), Random.nextFloat() * 6.3f, CONFETTI.random())
+        }
+
+        fun rain(w: Float, u: Float) {
+            parts += P(Random.nextFloat() * w, -20 * u, (Random.nextFloat() - 0.5f) * 40 * u, 60 * u + Random.nextFloat() * 80 * u, Random.nextFloat() * 6.3f, (Random.nextFloat() - 0.5f) * 8, 0.5f + 0.5f * Random.nextFloat(), Random.nextFloat() * 6.3f, CONFETTI.random())
+        }
+
+        fun draw(c: Canvas, dt: Float, h: Float, u: Float) {
+            val it = parts.iterator()
+            while (it.hasNext()) {
+                val p = it.next()
+                p.vy = min(p.vy + 520 * u * dt, 170 * u)   // paper falls slowly once it has opened
+                p.vx *= 1 - 1.6f * dt
+                p.x += (p.vx + sin(p.flutter + p.y / (40 * u)) * 30 * u) * dt
+                p.y += p.vy * dt
+                p.rot += p.vrot * dt
+                if (p.y > h + 30 * u) { it.remove(); continue }
+                val w = 9 * u * p.size
+                val hh = 5 * u * p.size * abs(cos(p.rot * 1.7f)) + u   // the spin shows its edge
+                c.save(); c.translate(p.x, p.y); c.rotate(p.rot * 57.3f)
+                paint.color = p.color
+                c.drawRect(-w, -hh, w, hh, paint)
+                c.restore()
+            }
+        }
+    }
+
+    fun rays(c: Canvas, paint: Paint, cx: Float, cy: Float, len: Float, t: Float, a: Float) {
+        val path = Path()
+        for (i in 0 until 14) {
+            val a0 = t * 0.12f + i * 2 * PI.toFloat() / 14
+            val a1 = a0 + PI.toFloat() / 14 * 0.55f
+            path.reset(); path.moveTo(cx, cy); path.lineTo(cx + cos(a0) * len, cy + sin(a0) * len); path.lineTo(cx + cos(a1) * len, cy + sin(a1) * len); path.close()
+            paint.shader = android.graphics.RadialGradient(cx, cy, len, alpha(GOLD, 0.27f * a), Color.TRANSPARENT, android.graphics.Shader.TileMode.CLAMP)
+            c.drawPath(path, paint)
+        }
+        paint.shader = null
+    }
+}
+
+/** The top screen's card. Taps or pad presses go through [Smz3Finish]: the first one ends the animation. */
+@SuppressLint("ViewConstructor")
+class Smz3FinishTopView(context: Context, private val face: Typeface) : View(context) {
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { typeface = face }
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val confetti = Smz3Finish.Confetti()
+    private var last = 0f
+    private var landed = false
+    private var ticks = 0
+    private val menuBox = RectF()
+    private val creditsBox = RectF()
+
+    private fun text(c: Canvas, s: String, x: Float, y: Float, px: Float, color: Int, align: Paint.Align = Paint.Align.CENTER) {
+        paint.textSize = px; paint.color = color; paint.textAlign = align
+        c.drawText(s, x, y + px * 0.8f, paint)
+    }
+
+    override fun onDraw(c: Canvas) {
+        val card = Smz3Finish.card ?: return
+        val t = Smz3Finish.time()
+        val dt = (t - last).coerceIn(0f, 0.05f)
+        last = t
+        val w = width.toFloat(); val h = height.toFloat(); val u = min(h / 560f, w / 900f); val mx = w / 2
+        val race = card.standings?.takeIf { !Smz3Tracker.onSecondScreen }   // one screen: the standings go on the card
+        val cw = 700 * u; val ch = (330 + 34 * (race?.size?.coerceAtMost(4) ?: 0) - if (race != null) 34 else 0) * u
+        val pop = Smz3Finish.backOut((t - Smz3Finish.T_CARD) / 0.45f)
+        val cy0 = (h - ch) / 2; val cy = cy0 + (1 - pop) * 60 * u
+        val inA = Smz3Finish.clamp01((t - Smz3Finish.T_CARD) / 0.3f)
+
+        c.drawColor(Color.argb((185 * Smz3Finish.clamp01(t / 0.3f)).toInt(), 0, 0, 0))
+        if (card.win) {
+            Smz3Finish.rays(c, fill, mx, cy0 + ch / 2, w, t, inA * (0.7f + 0.3f * sin(t * 2.2f)))
+            if (t >= Smz3Finish.T_TITLE && t < Smz3Finish.T_LAND && Random.nextFloat() < 0.25f) confetti.rain(w, u)
+            if (t >= Smz3Finish.T_LAND && Random.nextFloat() < 0.4f) confetti.rain(w, u)
+        }
+        if (t >= Smz3Finish.T_LAND && !landed) {
+            landed = true
+            if (!Smz3Finish.skipped) { if (card.win) Smz3Finish.fanfare() else Smz3Finish.cue(5) }
+            if (card.win) {
+                confetti.burst(mx - 365 * u, cy + 150 * u, 60, 900 * u)
+                confetti.burst(mx + 365 * u, cy + 150 * u, 60, 900 * u)
+            }
+        }
+        confetti.draw(c, dt, h, u)   // behind the card, so the numbers stay readable
+
+        val glow = 0.5f + 0.5f * sin(t * 3.4f)
+        val sc = 0.86f + 0.14f * pop
+        val bw = cw * sc; val bh = ch * sc; val x = mx - bw / 2; val y = cy + (ch - bh) / 2
+        fill.color = Smz3Finish.alpha(card.accent, (if (card.win) 80 + 110 * glow else 70f) / 255f * inA)
+        c.drawRect(x - 4 * u, y - 4 * u, x + bw + 4 * u, y + bh + 4 * u, fill)
+        fill.color = Smz3Finish.alpha(Smz3Finish.CARD, inA)
+        c.drawRect(x, y, x + bw, y + bh, fill)
+        fill.color = Smz3Finish.alpha(if (card.win) Smz3Finish.PALE_GOLD else card.accent, inA)
+        c.drawRect(x, y, x + bw, y + 3 * u, fill)
+
+        // the title, letter by letter
+        val tpx = 36 * u
+        paint.textSize = tpx
+        var lx = mx - paint.measureText(card.title) / 2
+        card.title.forEachIndexed { i, ch1 ->
+            paint.textSize = tpx
+            val lw = paint.measureText(ch1.toString())
+            val lp = Smz3Finish.clamp01((t - Smz3Finish.T_TITLE - i * 0.035f) / 0.22f)
+            if (lp > 0 && ch1 != ' ') {
+                val ls = 1 + 0.9f * (1 - Smz3Finish.backOut(lp))
+                text(c, ch1.toString(), lx + lw / 2, cy + 30 * u - (ls - 1) * tpx / 2, tpx * ls, Smz3Finish.alpha(card.accent, lp))
+            }
+            lx += lw
+        }
+
+        // the final time counting up, then a punch, a ring and the fanfare
+        val cp = Smz3Finish.easeOut((t - Smz3Finish.T_COUNT) / (Smz3Finish.T_LAND - Smz3Finish.T_COUNT))
+        if (card.big == null && t >= Smz3Finish.T_COUNT && t < Smz3Finish.T_LAND && ((t - Smz3Finish.T_COUNT) / 0.11f).toInt() > ticks) { ticks = ((t - Smz3Finish.T_COUNT) / 0.11f).toInt(); Smz3Finish.tick() }
+        val punch = if (t >= Smz3Finish.T_LAND) 1 + 0.18f * exp(-(t - Smz3Finish.T_LAND) * 7) else 1f
+        if (t >= Smz3Finish.T_COUNT) {
+            val a = Smz3Finish.alpha(Smz3Finish.TEXT, (t - Smz3Finish.T_COUNT) / 0.2f)
+            if (card.big != null) text(c, card.big, mx, cy + 104 * u, 44 * u, a)
+            else text(c, Smz3Finish.clock(if (t >= Smz3Finish.T_LAND) card.ms else (card.ms * cp).toLong()), mx, cy + 90 * u - (punch - 1) * 40 * u, 84 * u * punch, a)
+        }
+        if (card.win && t >= Smz3Finish.T_LAND && t < Smz3Finish.T_LAND + 0.7f) {
+            val rp = (t - Smz3Finish.T_LAND) / 0.7f
+            fill.style = Paint.Style.STROKE; fill.strokeWidth = 6 * u * (1 - rp) + u; fill.color = Smz3Finish.alpha(Smz3Finish.PALE_GOLD, 0.8f * (1 - rp))
+            c.drawCircle(mx, cy + 134 * u, 60 * u + 300 * u * Smz3Finish.easeOut(rp), fill)
+            fill.style = Paint.Style.FILL
+        }
+        if (t >= Smz3Finish.T_LAND) {
+            val a = (t - Smz3Finish.T_LAND) / 0.4f
+            val saved = race != null && card.ladder.isNotEmpty()   // a race's time just went to the ladder
+            text(c, if (saved) card.ladder else card.name, mx, cy + 180 * u, 20 * u, Smz3Finish.alpha(if (saved) Smz3Finish.BLUE else Smz3Finish.DIM, a))
+            if (race != null) race.take(4).forEachIndexed { i, s ->   // the standings, a line each
+                val ry = cy + 214 * u + i * 34 * u; val col = Smz3Finish.alpha(if (s.mine) Smz3Finish.GOLD else Smz3Finish.TEXT, a)
+                text(c, s.place, x + 60 * u, ry, 22 * u, col, Paint.Align.LEFT)
+                text(c, s.name, x + 110 * u, ry, 22 * u, col, Paint.Align.LEFT)
+                text(c, s.value, x + bw - 60 * u, ry, 22 * u, col, Paint.Align.RIGHT)
+            }
+            else text(c, card.ladder, mx, cy + 216 * u, 20 * u, Smz3Finish.alpha(if (card.ladderBlue) Smz3Finish.BLUE else Smz3Finish.DIM, a))
+        }
+        val tb = Smz3Finish.tButtons()
+        if (t >= tb) {
+            val a = Smz3Finish.easeOut((t - tb) / 0.3f)
+            val by = cy + ch - 56 * u
+            button(c, menuBox, mx - 250 * u, by, 230 * u, "A", card.a, true, a, u)
+            button(c, creditsBox, mx + 20 * u, by, 230 * u, "B", card.b, false, a, u)
+        }
+        postInvalidateOnAnimation()
+
+        if (t < 0.35f) c.drawColor(Color.argb((150 * (1 - t / 0.35f)).toInt(), 255, 250, 235))
+    }
+
+    private fun button(c: Canvas, box: RectF, x: Float, y: Float, w: Float, key: String, label: String, primary: Boolean, a: Float, u: Float) {
+        box.set(x, y, x + w, y + 40 * u)
+        fill.color = Smz3Finish.alpha(if (primary) Smz3Finish.GOLD else Smz3Finish.TRACK, a)
+        c.drawRoundRect(box, 6 * u, 6 * u, fill)
+        fill.color = Smz3Finish.alpha(if (primary) Smz3Finish.CARD else Smz3Finish.TEXT, a)
+        c.drawCircle(x + 22 * u, y + 20 * u, 12 * u, fill)
+        text(c, key, x + 22 * u, y + 11 * u, 16 * u, Smz3Finish.alpha(if (primary) Smz3Finish.GOLD else Smz3Finish.TRACK, a))
+        text(c, label, x + 42 * u, y + 10 * u, 19 * u, Smz3Finish.alpha(if (primary) Smz3Finish.CARD else Smz3Finish.TEXT, a), Paint.Align.LEFT)
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    override fun onTouchEvent(e: MotionEvent): Boolean {
+        if (e.action != MotionEvent.ACTION_UP) return true
+        if (Smz3Finish.skip()) return true
+        if (menuBox.contains(e.x, e.y)) Smz3Finish.pressA() else if (creditsBox.contains(e.x, e.y)) Smz3Finish.pressB()
+        return true
+    }
+}
+
+/**
+ * The bottom screen once the game has ended: instead of the tracker, the run's details one per second (time, completion,
+ * each world), then the two buttons while the card is up, or Back to menu during the credits.
+ */
+@SuppressLint("ViewConstructor")
+class Smz3FinishPanel(context: Context, private val face: Typeface) : View(context) {
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { typeface = face }
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val menuBox = RectF()
+    private val creditsBox = RectF()
+    private val backBox = RectF()
+    private var rowsSaid = 0
+    private var shownFor: Smz3Finish.Card? = null
+
+    private fun text(c: Canvas, s: String, x: Float, y: Float, px: Float, color: Int, align: Paint.Align = Paint.Align.LEFT) {
+        paint.textSize = px; paint.color = color; paint.textAlign = align
+        c.drawText(s, x, y + px * 0.8f, paint)
+    }
+
+    override fun onDraw(c: Canvas) {
+        val w = width.toFloat(); val h = height.toFloat(); val u = w / 1240f
+        val card = Smz3Finish.card ?: return
+        if (shownFor !== card) { shownFor = card; rowsSaid = 0 }
+        val t = Smz3Finish.time()
+        fill.color = Color.argb((255 * Smz3Finish.clamp01(t / 0.4f)).toInt(), 0x0A, 0x0E, 0x15)
+        c.drawRect(0f, 0f, w, h, fill)
+        if (card.win) Smz3Finish.rays(c, fill, w / 2, -40 * u, h * 1.4f, t, 0.5f * Smz3Finish.clamp01(t / 0.6f))
+
+        text(c, card.title, w / 2, 34 * u, 34 * u, Smz3Finish.alpha(card.accent, t / 0.4f), Paint.Align.CENTER)
+        if (card.standings != null) text(c, card.ladder.ifEmpty { card.name }, w / 2, 76 * u, 24 * u, Smz3Finish.alpha(if (card.ladder.isEmpty()) Smz3Finish.DIM else Smz3Finish.BLUE, t / 0.4f), Paint.Align.CENTER)
+        val lx = 120 * u; val rx = w - 120 * u
+        for (r in 0 until Smz3Finish.rows(card)) {
+            val rt = t - Smz3Finish.T_ROWS - r
+            if (rt < 0) continue
+            if (r >= rowsSaid) { rowsSaid = r + 1; if (!Smz3Finish.skipped) Smz3Finish.row() }
+            val rp = Smz3Finish.easeOut(rt / 0.35f); val grow = Smz3Finish.easeOut(rt / 0.7f)
+            val y = 120 * u + r * 170 * u + (1 - rp) * 24 * u
+            val dim = Smz3Finish.alpha(Smz3Finish.DIM, rp)
+            val s = card.standings?.getOrNull(r)
+            if (s != null) {   // a race: the place, the name, the time
+                val col = Smz3Finish.alpha(if (s.mine) Smz3Finish.GOLD else Smz3Finish.TEXT, rp)
+                text(c, s.place, lx, y - 4 * u, 56 * u, Smz3Finish.alpha(if (s.mine) Smz3Finish.GOLD else Smz3Finish.DIM, rp))
+                text(c, s.name, lx + 110 * u, y - 4 * u, 56 * u, col)
+                text(c, s.value, rx, y - 4 * u, 56 * u, col, Paint.Align.RIGHT)
+                continue
+            }
+            when (r) {
+                0 -> {
+                    text(c, "TIME", lx, y, 28 * u, dim)
+                    text(c, Smz3Finish.clock((card.ms * grow).toLong()), rx, y - 20 * u, 72 * u, Smz3Finish.alpha(Smz3Finish.TEXT, rp), Paint.Align.RIGHT)
+                }
+                1 -> {
+                    val all = Smz3Finish.pct(card.zelda + card.metroid, card.zeldaTotal + card.metroidTotal)
+                    text(c, "COMPLETION", lx, y, 28 * u, dim)
+                    text(c, "${(all * grow).roundToInt()}%", rx, y - 20 * u, 72 * u, Smz3Finish.alpha(Smz3Finish.PALE_GOLD, rp), Paint.Align.RIGHT)
+                }
+                else -> {
+                    val zelda = r == 2
+                    val got = if (zelda) card.zelda else card.metroid; val of = if (zelda) card.zeldaTotal else card.metroidTotal
+                    text(c, if (zelda) "ZELDA" else "METROID", lx, y, 28 * u, dim)
+                    text(c, "$got/$of   ${Smz3Finish.pct(got, of)}%", rx, y - 4 * u, 40 * u, Smz3Finish.alpha(Smz3Finish.TEXT, rp), Paint.Align.RIGHT)
+                    val by = y + 58 * u
+                    fill.color = Smz3Finish.alpha(Smz3Finish.TRACK, rp)
+                    c.drawRoundRect(lx, by, rx, by + 18 * u, 9 * u, 9 * u, fill)
+                    fill.color = Smz3Finish.alpha(if (zelda) Smz3Finish.GREEN else Smz3Finish.ORANGE, rp)
+                    val f = if (of > 0) got.toFloat() / of else 0f
+                    if (f > 0) c.drawRoundRect(lx, by, lx + (rx - lx) * f * grow, by + 18 * u, 9 * u, 9 * u, fill)
+                }
+            }
+        }
+        val tb = Smz3Finish.tButtons()
+        if (t >= tb && !Smz3Finish.open) {   // the credits: one way out
+            val a = Smz3Finish.easeOut((t - tb) / 0.3f)
+            val by = h - 130 * u + (1 - a) * 16 * u
+            backBox.set(w / 2 - 260 * u, by, w / 2 + 260 * u, by + 96 * u)
+            fill.color = Smz3Finish.alpha(Smz3Finish.GOLD, a)
+            c.drawRoundRect(backBox, 10 * u, 10 * u, fill)
+            text(c, "Back to menu", backBox.centerX(), by + 26 * u, 36 * u, Smz3Finish.alpha(Smz3Finish.CARD, a), Paint.Align.CENTER)
+        } else if (t >= tb) {
+            val a = Smz3Finish.easeOut((t - tb) / 0.3f)
+            val by = h - 130 * u + (1 - a) * 16 * u
+            menuBox.set(lx, by, w / 2 - 20 * u, by + 96 * u)
+            creditsBox.set(w / 2 + 20 * u, by, rx, by + 96 * u)
+            fill.color = Smz3Finish.alpha(Smz3Finish.GOLD, a)
+            c.drawRoundRect(menuBox, 10 * u, 10 * u, fill)
+            fill.color = Smz3Finish.alpha(Smz3Finish.TRACK, a)
+            c.drawRoundRect(creditsBox, 10 * u, 10 * u, fill)
+            text(c, card.a, menuBox.centerX(), by + 26 * u, 36 * u, Smz3Finish.alpha(Smz3Finish.CARD, a), Paint.Align.CENTER)
+            text(c, card.b, creditsBox.centerX(), by + 26 * u, 36 * u, Smz3Finish.alpha(Smz3Finish.TEXT, a), Paint.Align.CENTER)
+        }
+        if (t < tb + 1) postInvalidateOnAnimation() else postInvalidateDelayed(33)   // the rays keep turning
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    override fun onTouchEvent(e: MotionEvent): Boolean {
+        if (Smz3Finish.card == null) return false
+        if (e.action != MotionEvent.ACTION_UP) return true
+        if (Smz3Finish.skip()) return true
+        if (!Smz3Finish.open) { if (backBox.contains(e.x, e.y)) Smz3Finish.pressA() }
+        else if (menuBox.contains(e.x, e.y)) Smz3Finish.pressA() else if (creditsBox.contains(e.x, e.y)) Smz3Finish.pressB()
+        return true
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3GoalsView.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3GoalsView.kt
new file mode 100644
index 0000000..6bf12f4
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3GoalsView.kt
@@ -0,0 +1,185 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.view.View
+
+/** What a weekly or monthly run asks for: the crystals and Metroid bosses it needs, then Ganon and Mother Brain with what still keeps them closed. */
+internal class Smz3GoalsView(context: Context) : View(context) {
+    private val density = context.resources.displayMetrics.density
+    private val tokens: List<Bitmap?> = listOf("kraid", "phantoon", "draygon", "ridley").map { name ->
+        runCatching { context.assets.open("smz3/rewards/${name}_boss_token.png").use { BitmapFactory.decodeStream(it) } }.getOrNull()?.let(::cropToArt)
+    }
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val text = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val gem = Path()
+    private val dst = RectF()
+    private var bosses = 0
+    private var crystals = 0
+    private var finished = false
+    private var ganonNeeds = 7
+    private var towerNeeds = 7
+    private var tourianNeeds = 4
+    private var fastGanon = false   // alttpr's Fast Ganon: the pyramid is open and the tower does not count
+    private var textColor = Color.WHITE
+    private var dimColor = Color.GRAY
+    private var accentColor = Color.YELLOW
+    private var face: Typeface? = null
+
+    fun setRules(ganonCrystals: Int, towerCrystals: Int, tourianBosses: Int, fastGanon: Boolean = false) {
+        this.fastGanon = fastGanon
+        ganonNeeds = ganonCrystals.coerceIn(0, 7)
+        towerNeeds = if (fastGanon) 0 else towerCrystals.coerceIn(0, 7)
+        tourianNeeds = tourianBosses.coerceIn(0, 4)
+        invalidate()
+    }
+
+    fun setTheme(theme: Smz3Theme) {
+        textColor = theme.text
+        dimColor = theme.dim
+        accentColor = theme.accent
+        face = theme.typeface
+        invalidate()
+    }
+
+    /** [bossMask]: bit 0 Kraid, 1 Phantoon, 2 Draygon, 3 Ridley. [crystalMask]: bit n-1 is crystal n. [credits]: both final bosses are down. */
+    fun set(bossMask: Int, crystalMask: Int, credits: Boolean) {
+        if (bossMask == bosses && crystalMask == crystals && credits == finished) return
+        bosses = bossMask
+        crystals = crystalMask
+        finished = credits
+        invalidate()
+    }
+
+    private val row get() = 22 * density
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        setMeasuredDimension(MeasureSpec.getSize(widthMeasureSpec), (row * if (Smz3Tracker.smAlone || Smz3Tracker.z3Alone) 3 else 5).toInt())   // a single game: its own goal rows only
+    }
+
+    private fun write(canvas: Canvas, s: String, x: Float, y: Float, size: Float, color: Int, align: Paint.Align = Paint.Align.LEFT) {
+        text.typeface = face
+        text.textSize = size * density
+        text.color = color
+        text.textAlign = align
+        canvas.drawText(s, x, y, text)
+    }
+
+    private fun drawGem(canvas: Canvas, l: Float, t: Float, w: Float, h: Float, done: Boolean, red: Boolean, number: Int) {
+        gem.reset()
+        gem.moveTo(l + w * 0.5f, t)
+        gem.lineTo(l + w, t + h * 0.32f)
+        gem.lineTo(l + w * 0.8f, t + h)
+        gem.lineTo(l + w * 0.2f, t + h)
+        gem.lineTo(l, t + h * 0.32f)
+        gem.close()
+        paint.style = Paint.Style.FILL
+        paint.alpha = 255
+        paint.color = if (!done) Color.parseColor("#2A3340") else if (red) Color.parseColor("#FF6B6B") else Color.parseColor("#4FC3F7")
+        canvas.drawPath(gem, paint)
+        paint.style = Paint.Style.STROKE
+        paint.strokeWidth = 1.5f * density
+        paint.color = if (done) Color.parseColor("#E8F6FF") else Color.parseColor("#667080")
+        canvas.drawPath(gem, paint)
+        paint.style = Paint.Style.FILL
+        if (number > 0) {
+            text.typeface = null
+            text.textSize = h * 0.5f
+            text.textAlign = Paint.Align.CENTER
+            text.color = if (done) Color.parseColor("#0A2230") else Color.parseColor("#8C97A3")
+            canvas.drawText(number.toString(), l + w * 0.5f, t + h * 0.66f, text)
+        }
+    }
+
+    private fun drawBox(canvas: Canvas, x: Float, mid: Float, done: Boolean) {
+        val s = 11 * density
+        dst.set(x, mid - s / 2, x + s, mid + s / 2)
+        paint.style = if (done) Paint.Style.FILL else Paint.Style.STROKE
+        paint.strokeWidth = 1.2f * density
+        paint.color = if (done) Color.parseColor("#4CC38A") else dimColor
+        canvas.drawRect(dst, paint)
+        paint.style = Paint.Style.FILL
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val w = width.toFloat()
+        val got = Integer.bitCount(crystals and 0x7F)
+        val beaten = Integer.bitCount(bosses and 0xF)
+        val crystalsNeeded = maxOf(ganonNeeds, towerNeeds)
+        val ok = Color.parseColor("#4CC38A")
+        val iconsLeft = w * 0.30f
+        val iconsRight = w * 0.84f
+        var y = 0f
+
+        write(canvas, "GOALS", 0f, y + row * 0.7f, 10f, accentColor)
+        y += row
+
+        // crystals: all seven by number when the run wants seven, else as many slots as it wants, filled by count
+        if (!Smz3Tracker.smAlone) {
+            write(canvas, "Crystals", 0f, y + row * 0.68f, 12f, textColor)
+            if (crystalsNeeded > 0) {
+                val slot = minOf(row * 0.75f, (iconsRight - iconsLeft) / crystalsNeeded)
+                val gh = slot * 1.15f
+                for (i in 0 until crystalsNeeded) {
+                    val done = if (crystalsNeeded == 7) crystals and (1 shl i) != 0 else i < got
+                    drawGem(canvas, iconsLeft + i * slot, y + (row - gh) / 2, slot * 0.85f, gh, done, crystalsNeeded == 7 && (i == 4 || i == 5), if (crystalsNeeded == 7) i + 1 else 0)
+                }
+            }
+            write(canvas, "${minOf(got, crystalsNeeded)}/$crystalsNeeded", w, y + row * 0.68f, 12f, if (got >= crystalsNeeded) ok else textColor, Paint.Align.RIGHT)
+            y += row
+        }
+
+        if (!Smz3Tracker.z3Alone) {   // A Link to the Past alone: no Metroid bosses nor Mother Brain
+            // Metroid bosses: the beaten ones first, then the ones still standing, as many as Tourian wants
+            write(canvas, "Bosses", 0f, y + row * 0.68f, 12f, textColor)
+            val order = (0 until 4).filter { bosses and (1 shl it) != 0 } + (0 until 4).filter { bosses and (1 shl it) == 0 }
+            val unit = minOf(row * 0.9f, (iconsRight - iconsLeft) / 4f)
+            for ((k, i) in order.take(tourianNeeds).withIndex()) {
+                val bmp = tokens[i] ?: continue
+                val h = unit * bmp.height / bmp.width
+                dst.set(iconsLeft + k * unit * 1.05f, y + (row - h) / 2, iconsLeft + k * unit * 1.05f + unit, y + (row + h) / 2)
+                paint.alpha = if (bosses and (1 shl i) != 0) 255 else 80
+                canvas.drawBitmap(bmp, null, dst, paint)
+            }
+            paint.alpha = 255
+            write(canvas, "${minOf(beaten, tourianNeeds)}/$tourianNeeds", w, y + row * 0.68f, 12f, if (beaten >= tourianNeeds) ok else textColor, Paint.Align.RIGHT)
+            y += row
+        }
+
+        val boxX = 0f
+        val nameX = 18 * density
+        if (!Smz3Tracker.smAlone) {
+            drawBox(canvas, boxX, y + row / 2, finished)
+            write(canvas, "Ganon", nameX, y + row * 0.68f, 12f, textColor)
+            val tower = towerNeeds - got
+            val ganon = ganonNeeds - got
+            val ganonNote = when {
+                finished -> "Beaten"
+                tower > 0 -> "Tower: $tower crystal${if (tower == 1) "" else "s"} more"
+                ganon > 0 -> "Ganon: $ganon crystal${if (ganon == 1) "" else "s"} more"
+                fastGanon -> "Ganon vulnerable"
+                else -> "Tower open"
+            }
+            write(canvas, ganonNote, w, y + row * 0.68f, 11f, if (finished || (tower <= 0 && ganon <= 0)) ok else dimColor, Paint.Align.RIGHT)
+            y += row
+        }
+
+        if (Smz3Tracker.z3Alone) return
+        drawBox(canvas, boxX, y + row / 2, finished)
+        write(canvas, "Mother Brain", nameX, y + row * 0.68f, 12f, textColor)
+        val tourian = tourianNeeds - beaten
+        val brainNote = when {
+            finished -> "Beaten"
+            tourian > 0 -> "Tourian: $tourian boss${if (tourian == 1) "" else "es"} more"
+            else -> "Tourian open"
+        }
+        write(canvas, brainNote, w, y + row * 0.68f, 11f, if (finished || tourian <= 0) ok else dimColor, Paint.Align.RIGHT)
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Help.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Help.kt
