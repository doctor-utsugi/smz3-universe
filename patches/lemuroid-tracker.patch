+    /** Start or Continue on the Daily screen: makes the window's run in the daily slot unless it is there, then plays it. */
+    fun startDaily() {
+        val window = Smz3Native.uiDailyWindow()
+        if (DailyChallenge.kept(context, window)) { RunStore.load(context, DailyChallenge.SLOT)?.let { play(it, false) }; return }
+        quiet[0] = true   // Start goes straight to the game: no wipe into the busy screen nor back to the list
+        Smz3Native.uiBusy("Starting the challenge ...")
+        version++
+        scope.launch {
+            val outcome = runCatching {
+                val (sm, z3) = onlineBases()
+                    ?: run {
+                        quiet[0] = false
+                        singleRomMissing()?.let { error(it) }
+                        needRoms(RunGenerator.wrongBaseRom) { startDaily() }
+                        return@launch
+                    }
+                val (attempt, server) = withContext(Dispatchers.IO) { DailyChallenge.start(context, window) }.getOrThrow()
+                val made = Smz3Native.dailySettingsJson(server, attempt.check).ifEmpty { error("The challenge's settings do not fit") }
+                Smz3Native.uiSetPlando(null)
+                Smz3Native.uiBusy("Generating the challenge ...")
+                version++
+                val (rom, usedSeed, raw) = onlineGame(sm, z3, made)
+                val settings = JSONObject(raw)
+                RunStore.delete(context, DailyChallenge.SLOT)
+                val romFile = RunStore.newRomFile(context, usedSeed, raw)
+                romFile.writeBytes(rom)
+                val totals = Smz3Native.summarize(ByteArray(0), ByteArray(0))
+                RunStore.save(
+                    context,
+                    Run(
+                        slot = DailyChallenge.SLOT, name = "Daily ${attempt.window}", gameId = 0, createdAt = System.currentTimeMillis(),
+                        zeldaTotal = totals[3], metroidTotal = totals[5], keysanity = settings.optString("keysanity") != "None",
+                        logic = "Vanilla", romPath = romFile.path, seed = usedSeed, settings = raw, mapMode = settings.optString("mapMode", "all"),
+                    ),
+                )
+                OnlineLadder.markRun(context, DailyChallenge.SLOT, false, "")
+                DailyChallenge.begin(context, attempt)
+                RunStore.load(context, DailyChallenge.SLOT)
+            }.onFailure { android.util.Log.e("NativeMenu", "daily start failed", it) }
+            outcome.exceptionOrNull()?.let {
+                Smz3Native.uiBusy((it.message ?: "Cannot start the challenge").take(43))
+                version++
+                kotlinx.coroutines.delay(5000)
+            }
+            outcome.getOrNull()?.let { play(it, false) }
+            quiet[0] = true
+            Smz3Native.uiIdle()
+            refreshSlots()
+            dailyAgain.set(true)
+        }
+    }
