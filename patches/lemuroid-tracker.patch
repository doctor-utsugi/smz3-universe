@@ -0,0 +1,99 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.view.View
+
+/** The token pictures sit in a corner of a 32x32 canvas: keep just the part that is drawn. */
+internal fun cropToArt(bmp: Bitmap): Bitmap {
+    var minX = bmp.width; var minY = bmp.height; var maxX = -1; var maxY = -1
+    for (y in 0 until bmp.height) for (x in 0 until bmp.width) {
+        if (Color.alpha(bmp.getPixel(x, y)) > 0) { minX = minOf(minX, x); minY = minOf(minY, y); maxX = maxOf(maxX, x); maxY = maxOf(maxY, y) }
+    }
+    return if (maxX < 0) bmp else Bitmap.createBitmap(bmp, minX, minY, maxX - minX + 1, maxY - minY + 1)
+}
+
+/** One line with the four Super Metroid boss tokens and the seven numbered crystals; what is still missing is dimmed. */
+internal class Smz3RewardsView(context: Context) : View(context) {
+    private val density = context.resources.displayMetrics.density
+    private val tokens: List<Bitmap?> = listOf("kraid", "phantoon", "draygon", "ridley").map { name ->
+        runCatching { context.assets.open("smz3/rewards/${name}_boss_token.png").use { BitmapFactory.decodeStream(it) } }.getOrNull()?.let(::cropToArt)
+    }
+    // A Link to the Past alone: its pendants where the Metroid bosses go (bit 0 green, 1 blue, 2 red)
+    private val pendants: List<Bitmap?> = listOf("green", "blue", "red").map { name ->
+        runCatching { context.assets.open("smz3/rewards/${name}_pendant_boss_token.png").use { BitmapFactory.decodeStream(it) } }.getOrNull()?.let(::cropToArt)
+    }
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val text = Paint(Paint.ANTI_ALIAS_FLAG).apply { textAlign = Paint.Align.CENTER; isFakeBoldText = true }
+    private val gem = Path()
+    private val dst = RectF()
+    private var bosses = 0
+    private var crystals = 0
+
+    /** [bossMask]: bit 0 Kraid, 1 Phantoon, 2 Draygon, 3 Ridley. [crystalMask]: bit n-1 is crystal n. */
+    fun set(bossMask: Int, crystalMask: Int) {
+        if (bossMask == bosses && crystalMask == crystals) return
+        bosses = bossMask
+        crystals = crystalMask
+        invalidate()
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        setMeasuredDimension(MeasureSpec.getSize(widthMeasureSpec), (28 * density).toInt())
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        // 4 tokens of one unit, a small gap, 7 gems of 0.7 units: the unit is whatever makes them fill the width.
+        val unit = minOf(height.toFloat(), width / (4f + 0.25f + 7 * 0.7f + 0.2f))
+        var x = 0f
+        val top = (height - unit) / 2f
+        val shown = if (Smz3Tracker.z3Alone) pendants else tokens
+        for (i in shown.indices) {
+            val bmp = shown[i]
+            val done = bosses and (1 shl i) != 0
+            if (bmp != null) {
+                val h = unit * bmp.height / bmp.width
+                dst.set(x, (height - h) / 2f, x + unit, (height + h) / 2f)
+                paint.alpha = if (done) 255 else 90
+                canvas.drawBitmap(bmp, null, dst, paint)
+            }
+            x += unit
+        }
+        if (Smz3Tracker.smAlone) return   // the crystals are ALttP's
+        x += unit * 0.25f
+        val gw = unit * 0.7f
+        val gh = unit * 0.9f
+        for (n in 1..7) {
+            val done = crystals and (1 shl (n - 1)) != 0
+            val red = n == 5 || n == 6
+            val l = x
+            val t = (height - gh) / 2f
+            gem.reset()
+            gem.moveTo(l + gw * 0.5f, t)
+            gem.lineTo(l + gw, t + gh * 0.32f)
+            gem.lineTo(l + gw * 0.8f, t + gh)
+            gem.lineTo(l + gw * 0.2f, t + gh)
+            gem.lineTo(l, t + gh * 0.32f)
+            gem.close()
+            paint.style = Paint.Style.FILL
+            paint.alpha = 255
+            paint.color = if (!done) Color.parseColor("#2A3340") else if (red) Color.parseColor("#FF6B6B") else Color.parseColor("#4FC3F7")
+            canvas.drawPath(gem, paint)
+            paint.style = Paint.Style.STROKE
+            paint.strokeWidth = 1.5f * density
+            paint.color = if (done) Color.parseColor("#E8F6FF") else Color.parseColor("#667080")
+            canvas.drawPath(gem, paint)
+            text.textSize = gh * 0.5f
+            text.color = if (done) Color.parseColor("#0A2230") else Color.parseColor("#8C97A3")
+            canvas.drawText(n.toString(), l + gw * 0.5f, t + gh * 0.66f, text)
+            x += gw
+        }
+        paint.style = Paint.Style.FILL
+    }
+}
