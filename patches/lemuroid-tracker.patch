+/**
+ * The game screen when the tracker shares it. Landscape: the game in the middle, run panels in the side bars like the PC
+ * version, the tracker over the game on R3 or the pad's tracker button. Portrait: the game on top, a status line, and
+ * the touch pad below; the tracker unfolds over the pad (with a controller connected it stays there).
+ */
+@Composable
+fun PadKitScope.Smz3SingleScreen(
+    viewModel: BaseGameScreenViewModel,
+    isLandscape: Boolean,
+    touchVisible: Boolean,
+    touchSettings: TouchControllerSettingsManager.Settings?,
+    leftPad: PadComposable?,
+    rightPad: PadComposable?,
+    onGameBounds: (Rect) -> Unit,
+) {
+    val context = LocalContext.current
+    val padScope = this
+    val trackerOpen by Smz3ScreenMode.trackerOpen.collectAsState()
+    val snapshot by Smz3Tracker.latest.collectAsState()
+    val editing by viewModel.isEditControlShown().collectAsState(false)
+
+    DisposableEffect(Unit) {
+        Smz3ScreenMode.singleActive = true
+        com.swordfish.touchinput.radial.layouts.shared.TrackerButton.shown = true
+        onDispose {
+            Smz3ScreenMode.singleActive = false
+            Smz3ScreenMode.trackerOpen.value = false
+            Smz3ScreenMode.syncHold()
+            com.swordfish.touchinput.radial.layouts.shared.TrackerButton.shown = false
+            Smz3Tracker.embedded = null
+        }
+    }
+    LaunchedEffect(isLandscape) { Smz3ScreenMode.landscape = isLandscape }
+    // the tracker's pages are built once, soon after the game starts, and kept: building them on each open made it lag
+    val panel = remember { arrayOfNulls<Smz3TrackerPanel>(1) }
+    LaunchedEffect(Unit) {
+        kotlinx.coroutines.delay(1500)
+        if (panel[0] == null) panel[0] = newPanel(context)
+    }
+    LaunchedEffect(trackerOpen, isLandscape) { Smz3ScreenMode.landscape = isLandscape; Smz3ScreenMode.syncHold() }
+
+    val defaultScale = touchSettings?.scale ?: TouchControllerSettingsManager.DEFAULT_SCALE
+    var left by remember(isLandscape, defaultScale) { mutableStateOf(Smz3PadLayout.load(context, isLandscape, true, defaultScale)) }
+    var right by remember(isLandscape, defaultScale) { mutableStateOf(Smz3PadLayout.load(context, isLandscape, false, defaultScale)) }
+    var leftBounds by remember { mutableStateOf<Rect?>(null) }
+    var rightBounds by remember { mutableStateOf<Rect?>(null) }
+
+    @Composable
+    fun pads(boxModifierLeft: Modifier, boxModifierRight: Modifier) {
+        if (touchSettings == null) return
+        val density = LocalDensity.current
+        fun Modifier.placed(p: Smz3PadLayout.Placement, onBounds: (Rect) -> Unit) =
+            this
+                .offset { with(density) { IntOffset(p.dx.dp.roundToPx(), p.dy.dp.roundToPx()) } }
+                .onGloballyPositioned { onBounds(it.boundsInRoot()) }
+        leftPad?.invoke(padScope, boxModifierLeft.placed(left) { leftBounds = it }, touchSettings.copy(scale = left.scale, marginX = 0f, marginY = 0f))
+        rightPad?.invoke(padScope, boxModifierRight.placed(right) { rightBounds = it }, touchSettings.copy(scale = right.scale, marginX = 0f, marginY = 0f))
+    }
+
+    val menuFont = androidx.compose.runtime.remember { androidx.compose.ui.text.font.FontFamily(com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Box.face(context)) }
+    androidx.compose.runtime.CompositionLocalProvider(androidx.compose.material3.LocalTextStyle provides androidx.compose.material3.LocalTextStyle.current.copy(fontFamily = menuFont)) {   // the menus' font, not Roboto
+        BoxWithConstraints(Modifier.fillMaxSize().windowInsetsPadding(WindowInsets.safeDrawing)) {
+            val portraitGameHeight = maxWidth * (3f / 4f)
+            if (isLandscape) {
+                Box(Modifier.fillMaxSize().onGloballyPositioned { onGameBounds(it.boundsInRoot()) })
+                val gameWidth = maxHeight * (4f / 3f)
+                val side = (maxWidth - gameWidth) / 2
+                val panelsOff by com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3ScreenMode.panelsOff.collectAsState()
+                if (side >= 90.dp && panelsOff != true) {
+                    snapshot?.let { s ->
+                        SidePanelLeft(s, Modifier.align(Alignment.CenterStart).width(side).fillMaxHeight())
+                        SidePanelRight(s, Modifier.align(Alignment.CenterEnd).width(side).fillMaxHeight())
+                    }
+                }
+                if (trackerOpen) {
+                    Box(
+                        Modifier
+                            .align(Alignment.Center)
+                            .fillMaxWidth(0.9f)
+                            .fillMaxHeight(0.92f)
+                            .background(PANEL, RoundedCornerShape(8.dp))
+                            .border(1.dp, TAB, RoundedCornerShape(8.dp)),
+                    ) {
+                        Column(Modifier.fillMaxSize()) {
+                            EmbeddedTracker(Modifier.fillMaxWidth().weight(1f), panel)
+                            Row(
+                                Modifier.fillMaxWidth().padding(horizontal = 10.dp, vertical = 6.dp),
+                                horizontalArrangement = Arrangement.SpaceBetween,
+                                verticalAlignment = Alignment.CenterVertically,
+                            ) {
+                                Text("L1 R1 change tab · D-pad move · A press · R3 or B close", color = DIM, fontSize = 12.sp)
+                                val onClose by Smz3ScreenMode.closeFocused.collectAsState()
+                                SmallButton("Close", if (onClose) Modifier.border(2.dp, Color.White, RoundedCornerShape(6.dp)) else Modifier) {
+                                    Smz3ScreenMode.closeFocused.value = false; Smz3ScreenMode.trackerOpen.value = false
+                                }
+                            }
+                        }
+                    }
+                } else if (touchVisible) {
+                    Box(Modifier.fillMaxSize()) { pads(Modifier.align(Alignment.BottomStart), Modifier.align(Alignment.BottomEnd)) }
+                } else {   // a controller and no touch pad: which button opens the panel, quietly in the corner
+                    Text("R3  Tracker", color = DIM.copy(alpha = 0.55f), fontSize = 11.sp, modifier = Modifier.align(Alignment.BottomStart).padding(start = 8.dp, bottom = 6.dp))
+                }
+            } else {
+                Column(Modifier.fillMaxSize()) {
+                    Box(
+                        Modifier
+                            .fillMaxWidth()
+                            .height(portraitGameHeight)
+                            .onGloballyPositioned { onGameBounds(it.boundsInRoot()) },
+                    )
+                    StatusLine(snapshot, toggle = if (!touchVisible) null else if (trackerOpen) "Pad" else "Tracker")
+                    Box(Modifier.fillMaxWidth().weight(1f)) {
+                        if (!touchVisible || trackerOpen) {
+                            EmbeddedTracker(Modifier.fillMaxSize(), panel)
+                        } else {
+                            pads(Modifier.align(Alignment.BottomStart), Modifier.align(Alignment.BottomEnd))
+                        }
+                    }
+                }
+            }
+
+            if (editing && touchVisible) {
+                PadEditor(
+                    left = left,
+                    right = right,
+                    leftBounds = leftBounds,
+                    rightBounds = rightBounds,
+                    onChange = { isLeft, p -> if (isLeft) left = p else right = p },
+                    onReset = {
+                        Smz3PadLayout.reset(context, isLandscape)
+                        left = Smz3PadLayout.load(context, isLandscape, true, defaultScale)
+                        right = Smz3PadLayout.load(context, isLandscape, false, defaultScale)
+                    },
+                    onDone = {
+                        Smz3PadLayout.save(context, isLandscape, true, left)
+                        Smz3PadLayout.save(context, isLandscape, false, right)
+                        viewModel.showEditControls(false)
+                    },
+                )
+            }
+        }
+    }
+}
+
+/** The tracker's tabs inside the game screen; the tracker thread feeds it while it is attached. */
+@Composable
+private fun EmbeddedTracker(modifier: Modifier, kept: Array<Smz3TrackerPanel?>) {
+    AndroidView(
+        modifier = modifier,
+        factory = { ctx ->
+            val panel = kept[0] ?: newPanel(ctx).also { kept[0] = it }
+            (panel.parent as? android.view.ViewGroup)?.removeView(panel)
+            Smz3Tracker.latest.value?.let { panel.render(it) }
+            Smz3Tracker.embedded = panel
+            panel
+        },
+        onRelease = { if (Smz3Tracker.embedded === it) Smz3Tracker.embedded = null },
+    )
+}
