+    /** The base ROMs of the game shown: SMZ3's two, or one game's alone (the other one empty); null when one is missing. */
+    suspend fun onlineBases(): Pair<ByteArray, ByteArray>? {
+        val games = retrogradeDb.gameDao().selectListBySystem("snes")
+        return when (RunStore.mode) {
+            "sm" -> RunGenerator.findSmRom(context, games)?.let { it to ByteArray(0) }
+            "z3" -> RunGenerator.findZ3Rom(context, games)?.let { ByteArray(0) to it }
+            else -> RunGenerator.findBaseRoms(context, games)
+        }
+    }
