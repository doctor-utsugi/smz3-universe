+/**
+ * Edit mode for the touch pad: drag a group to move it, pinch it (or use the slider) to scale it. Each group keeps its
+ * own place and size, saved apart for landscape and portrait.
+ */
+@Composable
+private fun PadEditor(
+    left: Smz3PadLayout.Placement,
+    right: Smz3PadLayout.Placement,
+    leftBounds: Rect?,
+    rightBounds: Rect?,
+    onChange: (Boolean, Smz3PadLayout.Placement) -> Unit,
+    onReset: () -> Unit,
+    onDone: () -> Unit,
+) {
+    var selectedLeft by remember { mutableStateOf(true) }
+    val density = LocalDensity.current
+    val current = rememberUpdated(left, right)
+    val padBounds = rememberUpdatedState(leftBounds to rightBounds)   // read inside the gesture: a key would restart it mid-drag
+    val change = rememberUpdatedState(onChange)
+    var origin by remember { mutableStateOf(Offset.Zero) }
+
+    Box(
+        Modifier
+            .fillMaxSize()
+            .background(Color(0x66000000))
+            .onGloballyPositioned { origin = it.boundsInRoot().topLeft }
+            .pointerInput(Unit) {
+                awaitEachGesture {
+                    val down = awaitFirstDown(requireUnconsumed = false)
+                    val at = down.position + origin
+                    val (lb, rb) = padBounds.value
+                    when {
+                        rb?.inflate(24f)?.contains(at) == true && lb?.inflate(24f)?.contains(at) != true -> selectedLeft = false
+                        lb?.inflate(24f)?.contains(at) == true -> selectedLeft = true
+                    }
+                }
+            }
+            .pointerInput(Unit) {
+                detectTransformGestures { _, pan, zoom, _ ->
+                    val p = if (selectedLeft) current.value.first else current.value.second
+                    val moved =
+                        p.copy(
+                            dx = p.dx + with(density) { pan.x.toDp().value },
+                            dy = p.dy + with(density) { pan.y.toDp().value },
+                            scale = (p.scale + (zoom - 1f) * 1.5f).coerceIn(Smz3PadLayout.MIN_SCALE, Smz3PadLayout.MAX_SCALE),
+                        )
+                    change.value(selectedLeft, moved)
+                }
+            },
+    ) {
+        val bounds = if (selectedLeft) leftBounds else rightBounds
+        bounds?.let { b ->
+            with(density) {
+                Box(
+                    Modifier
+                        .offset { IntOffset((b.left - origin.x).roundToInt(), (b.top - origin.y).roundToInt()) }
+                        .size(b.width.toDp(), b.height.toDp())
+                        .border(2.dp, GOLD, RoundedCornerShape(12.dp)),
+                )
+            }
+        }
+        Column(
+            Modifier
+                .align(Alignment.Center)
+                .width(280.dp)
+                .background(PANEL, RoundedCornerShape(8.dp))
+                .border(1.dp, TAB, RoundedCornerShape(8.dp))
+                .padding(14.dp),
+        ) {
+            Text("Edit controls", color = GOLD, fontSize = 15.sp, fontWeight = FontWeight.Bold)
+            Text("Drag a pad to move it. Pinch it or use the slider to resize it.", color = DIM, fontSize = 12.sp)
+            Row(Modifier.padding(top = 10.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                Toggle("Left pad", selectedLeft) { selectedLeft = true }
+                Toggle("Right pad", !selectedLeft) { selectedLeft = false }
+            }
+            val p = if (selectedLeft) left else right
+            Slider(
+                value = p.scale,
+                onValueChange = { onChange(selectedLeft, p.copy(scale = it)) },
+                valueRange = Smz3PadLayout.MIN_SCALE..Smz3PadLayout.MAX_SCALE,
+                colors = SliderDefaults.colors(thumbColor = GOLD, activeTrackColor = GOLD, inactiveTrackColor = Color(0xFF1D2430)),
+            )
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                SmallButton("Reset", Modifier, onReset)
+                SmallButton("Done", Modifier, onDone)
+            }
+        }
+    }
+}
+
+@Composable
+private fun Toggle(label: String, on: Boolean, onClick: () -> Unit) {
+    Text(
+        label,
+        color = if (on) GOLD else DIM,
+        fontSize = 13.sp,
+        modifier =
+            Modifier
+                .background(if (on) TAB else Color(0xFF1D2430), RoundedCornerShape(6.dp))
+                .clickable(onClick = onClick)
+                .padding(horizontal = 12.dp, vertical = 6.dp),
+    )
+}
+
+@Composable
+private fun rememberUpdated(
+    left: Smz3PadLayout.Placement,
+    right: Smz3PadLayout.Placement,
+) = remember { mutableStateOf(left to right) }.also { it.value = left to right }
