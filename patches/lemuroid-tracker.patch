+/** The menu's wallpaper, also what a screen change shows between screens: dark, with spores rising like in Brinstar. */
+private fun DrawScope.drawBackdrop(scale: Float, drift: Float) {
+    drawRect(Color(0xFF0A0E15), Offset.Zero, size)
+    drawRect(Brush.verticalGradient(listOf(Color(0xE62A2112), Color(0x002A2112)), startY = 0f, endY = 90f * scale), Offset.Zero, Size(size.width, 90f * scale))
+    drawRect(Brush.verticalGradient(listOf(Color(0x000F2A2C), Color(0xCC0F2A2C)), startY = size.height - 70f * scale, endY = size.height), Offset(0f, size.height - 70f * scale), Size(size.width, 70f * scale))
+    for (i in 0..20) {
+        val d = Math.abs(i * 16 - 160) / 160f
+        drawRect(Color(0xFF4FC3F7).copy(alpha = 0.05f * (1 - d * d)), Offset(i * 16 * scale, 0f), Size(1f, size.height))
+    }
+    for (s in SPORES) {
+        // whole laps and sways per loop, so the loop restarts without a jump
+        val y = 1f - (s[1] + drift * s[2]) % 1f
+        val x = s[0] * size.width + sin((drift * s[4] + s[1]) * 2f * PI.toFloat()) * 9f * scale
+        val fade = minOf(1f, y * 6f, (1f - y) * 6f)
+        val c = if (s[5] < 0.5f) Color(0xFF4CC38A) else Color(0xFF4FC3F7)
+        val r = (0.6f + 0.9f * s[3]) * scale
+        drawCircle(c.copy(alpha = 0.07f * fade), r * 4f, Offset(x, y * size.height))
+        drawCircle(c.copy(alpha = (0.25f + 0.4f * s[3]) * fade), r, Offset(x, y * size.height))
+    }
+}
+
+private val SPORES = kotlin.random.Random(11).let { rnd ->
+    List(42) { floatArrayOf(rnd.nextFloat(), rnd.nextFloat(), (1 + rnd.nextInt(3)).toFloat(), rnd.nextFloat(), (1 + rnd.nextInt(4)).toFloat(), rnd.nextFloat()) }
+}
+
+private fun DrawScope.chamfer(l: Float, t: Float, w: Float, h: Float, cut: Float): Path = Path().apply {
+    moveTo(l + cut, t); lineTo(l + w - cut, t); lineTo(l + w, t + cut); lineTo(l + w, t + h - cut)
+    lineTo(l + w - cut, t + h); lineTo(l + cut, t + h); lineTo(l, t + h - cut); lineTo(l, t + cut); close()
+}
+
+/** Rows and panels get cut corners; the chosen row glows amber and breathes; the title strip is a dark gradient. */
+private fun DrawScope.drawStyledRect(idx: Int, lx: Float, ly: Float, lw: Float, lh: Float, l: Float, t: Float, w: Float, h: Float, scale: Float, pulse: Float, color: Color) {
+    if (idx == 0 && lw >= 318f && lh >= 238f) return
+    if (idx == 1 && lw >= 280f && ly <= 2f) {
+        drawRect(Brush.verticalGradient(listOf(Color(0xFF141B27), Color(0xFF10161F)), startY = t, endY = t + h), Offset(l, t), Size(w, h))
