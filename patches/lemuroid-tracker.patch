+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/** One finished run: [isDefault] tells which of the two ladders it belongs to (default rules or custom rules), [game] its game. */
+data class LeaderboardEntry(val name: String, val seed: String, val timeMs: Long, val finishedAt: Long, val isDefault: Boolean, val game: String = "smz3")
+
+/** Finished runs ranked by play time, one ladder for runs with the default rules and another for custom ones. */
+object Leaderboard {
+    private const val MAX_PER_LADDER = 50
+
+    private fun file(context: Context) = File(File(context.filesDir, "runs").apply { mkdirs() }, "leaderboard.json")
+
+    fun all(context: Context): List<LeaderboardEntry> {
+        val f = file(context)
+        if (!f.exists()) return emptyList()
+        return runCatching {
+            val a = JSONArray(f.readText())
+            List(a.length()) { i ->
+                a.getJSONObject(i).let {
+                    LeaderboardEntry(it.getString("name"), it.optString("seed"), it.getLong("timeMs"), it.optLong("finishedAt"), it.optBoolean("default"), it.optString("game", "smz3"))
+                }
+            }
+        }.getOrDefault(emptyList())
+    }
+
+    /** The fastest [limit] entries of one ladder of the game shown, best first. */
+    fun top(context: Context, isDefault: Boolean, limit: Int = 5): List<LeaderboardEntry> =
+        all(context).filter { it.isDefault == isDefault && it.game == RunStore.mode }.sortedBy { it.timeMs }.take(limit)
+
+    @Synchronized
+    fun add(context: Context, entry: LeaderboardEntry) {
+        val kept = all(context).filter { !(it.finishedAt == entry.finishedAt && it.name == entry.name) } + entry
+        val trimmed = kept.groupBy { it.game to it.isDefault }.values.flatMap { l -> l.sortedBy { it.timeMs }.take(MAX_PER_LADDER) }
+        val json = JSONArray()
+        for (e in trimmed) {
+            json.put(JSONObject().put("name", e.name).put("seed", e.seed).put("timeMs", e.timeMs).put("finishedAt", e.finishedAt).put("default", e.isDefault).put("game", e.game))
+        }
+        file(context).writeText(json.toString())
+    }
+
+    fun format(ms: Long): String {
+        val s = ms / 1000
+        return "%d:%02d:%02d.%02d".format(s / 3600, s / 60 % 60, s % 60, ms % 1000 / 10)   // finished runs: with hundredths
+    }
+}
