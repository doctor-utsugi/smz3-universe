+                val set = runCatching { org.json.JSONObject(com.swordfish.lemuroid.app.mobile.feature.runs.RunStore.load(context, slot)!!.settings) }.getOrNull()
+                val z3 = set?.optJSONObject("z3")
+                if (Smz3Tracker.z3Alone && z3 != null) {   // alttpr's keys; "random" counts as all seven
