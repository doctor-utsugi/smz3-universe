+    /** A challenge's or race's game from its settings [raw]: the ROM, its seed and the settings the run keeps (the single games' get the seed hash). */
+    suspend fun onlineGame(sm: ByteArray, z3: ByteArray, raw: String): Triple<ByteArray, String, String> {
+        val settings = JSONObject(raw)
+        fun rdc(game: Int, key: String) = settings.optString(key).takeIf { it.isNotEmpty() }
+            ?.let { spriteFile(context, game, "$it.rdc") }
+        if (RunStore.mode == "sm") {
+            if (MapRando.isMapRando(raw)) withContext(Dispatchers.IO) { MapRando.ensure(context) }
+            val (rom, kept) = RunGenerator.generateSm(sm, raw, rdc(1, "samusSprite"))
+            Smz3Native.setMode(SMZ_MODE_SM)
+            return Triple(rom, JSONObject(kept).optString("seed"), kept)
+        }
+        if (RunStore.mode == "z3") {
+            val (rom, kept) = RunGenerator.generateZ3Json(z3, raw, rdc(0, "linkSprite"))
+            Smz3Native.setMode(SMZ_MODE_Z3)
+            return Triple(rom, JSONObject(kept).optString("seed"), kept)
+        }
+        val (rom, usedSeed) = RunGenerator.generate(context, sm, z3, settings, rdc(0, "linkSprite"), rdc(1, "samusSprite"))
+        Smz3Native.setMode(0)
+        return Triple(rom, usedSeed, raw)
+    }
