+/** Whole days until the monthly seed changes (it follows the UTC month), counting today as the last one when 0. */
+private fun daysLeftInMonth(): Int {
+    val now = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"))
+    val end = (now.clone() as java.util.Calendar).apply { set(java.util.Calendar.DAY_OF_MONTH, 1); add(java.util.Calendar.MONTH, 1); set(java.util.Calendar.HOUR_OF_DAY, 0); set(java.util.Calendar.MINUTE, 0); set(java.util.Calendar.SECOND, 0) }
+    return ((end.timeInMillis - now.timeInMillis) / 86_400_000L).toInt()
+}
+
+/** Whole days until the weekly seed changes (next Monday 00:00 UTC). */
+private fun daysLeftInWeek(): Int {
+    val now = java.time.ZonedDateTime.now(java.time.ZoneOffset.UTC)
+    val end = now.toLocalDate().with(java.time.temporal.TemporalAdjusters.next(java.time.DayOfWeek.MONDAY)).atStartOfDay(java.time.ZoneOffset.UTC)
+    return (java.time.Duration.between(now, end).toMillis() / 86_400_000L).toInt()
+}
