+        say = label(Gravity.BOTTOM or Gravity.END, Color.rgb(0xE8, 0xEC, 0xF2), pad * 12)
+        endsIn = label(Gravity.TOP or Gravity.CENTER_HORIZONTAL, Color.rgb(0xF2, 0xA3, 0x3A), pad)
+        goalLine = label(Gravity.TOP or Gravity.START, Color.rgb(0xE8, 0xEC, 0xF2), pad).apply { textSize = 12f }
