@@ -0,0 +1,11 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+/** A run's row text as the other versions write it (smz_run_summary): the checks cleared and the play time, short enough for the row. */
+internal fun summary(run: Run): String {
+    val sec = run.playTimeMs / 1000
+    val time = "%d:%02d:%02d".format(sec / 3600, sec / 60 % 60, sec % 60)
+    val checks = if (RunStore.mode == "sm") "Metroid ${run.metroidCleared}/${run.metroidTotal}"   // a single game: its own count
+        else if (RunStore.mode == "z3") "Zelda ${run.zeldaCleared}/${run.zeldaTotal}"
+        else "Zelda ${run.zeldaCleared}/${run.zeldaTotal} - Metroid ${run.metroidCleared}/${run.metroidTotal}"
+    return "$checks - $time"
+}
