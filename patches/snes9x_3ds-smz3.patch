+struct Part { float x, y, vx, vy, rot, vrot, size, flutter; int color; bool on; };
+static Part part[PARTS];
+static u64 cardStart;
+static int64_t cardMs;
+static unsigned cardZ, cardZT, cardM, cardMT;
+static SmzRun finalRun;   // a run finished before: its final counts
+static float cardLastT;
+static int cardTicks, cardRows;
+static bool cardLanded, cardBurst;
+
+static float clamp01(float v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
+static float easeOut(float p) { p = clamp01(p); return 1 - (1 - p) * (1 - p) * (1 - p); }
+static float backOut(float p) { p = clamp01(p); float c = 1.9f; return 1 + (c + 1) * powf(p - 1, 3) + c * powf(p - 1, 2); }
+static float frand() { return (float)rand() / RAND_MAX; }
+static float cardT() { return (osGetTime() - cardStart) / 1000.0f; }
+
+// The game has ended: the card when it ends now, only the details for a run finished before.
+static void cardBegin()
+{
+    cardState = finishedBefore ? 2 : 1;
+    cardStart = osGetTime();
+    cardMs = daily && dailyDoneMs > 1 ? dailyDoneMs : runMs();
+    if (finishedBefore) { cardZ = finalRun.zelda_cleared; cardZT = finalRun.zelda_total; cardM = finalRun.metroid_cleared; cardMT = finalRun.metroid_total; }
+    else { cardZ = trk.zelda_cleared; cardZT = trk.zelda_total; cardM = trk.metroid_cleared; cardMT = trk.metroid_total; }
+    cardLastT = 0; cardTicks = cardRows = 0; cardLanded = cardBurst = finishedBefore;
+    if (finishedBefore) cardTicks = 1000;
+    memset(part, 0, sizeof part);
+    dirty = true;
+}
+
+// A press before the buttons: straight to the end, without the sounds on the way.
+static bool cardSkip()
+{
+    if (cardT() >= T_BUTTONS) return false;
+    cardStart = osGetTime() - (u64)(T_BUTTONS * 1000);
+    cardTicks = 1000; cardRows = CARD_ROWS; cardLanded = cardBurst = true;
+    dirty = true;
+    return true;
+}
