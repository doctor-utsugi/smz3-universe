+// ---- the bottom screen while the run menu is above (the Thor's Smz3IdlePresentation): the logo, the run under the cursor
+// and the ladders, on the menu's 320-wide grid and in its colours
+
+enum { ID_PANEL = 0x141B27, ID_BORDER = 0x25324A, ID_TEXT = 0xE8ECF2, ID_TEXT_HI = 0xFFF4DC, ID_DIM = 0x8793A6, ID_ACCENT = 0xF2A33A,
+       ID_GREEN = 0x4CC38A, ID_BLUE = 0x4FC3F7 };
+
+// A panel with its top left and bottom right corners cut, as in the menu.
+static void idleBox(int l, int t, int w, int h)
+{
+    for (int y = 0; y < h; y++) {
+        int cut0 = 6 - y > 0 ? 6 - y : 0, cut1 = y - (h - 6) > 0 ? y - (h - 6) : 0;
+        fill(l + cut0, t + y, l + w - cut1, t + y + 1, ID_BORDER);
+        if (y > 0 && y < h - 1) fill(l + cut0 + 1, t + y, l + w - cut1 - 1, t + y + 1, ID_PANEL);
+    }
+}
+
+static void idleBar(const char *label, int done, int total, int x, int y, int w, int color)
+{
+    char v[24];
+    text(x, y, ID_DIM, label);
+    snprintf(v, sizeof v, total > 0 ? "%d/%d" : "-", done, total);
+    text(x + w, y, ID_TEXT, v, HALIGN_RIGHT);
+    fill(x, y + 15, x + w, y + 17, ID_BORDER);
+    if (total > 0) fill(x, y + 15, x + w * done / total, y + 17, color);
+}
+
+static void idleLogo(int x, int y, int size)
+{
+    const Preview *p = getPreview("logo");
+    if (!p) return;
+    for (int dy = 0; dy < size; dy++)
+        for (int dx = 0; dx < size; dx++) {
+            const unsigned char *px = p->rgba + ((dy * p->h / size) * p->w + dx * p->w / size) * 4;
+            if (px[3] > 16) fillAlpha(x + dx, y + dy, x + dx + 1, y + dy + 1, px[0] << 16 | px[1] << 8 | px[2], px[3]);
+        }
+}
