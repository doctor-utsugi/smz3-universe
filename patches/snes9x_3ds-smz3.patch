+static int64_t finalMs;   // a run finished before keeps its final time
+static int64_t runMs() { return finishedBefore ? finalMs : trk.base_ms + trk.pending_ms; }
+
+// The clock the RUN tab shows: a daily challenge runs on the real clock from the game's start.
+static int64_t shownClockMs()
+{
+    if (daily && trk.game != 3 && dr.started_at) return smzDailyNowMs() - smz_daily_clock_from(&dr);
+    if (daily && dailyDoneMs > 1) return dailyDoneMs;
+    return runMs();
+}
+
+static void drawDailyStrip()
+{
+    int64_t now = smzDailyNowMs(), left = dr.closes_at - now;
+    bool finished = trk.game == 3;
+    fill(0, 0, 320, STRIP_H, 0x141B27);
+    char a[32], line[160];
+    int x = 6;
+    if (finished) {
+        fmtClock(dailyDoneMs > 1 ? dailyDoneMs : runMs(), a, sizeof a);
+        snprintf(line, sizeof line, "Done in %s", a);
+        text(x, 1, 0x4CC38A, line);
+        x += textW(line) + 14;
+    }
+    smz_daily_span(left, a, sizeof a);
+    snprintf(line, sizeof line, left > 0 ? "Closes in %s" : "Window closed", a);
+    text(x, 1, left < 15 * 60000 ? 0xE05A4F : 0xFFFFFF, line);
+    x += textW(line) + 14;
+    if (!finished) {
+        fmtClock(now - smz_daily_clock_from(&dr), a, sizeof a);
+        text(x, 1, 0xFFFFFF, a);
+        x += textW(a) + 14;
+        if (dr.next_hint_at > 0) {
+            smz_daily_span(dr.next_hint_at - now, a, sizeof a);
+            snprintf(line, sizeof line, "Next hint in %s", a);
+            textFit(x, 1, 316 - x, 0x8793A6, line);
+        }
+    }
+    if (now < newHintUntil && dr.n_hints > 0) {
+        snprintf(line, sizeof line, "Hint: %s", dr.hint[dr.n_hints - 1]);
+        textFit(6, 15, 308, 0xF2A33A, line);
+    } else if (now < playersNoteUntil && dr.players_known) {
+        fill(7, 20, 13, 26, 0x4CC38A);
+        snprintf(line, sizeof line, "%d players on this daily right now", dr.players_now);
+        textFit(18, 15, 296, 0x4CC38A, line);
+    } else textFit(6, 15, 308, 0xF2A33A, dr.goal);
+}
+
+static void drawTabs()
+{
+    int y = topOfTabs(), order[TAB_COUNT], n = shownTabs(order);
+    fill(0, y, 320, y + TAB_H, theme.bg);
+    int w = (320 - PAUSE_W) / n;
+    for (int i = 0; i < n; i++) {
+        int t = order[i], x = i * w;
+        if (t == tab) fill(x, y, x + w, y + TAB_H, theme.tab);
+        text(x, y + 3, t == tab ? theme.accent : theme.dim, TAB_NAMES[t], HALIGN_CENTER, x + w);
+    }
+    // the menu button (three bars): it opens the game menu, and closes it again
+    int px = 320 - PAUSE_W;
+    fill(px, y, 320, y + TAB_H, theme.panel);
+    for (int b = 0; b < 3; b++) fill(px + 6, y + 5 + b * 4, px + 18, y + 7 + b * 4, theme.dim);
+    fill(0, y + TAB_H - 1, 320, y + TAB_H, theme.panel);
+}
+
+// A crystal: a pentagon outline filled row by row.
+static void drawGem(int x, int y, int gw, int h, bool done, bool red)
+{
+    int c = !done ? 0x2A3340 : red ? 0xFF6B6B : 0x4FC3F7, rim = done ? 0xE8F6FF : 0x667080;
+    for (int yy = 0; yy < h; yy++) {
+        float f = yy < h * 0.32f ? yy / (h * 0.32f) : 1 - (yy - h * 0.32f) / (h * 0.68f) * 0.6f;
+        int half = (int)(gw * 0.5f * f + 0.5f), cx = x + gw / 2;
+        if (half < 1) half = 1;
+        fill(cx - half, y + yy, cx + half, y + yy + 1, rim);
+        if (yy > 0 && yy < h - 1 && half > 1) fill(cx - half + 1, y + yy, cx + half - 1, y + yy + 1, c);
+    }
+}
+
+static void drawRewards(int x, int y, int h)
+{
+    static const char *const TOKENS[4] = {"kraid_boss_token", "phantoon_boss_token", "draygon_boss_token", "ridley_boss_token"};
+    for (int i = 0; i < 4; i++, x += h + 1) drawIcon(getIcon(TOKENS[i]), x, y, h, h, trk.boss_mask >> i & 1 ? 256 : 70);
+    x += 4;
+    int gw = h * 7 / 10;
+    for (int n = 1; n <= 7; n++, x += gw + 1) drawGem(x, y, gw, h, trk.crystal_mask >> (n - 1) & 1, n == 5 || n == 6);
+}
+
+static void drawMap(TrkMapView &v, int ax, int ay, int aw, int ah, bool mini)
+{
+    buildStacks();
+    if (v.follow && disc.has_position) { v.cx = disc.x; v.cy = disc.y; }
+    int sx0 = clipX0, sy0 = clipY0, sx1 = clipX1, sy1 = clipY1;
+    setClip(ax, ay, ax + aw, ay + ah);
+    mapPixels(v, ax, ay, aw, ah, ax, ay, ax + aw, ay + ah, discoveredOnly ? 3 : 1);
+    static SmzRect seen[400];
+    int ns = smz_disc_rects(&disc, seen, 400);
+    float ox = ax + aw / 2.0f - v.cx * v.zoom, oy = ay + ah / 2.0f - v.cy * v.zoom;
+    for (int i = 0; i < ns; i++) {
+        int x0 = (int)floorf(ox + seen[i].x * v.zoom), y0 = (int)floorf(oy + seen[i].y * v.zoom);
+        int x1 = (int)ceilf(ox + (seen[i].x + seen[i].w) * v.zoom), y1 = (int)ceilf(oy + (seen[i].y + seen[i].h) * v.zoom);
+        if (x1 <= ax || y1 <= ay || x0 >= ax + aw || y0 >= ay + ah) continue;
+        mapPixels(v, ax, ay, aw, ah, x0, y0, x1, y1, 0);
+    }
+    auto isSeen = [&](float x, float y) {
+        for (int i = 0; i < ns; i++) if (x >= seen[i].x && x < seen[i].x + seen[i].w && y >= seen[i].y && y < seen[i].y + seen[i].h) return true;
+        return false;
+    };
+    float rad = 1.6f + 3.0f * v.zoom;
+    if (rad > 6) rad = 6;
+    const SmzMapData &m = SMZ3_MAP_DATA;
+    for (int k = 0; k < m.n_markers; k++) {
+        int i = m.markers[k].index;
+        if (i < 0 || i >= (int)smz3_location_count || i >= SMZ_TRK_MAX_LOCS) continue;
+        float px = ox + m.markers[k].x * v.zoom, py = oy + m.markers[k].y * v.zoom;
+        if (px < ax - 8 || py < ay - 8 || px > ax + aw + 8 || py > ay + ah + 8) continue;
+        if (discoveredOnly && !isSeen((float)m.markers[k].x, (float)m.markers[k].y)) continue;
+        int head = stackHead[i];
+        bool done;
+        if (stackSize[head] > 1) {
+            if (i != head) continue;
+            done = true;
+            for (unsigned j = 0; j < smz3_location_count && j < SMZ_TRK_MAX_LOCS; j++) if (stackHead[j] == head && !trk.cleared[j]) done = false;
+        } else done = trk.cleared[i];
+        if (done) { dot(px, py, rad * 0.65f + 1, 0x000000); dot(px, py, rad * 0.65f, 0xFFFFFF); }
+        else { dot(px, py, rad + 1, 0xFFFFFF); dot(px, py, rad, 0x000000); dot(px, py, rad - 0.8f, 0xFFB300); }
+    }
+    SmzBossMark boss[16];
+    int nb = Memory.RAM ? smz_disc_boss_marks(&disc, Memory.RAM, 0x20000, boss, 16) : 0;
+    for (int i = 0; i < nb; i++) {
+        if (discoveredOnly && !isSeen(boss[i].x, boss[i].y)) continue;
+        int px = (int)(ox + boss[i].x * v.zoom), py = (int)(oy + boss[i].y * v.zoom), h = (int)(3 + 3 * v.zoom);
+        if (h > 7) h = 7;
+        fill(px - h, py - h, px + h, py + h, 0x000000);
+        fill(px - h + 1, py - h + 1, px + h - 1, py + h - 1, boss[i].done ? 0x606878 : 0xE05A4F);
+    }
+    if (disc.has_position) {
+        float px = ox + disc.x * v.zoom, py = oy + disc.y * v.zoom, pr = mini ? 4 : 3.5f + 2 * v.zoom;
+        dot(px, py, pr * 1.6f, 0x000000);
+        dot(px, py, pr * 1.3f, 0xFFFFFF);
+        dot(px, py, pr, 0xE05A4F);
+    }
+    // frame
+    fill(ax, ay, ax + aw, ay + 1, theme.panel);
+    fill(ax, ay + ah - 1, ax + aw, ay + ah, theme.panel);
+    fill(ax, ay, ax + 1, ay + ah, theme.panel);
+    fill(ax + aw - 1, ay, ax + aw, ay + ah, theme.panel);
+    setClip(sx0, sy0, sx1, sy1);
+}
+
+static int regionDone(const Region &r)
+{
+    int d = 0;
+    for (int k = 0; k < r.count; k++) d += trk.cleared[regionLocs[r.first + k]] ? 1 : 0;
+    return d;
+}
+
+static int runMiniTop, runMiniBottom;   // where the RUN tab's map is, for a tap
+
+// ---- item shortcuts (core/ui/smz3_shortcuts.h): the rows over the RUN tab's map. In ALttP five slots, the same for every
+// run, equip their item on Y; in Super Metroid each beam owned turns on or off, and under them each HUD weapon owned is
+// picked. Only in normal play, silently.
+
+#define SC_SLOTS 5
+#define SC_FILE SMZ_DIR "/shortcuts.txt"
+#define SC_ROW_X 162
+#define SC_ROW_W 154
+#define SC_ROW_H 30
+
+static int scSlots[SC_SLOTS] = {-1, -1, -1, -1, -1};
+static int scShown[2] = {1, 1};   // the slot/beam row and the weapon row; saved after the slots
+static int scPick = -1;   // the slot whose item picker is open, -1 none
+static int scRowY[2] = {-1, -1};   // where each row was drawn, -1 hidden
+// The shortcuts a New 3DS button can be bound to: the five ALttP slots, then the beams and weapons in id order.
+#define SC_KEYS (SC_SLOTS + SC_COUNT - SC_ZELDA_COUNT)
+
+static void scLoad()
+{
+    static bool loaded = false;
+    if (loaded) return;
+    loaded = true;
+    if (FILE *f = fopen(SC_FILE, "r")) {
+        for (int i = 0; i < SC_SLOTS; i++) if (fscanf(f, "%d", &scSlots[i]) != 1 || scSlots[i] < -1 || scSlots[i] >= SC_ZELDA_COUNT) scSlots[i] = -1;
+        for (int i = 0; i < 2; i++) if (fscanf(f, "%d", &scShown[i]) != 1) scShown[i] = 1;
+        fclose(f);
+    }
+}
+
+static void scSave()
+{
+    mkdir(SMZ_DIR, 0777);
+    if (FILE *f = fopen(SC_FILE, "w")) {
+        for (int i = 0; i < SC_SLOTS; i++) fprintf(f, "%d\n", scSlots[i]);
+        for (int i = 0; i < 2; i++) fprintf(f, "%d\n", scShown[i]);
+        fclose(f);
+    }
+}
+
+static bool scOwned(int id) { return smz_shortcut_owned(id, Memory.RAM, 0x20000, Memory.SRAM, 0x20000) != 0; }
+static bool scActive(int id) { return smz_shortcut_active(id, Memory.RAM, 0x20000, Memory.SRAM, 0x20000) != 0; }
+
+static void scUse(int id)
+{
+    SmzPoke pk[4];
+    int n = smz_shortcut_pokes(id, Memory.RAM, 0x20000, Memory.SRAM, 0x20000, pk, 4);
+    for (int i = 0; i < n; i++) if (pk[i].offset < 0x20000) Memory.RAM[pk[i].offset] = pk[i].value;
+}
+
+int smz3ShortcutKeyCount(void) { return SC_KEYS; }
+
+const char *smz3ShortcutKeyName(int i)
+{
+    static char s[24];
+    if (i < SC_SLOTS) { snprintf(s, sizeof s, "Zelda slot %d", i + 1); return s; }
+    return smz_shortcuts[SC_ZELDA_COUNT + i - SC_SLOTS].name;
+}
+
+
+bool smz3ShortcutRowShown(int row) { scLoad(); return scShown[row] != 0; }
+void smz3SetShortcutRowShown(int row, bool shown) { scLoad(); scShown[row] = shown; scSave(); dirty = true; }
+
+// The ids in a row now: row 0 the five slots in ALttP (-1 empty) or the beams owned in Super Metroid, row 1 the weapons
+// owned in Super Metroid. Returns how many cells, 0 when the row is hidden.
+static int scCells(int *ids, int row)
+{
+    scLoad();
+    if (!trk.started || !scShown[row]) return 0;
+    if (trk.game == SMZ3_GAME_ZELDA) {
+        if (row) return 0;
+        for (int i = 0; i < SC_SLOTS; i++) ids[i] = scSlots[i];
+        return SC_SLOTS;
+    }
+    int n = 0;
+    if (trk.game == SMZ3_GAME_METROID)
+        for (int id = row ? SC_WEAPON_FIRST : SC_ZELDA_COUNT; id < (row ? SC_COUNT : SC_WEAPON_FIRST); id++) if (scOwned(id)) ids[n++] = id;
+    return n;
+}
+
+static int scCellW() { return (SC_ROW_W - 4 * 3) / SC_SLOTS; }
+
+static void scIcon(int id, int x, int y, int w, int h, int alpha)
+{
+    const SmzShortcut &sc = smz_shortcuts[id];
+    if (sc.icon[0]) drawIcon(getIcon(sc.icon), x, y, w, h, alpha);
+    else {
+        char cut[16];
+        ui3dsEllipsize(sc.name, cut, sizeof cut, w);
+        text(x, y + (h - 13) / 2, alpha > 128 ? 0xFFFFFF : 0x667080, cut, HALIGN_CENTER, x + w);
+    }
+    if (id >= SC_BOTTLE1 && id <= SC_BOTTLE4) {   // the four bottles share one icon
+        char d[2] = {(char)('1' + id - SC_BOTTLE1), 0};
+        text(x + w + 1, y + h - 12, 0x000000, d, HALIGN_RIGHT);
+        text(x + w, y + h - 13, 0xFFFFFF, d, HALIGN_RIGHT);
+    }
+}
+
+static void drawShortcutRow(int y, int row)
+{
+    int ids[SC_COUNT], n = scCells(ids, row), w = scCellW();
+    for (int i = 0; i < n; i++) {
+        int x = SC_ROW_X + i * (w + 3), id = ids[i];
+        bool on = id >= 0 && scActive(id);
+        fill(x, y, x + w, y + SC_ROW_H, on ? theme.tab : theme.panel);
+        if (on) { fill(x, y + SC_ROW_H - 2, x + w, y + SC_ROW_H, theme.accent); }
+        if (id < 0) text(x, y + 8, theme.dim, "+", HALIGN_CENTER, x + w);
+        else scIcon(id, x + 2, y + 2, w - 4, SC_ROW_H - 4, scOwned(id) ? 256 : 64);
+    }
+}
+
+// Cell of the row under (x, y), or -1.
+static int scCellAt(int x, int y, int row)
+{
+    int ids[SC_COUNT], n = scCells(ids, row), w = scCellW(), rowY = scRowY[row];
+    if (rowY < 0 || y < rowY || y >= rowY + SC_ROW_H) return -1;
+    for (int i = 0; i < n; i++) if (x >= SC_ROW_X + i * (w + 3) && x < SC_ROW_X + i * (w + 3) + w) return i;
+    return -1;
+}
+
+// The picker of an ALttP slot: the items owned, CLEAR and CLOSE.
+static void scPickerLayout(int y0, int i, int *x, int *y)
+{
+    *x = 8 + i % 9 * 34; *y = y0 + 24 + i / 9 * 34;
+}
+
+static void drawPicker(int y0, int y1)
+{
+    fill(0, y0, 320, y1, theme.bg);
+    char s[64];
+    int cur = scSlots[scPick];
+    snprintf(s, sizeof s, cur < 0 ? "Slot %d: tap an item to put in it" : "Slot %d: %s", scPick + 1, cur < 0 ? "" : smz_shortcuts[cur].name);
+    text(8, y0 + 5, theme.accent, s);
+    int k = 0;
+    for (int id = 0; id < SC_ZELDA_COUNT; id++) {
+        if (!scOwned(id)) continue;
+        int x, y;
+        scPickerLayout(y0, k++, &x, &y);
+        fill(x, y, x + 32, y + 32, id == cur ? theme.accent : theme.panel);
+        scIcon(id, x + 2, y + 2, 28, 28, 256);
+    }
+    if (!k) text(8, y0 + 28, theme.dim, "No items yet");
+    fill(8, y1 - 28, 156, y1 - 6, theme.panel);
+    text(8, y1 - 24, theme.text, "CLEAR", HALIGN_CENTER, 156);
+    fill(164, y1 - 28, 312, y1 - 6, theme.panel);
+    text(164, y1 - 24, theme.text, "CLOSE", HALIGN_CENTER, 312);
+}
+
+static void pickerTap(int x, int y, int y0, int y1)
+{
+    if (y >= y1 - 28 && y < y1 - 6) {
+        if (x < 160) { scSlots[scPick] = -1; scSave(); }
+        else scPick = -1;
+        return;
+    }
+    int k = 0;
+    for (int id = 0; id < SC_ZELDA_COUNT; id++) {
+        if (!scOwned(id)) continue;
+        int cx, cy;
+        scPickerLayout(y0, k++, &cx, &cy);
+        if (x >= cx && x < cx + 32 && y >= cy && y < cy + 32) { scSlots[scPick] = id; scSave(); scPick = -1; return; }
+    }
+}
+
+// A tap on a row: an empty ALttP slot opens its picker, a filled one equips its item, a beam turns on or off, a weapon is
+// picked (again: back to the beam).
+static bool shortcutTap(int x, int y, bool hold)
+{
+    int ids[SC_COUNT], row = 0, i = scCellAt(x, y, 0);
+    if (i < 0) i = scCellAt(x, y, row = 1);
+    if (i < 0) return false;
+    scCells(ids, row);
+    if (trk.game == SMZ3_GAME_ZELDA && (hold || ids[i] < 0)) scPick = i;
+    else if (!hold && ids[i] >= 0) scUse(ids[i]);
+    return true;
+}
+
+// ---- the 3DS's own controls in a run, the same for every run (IN_FILE): the save bar on the RUN tab, whether its SAVE and
+// LOAD ask first, and on a New 3DS what ZL, ZR and the C-stick do. Fast forward comes from the 3D slider held up, the bar's
+// toggle or a held bound button, never in a daily challenge.
+
+#define IN_FILE SMZ_DIR "/3ds_input.txt"
+#define BTN_COUNT 6
+#define QUICK_SLOT 1
+#define BAR_FF_W 72
+#define BAR_BTN_W ((SC_ROW_W - BAR_FF_W - 6) / 2)
+enum { BIND_NONE, BIND_FAST, BIND_SAVE, BIND_LOAD, BIND_MENU, BIND_SHORTCUT = 10 };
+static const u32 BTN_KEYS[BTN_COUNT] = {KEY_ZL, KEY_ZR, KEY_CSTICK_UP, KEY_CSTICK_DOWN, KEY_CSTICK_LEFT, KEY_CSTICK_RIGHT};
+static const char *const BTN_NAMES[BTN_COUNT] = {"ZL", "ZR", "C Up", "C Down", "C Left", "C Right"};
+static int inBar = 1, inConfirm = 0, inBtn[BTN_COUNT];
+static bool ffToggle, ffSlider, ffOn;   // the bar's toggle, the slider up, the speed in effect
+static int askState = -1;   // a SAVE (1) or LOAD (0) waiting for A or B
+static int barY = -1;   // where the save bar was drawn, -1 hidden
+static char barNote[16];
+static bool barNoteOk;
+static u64 barNoteUntil;
+
+static void inLoad()
+{
+    static bool loaded = false;
+    if (loaded) return;
+    loaded = true;
+    if (FILE *f = fopen(IN_FILE, "r")) {
+        if (fscanf(f, "%d %d", &inBar, &inConfirm) != 2) { inBar = 1; inConfirm = 0; }
+        for (int i = 0; i < BTN_COUNT; i++) {
+            int a = BIND_NONE;
+            if (fscanf(f, "%d", &a) != 1) a = BIND_NONE;
+            inBtn[i] = (a >= BIND_NONE && a <= BIND_MENU) || (a >= BIND_SHORTCUT && a < BIND_SHORTCUT + SC_KEYS) ? a : BIND_NONE;
+        }
+        fclose(f);
+    }
+}
+
+static void inSave()
+{
+    mkdir(SMZ_DIR, 0777);
+    if (FILE *f = fopen(IN_FILE, "w")) {
+        fprintf(f, "%d %d\n", inBar, inConfirm);
+        for (int i = 0; i < BTN_COUNT; i++) fprintf(f, "%d\n", inBtn[i]);
+        fclose(f);
+    }
+}
+
+static const char *actionName(int a, char *s, size_t cap)
+{
+    switch (a) {
+    case BIND_NONE: snprintf(s, cap, "-"); break;
+    case BIND_FAST: snprintf(s, cap, "Fast forward (hold)"); break;
+    case BIND_SAVE: snprintf(s, cap, "Save state"); break;
+    case BIND_LOAD: snprintf(s, cap, "Load state"); break;
+    case BIND_MENU: snprintf(s, cap, "Game menu"); break;
+    default: snprintf(s, cap, "%s shortcut", smz3ShortcutKeyName(a - BIND_SHORTCUT)); break;
+    }
+    return s;
+}
+
+// The buttons bound to something, taken from the game; a New 3DS only.
+static u32 boundKeys()
+{
+    if (!settings3DS.isNew3DS) return 0;
+    inLoad();
+    u32 m = 0;
+    for (int i = 0; i < BTN_COUNT; i++) if (inBtn[i]) m |= BTN_KEYS[i];
+    return m;
+}
+
+static void barSays(bool save, bool ok)
+{
+    snprintf(barNote, sizeof barNote, "%s", ok ? (save ? "Saved" : "Loaded") : save ? "Not saved" : "No state yet");
+    barNoteOk = ok;
+    barNoteUntil = osGetTime() + 1500;
+    dirty = true;
+}
+
+static int pendingState = -1;   // a SAVE (1) or LOAD (0) asked for, done after the frame (smz3TrackerFrame)
+
+static void quickState(bool save) { pendingState = save; }
+
+// The quick slot saved or loaded outside the frame, with no Snes9x notification: the bar says how it went.
+static void runPendingState()
+{
+    if (pendingState < 0) return;
+    bool save = pendingState == 1, ok = false;
+    pendingState = -1;
+    if (!snd3DS.generateSilence && (save || impl3dsSlotHasState(QUICK_SLOT)) && !(save && impl3dsHasBrokenAudioStateSignature())) {
+        snd3dsDrainMixing();   // the SRAM auto save runs with generateSilence set: a state then could abort
+        ok = save ? impl3dsSaveStateSlot(QUICK_SLOT) : impl3dsLoadStateSlot(QUICK_SLOT);
+        snd3dsResumeMixing();
+    }
+    barSays(save, ok);
+}
+
+static u64 noStatesUntil;   // the "No save states" popup is up until then
+
+static void requestState(bool save)
+{
+    if (!smz3IsRun()) return;
+    if (smz3NoStates()) { noStatesUntil = osGetTime() + 3000; dirty = true; return; }
+    inLoad();
+    if (inConfirm) { askState = save; dirty = true; }
+    else quickState(save);
+}
+
+bool smz3FastForward(unsigned held)
+{
+    bool slider = false, on = false;
+    if (smz3IsRun() && !gChallenge) {
+        slider = osGet3DSliderState() > 0.02f;
+        if (ffSlider && !slider) ffToggle = false;   // the slider back at 0 turns the bar's toggle off too
+        u32 keys = boundKeys();
+        for (int i = 0; i < BTN_COUNT; i++) if (inBtn[i] == BIND_FAST && (held & keys & BTN_KEYS[i])) on = true;
+        on = on || slider || ffToggle;
+    } else ffToggle = false;
+    if (slider != ffSlider || on != ffOn) dirty = true;
+    ffSlider = slider;
+    ffOn = on;
+    return on;
+}
+
+static void barButton(int x0, int x1, int y, int border, int back, int ink, const char *label)
+{
+    fill(x0, y, x1, y + SC_ROW_H, border);
+    fill(x0 + 1, y + 1, x1 - 1, y + SC_ROW_H - 1, back);
+    if (label) text(x0, y + 8, ink, label, HALIGN_CENTER, x1);
+}
+
+// SAVE, LOAD and the fast forward toggle under the shortcut rows; greyed where the run allows none.
+static void drawSaveBar(int y)
+{
+    const int BORDER = 0x2C4A5E, BACK = 0x0C1A24, INK = 0xE8ECF2, LIT = 0xFF9A1F, LIT_BACK = 0x3A2408;
+    int x = SC_ROW_X, xf = SC_ROW_X + SC_ROW_W - BAR_FF_W;
+    bool noStates = smz3NoStates(), noFast = gChallenge;
+    float g = noStates ? 0.35f : 1.0f;
+    if (barNoteUntil && osGetTime() < barNoteUntil) {
+        int c = barNoteOk ? 0x4CC38A : theme.dim;
+        barButton(x, xf - 3, y, c, BACK, c, barNote);
+    } else {
+        barButton(x, x + BAR_BTN_W, y, mixC(theme.bg, BORDER, g), mixC(theme.bg, BACK, g), mixC(theme.bg, INK, g), "SAVE");
+        barButton(x + BAR_BTN_W + 3, xf - 3, y, mixC(theme.bg, BORDER, g), mixC(theme.bg, BACK, g), mixC(theme.bg, INK, g), "LOAD");
+    }
+    bool lit = ffOn && !noFast;
+    g = noFast ? 0.35f : 1.0f;
+    int ink = mixC(theme.bg, lit ? LIT : INK, g);
+    barButton(xf, xf + BAR_FF_W, y, mixC(theme.bg, lit ? LIT : BORDER, g), mixC(theme.bg, lit ? LIT_BACK : BACK, g), ink, NULL);
+    int cx = xf + (ffSlider && lit ? 26 : BAR_FF_W / 2) - 8, cy = y + SC_ROW_H / 2;
+    for (int k = 0; k < 2; k++)
+        for (int i = 0; i < 8; i++) {   // two triangles pointing right
+            int h = 6 - i * 6 / 8;
+            fill(cx + k * 8 + i, cy - h, cx + k * 8 + i + 1, cy + h + 1, ink);
+        }
+    if (ffSlider && lit) {   // driven by the 3D slider
+        fill(xf + BAR_FF_W - 24, cy - 7, xf + BAR_FF_W - 5, cy + 7, LIT);
+        text(xf + BAR_FF_W - 24, cy - 7, 0x1A1004, "3D", HALIGN_CENTER, xf + BAR_FF_W - 5);
+    }
+}
