+// ---- the run-complete card (frontends/pc/pc_finish.c): fanfare on the game screen, the details on this one. Times are
+// seconds from the card's first frame; a press before the buttons only jumps to them.
+
+#define T_CARD 0.10f
+#define T_TITLE 0.35f
+#define T_COUNT 0.70f
+#define T_LAND 2.10f
+#define T_ROWS 1.00f   // the bottom screen's details, one per second from here
+#define CARD_ROWS 4
+#define T_BUTTONS 5.00f
+#define PARTS 160
+#define CV_W 400
+#define CV_H 240
+
+static const int CONFETTI[] = {0xF2A33A, 0xFFE07A, 0x5BD46A, 0xFF8A3D, 0x4FC3F7, 0xFF6AD5};
