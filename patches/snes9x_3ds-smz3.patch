+static void fmtClock(int64_t ms, char *out, size_t cap)
+{
+    long long s = ms > 0 ? ms / 1000 : 0;
+    snprintf(out, cap, "%lld:%02lld:%02lld", s / 3600, s / 60 % 60, s % 60);
+}
