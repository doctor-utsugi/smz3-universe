+static void deriveFromRoms(SmzUi *u);
+static void trackerRelease();
+
+static void uiCueSound(UiCue c);
+static void goalsLeave(bool report);
+static void drawIdlePanel(const SmzUi *u);
+static char idleKey[160];   // what the bottom screen shows now; emptied when the menu opens, so it is drawn again
+
+static char pendingNote[64];
+
+void smz3RunMenuNote(const char *text) { snprintf(pendingNote, sizeof pendingNote, "%s", text); }
+
+static bool runMenu(char *romPathOut, size_t cap)
+{
+    static SmzUi ui;
+    static char linkNames[UI_MAX_SPRITES][32], samusNames[UI_MAX_SPRITES][32];
+    int left = smz3IsRun() ? gPlaySlot : -1;   // the run just left keeps the cursor
+    if (smz3IsRun()) { goalsLeave(true); impl3dsSaveStateAuto(); }   // now, while the flags still belong to the run that was being played
+    trackerRelease();   // the game's map pictures (about 4 MB) wait on the heap otherwise, through the next generation
+    gRunStates = false;
+    ui_init(&ui);
+    ui.rings = 1;   // the run list's percent sits in a progress ring (drawRing)
+    ui.orbs = 1;    // and the load choice's marker is an orb (drawOrb)
+    ui.flags = 1;   // countries as flags (romfs:/smz3/flags)
+    const char *list[UI_MAX_SPRITES];
+    int n = listSprites(SPRITE_DIR "/link", linkNames, UI_MAX_SPRITES - 1);
+    for (int i = 0; i < n; i++) list[i] = linkNames[i];
+    ui_set_sprites(&ui, 0, list, n);
+    n = listSprites(SPRITE_DIR "/samus", samusNames, UI_MAX_SPRITES - 1);
+    for (int i = 0; i < n; i++) list[i] = samusNames[i];
+    ui_set_sprites(&ui, 1, list, n);
+    static char plandoNames[UI_MAX_SPRITES][32];
+    n = listPlandos(SMZ_DIR "/plando", plandoNames, UI_MAX_SPRITES - 1);
+    for (int i = 0; i < n; i++) list[i] = plandoNames[i];
+    ui_set_sprites(&ui, 2, list, n);
+    loadSavedCustoms(&ui);
+    deriveFromRoms(&ui);   // the run list draws the standing Link and Samus from the start
+    ui_player_enable(&ui, 1);
+    {
+        char profile[96];
+        if (smzOnlineProfileLoad(profile, sizeof profile)) ui_player_load(&ui, profile);
+    }
+    // the seeds arrive once per session: a menu opened again (after a run) gets them back from here, ui_init cleared them
+    static struct { bool have; char label[16]; int seed, days; } monthly, weekly;
+    if (monthly.have) ui_set_monthly(&ui, monthly.label, monthly.seed, monthly.days);
+    if (weekly.have) ui_set_weekly(&ui, weekly.label, weekly.seed, weekly.days);
+    smzOnlineStartup();
+    smzOnlineRequestLadders();   // the bottom screen shows them from the start
+    ui_ladder_enable(&ui, 1);
+    ui_daily_enable(&ui, 1);
+    smzDailyRequestInfo();
+    u64 nextInfo = osGetTime() + 60000;
+    u64 nextWorld = 0;   // the world goals: fetched once they come on screen, then once a minute while they stay
+    bool worldShown = false;
+    refreshSlots(&ui);
+    if (left == SMZ_DAILY_SLOT && ui.daily_on) ui.daily_sel = 1;
+    else if (left >= 0 && left < ui.slot_count) {   // one step down onto it, so the list scrolls the way the pad does
+        if (left == 0 && ui.daily_on) ui.daily_sel = 1;
+        else { ui.daily_sel = 0; ui.slot_cursor = (left + ui.slot_count - 1) % ui.slot_count; }
+        ui_input(&ui, BTN_DOWN);
+    }
+
+    bool chosen = false;
+    char note[64] = "";
+    if (pendingNote[0]) {
+        ui_busy(&ui, pendingNote);
+        drawUi(&ui);
+        svcSleepThread(2500000000LL);
+        ui_idle(&ui);
+        pendingNote[0] = 0;
+    }
+    while (aptMainLoop()) {
+        hidScanInput();
+        u32 down = hidKeysDown();
+        UiButton b;
+        bool have = true;
+        if (down & KEY_DUP) b = BTN_UP;
+        else if (down & KEY_DDOWN) b = BTN_DOWN;
+        else if (down & KEY_DLEFT) b = BTN_LEFT;
+        else if (down & KEY_DRIGHT) b = BTN_RIGHT;
+        else if (down & KEY_A) b = BTN_A;
+        else if (down & KEY_B) {
+            if (ui.screen == UI_SLOTS_SCREEN) have = false;   // the run list is the app's home: nothing to go back to
+            else b = BTN_B;
+        }
+        else if (down & KEY_L) b = BTN_L;
+        else if (down & KEY_R) b = BTN_R;
+        else if (down & KEY_SELECT) b = BTN_SELECT;
+        else if (down & KEY_START) b = BTN_START;
+        else have = false;
+        if (uiBusy()) have = false, down &= ~KEY_TOUCH;   // a new screen takes its time: no skipping through
+        static SmzUi before;   // copied only on input: the struct is large
+        if (have) {
+            before = ui;
+            ui_input(&ui, b);
+            uiCueSound(ui_cue(&before, &ui, b));
+        }
+        if (down & KEY_TOUCH) {   // the bottom screen stands for the menu above, stretched to its width
+            touchPosition t;
+            hidTouchRead(&t);
+            before = ui;
+            ui_touch(&ui, t.px * UI_W / SCREEN_BOTTOM_WIDTH, t.py);
+            uiCueSound(ui_cue(&before, &ui, -1));
+        }
+        storeSavedCustoms(&ui);
+        {
+            char label[16];
+            int seed, days;
+            if (smzOnlineTakeMonthly(label, &seed, &days)) { ui_set_monthly(&ui, label, seed, days); monthly = {true, "", seed, days}; snprintf(monthly.label, sizeof monthly.label, "%s", label); }
+            if (smzOnlineTakeWeekly(label, &seed, &days)) { ui_set_weekly(&ui, label, seed, days); weekly = {true, "", seed, days}; snprintf(weekly.label, sizeof weekly.label, "%s", label); }
+            static char ladderJson[16384];
+            for (int t = 0; t < 3; t++) {
+                int st = smzOnlineTakeLadder(t, ladderJson, sizeof ladderJson);
+                if (st) ui_ladder_load_json(&ui, t, st == 1 ? ladderJson : NULL);
+            }
+            static char goalsJson[8192];
+            int gs = smzOnlineTakeGoals(goalsJson, sizeof goalsJson);
+            if (gs) ui_world_load_json(&ui, gs == 1 ? goalsJson : NULL);
+            bool world = ui_world_showing(&ui) != 0;
+            if (world && (!worldShown || osGetTime() >= nextWorld)) { nextWorld = osGetTime() + 60000; smzOnlineRequestGoals(); }
+            worldShown = world;
+            static SmzDailyInfo daily;
+            int ds = smzDailyTakeInfo(&daily);
+            if (ds == 1) ui_daily_set(&ui, &daily, dailyKept(daily.window));
+            else if (ds == 2 && ui.daily.loaded == 0) { memset(&daily, 0, sizeof daily); daily.loaded = -1; ui_daily_set(&ui, &daily, 0); }
+            if (osGetTime() >= nextInfo) { nextInfo = osGetTime() + 60000; smzDailyRequestInfo(); }
+            if (ui_player_dirty(&ui)) { char profile[96]; ui_player_text(&ui, profile, sizeof profile); smzOnlineProfileSave(profile); }
+        }
+        if (ui.action != ACT_NONE) {
+            int act = ui.action, slot = ui.action_slot;
+            ui.action = ACT_NONE;
+            if (act == ACT_LADDER) smzOnlineRequestLadders();
+            else if (act == ACT_DELETE) { deleteRun(slot); refreshSlots(&ui); }
+            else if (act == ACT_DAILY && !dailyBegin(&ui, note, sizeof note)) { ui_busy(&ui, note); drawUi(&ui); svcSleepThread(2500000000LL); ui_idle(&ui); }
+            if (act == ACT_DAILY && dailyKept(ui.daily.window)) { act = ACT_CONTINUE; slot = SMZ_DAILY_SLOT; }
+            if (act == ACT_CONTINUE || act == ACT_LOAD_SAVE || act == ACT_LOAD_STATE) {
+                char path[96], state[PATH_MAX];
+                SmzRun r;
+                snprintf(path, sizeof path, RUN_DIR "/slot%d.run", slot);
+                bool loaded = runLoad(path, &r) == 0;
+                bool states = loaded && strstr(r.settings, "\"saveStates\":true") && smzOnlineSlotKind(slot) < 1 && slot != SMZ_DAILY_SLOT;
+                if (states) file3dsGetRelatedPath(r.rom_path, state, sizeof state, ".auto.frz", "savestates");
+                bool hasState = states && access(state, F_OK) == 0;
+                if (act == ACT_CONTINUE && hasState && r.save_ms > 0 && (r.game == 3 || r.play_ms - r.save_ms > 10000)) {   // a finished run's clock is frozen
+                    ui_load_choice(&ui, slot, r.save_ms, r.save_zelda, r.save_metroid, r.play_ms, r.zelda_cleared, r.metroid_cleared, r.zelda_total, r.metroid_total);
+                } else if (loaded) {
+                    deriveFromRoms(&ui);
+                    gNextStates = states;
+                    gNextLoadState = hasState && act != ACT_LOAD_SAVE;
+                    // The run's screen shape picks the scaling: wide fills the 400x240 screen, pixel is 8:7, original is 4:3.
+                    settings3DS.ScreenStretch = strstr(r.settings, "\"screenShape\":\"wide\"") ? Setting::ScreenStretch::Full
+                        : strstr(r.settings, "\"screenShape\":\"pixel\"") ? Setting::ScreenStretch::CrtAspect
+                        : Setting::ScreenStretch::Aspect_4_3;
+                    settings3dsApplyScreenStretch();
+                    // 3DS has no shaders: CRT and LCD take the blend of sharp and smooth.
+                    settings3DS.ScreenFilter = strstr(r.settings, "\"screenFilter\":\"smooth\"") ? Setting::ScreenFilter::Smooth
+                        : strstr(r.settings, "\"screenFilter\":\"crt\"") || strstr(r.settings, "\"screenFilter\":\"lcd\"") ? Setting::ScreenFilter::Balanced
+                        : Setting::ScreenFilter::Sharp;
+                    mkdir(SMZ_DIR "/saves", 0777); mkdir(SMZ_DIR "/savestates", 0777); addShortcutHooks(r.rom_path); snprintf(romPathOut, cap, "%s", r.rom_path); gPlaySlot = slot; chosen = true; break; }
+            } else if (act == ACT_GENERATE && slot < UI_SLOTS) {
+                ui_busy(&ui, "Generating the seed ...");
+                drawUi(&ui);
+                if (!generateRun(&ui, slot, note, sizeof note)) { ui_idle(&ui); ui_busy(&ui, note); drawUi(&ui); svcSleepThread(2500000000LL); }
+                ui_idle(&ui);
+                refreshSlots(&ui);
+            }
+        }
+        drawUi(&ui);
+        drawIdlePanel(&ui);
+    }
+    if (chosen) freePreviews();   // the game gets the heap back
+    return chosen;
+}
+
+// The menu takes the whole top screen (400 wide, in 2D) while the bottom one passes the touches up; the emulator's
+// layout comes back afterwards, and its own menu redraws the game screen.
+static gfxScreen_t topSecond;
+static int topSecondWidth;
+
+static void topBegin()
+{
+    topSecond = settings3DS.SecondScreen;
+    topSecondWidth = settings3DS.SecondScreenWidth;
+    gfxSetWide(false);   // gpu3dsSetTopMode puts the wide and 3D modes back
+    gfxSet3D(false);
+    settings3DS.SecondScreen = GFX_TOP;
+    settings3DS.SecondScreenWidth = SCREEN_TOP_WIDTH;
+    ui3dsSetViewport(0, 0, SCREEN_TOP_WIDTH, SCREEN_HEIGHT);
+    if (gfxGetScreenFormat(GFX_TOP) != GSP_RGB565_OES) gfxSetScreenFormat(GFX_TOP, GSP_RGB565_OES);
+    ui_set_width(SCREEN_TOP_WIDTH);
+}
+
+static void topEnd()
+{
+    settings3DS.SecondScreen = topSecond;
+    settings3DS.SecondScreenWidth = topSecondWidth;
