+static void idleRun(const SmzRun &r, int slot, int l, int t, int w, int h)
+{
+    idleBox(l, t, w, h);
+    int x = l + 8, iw = w - 16;
+    char line[96];
+    snprintf(line, sizeof line, "SLOT %d", slot + 1);
+    text(x, t + 4, ID_DIM, line);
+    bool def = strstr(r.settings, "\"defaultRules\":true") != NULL;
+    const char *badge = def ? "DEFAULT RULES" : "CUSTOM RULES";
+    int bw = textW(badge) + 8, tint = def ? ID_GREEN : ID_ACCENT;
+    fillAlpha(x + iw - bw, t + 4, x + iw, t + 17, tint, 40);
+    text(x + iw - 4, t + 3, tint, badge, HALIGN_RIGHT);
+    textFit(x, t + 19, iw, ID_TEXT_HI, r.name);
+    bool finished = r.game == 3;
+    char clock[32];
+    fmtTime(r.play_ms, clock, sizeof clock);
+    clock[strlen(clock) - 3] = 0;   // the hundredths are the ladder's
+    text(x, t + 37, ID_DIM, finished ? "FINISHED IN" : "PLAY TIME");
+    text(x + iw, t + 37, finished ? ID_GREEN : ID_TEXT, clock, HALIGN_RIGHT);
+    idleBar("ZELDA", r.zelda_cleared, r.zelda_total, x, t + 53, iw, ID_GREEN);
+    idleBar("METROID", r.metroid_cleared, r.metroid_total, x, t + 73, iw, ID_BLUE);
+    // the options that differ from the defaults, from the settings' "diff" list
+    const char *d = strstr(r.settings, "\"diff\":[");
+    int y = t + 95, bottom = t + h - 20, count = 0, shown = 0;
+    for (const char *q = d ? d + 8 : NULL; q && *q == '"'; count++) {
+        const char *e = strchr(q + 1, '"');
+        if (!e) break;
+        if (y + 14 <= bottom - (e[1] == ',' ? 14 : 0)) {
+            snprintf(line, sizeof line, "%.*s", (int)(e - q - 1), q + 1);
+            fill(x, y + 6, x + 2, y + 8, ID_ACCENT);
+            textFit(x + 6, y, iw - 6, ID_TEXT, line);
+            y += 14;
+            shown++;
+        }
+        q = e[1] == ',' ? e + 2 : NULL;
+    }
+    if (count > shown) { snprintf(line, sizeof line, "+ %d more", count - shown); text(x + 6, y, ID_DIM, line); }
+    fill(l + 6, t + h - 18, l + w - 6, t + h - 17, ID_BORDER);
+    const char *m = strstr(r.settings, "\"musicPackage\":\"");
+    char music[40] = "Original";
+    if (m && m[16] != '"') { const char *e = strchr(m + 16, '"'); if (e) snprintf(music, sizeof music, "%.*s", (int)(e - m - 16), m + 16); }
+    snprintf(line, sizeof line, "Music: %s", !strcmp(music, "*") ? "Random" : music);
+    textFit(x, t + h - 16, iw, ID_DIM, line);
+}
