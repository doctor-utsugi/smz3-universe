+// The daily challenge in place of the completion bars (the Thor's Smz3DailyBlock): the goal in its box with a bar of who is
+// on it (green playing now, gold finished, out of everyone who started), the counts and the next hint, then the window.
+static int drawDailyBlock(int x, int y, int cw)
+{
+    char s[96], a[24];
+    int64_t now = smzDailyNowMs(), left = dr.closes_at - now;
+    bool done = trk.game == 3 || finishedBefore;
+    int lines = textWrap(x + 18, y + 3, cw - 22, theme.text, dr.goal, 3, false) - (y + 3);
+    int h = lines + 11;
+    fill(x, y, x + cw, y + h, 0x141B27);
+    fill(x, y, x + 2, y + h, theme.accent);
+    if (done) fill(x + 6, y + 5, x + 14, y + 13, 0x4CC38A);
+    else { fill(x + 6, y + 5, x + 14, y + 13, theme.dim); fill(x + 7, y + 6, x + 13, y + 12, 0x141B27); }
+    textWrap(x + 18, y + 3, cw - 22, theme.text, dr.goal, 3);
+    int bx = x + 6, bw = cw - 12, by = y + h - 5;
+    fill(bx, by, bx + bw, by + 3, 0x25324A);
+    if (dr.players_known && dr.players_started > 0) {
+        int st = dr.players_started, pl = dr.players_now < st ? dr.players_now : st;
+        int fin = dr.players_done < st - pl ? dr.players_done : st - pl;
+        int gw = bw * pl / st, fw = bw * fin / st;
+        fill(bx, by, bx + gw, by + 3, 0x4CC38A);
+        fill(bx + gw, by, bx + gw + fw, by + 3, 0xE9A23B);
+    }
+    y += h + 4;
+    const char *hint = "";
+    if (!done && dr.next_hint_at > 0) { smz_daily_span(dr.next_hint_at - now, a, sizeof a); snprintf(s, sizeof s, "hint in %s", a); hint = s; }
+    else if (!done) hint = "every hint out";
+    int cx = x;
+    if (dr.players_known) {
+        char n[16];
+        playersDot(cx, y + 3); cx += 10;
+        snprintf(n, sizeof n, "%d now", dr.players_now); text(cx, y, 0x4CC38A, n); cx += textW(n) + 7;
+        playersFlag(cx, y + 2, true); cx += 10;
+        snprintf(n, sizeof n, "%d", dr.players_done); text(cx, y, 0xE9A23B, n); cx += textW(n) + 7;
+        playersFlag(cx, y + 2, false); cx += 10;
+        snprintf(n, sizeof n, "%d", dr.players_started); text(cx, y, theme.dim, n); cx += textW(n);
+    }
+    if (hint[0]) {
+        if (cx > x && cx + 8 + textW(hint) > x + cw) y += 15;   // no room beside the counts: a line of its own
+        text(x + cw, y, theme.dim, hint, HALIGN_RIGHT);
+    }
+    y += 15;
+    text(x, y, theme.dim, "Window");
+    if (left > 0) { smz_daily_span(left, a, sizeof a); snprintf(s, sizeof s, "%s left", a); }
+    else snprintf(s, sizeof s, "closed");
+    text(x + cw, y, left > 0 && left < 15 * 60000 ? 0xE05A4F : theme.text, s, HALIGN_RIGHT);
+    return y + 16;
+}
