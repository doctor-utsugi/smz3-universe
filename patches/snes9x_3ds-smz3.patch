+static void idleLadder(const SmzUi *u, int tab, int l, int t, int w, int h)
+{
+    static const char *const NAMES[3] = {"ORIGINAL LADDER", "MONTHLY LADDER", "WEEKLY LADDER"};
+    static const int MEDALS[3] = {0xF2C14E, 0xC7D0DE, 0xC98A55};
+    idleBox(l, t, w, h);
+    text(l, t + 3, ID_ACCENT, NAMES[tab], HALIGN_CENTER, l + w);
+    fill(l + 6, t + 19, l + w - 6, t + 20, ID_BORDER);
+    const auto &lad = u->ladder[tab];
+    if (lad.loaded != 1 || lad.n == 0) {
+        text(l, t + h / 2 - 7, ID_DIM, lad.loaded == 0 ? "Loading ..." : lad.loaded < 0 ? "Offline" : "No times yet", HALIGN_CENTER, l + w);
+        return;
+    }
+    int rows = (h - 26) / 15;
+    if (rows > lad.n) rows = lad.n;
+    for (int i = 0; i < rows; i++) {
+        int y = t + 24 + i * 15;
+        if (i == 0) fillAlpha(l + 3, y - 1, l + w - 3, y + 14, ID_ACCENT, 22);
+        char rank[8], time[32];
+        snprintf(rank, sizeof rank, "%d", i + 1);
+        text(l + 4, y, i < 3 ? MEDALS[i] : ID_DIM, rank, HALIGN_CENTER, l + 22);
+        fmtTime(lad.row[i].ms, time, sizeof time);
+        int tw = textW(time);
+        textFit(l + 24, y, w - 34 - tw, i == 0 ? ID_TEXT_HI : ID_TEXT, lad.row[i].name);
+        text(l + w - 6, y, i == 0 ? ID_ACCENT : ID_TEXT, time, HALIGN_RIGHT);
+    }
+}
