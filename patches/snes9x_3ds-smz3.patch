+#define SAVED_FILE SMZ_DIR "/saved_customs.txt"
+
+static void loadSavedCustoms(SmzUi *u)
+{
+    size_t len = 0;
+    unsigned char *data = readFile(SAVED_FILE, &len);
+    if (!data) { ui_saved_load(u, NULL); return; }
+    char *text = (char *)malloc(len + 1);
+    if (text) { memcpy(text, data, len); text[len] = 0; ui_saved_load(u, text); free(text); }
+    free(data);
+}
+
+static void storeSavedCustoms(SmzUi *u)
+{
+    static char buf[UI_MAX_SAVED * (UI_SPEC_LEN + 40)];
+    if (!ui_saved_dirty(u) || ui_saved_text(u, buf, sizeof buf) < 0) return;
+    mkdir(SMZ_DIR, 0777);
+    FILE *f = fopen(SAVED_FILE, "wb");
+    if (f) { fwrite(buf, 1, strlen(buf), f); fclose(f); }
+}
