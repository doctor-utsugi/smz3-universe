+// Redrawn only when what it shows changed: the run under the cursor, or a ladder that came in.
+static void drawIdlePanel(const SmzUi *u)
+{
+    int slot = u->screen == UI_SLOTS_SCREEN ? (u->daily_sel ? -1 : u->slot_cursor)
+             : u->screen == UI_SLOT_MENU || u->screen == UI_CONFIRM ? u->active_slot : -1;
+    SmzRun r;
+    char path[96];
+    snprintf(path, sizeof path, RUN_DIR "/slot%d.run", slot);
+    bool have = slot >= 0 && slot < UI_SLOTS && runLoad(path, &r) == 0;
+    int kind = have ? smzOnlineRunMode(slot) : 0, tab = kind >= 1 && kind <= 3 ? kind - 1 : 0;
+    bool online = u->ladder[0].loaded == 1 || u->ladder[1].loaded == 1 || u->ladder[2].loaded == 1;
+    char key[160];
+    snprintf(key, sizeof key, "%d|%d|%d|%d|%d|%s|%lld|%d", slot, have, tab, u->ladder[tab].loaded, u->ladder[tab].n, have ? r.name : "",
+             have ? (long long)r.play_ms : 0LL, online);
+    if (!strcmp(key, idleKey)) return;
+    snprintf(idleKey, sizeof idleKey, "%s", key);
+
+    gfxScreen_t menuScreen = settings3DS.SecondScreen;   // the text helpers draw on the second screen: the bottom one, for now
+    int menuWidth = settings3DS.SecondScreenWidth;
+    settings3DS.SecondScreen = GFX_BOTTOM;
+    settings3DS.SecondScreenWidth = SCREEN_BOTTOM_WIDTH;
+    if (gfxGetScreenFormat(GFX_BOTTOM) != GSP_RGB565_OES) gfxSetScreenFormat(GFX_BOTTOM, GSP_RGB565_OES);
+    trkFb = (u16 *)gfxGetFramebuffer(GFX_BOTTOM, GFX_LEFT, NULL, NULL);
+    setClip(0, 0, 320, 240);
+    for (int y = 0; y < 240; y++) fill(0, y, 320, y + 1, mixC(0x0C1220, 0x0A0E15, y / 240.0f));
+    for (int i = 0; i <= 20; i++) fillAlpha(i * 16, 0, i * 16 + 1, 240, 0x4FC3F7, 10);
+    unsigned seed = 7;   // still stars: the 3DS redraws this screen only when it changes
+    for (int i = 0; i < 70; i++) {
+        seed = seed * 1664525u + 1013904223u; int sx = (int)(seed >> 8) % 320;
+        seed = seed * 1664525u + 1013904223u; int sy = (int)(seed >> 8) % 240;
+        seed = seed * 1664525u + 1013904223u; int a = 40 + (int)((seed >> 8) % 110);
+        fillAlpha(sx, sy, sx + 1, sy + 1, 0xC8DCFF, a);
+    }
+    int tw = bigText(-400, -100, 20, ID_ACCENT, "SMZ3");   // measured off screen
+    int lx = 160 - (22 + 6 + tw) / 2;
+    idleLogo(lx, 4, 22);
+    bigText(lx + 28, 5, 20, ID_ACCENT, "SMZ3");
+    text(0, 27, ID_DIM, "A LINK TO THE PAST - SUPER METROID", HALIGN_CENTER, 320);
+    const char *net = online ? "ONLINE" : "OFFLINE";
+    text(314, 2, online ? ID_GREEN : ID_DIM, net, HALIGN_RIGHT);
+    dot(314 - textW(net) - 6, 9, 2, online ? ID_GREEN : ID_DIM);
+    fill(6, 44, 314, 45, ID_BORDER);
+    fill(148, 43, 172, 45, ID_ACCENT);
+    if (have) {
+        idleRun(r, slot, 6, 50, 152, 184);
+        idleLadder(u, tab, 162, 50, 152, 184);
+    } else idleLadder(u, tab, 6, 50, 308, 184);
+    impl3dsFlushScreen(GFX_BOTTOM, false, false);
+    gfxScreenSwapBuffers(GFX_BOTTOM, false);
+    settings3DS.SecondScreen = menuScreen;
+    settings3DS.SecondScreenWidth = menuWidth;
+    ui3dsSetViewport(0, 0, menuWidth, SCREEN_HEIGHT);
+}
+
+// ---- helps of the run being played (the pause menu asks for them)
+
+bool smz3IsRun(void) { return strncmp(Memory.ROMFilename, RUN_DIR "/", sizeof RUN_DIR) == 0; }
+
+// Runs that allow save states keep an auto state, saved on leaving and offered on Continue (the load choice).
+bool smz3AutoStates(void) { return smz3IsRun() && gRunStates && !smz3NoStates(); }
+
+// The run chosen in the menu is loaded: its flags take over. True when it starts from its auto state.
+bool smz3RunStarted(void)
+{
+    curSlot = -2;   // the tracker starts over, also when the same run is chosen again
+    gRunStates = gNextStates;
+    return gNextLoadState && smz3AutoStates();
+}
+
+// Save states of any kind only where the run's settings allow them, and never in a monthly, weekly or daily run.
+bool smz3NoStates(void) { return smz3IsRun() && (!gRunStates || gChallenge || (gPlaySlot >= 0 && smzOnlineSlotKind(gPlaySlot) >= 1)); }
+
+// Gives the next hint (a help is spent in the limited mode). The text is for a dialog.
+void smz3AskHelp(char *out, size_t cap)
+{
+    char path[320];
+    snprintf(path, sizeof path, "%.300s.help", Memory.ROMFilename);
+    FILE *f = fopen(path, "rb");
+    if (!f) { snprintf(out, cap, "This run has no helps."); return; }
+    int mode = 2, count = 0, used = 0, given = 0;
+    static char hints[SMZ_HOST_HELP_COUNT][SMZ_HOST_HELP_TEXT];
+    if (fscanf(f, "%d %d %d %d\n", &mode, &count, &used, &given) != 4) mode = 2;
+    for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) {
+        hints[i][0] = 0;
+        if (!fgets(hints[i], SMZ_HOST_HELP_TEXT, f)) break;
+        hints[i][strcspn(hints[i], "\r\n")] = 0;
+    }
+    fclose(f);
+    if (mode == 2) { snprintf(out, cap, "This run has no helps."); return; }
+    if (mode == 1 && used >= count) { snprintf(out, cap, "No helps left (0 of %d).", count); return; }
+    if (given >= SMZ_HOST_HELP_COUNT || !hints[given][0]) { snprintf(out, cap, "No more hints."); return; }
+    int index = given;
+    given++;
+    if (mode == 1) used++;
+    f = fopen(path, "wb");
+    if (f) {
+        fprintf(f, "%d %d %d %d\n", mode, count, used, given);
+        for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) fprintf(f, "%s\n", hints[i]);
+        fclose(f);
+    }
+    if (mode == 1) snprintf(out, cap, "%s (helps left: %d of %d)", hints[index], count - used, count);
+    else snprintf(out, cap, "%s", hints[index]);
+}
+
+// ---- the game menu while a run is played: what the Thor's game menu offers, drawn like the run menu (wallpaper, cut-corner
+// rows, the amber cursor, the button legend) on the top screen. The bottom screen keeps the tracker and passes touches up.
+
+enum { PM_RESUME, PM_SAVE, PM_LOAD, PM_RUNS, PM_RESTART, PM_MUTE, PM_ROW0, PM_ROW1, PM_BAR, PM_CONFIRM, PM_BUTTONS, PM_BTN, PM_ACT };
+struct PauseRow { int id, arg; };
+
+#define PM_ROWS_SHOWN 7
+#define PM_LIST_Y 40
+#define PM_ROW_H 22
+static const char *pmHeading = "SMZ3  -  Game menu";
+
+// Any single 3DS button by name, for the binding errors.
+static const char *keyName(u32 key)
+{
+    static const struct { u32 key; const char *name; } ALL[] = {
+        {KEY_A, "A"}, {KEY_B, "B"}, {KEY_X, "X"}, {KEY_Y, "Y"}, {KEY_L, "L"}, {KEY_R, "R"}, {KEY_ZL, "ZL"}, {KEY_ZR, "ZR"},
+        {KEY_START, "Start"}, {KEY_SELECT, "Select"}, {KEY_DUP, "Up"}, {KEY_DDOWN, "Down"}, {KEY_DLEFT, "Left"}, {KEY_DRIGHT, "Right"},
+        {KEY_CPAD_UP, "Circle Pad Up"}, {KEY_CPAD_DOWN, "Circle Pad Down"}, {KEY_CPAD_LEFT, "Circle Pad Left"}, {KEY_CPAD_RIGHT, "Circle Pad Right"},
+        {KEY_CSTICK_UP, "C Up"}, {KEY_CSTICK_DOWN, "C Down"}, {KEY_CSTICK_LEFT, "C Left"}, {KEY_CSTICK_RIGHT, "C Right"},
+    };
+    for (const auto &k : ALL) if (k.key == key) return k.name;
+    return "That button";
+}
+
+// What a button does in a run, for the error when it cannot be bound.
+static void keyUse(u32 key, char *out, size_t cap)
+{
+    const char *k = keyName(key);
+    if (key & (KEY_DUP | KEY_DDOWN | KEY_DLEFT | KEY_DRIGHT)) { snprintf(out, cap, "%s is the SNES D-pad", k); return; }
+    if ((key & (KEY_CPAD_UP | KEY_CPAD_DOWN | KEY_CPAD_LEFT | KEY_CPAD_RIGHT)) && settings3DS.BindCirclePad) { snprintf(out, cap, "%s moves like the D-pad", k); return; }
+    static const u32 PADS[10] = {KEY_A, KEY_B, KEY_X, KEY_Y, KEY_L, KEY_R, KEY_ZL, KEY_ZR, KEY_SELECT, KEY_START};
+    static const struct { u32 mask; const char *name; } SNES[] = {
+        {SNES_A_MASK, "A"}, {SNES_B_MASK, "B"}, {SNES_X_MASK, "X"}, {SNES_Y_MASK, "Y"}, {SNES_TL_MASK, "L"}, {SNES_TR_MASK, "R"},
+        {SNES_SELECT_MASK, "Select"}, {SNES_START_MASK, "Start"},
+    };
+    for (int i = 0; i < 10; i++) {
+        if (key != PADS[i]) continue;
+        u32 m = 0;
+        for (int j = 0; j < 4; j++) m |= (u32)settings3DS.ButtonMapping[i][j];
+        if (!m) break;
+        const char *snes = "a game";
+        for (const auto &b : SNES) if (m & b.mask) { snes = b.name; break; }
+        snprintf(out, cap, "%s is the SNES %s button", k, snes);
+        return;
+    }
+    if (settings3DS.GlobalButtonHotkeys[HOTKEY_OPEN_MENU].MappingBitmasks[0] & key) { snprintf(out, cap, "%s opens the game menu", k); return; }
+    snprintf(out, cap, "%s cannot be bound", k);
+}
+
+static int pauseRows(PauseRow *rows)
+{
+    int n = 0;
+    rows[n++] = {PM_RESUME, 0};
+    if (!smz3NoStates()) { rows[n++] = {PM_SAVE, 0}; rows[n++] = {PM_LOAD, 0}; }
+    rows[n++] = {PM_RUNS, 0};
+    rows[n++] = {PM_RESTART, 0};
+    rows[n++] = {PM_MUTE, 0};
+    rows[n++] = {PM_ROW0, 0};
+    rows[n++] = {PM_ROW1, 0};
+    rows[n++] = {PM_BAR, 0};
+    rows[n++] = {PM_CONFIRM, 0};
+    if (settings3DS.isNew3DS) rows[n++] = {PM_BUTTONS, 0};   // ZL, ZR and the C-stick: an Old 3DS has none of them
+    return n;
+}
+
+static void pauseRowText(const PauseRow &r, int slot, char *label, char *value, size_t cap, bool *dim)
+{
+    *dim = false;
+    value[0] = 0;
+    switch (r.id) {
+    case PM_RESUME: snprintf(label, cap, "Resume"); break;
+    case PM_SAVE: snprintf(label, cap, "Save state"); snprintf(value, cap, "Slot %d%s", slot, impl3dsSlotHasState(slot) ? "  (used)" : ""); break;
+    case PM_LOAD:
+        snprintf(label, cap, "Load state");
+        snprintf(value, cap, "Slot %d%s", slot, impl3dsSlotHasState(slot) ? "" : "  (empty)");
+        *dim = !impl3dsSlotHasState(slot);
+        break;
+    case PM_RUNS: snprintf(label, cap, "Back to the runs"); break;
+    case PM_RESTART: snprintf(label, cap, "Restart"); break;
+    case PM_MUTE: snprintf(label, cap, "Mute audio"); snprintf(value, cap, "%s", snd3dsMuted ? "On" : "Off"); break;
+    case PM_ROW0: snprintf(label, cap, "Shortcut row"); snprintf(value, cap, "%s", smz3ShortcutRowShown(0) ? "Shown" : "Hidden"); break;
+    case PM_ROW1: snprintf(label, cap, "Weapon row"); snprintf(value, cap, "%s", smz3ShortcutRowShown(1) ? "Shown" : "Hidden"); break;
+    case PM_BAR: snprintf(label, cap, "Save bar"); snprintf(value, cap, "%s", inBar ? "Shown" : "Hidden"); break;
+    case PM_CONFIRM: snprintf(label, cap, "Confirm save/load"); snprintf(value, cap, "%s", inConfirm ? "On" : "Off"); break;
+    case PM_BUTTONS: snprintf(label, cap, "Buttons"); break;
+    case PM_BTN:
+        snprintf(label, cap, "%s", BTN_NAMES[r.arg]);
+        actionName(inBtn[r.arg], value, cap);
+        *dim = !inBtn[r.arg];
+        break;
+    case PM_ACT:
+        actionName(r.arg, label, cap);
+        for (int i = 0; i < BTN_COUNT; i++) if (inBtn[i] == r.arg) snprintf(value, cap, "%s", BTN_NAMES[i]);
+        break;
+    }
+}
+
+static const char *pauseTip(const PauseRow &r)
+{
+    switch (r.id) {
+    case PM_SAVE: return "Left and Right pick the slot.";
+    case PM_LOAD: return "Left and Right pick the slot.";
+    case PM_RUNS: return "The run keeps its time and progress.";
+    case PM_RESTART: return "Starts the game over from its own save.";
+    case PM_ROW0: return "The item slots or the beams over the tracker's map.";
+    case PM_ROW1: return "Missiles, Super Missiles and Power Bombs under the beams.";
+    case PM_BAR: return "SAVE, LOAD and fast forward under the shortcuts. The 3D slider up is fast forward too.";
+    case PM_CONFIRM: return "SAVE and LOAD from the bar or a button ask first.";
+    case PM_BUTTONS: return "What ZL, ZR and the C-stick do in a run. They no longer reach the game.";
+    case PM_BTN: return "A bound button no longer reaches the game.";
+    default: return "";
+    }
+}
+
+static void pmText(int x, int y, int w, int color, int align, const char *s)
+{
+    int x0 = x, x1 = x + w;
+    ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, x0, y, x1, y + 14, color, align, s);
+}
+
+// The list, with a dialog over it when title is set; a note under a dialog is an error in it.
+static void drawPause(const PauseRow *rows, int n, int cursor, int scroll, int slot, const char *note, const char *title, const char *body, const char *legend)
+{
+    float pulse = 0.5f + 0.5f * sinf((float)(osGetTime() % 100000) / 1000.0f * 3.4f);
+    drawBackdrop();
+    UiCmd c = {};
+    c.kind = 0; c.color = 1; c.x = 0; c.y = 0; c.w = UI_W; c.h = 28;
+    drawStyledRect(&c, PALETTE[C_PANEL], pulse);
+    UiCmd logo = {};
+    logo.kind = 2; logo.color = C_TEXT; logo.x = 6; logo.y = 3; logo.w = 22; logo.h = 22;
+    snprintf(logo.text, sizeof logo.text, "logo");
+    drawPreview(&logo);
+    pmText(32, 8, 200, PALETTE[C_ACCENT], HALIGN_LEFT, pmHeading);
+    pmText(UI_W - 208, 8, 200, PALETTE[C_DIM], HALIGN_RIGHT, runName);
+    for (int r = 0; r < PM_ROWS_SHOWN && scroll + r < n; r++) {
+        int i = scroll + r, y = PM_LIST_Y + r * PM_ROW_H;
+        c.color = i == cursor ? 2 : 1; c.x = 6; c.y = y; c.w = UI_W - 12; c.h = PM_ROW_H - 3;
+        drawStyledRect(&c, PALETTE[c.color], pulse);
+        char label[48], value[48];
+        bool dim;
+        pauseRowText(rows[i], slot, label, value, sizeof label, &dim);
+        pmText(16, y + 2, 240, dim && rows[i].id != PM_BTN ? PALETTE[C_DIM] : PALETTE[C_TEXT], HALIGN_LEFT, label);
+        if (value[0]) {
+            bool pick = rows[i].id == PM_SAVE || rows[i].id == PM_LOAD;
+            if (pick && i == cursor) {   // the arrows of a value that Left and Right change
+                char v[56];
+                snprintf(v, sizeof v, "<  %s  >", value);
+                pmText(UI_W - 216, y + 2, 200, dim ? PALETTE[C_DIM] : PALETTE[C_ACCENT], HALIGN_RIGHT, v);
+            } else pmText(UI_W - 216, y + 2, 200, dim ? PALETTE[C_DIM] : PALETTE[C_ACCENT], HALIGN_RIGHT, value);
+        }
+    }
+    if (scroll > 0) pmText(UI_W - 20, PM_LIST_Y - 12, 12, PALETTE[C_ACCENT], HALIGN_CENTER, "^");
+    if (scroll + PM_ROWS_SHOWN < n) pmText(UI_W - 20, PM_LIST_Y + PM_ROWS_SHOWN * PM_ROW_H - 4, 12, PALETTE[C_ACCENT], HALIGN_CENTER, "v");
+    if (!title) pmText(10, UI_H - 34, UI_W - 20, note && note[0] ? PALETTE[C_GREEN] : PALETTE[C_DIM], HALIGN_LEFT, note && note[0] ? note : pauseTip(rows[cursor]));
+    else {
+        for (int y = 0; y < UI_H; y += 2) ui3dsDrawRect(0, y, UI_W, y + 2, 0x05080C, 0.55f);
+        int w = 320, h = 132, x = (UI_W - w) / 2, y = 48;
+        c.color = 1; c.x = x; c.y = y; c.w = w; c.h = h;
+        drawStyledRect(&c, PALETTE[C_PANEL], pulse);
+        pmText(x + 12, y + 8, w - 24, PALETTE[C_ACCENT], HALIGN_LEFT, title);
+        ui3dsDrawStringWithWrapping(settings3DS.SecondScreen, x + 12, y + 30, x + w - 12, y + h - 40, PALETTE[C_TEXT], HALIGN_LEFT, body, 4);
+        if (note && note[0]) ui3dsDrawStringWithWrapping(settings3DS.SecondScreen, x + 12, y + h - 38, x + w - 12, y + h - 6, PALETTE[C_WARN], HALIGN_LEFT, note, 2);
+    }
+    ui3dsDrawRect(0, UI_H - 16, UI_W, UI_H, 0x0C1119);
+    ui3dsDrawRect(0, UI_H - 16, UI_W, UI_H - 15, 0x25324A);
+    drawHintBar(legend);
+    impl3dsFlushScreen(settings3DS.SecondScreen, false, false);
+    gfxScreenSwapBuffers(settings3DS.SecondScreen, false);
+    gpu3dsWaitForVBlank(settings3DS.SecondScreen);
+}
+
+// A dialog over the list until A (true) or B (false); a tap on its upper half is A, elsewhere B.
+static bool pauseDialog(const PauseRow *rows, int n, int cursor, int scroll, int slot, const char *title, const char *body, bool ask, const char *legend = NULL)
+{
+    uiCueSound(UI_CUE_OPEN);
+    if (!legend) legend = ask ? "A Yes B No" : "A OK";
+    while (aptMainLoop()) {
+        hidScanInput();
+        u32 down = hidKeysDown();
+        if (down & KEY_A) { uiCueSound(UI_CUE_CONFIRM); return true; }
+        if (down & KEY_B) { uiCueSound(UI_CUE_BACK); return !ask; }
+        if (down & KEY_TOUCH) {
+            touchPosition t;
+            hidTouchRead(&t);
+            bool yes = !ask || t.py < 120;
+            uiCueSound(yes ? UI_CUE_CONFIRM : UI_CUE_BACK);
+            return yes;
+        }
+        drawPause(rows, n, cursor, scroll, slot, NULL, title, body, legend);
+    }
+    return false;
+}
+
+// The list row under a touch (the bottom screen stands for the top one, stretched to its width), or -1.
+static int pmRowTouched(int scroll, int n)
+{
+    touchPosition t;
+    hidTouchRead(&t);
+    int y = t.py, r = (y - PM_LIST_Y) / PM_ROW_H;
+    return y >= PM_LIST_Y && r < PM_ROWS_SHOWN && scroll + r < n ? scroll + r : -1;
+}
+
+static void pmFollow(int cursor, int *scroll)
+{
+    if (cursor < *scroll) *scroll = cursor;
+    if (cursor >= *scroll + PM_ROWS_SHOWN) *scroll = cursor - PM_ROWS_SHOWN + 1;
+}
+
+// A on a button row: the action from a list, then the button for it, which only ZL, ZR or the C-stick can be. An action
+// lives on one button at most: binding it again moves it.
+static void bindAction(int slot)
+{
+    PauseRow acts[4 + SC_KEYS];
+    int n = 0, cursor = 0, scroll = 0, pick = -1;
+    for (int a = BIND_FAST; a <= BIND_MENU; a++) acts[n++] = {PM_ACT, a};
+    for (int i = 0; i < SC_KEYS; i++) acts[n++] = {PM_ACT, BIND_SHORTCUT + i};
+    pmHeading = "SMZ3  -  Pick an action";
+    input3dsWaitForRelease();
+    while (aptMainLoop()) {
+        pmFollow(cursor, &scroll);
+        hidScanInput();
+        u32 down = hidKeysDown();
+        if (down & KEY_B) { uiCueSound(UI_CUE_BACK); break; }
+        if (down & KEY_DUP) { cursor = (cursor + n - 1) % n; uiCueSound(UI_CUE_MOVE); }
+        else if (down & KEY_DDOWN) { cursor = (cursor + 1) % n; uiCueSound(UI_CUE_MOVE); }
+        else if (down & KEY_A) { pick = acts[cursor].arg; uiCueSound(UI_CUE_CONFIRM); break; }
+        else if (down & KEY_TOUCH) {
+            int r = pmRowTouched(scroll, n);
+            if (r >= 0) { cursor = r; pick = acts[r].arg; uiCueSound(UI_CUE_CONFIRM); break; }
+        }
+        drawPause(acts, n, cursor, scroll, slot, NULL, NULL, NULL, "A Choose B Back");
+    }
+    if (pick >= 0) {
+        char title[48], err[96] = "";
+        actionName(pick, title, sizeof title);
+        input3dsWaitForRelease();
+        while (aptMainLoop()) {
+            hidScanInput();
+            u32 down = hidKeysDown() & ~KEY_TOUCH, key = down & -down;   // one button: the lowest pressed
+            if (down & KEY_B) { uiCueSound(UI_CUE_BACK); break; }
+            if (key) {
+                int k = -1;
+                for (int i = 0; i < BTN_COUNT; i++) if (BTN_KEYS[i] == key) k = i;
+                if (k < 0) {
+                    char use[64];
+                    keyUse(key, use, sizeof use);
+                    snprintf(err, sizeof err, "%s. Pick ZL, ZR or C.", use);
+                    uiCueSound(UI_CUE_BACK);
+                } else {
+                    if (inBtn[k] && inBtn[k] != pick) {
+                        char was[48], q[128];
+                        snprintf(q, sizeof q, "%s is %s. Replace it with %s?", BTN_NAMES[k], actionName(inBtn[k], was, sizeof was), title);
+                        if (!pauseDialog(acts, n, cursor, scroll, slot, "Button in use", q, true, "A Replace B Keep")) break;
+                    } else uiCueSound(UI_CUE_CONFIRM);
+                    for (int i = 0; i < BTN_COUNT; i++) if (inBtn[i] == pick) inBtn[i] = BIND_NONE;
+                    inBtn[k] = pick;
+                    inSave();
+                    break;
+                }
+            }
+            drawPause(acts, n, cursor, scroll, slot, err, title, "Press ZL, ZR or the C stick. Only these can be bound. B cancels.", "B Cancel");
+        }
+    }
+    input3dsWaitForRelease();
+}
+
+// What ZL, ZR and the C-stick do in a run (a New 3DS only).
+static void buttonsMenu(int slot)
+{
+    PauseRow rows[BTN_COUNT];
+    for (int i = 0; i < BTN_COUNT; i++) rows[i] = {PM_BTN, i};
+    int cursor = 0;
+    input3dsWaitForRelease();
+    while (aptMainLoop()) {
+        pmHeading = "SMZ3  -  Buttons";
+        hidScanInput();
+        u32 down = hidKeysDown();
+        if (down & KEY_B) { uiCueSound(UI_CUE_BACK); break; }
+        if (down & KEY_DUP) { cursor = (cursor + BTN_COUNT - 1) % BTN_COUNT; uiCueSound(UI_CUE_MOVE); }
+        else if (down & KEY_DDOWN) { cursor = (cursor + 1) % BTN_COUNT; uiCueSound(UI_CUE_MOVE); }
+        else if (down & KEY_X) { if (inBtn[cursor]) { inBtn[cursor] = BIND_NONE; inSave(); uiCueSound(UI_CUE_SELECT); } }
+        else if (down & KEY_A) bindAction(slot);
+        else if (down & KEY_TOUCH) {
+            int r = pmRowTouched(0, BTN_COUNT);
+            if (r >= 0) { cursor = r; bindAction(slot); }
+        }
+        drawPause(rows, BTN_COUNT, cursor, 0, slot, NULL, NULL, NULL, "A Change X Clear B Back");
+    }
+    pmHeading = "SMZ3  -  Game menu";
+    input3dsWaitForRelease();
+}
+
+int smz3PauseMenu(void)
+{
+    PauseRow rows[16];
+    int n = pauseRows(rows), cursor = 0, scroll = 0, slot = settings3DS.CurrentSaveSlot;   // it opens on Resume, as on the Thor
+    if (slot < 1 || slot > SAVESLOTS_MAX) slot = 1;
+    char note[64] = "";
+    int result = SMZ3_PAUSE_CLOSING;
+    inLoad();
+    topBegin();
+    input3dsWaitForRelease();
+    while (aptMainLoop()) {
+        n = pauseRows(rows);
+        if (cursor >= n) cursor = n - 1;
+        pmFollow(cursor, &scroll);
+        hidScanInput();
+        u32 down = hidKeysDown();
+        int act = 0;   // 1 A, -1 Left, +2 Right
+        bool menuKey = settings3DS.UseGlobalEmuControlKeys ? settings3DS.GlobalButtonHotkeys[HOTKEY_OPEN_MENU].IsHeld(down)
+                                                           : settings3DS.ButtonHotkeys[HOTKEY_OPEN_MENU].IsHeld(down);
+        bool pauseIcon = false;   // the tracker's pause icon, still on the bottom screen under the menu
+        if (down & KEY_TOUCH) {
+            touchPosition t;
+            hidTouchRead(&t);
+            pauseIcon = t.px >= 320 - PAUSE_W && t.py >= topOfTabs() && t.py < topOfTabs() + TAB_H;
+        }
+        if ((down & (KEY_B | KEY_START)) || menuKey || pauseIcon) { uiCueSound(UI_CUE_BACK); result = SMZ3_PAUSE_RESUME; break; }   // what opened it closes it
+        if (down & KEY_DUP) { cursor = (cursor + n - 1) % n; note[0] = 0; uiCueSound(UI_CUE_MOVE); }
+        else if (down & KEY_DDOWN) { cursor = (cursor + 1) % n; note[0] = 0; uiCueSound(UI_CUE_MOVE); }
+        else if (down & KEY_DLEFT) act = -1;
+        else if (down & KEY_DRIGHT) act = 2;
+        else if (down & KEY_A) act = 1;
+        else if (down & KEY_TOUCH) {   // the bottom screen stands for this one, stretched to its width
+            touchPosition t;
+            hidTouchRead(&t);
+            int x = t.px * UI_W / SCREEN_BOTTOM_WIDTH, y = t.py;
+            int r = pmRowTouched(scroll, n);
+            if (r >= 0) {
+                bool pick = rows[r].id == PM_SAVE || rows[r].id == PM_LOAD;
+                if (pick && r == cursor && x >= UI_W - 216) act = x < UI_W - 108 ? -1 : 2;   // the value's arrows
+                else { cursor = r; act = 1; }
+            } else if (y < PM_LIST_Y && scroll > 0) { cursor = scroll - 1; uiCueSound(UI_CUE_MOVE); }
+            else if (y >= PM_LIST_Y + PM_ROWS_SHOWN * PM_ROW_H && y < UI_H - 16 && scroll + PM_ROWS_SHOWN < n) { cursor = scroll + PM_ROWS_SHOWN; uiCueSound(UI_CUE_MOVE); }
+        }
+        if (act) {
+            const PauseRow &row = rows[cursor];
+            int step = act == -1 ? -1 : 1;
+            note[0] = 0;
+            switch (row.id) {
+            case PM_SAVE:
+            case PM_LOAD:
+                if (act != 1) { slot = (slot - 1 + step + SAVESLOTS_MAX) % SAVESLOTS_MAX + 1; uiCueSound(UI_CUE_SELECT); break; }
+                if (row.id == PM_LOAD) {
+                    if (!impl3dsSlotHasState(slot)) { snprintf(note, sizeof note, "Slot %d is empty.", slot); uiCueSound(UI_CUE_BACK); break; }
+                    uiCueSound(UI_CUE_CONFIRM);
+                    if (impl3dsLoadStateSlot(slot)) { settings3DS.CurrentSaveSlot = slot; barSays(false, true); result = SMZ3_PAUSE_LOADED; goto done; }
+                    snprintf(note, sizeof note, "Slot %d could not be loaded.", slot);
+                    break;
+                }
+                if (impl3dsSlotHasState(slot)) {
+                    char q[48];
+                    snprintf(q, sizeof q, "Slot %d already holds a state. Save over it?", slot);
+                    if (!pauseDialog(rows, n, cursor, scroll, slot, "Save state", q, true)) break;
+                } else uiCueSound(UI_CUE_CONFIRM);
+                if (impl3dsSaveStateSlot(slot)) { settings3DS.CurrentSaveSlot = slot; barSays(true, true); result = SMZ3_PAUSE_SAVED; goto done; }
+                snprintf(note, sizeof note, "Saving into slot %d failed.", slot);
+                break;
+            case PM_RESUME: if (act == 1) { uiCueSound(UI_CUE_CONFIRM); result = SMZ3_PAUSE_RESUME; goto done; } break;
+            case PM_RUNS: if (act == 1) { uiCueSound(UI_CUE_CONFIRM); result = SMZ3_PAUSE_RUNS; goto done; } break;
+            case PM_RESTART:
+                if (act == 1 && pauseDialog(rows, n, cursor, scroll, slot, "Restart", "The game starts over from its own save. Restart it?", true)) {
+                    impl3dsResetConsole();
+                    result = SMZ3_PAUSE_RESUME;
+                    goto done;
+                }
+                break;
+            case PM_MUTE: snd3dsMuted = !snd3dsMuted; snd3dsApplyOutputVolume(); uiCueSound(UI_CUE_SELECT); break;
+            case PM_ROW0: case PM_ROW1: smz3SetShortcutRowShown(row.id == PM_ROW1, !smz3ShortcutRowShown(row.id == PM_ROW1)); uiCueSound(UI_CUE_SELECT); break;
+            case PM_BAR: inBar = !inBar; inSave(); dirty = true; uiCueSound(UI_CUE_SELECT); break;
+            case PM_CONFIRM: inConfirm = !inConfirm; inSave(); uiCueSound(UI_CUE_SELECT); break;
+            case PM_BUTTONS: if (act == 1) { uiCueSound(UI_CUE_CONFIRM); buttonsMenu(slot); } break;
+            }
+        }
+        drawPause(rows, n, cursor, scroll, slot, note, NULL, NULL, "A Choose Left Right Change B Resume");
+    }
+done:
+    topEnd();
+    return result;
+}
