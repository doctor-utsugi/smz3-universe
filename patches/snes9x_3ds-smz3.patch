+#ifndef SMZ3RUN_H
+#define SMZ3RUN_H
+
+#include <stddef.h>
+
+// The app's data folder: runs, saves, states, sprites, online files, logs. The base ROMs may sit in it too.
+#define SMZ_DIR "sdmc:/3ds/SMZ3"
+// Before anything else at boot: the data folder of older builds (sdmc:/SMZ3) is moved to SMZ_DIR when SMZ_DIR does not
+// exist yet, so its runs and saves carry over.
+void smz3MoveDataDir(void);
+
+// Shows the SMZ3 run menu, the app's home. Returns true with the full path of the ROM to play in romPathOut when the
+// player picked Continue on a run, false when the app is closing.
+bool smz3RunMenu(char *romPathOut, size_t cap);
+// The game menu while a run is played (the Thor's game menu), drawn like the run menu on the top screen. Saving, loading
+// and restarting happen inside; the caller resumes the game, opens the run list or closes the app.
+enum { SMZ3_PAUSE_RESUME, SMZ3_PAUSE_RUNS, SMZ3_PAUSE_LOADED, SMZ3_PAUSE_SAVED, SMZ3_PAUSE_CLOSING };
+int smz3PauseMenu(void);
+// A note the run menu shows for a moment the next time it opens (a run that failed to load).
+void smz3RunMenuNote(const char *text);
+
+// The run tracker on the second screen; call every frame while emulating, with tick set about once a second (the run is
+// read then; touches redraw in between). Does nothing for other games.
+void smz3TrackerFrame(bool tick);
+// Touch input while emulating (keys from hidKeysDown / hidKeysHeld). True when the tracker took the touch, so it must not
+// open the emulator's menu; false for other games and for the tracker's pause button.
+bool smz3TrackerTouch(unsigned keysDown, unsigned keysHeld);
+
+// While the run-complete card is up, A (to the run list) and B (close it) are the card's; otherwise the buttons bound to
+// the item shortcuts use them. Returns the keys taken from the game (0 otherwise). After A on the card, openMenu is set:
+// the emulator opens its menu and smz3TakeRunListRequest() is true once.
+unsigned smz3TrackerKeys(unsigned keysDown, bool *openMenu);
+// The run-complete card on the game screen: drawn into its texture before the frame, then over the game in each eye.
+void smz3CardSync(void);
+void smz3CardDraw(float xOffset);
+bool smz3TakeRunListRequest(void);
+
+// A save state was saved to or loaded from path: the world goal counters go with it in path.goals, and on a load the tracker's
+// recent lists drop what it undid.
+void smz3StateSaved(const char *path);
+void smz3StateLoaded(const char *path);
+// The app is closing: the run being played keeps its world goal counters.
+void smz3RunClosing(void);
+
+// True while a generated run is loaded.
+bool smz3IsRun(void);
+// True when the run being played allows no save states: its settings say so, or it is a monthly, weekly or daily run.
+bool smz3NoStates(void);
+// True when the run being played keeps an auto state (its settings allow save states).
+bool smz3AutoStates(void);
+// The run chosen in the SMZ3 menu has been loaded; true when it should start from its auto state.
+bool smz3RunStarted(void);
+// Fast forward in effect in a run, from the raw held buttons: the 3D slider up, the save bar's toggle or a held bound
+// button (New 3DS); never in a daily challenge.
+bool smz3FastForward(unsigned held);
+// Pause menu: spends a help (limited mode) and writes the next hint, or why there is none, into out.
+void smz3AskHelp(char *out, size_t cap);
+// The tracker's shortcut rows: 0 the ALttP slots or the beams, 1 the Super Metroid weapons.
+bool smz3ShortcutRowShown(int row);
+void smz3SetShortcutRowShown(int row, bool shown);
+// The item shortcuts a New 3DS button can be bound to: the five ALttP slots, then each beam and weapon.
+int smz3ShortcutKeyCount(void);
+const char *smz3ShortcutKeyName(int i);
+
+#endif
