diff --git a/source/smz3online.cpp b/source/smz3online.cpp
new file mode 100644
index 0000000..bf51e1b
--- /dev/null
+++ b/source/smz3online.cpp
@@ -0,0 +1,667 @@
+#include "smz3online.h"
+#include "smz3run.h"
+
+#include <3ds.h>
+#include <dirent.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+
+#define ONLINE_DIR SMZ_DIR "/online"
+#define BASE_URL "https://smz3.indieviral.com"
+
+static char *pathOf(const char *fmt, int slot)
+{
+    static char buf[4][128];
+    static int next;
+    char *p = buf[next++ & 3];
+    snprintf(p, 128, fmt, slot);
+    return p;
+}
+
+static char *readText(const char *path, size_t *len)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    char *b = (char *)malloc(n > 0 ? n + 1 : 1);
+    if (b && fread(b, 1, n, f) != (size_t)n) { free(b); b = NULL; }
+    fclose(f);
+    if (b) { b[n] = 0; if (len) *len = (size_t)n; }
+    return b;
+}
+
+static void writeText(const char *path, const char *text, size_t n)
+{
+    mkdir(SMZ_DIR, 0777);
+    mkdir(ONLINE_DIR, 0777);
+    FILE *f = fopen(path, "wb");
+    if (f) { fwrite(text, 1, n, f); fclose(f); }
+}
+
+static bool exists(const char *path) { struct stat st; return stat(path, &st) == 0; }
+
+// ---- one blocking request; returns the HTTP status or -1. The body is left in out (NUL terminated).
+
+// debug aid: SMZ_DIR/server.txt names another server (a local one, for tests)
+static const char *baseUrl()
+{
+    static char base[96];
+    static bool read;
+    if (!read) {
+        read = true;
+        snprintf(base, sizeof base, BASE_URL);
+        if (FILE *f = fopen(SMZ_DIR "/server.txt", "r")) {
+            char line[96] = "";
+            if (fgets(line, sizeof line, f) && !strncmp(line, "http", 4)) {
+                line[strcspn(line, "\r\n ")] = 0;
+                size_t n = strlen(line);
+                if (n && line[n - 1] == '/') line[n - 1] = 0;
+                snprintf(base, sizeof base, "%s", line);
+            }
+            fclose(f);
+        }
+    }
+    return base;
+}
+
+static int httpRequest(const char *method, const char *path, const char *body, char *out, size_t cap)
+{
+    out[0] = 0;
+    char url[480];
+    snprintf(url, sizeof url, "%s%s", baseUrl(), path);
+    for (int attempt = 0; attempt < 2; attempt++) {
+        httpcContext ctx;
+        if (R_FAILED(httpcOpenContext(&ctx, body ? HTTPC_METHOD_POST : HTTPC_METHOD_GET, url, 1))) return -1;
+        // the console's certificate store may not know the server's authority; the second attempt skips the check (the ladder holds
+        // no secrets: a name, a country and times)
+        if (attempt) httpcSetSSLOpt(&ctx, SSLCOPT_DisableVerify);
+        httpcAddRequestHeaderField(&ctx, "User-Agent", "smz3-3ds");
+        if (body) {
+            httpcAddRequestHeaderField(&ctx, "Content-Type", "application/json");
+            httpcAddPostDataRaw(&ctx, (const u32 *)body, (u32)strlen(body));
+        }
+        if (R_FAILED(httpcBeginRequest(&ctx))) { httpcCloseContext(&ctx); continue; }
+        u32 status = 0;
+        if (R_FAILED(httpcGetResponseStatusCodeTimeout(&ctx, &status, 8ULL * 1000 * 1000 * 1000))) { httpcCancelConnection(&ctx); httpcCloseContext(&ctx); continue; }
+        size_t got = 0;
+        Result r;
+        do {
+            u32 n = 0;
+            r = httpcDownloadData(&ctx, (u8 *)out + got, (u32)(cap - 1 - got), &n);
+            got += n;
+        } while (r == (Result)HTTPC_RESULTCODE_DOWNLOADPENDING && got < cap - 1);
+        out[got] = 0;
+        httpcCloseContext(&ctx);
+        return (int)status;
+    }
+    return -1;
+}
+
+static bool jsonStr(const char *json, const char *key, char *out, size_t cap)
+{
+    char pat[48];
+    snprintf(pat, sizeof pat, "\"%s\":\"", key);
+    const char *p = strstr(json, pat);
+    if (!p) return false;
+    p += strlen(pat);
+    size_t n = strcspn(p, "\"");
+    if (n >= cap) return false;
+    memcpy(out, p, n);
+    out[n] = 0;
+    return true;
+}
+
+static bool jsonNum(const char *json, const char *key, long long *v)
+{
+    char pat[48];
+    snprintf(pat, sizeof pat, "\"%s\":", key);
+    const char *p = strstr(json, pat);
+    if (!p) return false;
+    *v = atoll(p + strlen(pat));
+    return true;
+}
+
+// ---- profile, install id
+
+bool smzOnlineProfileLoad(char *out, size_t cap)
+{
+    size_t n;
+    char *t = readText(ONLINE_DIR "/player.txt", &n);
+    if (!t) return false;
+    snprintf(out, cap, "%s", t);
+    free(t);
+    return true;
+}
+
+void smzOnlineProfileSave(const char *text) { writeText(ONLINE_DIR "/player.txt", text, strlen(text)); }
+
+// The name and country the server shows ("Player" and none when the profile has not been filled in).
+static void playerOf(char name[32], char country[4])
+{
+    char profile[96] = "";
+    snprintf(name, 32, "Player");
+    country[0] = 0;
+    smzOnlineProfileLoad(profile, sizeof profile);
+    char *tab = strchr(profile, '\t');
+    if (profile[0]) { size_t l = tab ? (size_t)(tab - profile) : strlen(profile); if (l > 0 && l < 32) { memcpy(name, profile, l); name[l] = 0; } }
+    if (tab && tab[1] >= 'A' && tab[1] <= 'Z' && tab[2] >= 'A' && tab[2] <= 'Z') { country[0] = tab[1]; country[1] = tab[2]; country[2] = 0; }
+}
+
+static void installId(char out[40])
+{
+    size_t n;
+    char *t = readText(ONLINE_DIR "/install_id", &n);
+    if (t && n >= 16 && n <= 39) { snprintf(out, 40, "%s", t); out[strcspn(out, "\r\n ")] = 0; free(t); return; }
+    free(t);
+    u64 x = osGetTime() * 6364136223846793005ull ^ svcGetSystemTick();
+    for (int i = 0; i < 32; i++) {
+        x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+        out[i] = "0123456789abcdef"[(x >> 11) & 15];
+    }
+    out[32] = 0;
+    writeText(ONLINE_DIR "/install_id", out, 32);
+}
+
+// ---- per slot files: .mode (the run's kind, online or not), .online (kind on the ladder), .token, .finish ("time seed"), .proof
+
+static int kindOf(const char *t)
+{
+    return !strncmp(t, "original", 8) ? 1 : !strncmp(t, "monthly", 7) ? 2 : !strncmp(t, "weekly", 6) ? 3 : 0;
+}
+
+int smzOnlineSlotKind(int slot)
+{
+    size_t n;
+    char *t = readText(pathOf(ONLINE_DIR "/slot%d.online", slot), &n);
+    int kind = 0;
+    if (t) { kind = kindOf(t); free(t); }
+    return kind;
+}
+
+int smzOnlineRunMode(int slot)
+{
+    size_t n;
+    char *t = readText(pathOf(ONLINE_DIR "/slot%d.mode", slot), &n);
+    if (!t) return smzOnlineSlotKind(slot);   // runs made before the mode was kept
+    int kind = kindOf(t);
+    free(t);
+    return kind;
+}
+
+void smzOnlineMarkRun(int slot, int online, int kind)
+{
+    remove(pathOf(ONLINE_DIR "/slot%d.token", slot));
+    remove(pathOf(ONLINE_DIR "/slot%d.finish", slot));
+    remove(pathOf(ONLINE_DIR "/slot%d.proof", slot));
+    const char *k = kind == 3 ? "weekly" : kind == 2 ? "monthly" : "original";
+    writeText(pathOf(ONLINE_DIR "/slot%d.mode", slot), k, strlen(k));
+    if (!online) { remove(pathOf(ONLINE_DIR "/slot%d.online", slot)); return; }
+    writeText(pathOf(ONLINE_DIR "/slot%d.online", slot), k, strlen(k));
+}
+
+const char *smzOnlineProofPath(int slot) { return pathOf(ONLINE_DIR "/slot%d.proof", slot); }
+
+// ---- seeds
+
+static LightLock gLock;
+static bool gLockReady;
+static struct { bool ready; char label[16]; int seed, days; } gMonthly, gWeekly;
+static bool gStarted;
+
+static void lockInit() { if (!gLockReady) { LightLock_Init(&gLock); gLockReady = true; } }
+
+static int daysUntil(long long endMs)
+{
+    long long now = (long long)time(NULL) * 1000;
+    long long left = endMs - now;
+    return left <= 0 ? 0 : (int)((left + 86399999) / 86400000);
+}
+
+static void fetchSeeds()
+{
+    static char reply[1024];
+    char label[16], seedText[16];
+    if (httpRequest("GET", "/api/monthly", NULL, reply, sizeof reply) == 200 && jsonStr(reply, "month", label, sizeof label) && jsonStr(reply, "seed", seedText, sizeof seedText)) {
+        time_t now = time(NULL);
+        struct tm tmv;
+        gmtime_r(&now, &tmv);
+        tmv.tm_mon++; tmv.tm_mday = 1; tmv.tm_hour = tmv.tm_min = tmv.tm_sec = 0;
+        long long end = (long long)mktime(&tmv) * 1000;   // the console's clock is local time; a day more or less is fine for a countdown
+        LightLock_Lock(&gLock);
+        snprintf(gMonthly.label, sizeof gMonthly.label, "%s", label);
+        gMonthly.seed = atoi(seedText);
+        gMonthly.days = daysUntil(end);
+        gMonthly.ready = true;
+        LightLock_Unlock(&gLock);
+    }
+    long long ends = 0;
+    if (httpRequest("GET", "/api/weekly", NULL, reply, sizeof reply) == 200 && jsonStr(reply, "week", label, sizeof label) && jsonStr(reply, "seed", seedText, sizeof seedText) && jsonNum(reply, "endsAt", &ends)) {
+        LightLock_Lock(&gLock);
+        snprintf(gWeekly.label, sizeof gWeekly.label, "%s", label);
+        gWeekly.seed = atoi(seedText);
+        gWeekly.days = daysUntil(ends);
+        gWeekly.ready = true;
+        LightLock_Unlock(&gLock);
+    }
+}
+
+bool smzOnlineTakeMonthly(char label[16], int *seed, int *days)
+{
+    lockInit();
+    LightLock_Lock(&gLock);
+    bool r = gMonthly.ready;
+    if (r) { gMonthly.ready = false; snprintf(label, 16, "%s", gMonthly.label); *seed = gMonthly.seed; *days = gMonthly.days; }
+    LightLock_Unlock(&gLock);
+    return r;
+}
+
+bool smzOnlineTakeWeekly(char label[16], int *seed, int *days)
+{
+    lockInit();
+    LightLock_Lock(&gLock);
+    bool r = gWeekly.ready;
+    if (r) { gWeekly.ready = false; snprintf(label, 16, "%s", gWeekly.label); *seed = gWeekly.seed; *days = gWeekly.days; }
+    LightLock_Unlock(&gLock);
+    return r;
+}
+
+// ---- finishes
+
+static void flushFinishes()
+{
+    static char body[16384], reply[1024];
+    for (int slot = 0; slot < 32; slot++) {
+        size_t n;
+        char *ft = readText(pathOf(ONLINE_DIR "/slot%d.finish", slot), &n);
+        char *tk = readText(pathOf(ONLINE_DIR "/slot%d.token", slot), &n);
+        if (ft && tk) {
+            tk[strcspn(tk, "\r\n ")] = 0;
+            long long ms = 0;
+            int seed = 0;
+            sscanf(ft, "%lld %d", &ms, &seed);
+            char name[32], country[4];
+            playerOf(name, country);
+            for (char *c = name; *c; c++) if (*c == '"' || *c == '\\' || (unsigned char)*c < 32) *c = ' ';
+            int len = snprintf(body, sizeof body, "{\"token\":\"%s\",\"timeMs\":%lld,\"player\":\"%s\"", tk, ms, name);
+            if (country[0]) len += snprintf(body + len, sizeof body - len, ",\"country\":\"%s\"", country);
+            if (seed > 0) len += snprintf(body + len, sizeof body - len, ",\"seed\":\"%d\"", seed);
+            len += snprintf(body + len, sizeof body - len, ",\"proof\":\"");
+            char *pf = readText(pathOf(ONLINE_DIR "/slot%d.proof", slot), NULL);
+            for (const char *c = pf ? pf : ""; *c && len < (int)sizeof body - 8; c++) {
+                if (*c == '\n') { body[len++] = '\\'; body[len++] = 'n'; }
+                else if ((*c >= '0' && *c <= '9') || *c == ' ') body[len++] = *c;
+            }
+            free(pf);
+            snprintf(body + len, sizeof body - len, "\"}");
+            int code = httpRequest("POST", "/api/finish", body, reply, sizeof reply);
+            if (code == 400) writeText(ONLINE_DIR "/last_error.txt", reply, strlen(reply));
+            if (code == 200 || code == 400) {
+                remove(pathOf(ONLINE_DIR "/slot%d.finish", slot));
+                remove(pathOf(ONLINE_DIR "/slot%d.token", slot));
+                remove(pathOf(ONLINE_DIR "/slot%d.proof", slot));
+            }
+        }
+        free(ft); free(tk);
+    }
+}
+
+// ---- tables
+
+static char gLadder[3][16384];
+static int gLadderState[3];   // 0 idle, 1 fetching, 2 ready, 3 failed
+
+static void laddersThread(void *)
+{
+    static const char *const PATH[3] = {"/api/ladder?kind=original", "/api/ladder?kind=monthly", "/api/ladder?kind=weekly"};
+    static char buf[16384];
+    for (int t = 0; t < 3; t++) {
+        int ok = httpRequest("GET", PATH[t], NULL, buf, sizeof buf) == 200;
+        LightLock_Lock(&gLock);
+        if (ok) memcpy(gLadder[t], buf, sizeof buf);
+        gLadderState[t] = ok ? 2 : 3;
+        LightLock_Unlock(&gLock);
+    }
+}
+
+int smzOnlineTakeLadder(int tab, char *out, size_t cap)
+{
+    lockInit();
+    LightLock_Lock(&gLock);
+    int st = gLadderState[tab];
+    int r = 0;
+    if (st == 2) { snprintf(out, cap, "%s", gLadder[tab]); r = 1; gLadderState[tab] = 0; }
+    else if (st == 3) { r = 2; gLadderState[tab] = 0; }
+    LightLock_Unlock(&gLock);
+    return r;
+}
+
+// ---- world goals
+
+static char gGoals[8192];
+static int gGoalsState;   // 0 idle, 1 fetching, 2 ready, 3 failed
+
+static void goalsThread(void *)
+{
+    static char buf[8192];
+    char id[40], path[96];
+    installId(id);
+    snprintf(path, sizeof path, "/api/goals?install=%s", id);
+    int ok = httpRequest("GET", path, NULL, buf, sizeof buf) == 200;
+    LightLock_Lock(&gLock);
+    if (ok) memcpy(gGoals, buf, sizeof buf);
+    gGoalsState = ok ? 2 : 3;
+    LightLock_Unlock(&gLock);
+}
+
+int smzOnlineTakeGoals(char *out, size_t cap)
+{
+    lockInit();
+    LightLock_Lock(&gLock);
+    int r = 0;
+    if (gGoalsState == 2) { snprintf(out, cap, "%s", gGoals); r = 1; gGoalsState = 0; }
+    else if (gGoalsState == 3) { r = 2; gGoalsState = 0; }
+    LightLock_Unlock(&gLock);
+    return r;
+}
+
+struct GoalReport { int slot; bool online; int64_t created; char text[640]; };
+
+static void goalsReportThread(void *arg)
+{
+    GoalReport *g = (GoalReport *)arg;
+    char id[40], run[64], reply[256], body[2048], name[32], country[4];
+    installId(id);
+    playerOf(name, country);
+    snprintf(run, sizeof run, "s%d-%lld", g->slot, (long long)g->created);
+    int n = snprintf(body, sizeof body, "{\"install\":\"%s\",\"run\":\"%s\",\"online\":%s,\"player\":\"%s\",", id, run, g->online ? "true" : "false", name);
+    if (country[0]) n += snprintf(body + n, sizeof body - (size_t)n, "\"country\":\"%s\",", country);
+    n += snprintf(body + n, sizeof body - (size_t)n, "\"counts\":{");
+    for (const char *p = g->text; *p && n < (int)sizeof body - 64;) {   // "key=n,..." without the "_" keys
+        const char *eq = strchr(p, '='), *end = strchr(p, ',');
+        if (!end) end = p + strlen(p);
+        if (eq && eq < end && *p != '_') n += snprintf(body + n, sizeof body - (size_t)n, "%s\"%.*s\":%.*s", body[n - 1] == '{' ? "" : ",", (int)(eq - p), p, (int)(end - eq - 1), eq + 1);
+        p = *end ? end + 1 : end;
+    }
+    snprintf(body + n, sizeof body - (size_t)n, "}}");
+    httpRequest("POST", "/api/goals/report", body, reply, sizeof reply);
+    free(g);
+}
+
+// ---- threads
+
+static void spawn(ThreadFunc fn, void *arg)
+{
+    Thread t = threadCreate(fn, arg, 64 * 1024, 0x30, -2, true);   // detached
+    (void)t;
+}
+
+static bool gHttpReady;
+static void netUp() { if (!gHttpReady) gHttpReady = R_SUCCEEDED(httpcInit(0x4000)); }
+
+// ---- the daily challenge
+
+#define DAILY_TXT ONLINE_DIR "/daily.txt"
+#define DAILY_FINISH ONLINE_DIR "/daily.finish"
+#define DAILY_RESULT ONLINE_DIR "/daily.result"
+
+int64_t smzDailyNowMs(void) { return (int64_t)osGetTime() - 2208988800000LL; }   // osGetTime counts from 1900
+
+bool smzDailyLoad(SmzDailyRun *r)
+{
+    char *t = readText(DAILY_TXT, NULL);
+    bool ok = t && smz_daily_run_load(t, r) == 0;
+    free(t);
+    return ok;
+}
+
+void smzDailySave(const SmzDailyRun *r)
+{
+    static char text[8192];
+    int n = smz_daily_run_text(r, text, sizeof text);
+    if (n > 0) writeText(DAILY_TXT, text, (size_t)n);
+}
+
+void smzDailyForget(void)
+{
+    remove(DAILY_FINISH);
+    remove(DAILY_RESULT);
+    remove(smzOnlineProofPath(SMZ_DAILY_SLOT));
+}
+
+bool smzDailyResult(char *out, size_t cap)
+{
+    char *t = readText(DAILY_RESULT, NULL);
+    if (!t) return false;
+    snprintf(out, cap, "%s", t);
+    free(t);
+    return true;
+}
+
+static void flushDaily()
+{
+    char *ft = readText(DAILY_FINISH, NULL);
+    static SmzDailyRun r;
+    if (!ft || !smzDailyLoad(&r)) { free(ft); return; }
+    static char body[16384];
+    char reply[1024], line[160], name[32], country[4];
+    long long ms = atoll(ft);
+    free(ft);
+    playerOf(name, country);
+    for (char *c = name; *c; c++) if (*c == '"' || *c == '\\' || (unsigned char)*c < 32) *c = ' ';
+    int len = snprintf(body, sizeof body, "{\"token\":\"%s\",\"timeMs\":%lld,\"player\":\"%s\"", r.token, ms, name);
+    if (country[0]) len += snprintf(body + len, sizeof body - len, ",\"country\":\"%s\"", country);
+    len += snprintf(body + len, sizeof body - len, ",\"proof\":\"");
+    char *pf = readText(smzOnlineProofPath(SMZ_DAILY_SLOT), NULL);
+    for (const char *c = pf ? pf : ""; *c && len < (int)sizeof body - 8; c++) {
+        if (*c == '\n') { body[len++] = '\\'; body[len++] = 'n'; }
+        else if ((*c >= '0' && *c <= '9') || *c == ' ') body[len++] = *c;
+    }
+    free(pf);
+    snprintf(body + len, sizeof body - len, "\"}");
+    int code = httpRequest("POST", "/api/daily/finish", body, reply, sizeof reply);
+    if (code != 200 && code != 400) return;   // no answer: sent again at the next start
+    char why[64] = "";
+    long long rank = 0, tokens = 0, balance = 0;
+    if (code == 400) { jsonStr(reply, "error", why, sizeof why); snprintf(line, sizeof line, "Not counted: %s", why[0] ? why : "refused"); }
+    else if (strstr(reply, "\"held\":true")) snprintf(line, sizeof line, "Held for a check before it counts");
+    else if (strstr(reply, "\"late\":true")) snprintf(line, sizeof line, "After the window closed: late list, no prize");
+    else {
+        bool ranked = jsonNum(reply, "rank", &rank) && rank > 0;
+        jsonNum(reply, "tokens", &tokens);
+        jsonNum(reply, "balance", &balance);
+        if (ranked) snprintf(line, sizeof line, "Rank %lld for now  -  +%lld rupeergies (%lld)", rank, tokens, balance);
+        else snprintf(line, sizeof line, "Rank ? for now  -  +%lld rupeergies (%lld)", tokens, balance);
+    }
+    writeText(DAILY_RESULT, line, strlen(line));
+    remove(DAILY_FINISH);
+}
+
+static SmzDailyInfo gDaily;
+static int gDailyState;   // 0 idle, 1 fetching, 2 ready, 3 failed
+static SmzDailyRun gHintRun;
+static int gHintState;    // 0 idle, 1 fetching, 2 ready
+
+static void dailyInfoThread(void *)
+{
+    static char reply[4096];
+    char id[40], path[96];
+    installId(id);
+    snprintf(path, sizeof path, "/api/daily?install=%s", id);
+    static SmzDailyInfo d;
+    bool ok = httpRequest("GET", path, NULL, reply, sizeof reply) == 200 && smz_daily_parse_info(reply, smzDailyNowMs(), &d) == 0;
+    LightLock_Lock(&gLock);
+    if (ok) gDaily = d;
+    gDailyState = ok ? 2 : 3;
+    LightLock_Unlock(&gLock);
+}
+
+static void dailyHintsThread(void *)
+{
+    static char reply[8192], path[400];
+    static SmzDailyRun r;
+    LightLock_Lock(&gLock);
+    r = gHintRun;
+    LightLock_Unlock(&gLock);
+    snprintf(path, sizeof path, "/api/daily/hints?token=%s", r.token);
+    bool ok = httpRequest("GET", path, NULL, reply, sizeof reply) == 200 && smz_daily_parse_hints(reply, smzDailyNowMs(), &r) == 0;
+    LightLock_Lock(&gLock);
+    if (ok) gHintRun = r;
+    gHintState = ok ? 2 : 0;
+    LightLock_Unlock(&gLock);
+}
+
+int smzDailyStart(const char *window, SmzDailyRun *r, char *settings, size_t cap, char *err, size_t errcap)
+{
+    netUp();
+    if (!gHttpReady) { snprintf(err, errcap, "No network"); return -1; }
+    static char reply[32768];
+    char id[40], req[160];
+    installId(id);
+    snprintf(req, sizeof req, "{\"install\":\"%s\",\"window\":\"%s\"}", id, window);
+    int code = httpRequest("POST", "/api/daily/start", req, reply, sizeof reply);
+    if (code == 200 && smz_daily_parse_start(reply, smzDailyNowMs(), r, settings, cap) == 0) return 0;
+    char why[64] = "";
+    jsonStr(reply, "error", why, sizeof why);
+    if (code < 0) snprintf(err, errcap, "No connection to the challenge server");
+    else if (why[0]) snprintf(err, errcap, "Cannot start: %.48s", why);
+    else snprintf(err, errcap, "Cannot start the challenge (%d)", code);
+    return -1;
+}
+
+static void startupThread(void *) { fetchSeeds(); flushFinishes(); flushDaily(); }
+static void flushThread(void *) { flushFinishes(); flushDaily(); }
+static void tokenThread(void *arg)
+{
+    int slot = (int)(intptr_t)arg;
+    if (exists(pathOf(ONLINE_DIR "/slot%d.token", slot))) return;
+    int kind = smzOnlineSlotKind(slot);
+    if (!kind) return;
+    char id[40], req[160], reply[512], token[400];
+    installId(id);
+    snprintf(req, sizeof req, "{\"install\":\"%s\",\"kind\":\"%s\"}", id, kind == 3 ? "weekly" : kind == 2 ? "monthly" : "original");
+    if (httpRequest("POST", "/api/start", req, reply, sizeof reply) == 200 && jsonStr(reply, "token", token, sizeof token))
+        writeText(pathOf(ONLINE_DIR "/slot%d.token", slot), token, strlen(token));
+}
+
+
+void smzOnlineStartup(void)
+{
+    lockInit();
+    netUp();
+    if (!gHttpReady || gStarted) return;
+    gStarted = true;
+    spawn(startupThread, NULL);
+}
+
+void smzOnlineRequestLadders(void)
+{
+    lockInit();
+    netUp();
+    if (!gHttpReady) return;
+    LightLock_Lock(&gLock);
+    bool busy = gLadderState[0] == 1 || gLadderState[1] == 1 || gLadderState[2] == 1;
+    for (int t = 0; t < 3 && !busy; t++) gLadderState[t] = 1;
+    LightLock_Unlock(&gLock);
+    if (!busy) spawn(laddersThread, NULL);
+}
+
+void smzOnlineRequestGoals(void)
+{
+    lockInit();
+    netUp();
+    if (!gHttpReady) return;
+    LightLock_Lock(&gLock);
+    bool busy = gGoalsState == 1;
+    if (!busy) gGoalsState = 1;
+    LightLock_Unlock(&gLock);
+    if (!busy) spawn(goalsThread, NULL);
+}
+
+void smzOnlineGoalsReport(int slot, int64_t created, bool online, const char *counters)
+{
+    if (!counters || !*counters) return;
+    netUp();
+    if (!gHttpReady) return;
+    GoalReport *g = (GoalReport *)calloc(1, sizeof *g);
+    if (!g) return;
+    g->slot = slot; g->online = online; g->created = created;
+    snprintf(g->text, sizeof g->text, "%s", counters);
+    spawn(goalsReportThread, g);
+}
+
+void smzOnlineEnsureToken(int slot)
+{
+    netUp();
+    if (gHttpReady) spawn(tokenThread, (void *)(intptr_t)slot);
+}
+
+void smzOnlineQueueFinish(int slot, int64_t timeMs, int seed)
+{
+    if (!exists(pathOf(ONLINE_DIR "/slot%d.token", slot))) return;
+    char t[48];
+    int n = snprintf(t, sizeof t, "%lld %d", (long long)timeMs, seed);
+    writeText(pathOf(ONLINE_DIR "/slot%d.finish", slot), t, (size_t)n);
+    netUp();
+    if (gHttpReady) spawn(flushThread, NULL);
+}
+
+void smzDailyRequestInfo(void)
+{
+    lockInit();
+    netUp();
+    if (!gHttpReady) return;
+    LightLock_Lock(&gLock);
+    bool busy = gDailyState == 1;
+    if (!busy) gDailyState = 1;
+    LightLock_Unlock(&gLock);
+    if (!busy) spawn(dailyInfoThread, NULL);
+}
+
+int smzDailyTakeInfo(SmzDailyInfo *d)
+{
+    lockInit();
+    LightLock_Lock(&gLock);
+    int r = gDailyState == 2 ? 1 : gDailyState == 3 ? 2 : 0;
+    if (r == 1) *d = gDaily;
+    if (r) gDailyState = 0;
+    LightLock_Unlock(&gLock);
+    return r;
+}
+
+void smzDailyRequestHints(const SmzDailyRun *r)
+{
+    lockInit();
+    netUp();
+    if (!gHttpReady) return;
+    LightLock_Lock(&gLock);
+    bool busy = gHintState == 1;
+    if (!busy) { gHintState = 1; gHintRun = *r; }
+    LightLock_Unlock(&gLock);
+    if (!busy) spawn(dailyHintsThread, NULL);
+}
+
+bool smzDailyTakeHints(SmzDailyRun *r)
+{
+    lockInit();
+    LightLock_Lock(&gLock);
+    bool ok = gHintState == 2;
+    if (ok) { *r = gHintRun; gHintState = 0; }
+    LightLock_Unlock(&gLock);
+    if (ok) smzDailySave(r);
+    return ok;
+}
+
+void smzDailyQueueFinish(int64_t timeMs)
+{
+    char t[32];
+    int n = snprintf(t, sizeof t, "%lld", (long long)timeMs);
+    remove(DAILY_RESULT);
+    writeText(DAILY_FINISH, t, (size_t)n);
+    netUp();
+    if (gHttpReady) spawn(flushThread, NULL);
+}
diff --git a/source/smz3online.h b/source/smz3online.h
new file mode 100644
index 0000000..6e5685a
--- /dev/null
+++ b/source/smz3online.h
@@ -0,0 +1,66 @@
+#ifndef SMZ3ONLINE_H
+#define SMZ3ONLINE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+extern "C" {
+#include "smz3_daily.h"
+}
+
+// Online ladders (original, monthly, weekly) for the SMZ3 runs: the same protocol as the other frontends, over the 3DS httpc service.
+// Everything blocking runs on its own thread; the menu polls for what arrived.
+
+// Kind of a run: 0 offline, 1 original rules on the ladder, 2 monthly seed, 3 weekly.
+int smzOnlineSlotKind(int slot);
+// The run's own kind (1 original, 2 monthly, 3 weekly), also when it was made offline; 0 for an unknown older run.
+int smzOnlineRunMode(int slot);
+void smzOnlineMarkRun(int slot, int online, int kind);
+
+// Starts the seeds fetch and sends the finished runs that are waiting. Safe to call again.
+void smzOnlineStartup(void);
+// Takes a fetched seed once: returns true and fills the label, seed and days left.
+bool smzOnlineTakeMonthly(char label[16], int *seed, int *days);
+bool smzOnlineTakeWeekly(char label[16], int *seed, int *days);
+// The online tables (0 original, 1 monthly, 2 weekly): Request starts the fetch, Take returns each answer once it is there (state 1 ready,
+// 2 failed; the JSON is the server's /api/ladder answer).
+void smzOnlineRequestLadders(void);
+int smzOnlineTakeLadder(int tab, char *out, size_t cap);
+// The world goals of the month (/api/goals): Request starts the fetch, Take returns 1 with the JSON once, 2 when it failed, 0 meanwhile.
+void smzOnlineRequestGoals(void);
+int smzOnlineTakeGoals(char *out, size_t cap);
+// Sends a run's goal counters (smz_counters_text) on a thread; slot as in the run id "s<slot>-<created>".
+void smzOnlineGoalsReport(int slot, int64_t created, bool online, const char *counters);
+// The player's profile file text ("name\tCC\tmode"), and saving it back.
+bool smzOnlineProfileLoad(char *out, size_t cap);
+void smzOnlineProfileSave(const char *text);
+
+// While a run is played: asks the server for the run's token (retries are the caller's job) on a thread.
+void smzOnlineEnsureToken(int slot);
+// Records a finished run's time and seed (original ladder) and sends it on a thread.
+void smzOnlineQueueFinish(int slot, int64_t timeMs, int seed);
+// The proof of run file of a slot (loaded and saved as text, see smz3_proof.h).
+const char *smzOnlineProofPath(int slot);
+
+// The daily challenge (docs/DAILY.md). Its attempt's run lives in slot SMZ_DAILY_SLOT, never listed with the others; the attempt
+// itself in online/daily.txt. Times are ms since 1970 on the console clock; the server's "now" corrects a wrong clock.
+#define SMZ_DAILY_SLOT 32
+#define SMZ_DAILY_MIN_MS (3 * 60 * 1000)   // the shortest daily time the server takes (server/ladder/daily.js MIN_MS)
+int64_t smzDailyNowMs(void);
+// /api/daily on a thread; Take returns 1 with a new answer in d, 2 when the request failed, 0 while nothing came.
+void smzDailyRequestInfo(void);
+int smzDailyTakeInfo(SmzDailyInfo *d);
+// POST /api/daily/start, blocking: 0 with the attempt and the run settings, else -1 and the reason in err.
+int smzDailyStart(const char *window, SmzDailyRun *r, char *settings, size_t cap, char *err, size_t errcap);
+bool smzDailyLoad(SmzDailyRun *r);
+void smzDailySave(const SmzDailyRun *r);
+// Forgets the finish, result and proof of the attempt before (a new attempt starts).
+void smzDailyForget(void);
+// The hints released by now, on a thread; Take copies them into r (and saves it) once they came.
+void smzDailyRequestHints(const SmzDailyRun *r);
+bool smzDailyTakeHints(SmzDailyRun *r);
+// Records the attempt's real time at the goal and sends it on a thread; Result is the line for the player once the server answered.
+void smzDailyQueueFinish(int64_t timeMs);
+bool smzDailyResult(char *out, size_t cap);
+
+#endif
diff --git a/source/smz3run.cpp b/source/smz3run.cpp
new file mode 100644
index 0000000..b158b0b
--- /dev/null
+++ b/source/smz3run.cpp
@@ -0,0 +1,4337 @@
+// SMZ3 runs: the shared C menu (core/ui) drawn on the second screen, and offline generation (core/gen).
+#include <3ds.h>
+#include <dirent.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <math.h>
+#include <stdarg.h>
+#include <time.h>
+#include <malloc.h>
+
+extern "C" {
+#include "smz3_host.h"
+#include "smz3_md5.h"
+#include "smz3_romsetup.h"
+#include "smz3_tracker.h"
+#include "smz3_proof.h"
+#include "smz3_run.h"
+#include "smz3_ui.h"
+#include "smz3_preview.h"
+#include "smz3_counters.h"
+#include "smz3_goalicons.h"
+#include "smz3_romderived.h"
+// from smz3_rom.h, whose generator headers stay out of C++
+int smz_rom_shortcut_hooks(uint8_t *rom);
+void smz_rom_checksum(uint8_t *rom);
+}
+
+extern "C" {
+#include "smz3_state.h"
+}
+#include "snes9x.h"
+#include "memmap.h"
+#include "3dsgpu.h"
+#include "3dsimpl.h"
+#include "3dsimpl_gpu.h"
+#include "3dssound.h"
+#include "3dssettings.h"
+#include "3dsui.h"
+#include "3dsmenu.h"
+#include "3dsfiles.h"
+#include "3dsinput.h"
+#include "smz3run.h"
+#include "smz3online.h"
+
+#define OLD_DIR "sdmc:/SMZ3"   // the data folder of older builds
+#define RUN_DIR SMZ_DIR "/runs"
+#define SPRITE_DIR SMZ_DIR "/sprites"
+#define GOALS_DIR SMZ_DIR "/goals"   // the world goal icons cut from the base ROMs
+
+static bool gChallenge = false;   // the run being played is a daily challenge: no fast forward
+static int gPlaySlot = -1;   // slot of the run being played
+static bool gRunStates, gNextStates, gNextLoadState;   // the run being played (the next one) keeps an auto state; the next one starts from it
+
+static const int PALETTE[UI_COLORS] = {0x10141C, 0x1D2430, 0x2E4A6B, 0xE8ECF2, 0x8793A6, 0xE9A23B, 0xE05A4F, 0x4CC38A, 0x4FC3F7, 0x14504A, 0x1B2F6B, 0x4B2A7A, 0x8A6414,
+                                      0xFFF1F8, 0xFF9AD0, 0xE0559B, 0x8E2E68, 0x5A2A86, 0xFFC2E4, 0xF07AB6, 0xA8407E, 0x7A3AAE};   // the rupeergy's colours
+
+static bool readFileNoMemory;   // the last readFile failed for want of memory, not of the file
+
+static unsigned char *readFile(const char *path, size_t *len)
+{
+    readFileNoMemory = false;
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    unsigned char *b = (unsigned char *)malloc(n > 0 ? n : 1);
+    if (!b) readFileNoMemory = true;
+    if (b && fread(b, 1, n, f) != (size_t)n) { free(b); b = NULL; }
+    fclose(f);
+    if (b) *len = (size_t)n;
+    return b;
+}
+
+static char ipsFailed[40];   // the patch the generator could not get, "" when every one loaded
+static bool ipsNoMemory;
+
+static const uint8_t *loadIps(void *user, const char *name, size_t *len)
+{
+    static unsigned char *buf = NULL;
+    free(buf);
+    buf = NULL;
+    // zsm.ips is the first patch, asked for right after the two base ROMs were combined into the output (build_rom in
+    // core/gen/smz3_generate.c): the Super Metroid image is no longer needed, and its 3 MB make room for this 1.4 MB patch
+    if (user && !strcmp(name, "zsm.ips")) { unsigned char **sm = (unsigned char **)user; free(*sm); *sm = NULL; }
+    char path[128];
+    snprintf(path, sizeof path, "romfs:/smz3/ips/%s", name);
+    buf = readFile(path, len);
+    if (!buf && !ipsFailed[0]) { snprintf(ipsFailed, sizeof ipsFailed, "%s", name); ipsNoMemory = readFileNoMemory; }
+    return buf;
+}
+
+static bool isBase(const unsigned char *rom, size_t len, bool *isSm)
+{
+    if (len == 0x300200 || len == 0x100200) { rom += 0x200; len -= 0x200; }
+    if (len != 0x300000 && len != 0x100000) return false;
+    char title[22];
+    memcpy(title, rom + 0x7FC0, 21);
+    title[21] = 0;
+    for (char *p = title; *p; p++) if (*p >= 'a' && *p <= 'z') *p -= 32;
+    *isSm = strstr(title, "METROID") != NULL;
+    return *isSm ? len == 0x300000 : (strstr(title, "ZELDA") != NULL && len == 0x100000);
+}
+
+static char wrongRom[48];   // set when a base ROM was found but it is not the revision the patches need
+
+// While the run menu is up, the emulator's ROM buffer (8 MB) holds nothing it still needs: the run left was saved when the
+// menu opened, and the next one is loaded from its file. The menu's big jobs borrow it instead of the heap, which an Old 3DS
+// launched as an applet has little of. After that the emulator counts as having no game, so nothing saves or resumes the
+// overwritten one.
+#define ROM_SCRATCH_SIZE ((size_t)CMemory::MAX_ROM_SIZE + 0x200)
+static_assert(SMZ_HOST_ROM_SIZE + 0x100000 <= ROM_SCRATCH_SIZE, "the generated ROM and the ALttP image share the ROM buffer");
+static unsigned char *romScratch()
+{
+    snd3dsDrainMixing();
+    settings3DS.isRomLoaded = false;
+    Memory.ROMCRC32 = 0;
+    return Memory.ROM;
+}
+
+// Finds the user's own Super Metroid and ALttP ROMs in the usual folders: Super Metroid comes back headerless in a malloc'd
+// buffer (the file's own, no second copy), ALttP is copied into z3Out (1 MB). Only the exact revisions the patches were
+// written for are taken: with another A Link to the Past revision the patched Zelda code is misaligned and the game crashes
+// when Samus enters a portal.
+// smz_run_load, with the ROM path of a run made before the data folder moved pointed at SMZ_DIR.
+static int runLoad(const char *path, SmzRun *r)
+{
+    int e = smz_run_load(path, r);
+    size_t old = sizeof OLD_DIR - 1;
+    if (!e && !strncmp(r->rom_path, OLD_DIR "/", old + 1)) {
+        char moved[sizeof r->rom_path];
+        snprintf(moved, sizeof moved, SMZ_DIR "%s", r->rom_path + old);
+        snprintf(r->rom_path, sizeof r->rom_path, "%s", moved);
+    }
+    return e;
+}
+
+void smz3MoveDataDir(void)
+{
+    struct stat st;
+    if (stat(SMZ_DIR, &st) == 0 || stat(OLD_DIR, &st) != 0) return;
+    mkdir("sdmc:/3ds", 0777);
+    rename(OLD_DIR, SMZ_DIR);
+}
+
+static bool findBaseRoms(unsigned char **sm, unsigned char *z3Out)
+{
+    wrongRom[0] = 0;
+    static const char *dirs[] = {SMZ_DIR, SMZ_DIR "/base", "sdmc:/roms/snes", "sdmc:/roms", "sdmc:/ROMs", "sdmc:/", OLD_DIR "/base"};
+    *sm = NULL;
+    bool z3 = false;
+    // keeps the image when it is one of the two exact revisions the patches were written for; takes b over for Super Metroid
+    auto offer = [&](unsigned char *&b, size_t len) {
+        bool sm_ = false;
+        if (!isBase(b, len, &sm_)) return;
+        size_t off = (len & 0x1FF) ? 0x200 : 0;
+        char md5[33];
+        smz_md5_hex(b + off, len - off, md5);
+        if (strcmp(md5, sm_ ? SMZ_MD5_SM : SMZ_MD5_Z3)) {
+            if (!wrongRom[0]) snprintf(wrongRom, sizeof wrongRom, sm_ ? "Super Metroid ROM must be (JU), md5 21f3e98d" : "ALttP ROM must be Japanese v1.0 (03a63945)");
+        } else if (sm_ && !*sm) { memmove(b, b + off, len - off); *sm = b; b = NULL; }
+        else if (!sm_ && !z3) { memcpy(z3Out, b + off, len - off); z3 = true; }
+    };
+    for (const char *d : dirs) {
+        DIR *dir = opendir(d);
+        if (!dir) continue;
+        while (struct dirent *e = readdir(dir)) {
+            if (e->d_type == DT_DIR) continue;
+            char path[PATH_MAX];
+            snprintf(path, sizeof path, "%s/%s", d, e->d_name);
+            struct stat st;
+            if (stat(path, &st)) continue;
+            bool rom = st.st_size == 0x300000 || st.st_size == 0x300200 || st.st_size == 0x100000 || st.st_size == 0x100200;
+            bool zip = st.st_size > 1000 && st.st_size < 0x500000 && strlen(e->d_name) > 4 && !strcasecmp(e->d_name + strlen(e->d_name) - 4, ".zip");
+            if (!rom && !zip) continue;
+            if (rom && (st.st_size >= 0x300000 ? *sm != NULL : z3)) continue;   // that one is found already
+            size_t len;
+            unsigned char *b = readFile(path, &len);
+            if (b && rom) offer(b, len);
+            else if (b && smz_is_zip(b, len)) {
+                for (int i = 0;; i++) {
+                    size_t k;
+                    unsigned char *img = smz_zip_entry(b, len, i, &k);
+                    if (!img) break;
+                    offer(img, k);
+                    free(img);
+                }
+            }
+            free(b);
+        }
+        closedir(dir);
+        if (*sm && z3) return true;
+    }
+    if (*sm && !z3) { free(*sm); *sm = NULL; }
+    return false;
+}
+
+static int listSprites(const char *dir, char names[][32], int max)
+{
+    int n = 0;
+    DIR *d = opendir(dir);
+    if (!d) return 0;
+    while (struct dirent *e = readdir(d)) {
+        size_t l = strlen(e->d_name);
+        if (l > 4 && l < 36 && !strcasecmp(e->d_name + l - 4, ".rdc") && n < max) { memcpy(names[n], e->d_name, l - 4); names[n][l - 4] = 0; n++; }
+    }
+    closedir(d);
+    return n;
+}
+
+static int listPlandos(const char *dir, char names[][32], int max)
+{
+    int n = 0;
+    DIR *d = opendir(dir);
+    if (!d) return 0;
+    while (struct dirent *e = readdir(d)) {
+        size_t l = strlen(e->d_name);
+        bool yml = l > 4 && !strcasecmp(e->d_name + l - 4, ".yml"), yaml = l > 5 && !strcasecmp(e->d_name + l - 5, ".yaml");
+        if ((yml || yaml) && l < 32 && n < max) { memcpy(names[n], e->d_name, l + 1); n++; }
+    }
+    closedir(d);
+    return n;
+}
+
+struct Preview { char key[48]; int w, h; unsigned char *rgba; };
+static Preview previews[40];
+static int previewNext;
+
+// Lets go of every cached picture: before a generation, which needs the heap, and when the menu hands over to the game.
+static void freePreviews()
+{
+    for (auto &p : previews) { free(p.rgba); p.rgba = NULL; p.w = p.h = 0; p.key[0] = 0; }
+    previewNext = 0;
+}
+
+// The heap's state for SMZ_DIR/gen.log: in use, free inside it, and the largest block one malloc can still get.
+static void heapNote(char *out, size_t cap)
+{
+    struct mallinfo mi = mallinfo();
+    size_t lo = 0, hi = 64u << 20;
+    while (hi - lo > 64 * 1024) {
+        size_t mid = lo + (hi - lo) / 2;
+        void *b = malloc(mid);
+        if (b) { free(b); lo = mid; } else hi = mid;
+    }
+    snprintf(out, cap, "used %u KB, free in heap %u KB, largest block %u KB", (unsigned)mi.uordblks / 1024, (unsigned)mi.fordblks / 1024, (unsigned)(lo / 1024));
+}
+
+/* the .pv picture of a sprite ("link/<name>"), loaded once and kept; w == 0 when there is none */
+static const Preview *getPreview(const char *key)
+{
+    for (auto &p : previews) if (p.key[0] && !strcmp(p.key, key)) return p.w ? &p : NULL;
+    Preview &p = previews[previewNext];
+    previewNext = (previewNext + 1) % (int)(sizeof previews / sizeof previews[0]);
+    free(p.rgba);
+    p.rgba = NULL; p.w = p.h = 0;
+    snprintf(p.key, sizeof p.key, "%s", key);
+    char path[160];
+    if (!strcmp(key, "logo")) snprintf(path, sizeof path, "romfs:/smz3/logo.pv");   // the app logo beside the menu titles
+    else if (!strncmp(key, "reward/", 7)) snprintf(path, sizeof path, "romfs:/smz3/icons/%.24s_boss_token.pv", key + 7);   // a boss token
+    else if (!strncmp(key, "flag/", 5)) snprintf(path, sizeof path, "romfs:/smz3/flags/%.2s.pv", key + 5);   // a country flag
+    else if (!strncmp(key, "goal/", 5)) {   // "goal/boss/kraid": the app's goals/boss_kraid, or the sprite cut from the ROM
+        char k[40];
+        snprintf(k, sizeof k, "%s", key + 5);
+        for (char *c = k; *c; c++) if (*c == '/') *c = '_';
+        snprintf(path, sizeof path, "romfs:/smz3/goals/%s.pv", k);
+        if (access(path, F_OK) != 0) snprintf(path, sizeof path, GOALS_DIR "/%s.pv", k);
+    }
+    else snprintf(path, sizeof path, SPRITE_DIR "/%s.pv", key);
+    size_t len = 0;
+    unsigned char *d = readFile(path, &len);
+    int w, h;
+    const unsigned char *px;
+    if (d && smz_preview_parse(d, len, &w, &h, &px)) {   // a missing, empty or truncated file leaves the cell blank
+        p.rgba = (unsigned char *)malloc((size_t)w * h * 4);
+        if (p.rgba) { memcpy(p.rgba, px, (size_t)w * h * 4); p.w = w; p.h = h; }
+    }
+    free(d);
+    return p.w ? &p : NULL;
+}
+
+static void drawPreview(const UiCmd *c)
+{
+    const Preview *p = getPreview(c->text);
+    if (!p) return;
+    int dw = p->w, dh = p->h;
+    if (dw > c->w || dh > c->h) {   /* shrink to fit, keeping the aspect */
+        if (dw * c->h > dh * c->w) { dh = dh * c->w / dw; dw = c->w; } else { dw = dw * c->h / dh; dh = c->h; }
+        if (dw < 1) dw = 1;
+        if (dh < 1) dh = 1;
+    }
+    int ox = c->x + (c->w - dw) / 2, oy = c->y + (c->h - dh) / 2;
+    for (int y = 0; y < dh; y++) {
+        const unsigned char *row = p->rgba + (size_t)(y * p->h / dh) * p->w * 4;
+        int x = 0;
+        while (x < dw) {   /* horizontal runs of one colour become one rectangle */
+            const unsigned char *px = row + (size_t)(x * p->w / dw) * 4;
+            int x2 = x + 1;
+            while (x2 < dw && !memcmp(row + (size_t)(x2 * p->w / dw) * 4, px, 4)) x2++;
+            if (px[3] >= 128) ui3dsDrawRect(ox + x, oy + y, ox + x2, oy + y + 1, (px[0] << 16) | (px[1] << 8) | px[2], c->color == C_DIM ? 0.25f : 1.0f);   // dim: still missing
+            x = x2;
+        }
+    }
+}
+
+static inline u16 blend565(u16 back, u16 fore, int a)   // a: 0..256
+{
+    int rb = (back & 0xF81F) + ((((fore & 0xF81F) - (back & 0xF81F)) * (a >> 3)) >> 5);
+    int g = (back & 0x07E0) + ((((fore & 0x07E0) - (back & 0x07E0)) * (a >> 3)) >> 5);
+    return (u16)((rb & 0xF81F) | (g & 0x07E0));
+}
+
+static int mixC(int a, int b, float t)
+{
+    if (t < 0) t = 0;
+    if (t > 1) t = 1;
+    int r = (int)(((a >> 16) & 255) * (1 - t) + ((b >> 16) & 255) * t), g = (int)(((a >> 8) & 255) * (1 - t) + ((b >> 8) & 255) * t), bl = (int)((a & 255) * (1 - t) + (b & 255) * t);
+    return (r << 16) | (g << 8) | bl;
+}
+
+static void drawChamfer(int x, int y, int w, int h, int cut, int color)
+{
+    for (int i = 0; i < cut; i++) {
+        int in = cut - i;
+        ui3dsDrawRect(x + in, y + i, x + w - in, y + i + 1, color);
+        ui3dsDrawRect(x + in, y + h - 1 - i, x + w - in, y + h - i, color);
+    }
+    ui3dsDrawRect(x, y + cut, x + w, y + h - cut, color);
+}
+
+/* The menu's wallpaper, also what covers a screen change: dark, with spores rising like in Brinstar (NativeMenuScreen.kt).
+ * Only from left[row] rightwards on each 2-pixel row when left is given. */
+static void fillDisc(float cx, float cy, float r, int color, float alpha = 1.0f);
+
+static void drawBackdrop(const int *left = NULL)
+{
+    struct Spore { float x, y, speed, size, sway; int color; };
+    static Spore spores[42];
+    static bool made;
+    if (!made) {
+        unsigned seed = 11;
+        auto rnd = [&seed]() { seed = seed * 1664525u + 1013904223u; return (seed >> 8) / 16777216.0f; };
+        for (Spore &s : spores) {
+            s.x = rnd(); s.y = rnd(); s.speed = 1 + (int)(rnd() * 3); s.size = rnd(); s.sway = 1 + (int)(rnd() * 4);
+            s.color = rnd() < 0.5f ? 0x4CC38A : 0x4FC3F7;
+        }
+        made = true;
+    }
+    for (int y = 0; y < 240; y += 2) {
+        int c = 0x0A0E15, x0 = left ? left[y / 2] : 0;
+        if (x0 >= UI_W) continue;
+        if (y < 90) { float f = 1 - y / 90.0f; c = mixC(c, 0x2A2112, f * f * 0.9f); }
+        else if (y >= 170) { float f = (y - 170) / 70.0f; c = mixC(c, 0x0F2A2C, f * f * 0.8f); }
+        ui3dsDrawRect(x0, y, UI_W, y + 2, c);
+        for (int i = 0; i * 16 <= UI_W; i++) {   // faint blue columns, strongest in the middle
+            float d = fabsf(i * 16 - UI_W / 2) / (UI_W / 2.0f);
+            if (i * 16 >= x0) ui3dsDrawRect(i * 16, y, i * 16 + 1, y + 2, 0x4FC3F7, 0.05f * (1 - d * d));
+        }
+    }
+    float drift = (float)(osGetTime() % 60000) / 60000.0f;
+    for (const Spore &s : spores) {   // whole laps and sways per loop, so the loop restarts without a jump
+        float y = 1 - fmodf(s.y + drift * s.speed, 1.0f);
+        float x = s.x * UI_W + sinf((drift * s.sway + s.y) * 6.2831853f) * 9;
+        int row = (int)(y * UI_H) / 2;
+        if (left && (row < 0 || row >= 120 || x < left[row] + 6)) continue;
+        float fade = fminf(1, fminf(y * 6, (1 - y) * 6)), r = 0.6f + 0.9f * s.size;
+        fillDisc(x, y * UI_H, r * 4, s.color, 0.07f * fade);
+        fillDisc(x, y * UI_H, r < 1 ? 1 : r, s.color, (0.25f + 0.4f * s.size) * fade);
+    }
+}
+
+/* Cut-corner rows and panels, the chosen row glowing amber and breathing, a gradient title strip. */
+static void drawStyledRect(const UiCmd *c, int color, float pulse)
+{
+    if (c->color == 0 && c->w >= UI_W - 2 && c->h >= UI_H - 2) return;
+    if (c->color == 1 && c->w >= 280 && c->y <= 2) {
+        for (int q = 0; q < c->h; q++) ui3dsDrawRect(c->x, c->y + q, c->x + c->w, c->y + q + 1, mixC(0x141B27, 0x10161F, (float)q / c->h));
+        ui3dsDrawRect(c->x, c->y + c->h - 1, c->x + c->w, c->y + c->h, 0x25324A);
+    } else if ((c->color == 1 || c->color == 2) && c->w >= 24 && c->h >= 10) {
+        int cut = c->h >= 28 ? 4 : 2;
+        if (c->color == 2) {
+            for (int g = 3; g >= 1; g--) drawChamfer(c->x - g, c->y - g, c->w + 2 * g, c->h + 2 * g, cut + g, mixC(0x0A0E15, 0xF2A33A, (0.10f + 0.10f * pulse) / g));
+            drawChamfer(c->x, c->y, c->w, c->h, cut, mixC(0x24221C, 0xF2A33A, 0.55f + 0.45f * pulse));
+            drawChamfer(c->x + 1, c->y + 1, c->w - 2, c->h - 2, cut - 1, 0x33291A);   // the inside, amber tinted across the whole row
+        } else {
+            drawChamfer(c->x, c->y, c->w, c->h, cut, 0x25324A);
+            drawChamfer(c->x + 1, c->y + 1, c->w - 2, c->h - 2, cut - 1, 0x141B27);
+        }
+    } else ui3dsDrawRect(c->x, c->y, c->x + c->w, c->y + c->h, color);
+}
+
+/* The change of screen: a bright diagonal seam crosses it, four bands locking in one after another. */
+/* A progress ring in the box of c: a dark track and, from the top clockwise, the share in c->align (percent) in the colour. */
+static void drawRing(const UiCmd *c, int color)
+{
+    float r = c->w / 2.0f, th = 4.0f, frac = c->align / 100.0f;
+    for (int y = 0; y < c->h; y++) {
+        int runStart = -1, runColor = -2;
+        for (int x = 0; x <= c->w; x++) {
+            int col = -1;
+            if (x < c->w) {
+                float dx = x + 0.5f - r, dy = y + 0.5f - c->h / 2.0f, d = sqrtf(dx * dx + dy * dy);
+                if (d <= r && d >= r - th) {
+                    float a = atan2f(dx, -dy);   // 0 at the top, growing clockwise
+                    if (a < 0) a += 6.2831853f;
+                    col = a <= frac * 6.2831853f ? color : 0x25324A;
+                }
+            }
+            if (col != runColor || x == c->w) {   // horizontal runs of one colour become one rectangle
+                if (runStart >= 0 && runColor >= 0) ui3dsDrawRect(c->x + runStart, c->y + y, c->x + x, c->y + y + 1, runColor);
+                runStart = x; runColor = col;
+            }
+        }
+    }
+}
+
+static void fillDisc(float cx, float cy, float r, int color, float alpha)
+{
+    for (int y = (int)floorf(cy - r); y <= (int)ceilf(cy + r); y++) {
+        float dy = y + 0.5f - cy;
+        if (dy * dy > r * r) continue;
+        float half = sqrtf(r * r - dy * dy);
+        ui3dsDrawRect((int)(cx - half + 0.5f), y, (int)(cx + half + 0.5f), y + 1, color, alpha);
+    }
+}
+
+// A ring between radius r - th and r.
+static void fillRing(float cx, float cy, float r, float th, int color, float alpha)
+{
+    float ri = r - th;
+    for (int y = (int)floorf(cy - r); y <= (int)ceilf(cy + r); y++) {
+        float dy = y + 0.5f - cy;
+        if (dy * dy > r * r) continue;
+        float ho = sqrtf(r * r - dy * dy), hi = dy * dy < ri * ri ? sqrtf(ri * ri - dy * dy) : 0;
+        if (hi <= 0) { ui3dsDrawRect((int)(cx - ho + 0.5f), y, (int)(cx + ho + 0.5f), y + 1, color, alpha); continue; }
+        ui3dsDrawRect((int)(cx - ho + 0.5f), y, (int)(cx - hi + 0.5f), y + 1, color, alpha);
+        ui3dsDrawRect((int)(cx + hi + 0.5f), y, (int)(cx + ho + 0.5f), y + 1, color, alpha);
+    }
+}
+
+/* The load choice's marker, a soap bubble (pc_gfx.c kind 5): a faint body, a halo that breathes, a bright rim with three
+ * arcs of colour turning inside it, and highlights. align is its size in percent. */
+static void drawOrb(const UiCmd *c, int color, float pulse)
+{
+    float t = (float)(osGetTime() % 600000) / 1000.0f;
+    float r = 9 * c->align / 100.0f * (1 + 0.035f * sinf(t * 4.2f)), cx = c->x + c->w / 2.0f, cy = c->y + c->h / 2.0f;
+    if (r < 1) return;
+    fillRing(cx, cy, r * 2.1f, r * 1.1f, color, (30 + 25 * pulse) / 255.0f);
+    fillDisc(cx, cy, r, color, 40 / 255.0f);
+    static const int FILM[3] = {0x44E0FF, 0xFF6AD5, 0xFFE07A};
+    for (int s = 0; s < 3; s++) {
+        float a0 = t * 1.6f + s * 2.0943951f;
+        for (int j = 0; j < 10; j++) {
+            float a = a0 + j * 0.09f;
+            fillDisc(cx + cosf(a) * r * 0.82f, cy + sinf(a) * r * 0.82f, 0.9f, FILM[s], 150 / 255.0f * (1 - j / 10.0f));
+        }
+    }
+    fillRing(cx, cy, r, 0.9f, color, 220 / 255.0f);
+    fillDisc(cx - r * 0.38f, cy - r * 0.45f, r * 0.24f, 0xFFFFFF, 210 / 255.0f);
+    fillDisc(cx + r * 0.45f, cy + r * 0.5f, r * 0.1f < 0.6f ? 0.6f : r * 0.1f, 0xFFFFFF, 110 / 255.0f);
+}
+
+/* ---- the menus' legend ("A Load  Left Right Choose  B Back") as a bar of 3DS buttons ---- */
+static const char *const HINT_KEYS[] = {"A", "B", "X", "Y", "L", "R", "Select", "Start", "Up", "Down", "Left", "Right"};
+
+static int hintKey(const char *w)
+{
+    for (unsigned i = 0; i < sizeof HINT_KEYS / sizeof HINT_KEYS[0]; i++) if (!strcmp(HINT_KEYS[i], w)) return (int)i;
+    return -1;
+}
+
+static bool isHint(const UiCmd *c)
+{
+    if (c->kind != 1 || c->y < UI_H - 16) return false;
+    char w[16];
+    int l = 0;
+    while (c->text[l] && c->text[l] != ' ' && l < 15) { w[l] = c->text[l]; l++; }
+    w[l] = 0;
+    return hintKey(w) >= 0;
+}
+
+/* The button's picture at x, centred on cy; returns its width. pad: a key name, "LR" or "UD" for a pair of directions, "LR2" for the shoulders. */
+static int drawHintButton(int x, int cy, const char *pad, bool draw)
+{
+    const int cap = 0xC7D0DE, ink = 0x141B27, dim = 0x4A566B;
+    if (strlen(pad) == 1 && strchr("ABXY", pad[0])) {   // face button: a round cap with its letter
+        if (draw) {
+            fillDisc(x + 6.5f, cy, 6.5f, cap);
+            ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, x, cy - 6, x + 13, cy + 7, ink, HALIGN_CENTER, pad);
+        }
+        return 13;
+    }
+    bool dir = !strcmp(pad, "LR") || !strcmp(pad, "UD") || hintKey(pad) >= 8;
+    if (dir) {   // the D-pad, the arms that act lit
+        if (draw) {
+            bool l = !strcmp(pad, "LR") || !strcmp(pad, "Left"), r = !strcmp(pad, "LR") || !strcmp(pad, "Right");
+            bool u = !strcmp(pad, "UD") || !strcmp(pad, "Up"), d = !strcmp(pad, "UD") || !strcmp(pad, "Down");
+            ui3dsDrawRect(x, cy - 2, x + 13, cy + 2, dim);
+            ui3dsDrawRect(x + 4, cy - 6, x + 9, cy + 7, dim);
+            if (l) ui3dsDrawRect(x, cy - 2, x + 5, cy + 2, cap);
+            if (r) ui3dsDrawRect(x + 8, cy - 2, x + 13, cy + 2, cap);
+            if (u) ui3dsDrawRect(x + 4, cy - 6, x + 9, cy - 1, cap);
+            if (d) ui3dsDrawRect(x + 4, cy + 2, x + 9, cy + 7, cap);
+        }
+        return 13;
+    }
+    const char *label = !strcmp(pad, "LR2") ? "L R" : !strcmp(pad, "Select") ? "SELECT" : !strcmp(pad, "Start") ? "START" : pad;
+    int w = ui3dsGetStringWidth(label) + 8;   // shoulders and the small buttons: a cut-corner cap with the name
+    if (draw) {
+        drawChamfer(x, cy - 6, w, 13, 2, cap);
+        ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, x, cy - 6, x + w, cy + 7, ink, HALIGN_CENTER, label);
+    }
+    return w;
+}
+
+static void drawHintBar(const char *hint)
+{
+    char words[24][16], labels[10][40], pads[10][8];
+    int nw = 0, n = 0;
+    for (const char *p = hint; *p && nw < 24;) {
+        while (*p == ' ' || *p == ',') p++;
+        int l = 0;
+        while (p[l] && p[l] != ' ' && p[l] != ',') l++;
+        snprintf(words[nw], sizeof words[nw], "%.*s", l < 15 ? l : 15, p);
+        size_t wl = strlen(words[nw]);
+        if (wl && words[nw][wl - 1] == ':') words[nw][wl - 1] = 0;
+        if (l) nw++;
+        p += l;
+    }
+    for (int i = 0; i < nw && n < 10;) {
+        if (hintKey(words[i]) < 0) { i++; continue; }
+        int j = i + 1;
+        snprintf(pads[n], sizeof pads[n], "%s", words[i]);
+        if (j < nw && ((!strcmp(words[i], "Left") && !strcmp(words[j], "Right")) || (!strcmp(words[i], "Up") && !strcmp(words[j], "Down")) || (!strcmp(words[i], "L") && !strcmp(words[j], "R")))) {
+            snprintf(pads[n], sizeof pads[n], "%s", !strcmp(words[i], "Left") ? "LR" : !strcmp(words[i], "Up") ? "UD" : "LR2");
+            j++;
+        }
+        labels[n][0] = 0;
+        while (j < nw && hintKey(words[j]) < 0) {
+            size_t cur = strlen(labels[n]);
+            snprintf(labels[n] + cur, sizeof labels[n] - cur, "%s%s", cur ? " " : "", words[j]);
+            j++;
+        }
+        n++;
+        i = j;
+    }
+    const int y = UI_H - 16, cy = y + 8, gap = 10;
+    int total = 0;
+    for (int i = 0; i < n; i++) total += drawHintButton(0, cy, pads[i], false) + 4 + ui3dsGetStringWidth(labels[i]) + (i ? gap : 0);
+    int x = UI_W - 8 - total;
+    if (x < 4) x = 4;
+    for (int i = 0; i < n; i++) {
+        x += drawHintButton(x, cy, pads[i], true) + 4;
+        int tw = ui3dsGetStringWidth(labels[i]);
+        ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, x, cy - 7, x + tw + 2, cy + 7, 0xB8C2D4, HALIGN_LEFT, labels[i]);
+        x += tw + gap;
+    }
+}
+
+#define WIPE_HOLD 600   // ms the new screen stays covered by the wallpaper before the seam opens it
+#define WIPE_OPEN 500
+#define WIPE_FADE 200   // ms the screen that left takes to fade out over the cover
+
+static u64 wipeStart;
+
+// Menu input waits until the seam has opened most of the new screen.
+static bool uiBusy() { return osGetTime() - wipeStart < WIPE_HOLD + WIPE_OPEN * 6 / 10; }
+
+/* The change of screen: the wallpaper covers it for WIPE_HOLD, then a bright diagonal seam crosses it, four bands
+ * locking in one after another. p < 0 while it is still covered. */
+static void drawWipe(float p)
+{
+    if (p >= 1) return;
+    int left[120] = {0};   /* UI_H is 240 here; the compiler cannot tell the loop fills it */
+    bool holding = p < 0;
+    if (holding) p = 0;
+    for (int y = 0; y < UI_H; y += 2) {
+        int b = y / 60;
+        float edge = holding ? -1 : p * (UI_W + UI_H * 0.22f + 0.54f * UI_W) - 0.18f * UI_W * b - y * 0.22f;
+        left[y / 2] = edge < 0 ? 0 : edge > UI_W ? UI_W : (int)edge;
+    }
+    drawBackdrop(left);
+    if (holding) return;
+    for (int y = 0; y < UI_H; y += 2) {
+        int b = y / 60;
+        float edge = p * (UI_W + UI_H * 0.22f + 0.54f * UI_W) - 0.18f * UI_W * b - y * 0.22f;
+        if (edge > -2 && edge < UI_W) {
+            int e = (int)edge;
+            ui3dsDrawRect(e - 2, y, e + 4, y + 2, mixC(0x0A0E15, 0xF2A33A, 0.35f * (1 - p)));
+            ui3dsDrawRect(e, y, e + 2, y + 2, mixC(0x0A0E15, 0xFFE7A8, 1 - p * 0.6f));
+        }
+    }
+}
+
+static void drawUi(SmzUi *u)
+{
+    ui_draw(u);
+    static int lastScreen = -1;
+    static u16 shown[SCREEN_TOP_WIDTH * 240], gone[SCREEN_TOP_WIDTH * 240];   // the last frame drawn uncovered, and the screen that left
+    static u64 goneAt;
+    u64 now = osGetTime();
+    if ((int)u->screen != lastScreen) {   // a different screen, not a cursor move: the old one fades, the wallpaper holds, the seam opens
+        bool instant = lastScreen < 0 || lastScreen == UI_BUSY || u->screen == UI_BUSY;   // a busy note shows at once: work blocks right after it
+        if (instant) wipeStart = now - (lastScreen < 0 ? WIPE_HOLD : WIPE_HOLD + WIPE_OPEN);
+        else { wipeStart = now; memcpy(gone, shown, UI_W * 240 * 2); goneAt = now; }
+        lastScreen = (int)u->screen;
+    }
+    float pulse = 0.5f + 0.5f * sinf((float)(now % 100000) / 1000.0f * 3.4f);
+    drawBackdrop();
+    char hint[160] = "";
+    for (int i = 0; i < u->cmd_count; i++) {
+        if (!isHint(&u->cmd[i])) continue;
+        ui3dsDrawRect(0, UI_H - 16, UI_W, UI_H, 0x0C1119);   // under the screen, so text that reaches into the bar still shows
+        ui3dsDrawRect(0, UI_H - 16, UI_W, UI_H - 15, 0x25324A);
+        break;
+    }
+    for (int i = 0; i < u->cmd_count; i++) {
+        const UiCmd *c = &u->cmd[i];
+        int color = PALETTE[c->color < UI_COLORS ? c->color : 3];
+        if (c->kind == 0) {
+            drawStyledRect(c, color, pulse);
+        } else if (c->kind == 2) {
+            drawPreview(c);
+        } else if (c->kind == 4) {
+            drawRing(c, color);
+        } else if (c->kind == 5) {
+            drawOrb(c, color, pulse);
+        } else if (isHint(c)) {
+            size_t n = strlen(hint);
+            snprintf(hint + n, sizeof hint - n, "%s%s", n ? "  " : "", c->text);
+        } else {
+            int x0 = c->x, x1 = UI_W;
+            int align = HALIGN_LEFT;
+            if (c->align == 1) { x0 = c->x - UI_W / 2; x1 = c->x + UI_W / 2; align = HALIGN_CENTER; }
+            if (c->align == 2) { x0 = 0; x1 = c->x; align = HALIGN_RIGHT; }
+            ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, x0, c->y, x1, c->y + 14, color, align, c->text);
+        }
+    }
+    if (hint[0]) drawHintBar(hint);
+    u16 *fb = (u16 *)gfxGetFramebuffer(settings3DS.SecondScreen, GFX_LEFT, NULL, NULL);
+    memcpy(shown, fb, UI_W * 240 * 2);
+    drawWipe(((float)(now - wipeStart) - WIPE_HOLD) / WIPE_OPEN);
+    if (now - goneAt < WIPE_FADE) {
+        float a = 1 - (float)(now - goneAt) / WIPE_FADE;
+        int k = (int)(256 * a * a);
+        for (int i = 0; i < UI_W * 240; i++) fb[i] = blend565(fb[i], gone[i], k);
+    }
+    impl3dsFlushScreen(settings3DS.SecondScreen, false, false);
+    gfxScreenSwapBuffers(settings3DS.SecondScreen, false);
+    gpu3dsWaitForVBlank(settings3DS.SecondScreen);
+}
+
+static void refreshSlots(SmzUi *u)
+{
+    for (int i = 0; i < UI_SLOTS; i++) {
+        char path[96], sum[64];
+        snprintf(path, sizeof path, RUN_DIR "/slot%d.run", i);
+        SmzRun r;
+        if (runLoad(path, &r) == 0) { smz_run_summary(&r, sum, sizeof sum); ui_set_slot(u, i, 1, r.name, sum); ui_set_slot_stats(u, i, r.zelda_cleared, r.zelda_total, r.metroid_cleared, r.metroid_total, r.play_ms, r.game, r.boss_mask, r.crystal_mask); ui_set_slot_rules(u, i, r.settings); ui_set_slot_online(u, i, smzOnlineSlotKind(i)); }
+        else ui_set_slot(u, i, 0, "", "");
+    }
+}
