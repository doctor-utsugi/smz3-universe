+void smz3StateLoaded(const char *path)
+{
+    trk.state_loaded = 3;
+    char gp[PATH_MAX];
+    snprintf(gp, sizeof gp, "%s.goals", path);
+    size_t n = 0;
+    char *t = smz3IsRun() ? (char *)readFile(gp, &n) : NULL;   // none: the counters stay where they are
+    if (t) { snprintf(goalsLoaded, sizeof goalsLoaded, "%.*s", (int)n, t); goalsPending = true; free(t); }
+}
+
+void smz3StateSaved(const char *path)
+{
+    if (!smz3IsRun() || curSlot < 0) return;
+    char gp[PATH_MAX], t[640];
+    snprintf(gp, sizeof gp, "%s.goals", path);
+    int n = smz_counters_text(&goalc, t, sizeof t);
+    FILE *f = n >= 0 ? fopen(gp, "wb") : NULL;   // loading the state puts the counters back to this point
+    if (f) { fwrite(t, 1, (size_t)n, f); fclose(f); }
+}
+
+// Leaving the run: its file keeps the counters, and the server gets them.
+static void goalsLeave(bool report)
+{
+    if (curSlot < 0 || curSlot != gPlaySlot) return;
+    char rp[96];
+    SmzRun r;
+    snprintf(rp, sizeof rp, RUN_DIR "/slot%d.run", curSlot);
+    if (runLoad(rp, &r) != 0) return;
+    smz_counters_text(&goalc, r.goals, sizeof r.goals);
+    if (trk.started && !finishedBefore) {   // the run's file is written every ten seconds: the last ones go in now
+        r.play_ms = trk.base_ms + trk.pending_ms;
+        r.last_played = (int64_t)time(NULL) * 1000;
+        r.game = (int)trk.game;
+        r.zelda_cleared = (int)trk.zelda_cleared; r.metroid_cleared = (int)trk.metroid_cleared;
+        r.boss_mask = trk.boss_mask; r.crystal_mask = trk.crystal_mask;
+        if (trk.save_ms > 0) { r.save_ms = trk.save_ms; r.save_zelda = trk.save_zelda; r.save_metroid = trk.save_metroid; }
+    }
+    if (smz_run_save(rp, &r) == 0) smz_tracker_commit(&trk);
+    if (report) smzOnlineGoalsReport(curSlot + 1, r.created, smzOnlineSlotKind(curSlot) > 0, r.goals);
+}
+
+void smz3RunClosing(void) { if (smz3IsRun()) goalsLeave(false); }
+
+unsigned smz3TrackerKeys(unsigned keysDown, bool *openMenu)
+{
+    *openMenu = false;
+    if (!smz3IsRun()) return 0;
+    if (cardState != 1) {
+        unsigned took = boundKeys();   // a bound button never reaches the game
+        if (noStatesUntil && (keysDown & ~KEY_TOUCH)) { noStatesUntil = 0; dirty = true; return took | (keysDown & ~KEY_TOUCH); }   // the button that closes it does nothing else
+        if (askState >= 0) {   // A or B answers the SAVE or LOAD waiting
+            if (keysDown & (KEY_A | KEY_B)) answerStateAsk(keysDown & KEY_A);
+            return took | KEY_A | KEY_B;
+        }
+        for (int i = 0; i < BTN_COUNT; i++) {
+            if (!(took & keysDown & BTN_KEYS[i])) continue;
+            int a = inBtn[i];
+            if (a == BIND_SAVE || a == BIND_LOAD) requestState(a == BIND_SAVE);
+            else if (a == BIND_MENU) *openMenu = true;
+            else if (a >= BIND_SHORTCUT) {
+                scLoad();
+                int k = a - BIND_SHORTCUT, id = k < SC_SLOTS ? scSlots[k] : SC_ZELDA_COUNT + k - SC_SLOTS;
+                if (id >= 0) scUse(id);
+                dirty = true;
+            }
+        }
+        return took;
+    }
+    if (!(keysDown & (KEY_A | KEY_B))) return 0;
+    if (cardSkip()) return KEY_A | KEY_B;
+    if (keysDown & KEY_A) { wantRunList = *openMenu = true; }
+    cardState = 2;
+    dirty = true;
+    return KEY_A | KEY_B;
+}
+
+bool smz3TakeRunListRequest(void)
+{
+    bool want = wantRunList;
+    wantRunList = false;
+    return want;
+}
+
+void smz3TrackerFrame(bool tick)
+{
+    static int sinceDraw = 0;
+    if (strncmp(Memory.ROMFilename, RUN_DIR "/", sizeof RUN_DIR) != 0 || !Memory.RAM || !Memory.SRAM) return;
+    sinceDraw++;
+    static u64 lastFrameMs;
+    u64 now = osGetTime();
+    if (settings3DS.TurboMode && now - lastFrameMs < 3000) { turboWallMs += now - lastFrameMs; turboEmuMs += 1000 / 60.0988; }
+    lastFrameMs = now;
+    if (tick || curSlot != gPlaySlot) { trackerUpdate(); debugTouches(); dirty = true; }
+    static unsigned frames;
+    if (++frames % 6 == 0 && curSlot >= 0 && curSlot == gPlaySlot && !goalsPending)   // ~100 ms: an enemy's death is short
+        smz_counters_tick(&goalc, trk.started ? (int)trk.game : 0, Memory.RAM, 0x20000, Memory.SRAM, 0x20000, (int)(trk.zelda_cleared + trk.metroid_cleared));
+    runPendingState();
+    if (barNoteUntil && now >= barNoteUntil) { barNoteUntil = 0; dirty = true; }
+    if (noStatesUntil && now >= noStatesUntil) { noStatesUntil = 0; dirty = true; }
+    if (cardState) { cardSounds(); if (cardT() < T_BUTTONS + 0.4f && sinceDraw >= 2) dirty = true; }   // the details move at 30 fps
+    bool portal = portalPlaying(), visor = visorPlaying(), portalEnd = (portalAt && !portal) || (visorAt && !visor);
+    int every = visor ? 3 : 4;   // a blend of the whole screen costs ~5 ms on an Old 3DS: the visor at 20 fps, the portal at 15
+    if ((portal || visor) && sinceDraw >= every) dirty = true;
+    if (portalEnd) { if (!portal) portalAt = 0; if (!visor) visorAt = 0; dirty = true; }   // then the tracker alone, at once
+    if (dirty && (tick || sinceDraw >= 3 || cardState || ((portal || visor) && sinceDraw >= every) || portalEnd)) { trackerDraw(); sinceDraw = 0; }   // a drag redraws at most every third frame
+}
