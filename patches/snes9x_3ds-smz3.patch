+extern "C" {
+#include "smz3_discovery.h"
+#include "smz3_shortcuts.h"
+#include "smz3_dungeonmaps.h"
+extern const SmzMapData SMZ3_MAP_DATA;
+}
+
+struct TrkTheme { int bg, panel, accent, text, dim, bar, tab, pending, done; };
+static const TrkTheme THEME_ZELDA = {0x14231A, 0x1F3A24, 0xE8C14A, 0xF3EBC8, 0xA8A27A, 0x5BBF6A, 0x2B4A30, 0xFFD54A, 0x7BE08A};
+static const TrkTheme THEME_METROID = {0x05080C, 0x0C1A24, 0xFF9A1F, 0xD8F6FF, 0x5E8DA0, 0x19D3C5, 0x13303F, 0xFF9A1F, 0x19D3C5};
+
+enum { TAB_RUN, TAB_ITEMS, TAB_CHECKS, TAB_MAP, TAB_HELP, TAB_COUNT };
+static const char *const TAB_NAMES[TAB_COUNT] = {"RUN", "ITEMS", "CHECKS", "MAP", "HELP"};
+
+#define TAB_H 20
+#define STRIP_H 30
+#define PAUSE_W 24
+
+static u16 *trkFb;
+static int clipX0, clipY0, clipX1 = 320, clipY1 = 240;
+
+static inline u16 to565(int rgb) { return (u16)(((rgb >> 8) & 0xF800) | ((rgb >> 5) & 0x07E0) | ((rgb >> 3) & 0x1F)); }
+
+static void setClip(int x0, int y0, int x1, int y1)
+{
+    clipX0 = x0 < 0 ? 0 : x0; clipY0 = y0 < 0 ? 0 : y0; clipX1 = x1 > 320 ? 320 : x1; clipY1 = y1 > 240 ? 240 : y1;
+    ui3dsSetViewport(clipX0, clipY0, clipX1, clipY1);
+}
+
+static void fill(int x0, int y0, int x1, int y1, int rgb)
+{
+    if (x0 < clipX0) x0 = clipX0;
+    if (y0 < clipY0) y0 = clipY0;
+    if (x1 > clipX1) x1 = clipX1;
+    if (y1 > clipY1) y1 = clipY1;
+    u16 c = to565(rgb);
+    for (int x = x0; x < x1; x++) {
+        u16 *p = trkFb + x * 240 + 239 - y0;
+        for (int y = y0; y < y1; y++) *p-- = c;
+    }
+}
+
+static void fillAlpha(int x0, int y0, int x1, int y1, int rgb, int a)
+{
+    if (x0 < clipX0) x0 = clipX0;
+    if (y0 < clipY0) y0 = clipY0;
+    if (x1 > clipX1) x1 = clipX1;
+    if (y1 > clipY1) y1 = clipY1;
+    u16 c = to565(rgb);
+    for (int x = x0; x < x1; x++) {
+        u16 *p = trkFb + x * 240 + 239 - y0;
+        for (int y = y0; y < y1; y++, p--) *p = blend565(*p, c, a);
+    }
+}
+
+static void dot(float cx, float cy, float r, int rgb)
+{
+    for (int dy = (int)floorf(-r); dy <= (int)ceilf(r); dy++) {
+        float yy = dy + 0.5f;
+        if (yy * yy > r * r) continue;
+        float half = sqrtf(r * r - yy * yy);
+        fill((int)lroundf(cx - half), (int)cy + dy, (int)lroundf(cx + half), (int)cy + dy + 1, rgb);
+    }
+}
+
+static int textW(const char *s) { return ui3dsGetStringWidth(s); }
+
+// align HALIGN_CENTER centres in x..x1, HALIGN_RIGHT ends at x
+static void text(int x, int y, int rgb, const char *s, int align = HALIGN_LEFT, int x1 = 320)
+{
+    if (y + 14 <= clipY0 || y >= clipY1) return;
+    int x0 = x;
+    if (align == HALIGN_RIGHT) { x0 = 0; x1 = x; }
+    ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, x0, y, x1, y + 14, rgb, align, s);
+}
+
+static void textf(int x, int y, int rgb, const char *fmt, ...) __attribute__((format(printf, 4, 5)));
+static void textf(int x, int y, int rgb, const char *fmt, ...)
+{
+    char s[160];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(s, sizeof s, fmt, ap);
+    va_end(ap);
+    text(x, y, rgb, s);
+}
+
+// Text cut with an ellipsis to fit in w pixels.
+static void textFit(int x, int y, int w, int rgb, const char *s)
+{
+    char cut[160];
+    ui3dsEllipsize(s, cut, sizeof cut, w);
+    text(x, y, rgb, cut);
+}
+
+// Word-wrapped text in w pixels from (x, y), at most maxLines lines; returns the y below it. draw = false only measures.
+static int textWrap(int x, int y, int w, int rgb, const char *s, int maxLines = 99, bool draw = true)
+{
+    char line[160];
+    const char *p = s;
+    for (int n = 0; *p && n < maxLines; n++) {
+        while (*p == ' ') p++;
+        int fit = 0, i = 0;
+        while (p[i]) {
+            int j = i;
+            while (p[j] && p[j] != ' ') j++;
+            if (j >= (int)sizeof line) break;
+            memcpy(line, p, j); line[j] = 0;
+            if (fit && textW(line) > w) break;
+            fit = j;
+            i = p[j] ? j + 1 : j;
+        }
+        if (!fit) fit = (int)strnlen(p, sizeof line - 1);
+        snprintf(line, sizeof line, "%.*s", fit, p);
+        while (fit > 1 && textW(line) > w) line[--fit] = 0;   // one word wider than the line: it breaks where it must
+        if (n == maxLines - 1 && p[fit]) { char c[168]; snprintf(c, sizeof c, "%s ...", line); ui3dsEllipsize(c, line, sizeof line, w); }
+        if (draw) text(x, y, rgb, line, HALIGN_LEFT, x + w);
+        y += 14;
+        p += fit;
+    }
+    return y;
+}
+
+// Text taller than the font (up to 32 px), drawn through the UI's upscaling into an RGBA4 buffer. Returns its width.
+static int bigText(int x, int y, int h, int rgb, const char *s)
+{
+    enum { BW = 200 };
+    static u16 buf[BW * 32];
+    memset(buf, 0, sizeof buf);
+    int w = ui3dsDrawStringToTexture(buf, s, 0, 0, BW, h, (u32)rgb << 8, h);
+    u16 c = to565(rgb);
+    for (int yy = 0; yy < h; yy++) {
+        int sy = y + yy;
+        if (sy < clipY0 || sy >= clipY1) continue;
+        for (int xx = 0; xx < w; xx++) {
+            int a = buf[yy * BW + xx] & 15, sx = x + xx;
+            if (!a || sx < clipX0 || sx >= clipX1) continue;
+            u16 *p = trkFb + sx * 240 + 239 - sy;
+            *p = a == 15 ? c : blend565(*p, c, a * 17);
+        }
+    }
+    return w;
+}
+
+static void bar(int x, int y, int w, int h, int done, int total, const TrkTheme &t)
+{
+    fill(x, y, x + w, y + h, t.panel);
+    if (total > 0 && done > 0) fill(x, y, x + w * (done > total ? total : done) / total, y + h, t.bar);
+}
