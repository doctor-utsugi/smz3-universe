+/// JSON values in a packed `GameData`, as their text.
+mod json_text {
+    use super::*;
+    use serde::de::Error;
+    use serde::{Deserializer, Serializer};
+
+    pub mod map {
+        use super::*;
+        pub fn serialize<K: Serialize, S: Serializer>(m: &HashMap<K, JsonValue>, s: S) -> Result<S::Ok, S::Error> {
+            let pairs: Vec<(&K, String)> = m.iter().map(|(k, v)| (k, v.dump())).collect();
+            (m.capacity() as u64, pairs).serialize(s)
+        }
+        pub fn deserialize<'de, K: Deserialize<'de> + Hash + Eq, D: Deserializer<'de>>(
+            d: D,
+        ) -> Result<HashMap<K, JsonValue>, D::Error> {
+            let (cap, pairs): (u64, Vec<(K, String)>) = Deserialize::deserialize(d)?;
+            let mut m = HashMap::with_capacity(cap as usize);
+            for (k, t) in pairs {
+                m.insert(k, json::parse(&t).map_err(D::Error::custom)?);
+            }
+            Ok(m)
+        }
+    }
+
+    /// serde_hex reads only borrowed bytes, which a reader cannot lend.
+    pub mod glow {
+        use super::*;
+        pub fn serialize<S: Serializer>(g: &GlowPatch, s: S) -> Result<S::Ok, S::Error> {
+            serde_json::to_string(g).map_err(serde::ser::Error::custom)?.serialize(s)
+        }
+        pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<GlowPatch, D::Error> {
+            serde_json::from_str(&String::deserialize(d)?).map_err(D::Error::custom)
+        }
+    }
+
+    pub mod vec {
+        use super::*;
+        pub fn serialize<S: Serializer>(v: &[JsonValue], s: S) -> Result<S::Ok, S::Error> {
+            s.collect_seq(v.iter().map(|j| j.dump()))
+        }
+        pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Vec<JsonValue>, D::Error> {
+            let texts: Vec<String> = Vec::deserialize(d)?;
+            texts.iter().map(|t| json::parse(t).map_err(D::Error::custom)).collect()
+        }
+    }
+}
+
+/// Start locations in a packed `GameData`: as their JSON (their `requires` is free-form JSON), with the
+/// requirements parsed from it.
+mod start_locations_pack {
+    use super::*;
+    use serde::de::Error;
+    use serde::{Deserializer, Serializer};
+
+    pub fn serialize<S: Serializer>(v: &[StartLocation], s: S) -> Result<S::Ok, S::Error> {
+        let text = serde_json::to_string(v).map_err(serde::ser::Error::custom)?;
+        let parsed: Vec<&Option<Requirement>> = v.iter().map(|x| &x.requires_parsed).collect();
+        (text, parsed).serialize(s)
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Vec<StartLocation>, D::Error> {
+        let (text, parsed): (String, Vec<Option<Requirement>>) = Deserialize::deserialize(d)?;
+        let mut v: Vec<StartLocation> = serde_json::from_str(&text).map_err(D::Error::custom)?;
+        for (x, p) in v.iter_mut().zip(parsed) {
+            x.requires_parsed = p;
+        }
+        Ok(v)
+    }
+}
