+/// Link requirements in a packed `GameData`: an index into one table of the distinct requirements, written and read
+/// within `shared_requirement::writing` and `shared_requirement::reading`, so they stay shared.
+pub mod shared_requirement {
+    use super::*;
+    use serde::de::Error;
+    use serde::{Deserializer, Serializer};
+    use std::cell::Cell;
+
+    enum Table {
+        Writing(HashMap<Arc<Requirement>, u32>, Vec<Arc<Requirement>>),
+        Reading(Vec<Arc<Requirement>>),
+    }
+
+    // A pointer to a table on the caller's stack: a thread local with a destructor aborts on the 3DS, where std cannot
+    // register thread-exit destructors.
+    thread_local! {
+        static TABLE: Cell<*mut Table> = const { Cell::new(std::ptr::null_mut()) };
+    }
+
+    fn with_table<T>(table: &mut Table, f: impl FnOnce() -> T) -> T {
+        struct Reset;
+        impl Drop for Reset {
+            fn drop(&mut self) {
+                TABLE.with(|t| t.set(std::ptr::null_mut()));
+            }
+        }
+        TABLE.with(|t| t.set(table));
+        let _reset = Reset;
+        f()
+    }
+
+    fn current<T>(f: impl FnOnce(Option<&mut Table>) -> T) -> T {
+        // SAFETY: the pointer is set only while with_table borrows the table, on this thread.
+        f(TABLE.with(|t| unsafe { t.get().as_mut() }))
+    }
+
+    /// Runs `f` (a serialization) and returns its result with the table of the requirements it wrote.
+    pub fn writing<T>(f: impl FnOnce() -> T) -> (T, Vec<Requirement>) {
+        let mut table = Table::Writing(HashMap::new(), vec![]);
+        let out = with_table(&mut table, f);
+        let Table::Writing(_, reqs) = table else { unreachable!() };
+        (out, reqs.iter().map(|r| (**r).clone()).collect())
+    }
+
+    /// Runs `f` (a deserialization) with the requirements table written next to it.
+    pub fn reading<T>(reqs: Vec<Requirement>, f: impl FnOnce() -> T) -> T {
+        let mut table = Table::Reading(reqs.into_iter().map(Arc::new).collect());
+        with_table(&mut table, f)
+    }
+
+    pub fn serialize<S: Serializer>(r: &Arc<Requirement>, s: S) -> Result<S::Ok, S::Error> {
+        let idx = current(|t| match t {
+            Some(Table::Writing(index, reqs)) => Some(*index.entry(r.clone()).or_insert_with(|| {
+                reqs.push(r.clone());
+                reqs.len() as u32 - 1
+            })),
+            _ => None,
+        });
+        match idx {
+            Some(i) => s.serialize_u32(i),
+            None => Err(serde::ser::Error::custom("link requirement outside shared_requirement::writing")),
+        }
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<Arc<Requirement>, D::Error> {
+        let i = u32::deserialize(d)? as usize;
+        current(|t| match t {
+            Some(Table::Reading(reqs)) => reqs.get(i).cloned().ok_or_else(|| D::Error::custom("bad requirement index")),
+            _ => Err(D::Error::custom("link requirement outside shared_requirement::reading")),
+        })
+    }
+}
