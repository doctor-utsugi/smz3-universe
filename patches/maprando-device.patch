+
+fn link_buckets(n: usize, keys: impl Iterator<Item = usize> + Clone) -> (Vec<u32>, Vec<u32>) {
+    let mut offsets = vec![0u32; n + 1];
+    for k in keys.clone() {
+        offsets[k + 1] += 1;
+    }
+    for i in 0..n {
+        offsets[i + 1] += offsets[i];
+    }
+    let mut next = offsets.clone();
+    let mut flat = vec![0u32; offsets[n] as usize];
+    for (idx, k) in keys.enumerate() {
+        flat[next[k] as usize] = idx as u32;
+        next[k] += 1;
+    }
+    (offsets, flat)
 }
 
