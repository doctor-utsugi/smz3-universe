+/// The number under the top-level "id" key of a JSON object, read without parsing the rest.
+fn top_level_id(src: &str) -> Option<usize> {
+    let b = src.as_bytes();
+    let (mut depth, mut i) = (0, 0);
+    while i < b.len() {
+        match b[i] {
+            b'{' | b'[' => depth += 1,
+            b'}' | b']' => depth -= 1,
+            b'"' => {
+                let start = i + 1;
+                i += 1;
+                while b[i] != b'"' {
+                    i += if b[i] == b'\\' { 2 } else { 1 };
+                }
+                if depth == 1 && &b[start..i] == b"id" {
+                    if let Some(rest) = src[i + 1..].trim_start().strip_prefix(':') {
+                        let rest = rest.trim_start();
+                        let n = rest.find(|c: char| !c.is_ascii_digit()).unwrap_or(rest.len());
+                        return rest[..n].parse().ok();
+                    }
+                }
+            }
+            _ => {}
+        }
+        i += 1;
+    }
+    None
+}
