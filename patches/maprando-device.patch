+    /// After reading a pack: shares equal strat names again, and rebuilds the hash maps the randomizer iterates by
+    /// inserting their keys in the order loading from JSON did, so they iterate as a loaded `GameData`'s do.
+    pub fn after_unpack(&mut self) {
+        fn replay<K: Hash + Eq + Clone, V>(m: &mut HashMap<K, V>, order: &[K]) {
+            let mut old = std::mem::take(m);
+            for k in order {
+                if let Some(v) = old.remove(k) {
+                    m.insert(k.clone(), v);
+                }
+            }
+            assert!(old.is_empty());
+        }
+        let mut names: HashSet<Arc<str>> = HashSet::new();
+        for link in &mut self.base_links_data.links {
+            match names.get(&link.strat_name) {
+                Some(n) => link.strat_name = n.clone(),
+                None => {
+                    names.insert(link.strat_name.clone());
+                }
+            }
+        }
+        replay(&mut self.raw_room_id_by_ptr, &self.room_ptrs);
+        replay(&mut self.door_ptr_pair_map, &self.door_ptr_pair_order);
+        replay(&mut self.node_door_unlock, &self.door_unlock_order);
+    }
