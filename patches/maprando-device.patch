+impl TitleScreenData {
+    pub fn load(path: &Path) -> Result<Self> {
+        info!("Loading title screens");
+        let file_it = path.read_dir().with_context(|| {
+            format!(
+                "Unable to read title screen directory at {}",
+                path.display()
+            )
+        })?;
+        // Sorted, so a seed's title screen does not depend on the filesystem's directory order.
+        let mut files = file_it.collect::<std::io::Result<Vec<_>>>()?;
+        files.sort_by_key(|f| f.file_name());
+        let mut data = Self::default();
+        for file in files {
+            let filename = file.file_name().into_string().unwrap();
+            let img = read_image(&file.path())?;
+
+            if filename.starts_with("TL") {
+                data.top_left.push(img);
+            } else if filename.starts_with("TR") {
+                data.top_right.push(img);
+            } else if filename.starts_with("BL") {
+                data.bottom_left.push(img);
+            } else if filename.starts_with("BR") {
+                data.bottom_right.push(img);
+            } else if filename == "map.png" {
+                data.map_station = img;
+            }
+        }
+        Ok(data)
+    }
+}
