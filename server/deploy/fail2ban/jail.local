# /etc/fail2ban/jail.local
[DEFAULT]
banaction = iptables-multiport
banaction_allports = iptables-allports
bantime = 1h
bantime.increment = true
bantime.maxtime = 1w
findtime = 10m
# Ban history has to outlive bantime.maxtime for the increment to count.
dbpurgeage = 1w

[sshd]
enabled = true
backend = systemd
maxretry = 4

# Direct traffic to the duckdns site only; behind Cloudflare the peer is a Cloudflare address, never banned.
[caddy-4xx]
enabled = true
port = http,https
filter = caddy-4xx
logpath = /var/log/caddy/access.log
backend = auto
findtime = 1m
maxretry = 60
ignoreip = 127.0.0.1/8 ::1 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
